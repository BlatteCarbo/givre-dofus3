    <Compile Include="..\GivreClone.Tests\CraftAdvisorTests.cs" Link="Tests\CraftAdvisorTests.cs" />
    <Compile Include="..\GivreClone.Tests\EcoToolsTests.cs" Link="Tests\EcoToolsTests.cs" />
    <Compile Include="..\GivreClone.App\Services\CharacterDeletionEncoder.cs" Link="Linked\CharacterDeletionEncoder.cs" />
    <Compile Include="..\GivreClone.App\Services\SeasonalCalendar.cs" Link="Linked\SeasonalCalendar.cs" />
