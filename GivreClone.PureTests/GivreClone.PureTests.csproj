<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests de la logique PURE (trajets, expédition / donjon, fenêtre d'interaction, panoplies, achats HDV) : aucun projet voisin requis
       (GivreCore / GivreLauncher), donc compilables partout, y compris sur GitHub Actions. Les fichiers sont liés, pas copiés :
       le projet de tests complet (GivreClone.Tests) reste la référence locale. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>GivreClone.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compatibilité versions/protos : fixtures indépendantes d'Avalonia et du client Dofus,
         vérifiées également dans la CI publique du dépôt privé. -->
    <Compile Include="..\GivreClone.App\Services\ProtocolUpdates\*.cs" Link="Linked\ProtocolUpdates\%(Filename)%(Extension)" />
    <Compile Include="..\GivreClone.App\Services\ProtocolObservedDrift.cs" Link="Linked\ProtocolObservedDrift.cs" />
    <Compile Include="..\GivreClone.App\Services\AtomicJson.cs" Link="Linked\AtomicJson.cs" />
    <Compile Include="..\GivreClone.App\Services\VisualMods\*.cs" Link="Linked\VisualMods\%(Filename)%(Extension)" />
    <Compile Include="..\GivreClone.App\Services\CombatVisualModPolicy.cs" Link="Linked\CombatVisualModPolicy.cs" />
    <!-- Native distribution preflight belongs to the full test project (binary bundle and profile dependencies). -->
    <Compile Include="..\GivreClone.Tests\VisualModsCarnetTests.cs" Link="Tests\VisualModsCarnetTests.cs" />
    <Compile Include="..\GivreClone.Tests\ProtocolUpdateProbeTests.cs" Link="Tests\ProtocolUpdateProbeTests.cs" />
    <Compile Include="..\GivreClone.Tests\OfficialDofusReleaseProbeTests.cs" Link="Tests\OfficialDofusReleaseProbeTests.cs" />
    <Compile Include="..\GivreClone.Tests\Protocol371212CompatibilityTests.cs" Link="Tests\Protocol371212CompatibilityTests.cs" />
    <Compile Include="..\GivreClone.Tests\ProtocolUpdateIndexerTests.cs" Link="Tests\ProtocolUpdateIndexerTests.cs" />
    <Compile Include="..\GivreClone.Tests\ProtocolObservedDriftTests.cs" Link="Tests\ProtocolObservedDriftTests.cs" />
    <Compile Include="..\GivreClone.Tests\SocketPilotPolicyTests.cs" Link="Tests\SocketPilotPolicyTests.cs" />
    <Compile Include="..\GivreClone.App\Services\LotM\HdvCraftScanner.cs" Link="Linked\HdvCraftScanner.cs" />
    <Compile Include="..\GivreClone.Tests\HdvCraftScannerTests.cs" Link="Tests\HdvCraftScannerTests.cs" />
    <Compile Include="..\GivreClone.App\Services\Expedition\ZoneValue.cs" Link="Linked\ZoneValue.cs" />
    <Compile Include="..\GivreClone.Tests\ZoneValueTests.cs" Link="Tests\ZoneValueTests.cs" />
    <!-- Protocol-backed adapter and networked data cache are tested by the full app suite. -->
    <Compile Include="..\GivreClone.App\Services\Eco\*.cs" Exclude="..\GivreClone.App\Services\Eco\ForgeState.cs;..\GivreClone.App\Services\Eco\ItemEffectRanges.cs" Link="Linked\Eco\%(Filename)%(Extension)" />
    <Compile Include="..\GivreClone.Protocol\MapInteractive.cs" Link="Linked\MapInteractive.cs" />
    <Compile Include="..\GivreClone.Protocol\MZP3RawProtobuf.cs" Link="Linked\MZP3RawProtobuf.cs" />
