    <Compile Include="..\GivreClone.App\Services\ResaleOpportunity.cs" Link="Linked\ResaleOpportunity.cs" />
    <Compile Include="..\GivreClone.Tests\ResaleOpportunityTests.cs" Link="Tests\ResaleOpportunityTests.cs" />
