<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{6D9C2F41-7B3E-4A15-9C82-2E4D7A1B0F3C}</ProjectGuid>
    <RootNamespace>GivreKama</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Microsoft Detours vendorise dans ce projet (self-contained). Surchargeable : -p:DetoursDir=... -->
    <DetoursDir Condition="'$(DetoursDir)'==''">$(MSBuildThisFileDirectory)third_party\Detours\</DetoursDir>
    <!-- SDK VMProtect : DESACTIVE par defaut. Cette DLL est INJECTEE dans Dofus.exe : elle doit rester
         self-contained. Lier VMProtectSDK64.lib cree une dependance runtime a VMProtectSDK64.dll, absente
         a cote de Dofus.exe -> le module ne se charge pas -> le hook n'est jamais confirme (client ferme).
         Reactivable via -p:EnableVmp=true (la vraie protection s'applique au PACKING, pas au link). -->
    <EnableVmp Condition="'$(EnableVmp)'==''">false</EnableVmp>
    <VmpSdkDir Condition="'$(VmpSdkDir)'==''">$(ProgramW6432)\VMProtect Professional</VmpSdkDir>
    <VmpSdkDirN>$([MSBuild]::EnsureTrailingSlash('$(VmpSdkDir)'))</VmpSdkDirN>
    <VmpHasSdk Condition="'$(EnableVmp)'=='true' and Exists('$(VmpSdkDirN)Include\C\VMProtectSDK.h')">true</VmpHasSdk>
    <VmpInclude Condition="'$(VmpHasSdk)'=='true'">$(VmpSdkDirN)Include\C;</VmpInclude>
    <VmpLibDir Condition="'$(VmpHasSdk)'=='true'">$(VmpSdkDirN)Lib\Windows;</VmpLibDir>
    <VmpLib Condition="'$(VmpHasSdk)'=='true'">VMProtectSDK64.lib;</VmpLib>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)build\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)build\obj\$(Configuration)\</IntDir>
    <TargetName>GivreKama</TargetName>
  </PropertyGroup>

  <!-- ===== Debug ===== -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(DetoursDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>detours.lib;ws2_32.lib;iphlpapi.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(DetoursDir)lib.X64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!-- ===== Release (distribution) : durci OpSec (CRT statique, aucun PDB, build deterministe) ===== -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <DebugInformationFormat>None</DebugInformationFormat>
      <AdditionalIncludeDirectories>$(DetoursDir)include;$(VmpInclude)%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;WIN32;_WINDOWS;_USRDLL;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <AdditionalDependencies>detours.lib;ws2_32.lib;iphlpapi.lib;bcrypt.lib;$(VmpLib)%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(DetoursDir)lib.X64;$(VmpLibDir)%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalOptions>/Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="GivreKama.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
