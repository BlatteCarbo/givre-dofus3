<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GivreClone.App.Behaviors">

    <Style Selector="NumericUpDown /template/ TextBox">
        <Setter Property="local:NumericInputBehavior.SelectOnFocus" Value="True" />
    </Style>

    <!-- Police globale. Glyphes hors subset latin (cyrillique/CJK) -> fallback police système. -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="avares://GivreClone/Assets/Fonts#Roboto" />
    </Style>

    <!-- Texte -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <!-- Entrée de page -->
    <Style Selector="UserControl.page">
        <Setter Property="RenderTransformOrigin" Value="50%,0%" />
        <Style.Animations>
            <Animation Duration="0:0:0.16" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Sidebar -->
    <Style Selector="Border.sidebar">
        <Setter Property="Width" Value="74" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.sidebar.expanded">
        <Setter Property="Width" Value="252" />
    </Style>
    <Style Selector="Border.sidebar TextBlock.navlabel">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.sidebar.expanded TextBlock.navlabel">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Focus clavier visible sur TOUS les boutons (Tab), jamais au clic souris : contour accent clair,
         contraste mesure >= 5 sur toutes les surfaces du theme (WCAG 2.4.7 / 1.4.11). -->
    <Style Selector="Button, RadioButton, ToggleButton, CheckBox">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="2" CornerRadius="8" Margin="-3" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>

    <!-- Boutons sidebar -->
    <Style Selector="Button.nav">
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Background" Value="{StaticResource HoverMedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.navlabel">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Boutons barre de titre -->
    <Style Selector="Button.win">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="Foreground" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.win:pointerover">
        <Setter Property="Background" Value="{StaticResource WindowButtonHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.win.close:pointerover">
        <Setter Property="Background" Value="{StaticResource CloseButtonHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Boutons gestion des fichiers -->
    <Style Selector="Button.file">
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="11"
                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
                        Padding="16,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <PathIcon Grid.Column="1" Data="{StaticResource IconChevronRight}"
                                  Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.file:pointerover">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="RenderTransform" Value="scale(1.012)" />
    </Style>
    <Style Selector="Button.file:pressed">
        <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>

    <!-- Bouton primaire -->
    <Style Selector="Button.primary">
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Foreground" Value="{StaticResource WorkshopAccentTextBrush}" />
        <Setter Property="Background" Value="{StaticResource WorkshopAccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bg" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>
    <!-- pas d'agrandissement : bouton étiré en rangée serrée, sinon déborde sur les voisins -->
    <Style Selector="Button.primary.noscale:pointerover">
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button.primary.noscale:pressed">
        <Setter Property="RenderTransform" Value="scale(0.995)" />
    </Style>
    <!-- désactivé : atténué (ex. Accepter tant que la case n'est pas cochée) -->
    <Style Selector="Button.primary:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Action secondaire compacte : surface mate, meme rythme que les champs. -->
    <Style Selector="Button.accent">
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
    </Style>
    <Style Selector="Button.accent:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- Bouton choix de langue -->
    <Style Selector="Button.langpick">
        <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Button.langpick:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
    </Style>
    <Style Selector="Button.langpick.active">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{StaticResource HoverMedBrush}" />
    </Style>

    <!-- Bouton icône compact -->
    <Style Selector="Button.iconbtn">
        <Setter Property="Height" Value="34" />
        <Setter Property="Width" Value="38" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="0"
                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.iconbtn:pointerover">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Bouton ghost -->
    <Style Selector="Button.ghost">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Padding = celui du bouton (14,0 par défaut ; 0 pour les boutons-icônes -> icône réellement centrée). -->
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed">
        <Setter Property="Background" Value="{StaticResource HoverMedBrush}" />
    </Style>
    <Style Selector="Button.ghost:disabled, Button.accent:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Bouton Discord -->
    <Style Selector="Button.discord">
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="{StaticResource DiscordBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="13,0">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="White" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.discord:pointerover">
        <Setter Property="Background" Value="{StaticResource DiscordHoverBrush}" />
    </Style>

    <!-- Bouton lien -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="Foreground" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="9,6">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.link:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Croix : fermer une carte -->
    <Style Selector="Button.cardx">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="Foreground" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="7">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.cardx:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Champ de saisie (login) -->
    <Style Selector="TextBox.key">
        <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox.key:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- search bar : version compacte de .key -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,0,10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox.search:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- tous les TextBox : même look arrondi que la search bar -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource InputFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- AutoCompleteBox : wrapper neutre, l'apparence vient du TextBox interne -->
    <Style Selector="AutoCompleteBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- Sections natives : memes surfaces que les champs, y compris les petits panneaux d'equipement. -->
    <Style Selector="Expander">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
    </Style>

    <!-- Dropdowns -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
    </Style>
    <Style Selector="ComboBox:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- DatePicker (onglet Stats) : géométrie alignée sur les ComboBox ; les couleurs viennent des clés surchargées
         (Theme.axaml) -> plus de fond noir Fluent. -->
    <Style Selector="DatePicker">
        <!-- Le bouton du template Fluent lie son fond à {TemplateBinding Background} -> c'est DatePicker.Background qui
             pilote le fond au repos. On le met sur Surface2 = exactement le fond des boutons 24h/7j (fin du fond noir). -->
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DatePicker /template/ Button#PART_FlyoutButton">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="DatePicker /template/ Button#PART_FlyoutButton:pointerover">
        <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
    </Style>

    <!-- Items -->
    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <!-- popup : scaleY + fade -->
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="RenderTransformOrigin" Value="0%,0%" />
        <Style.Animations>
            <Animation Duration="0:0:0.17" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.8" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <!-- ToolTip -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{StaticResource TooltipBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeMedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="260" />
    </Style>

    <!-- Carte générique -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <!-- padding par defaut : le contenu ne colle pas aux bords (surchargeable par carte) -->
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Panneaux secondaires et listes de sélection : mêmes surfaces et espacements. -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
    </Style>
    <Style Selector="ListBox.surfaceList">
        <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox.surfaceList ListBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Badge -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
    </Style>

    <!-- Bandeau "notice" : avis licence / permission manquante. Couleur par defaut AMBER (indépendante
         de l'accent du thème -> reste un avertissement lisible même en thème Amber), bakée dans le style :
         les appelants posent juste Classes="notice" + IsVisible + contenu, aucune couleur inline.
         Icône + texte teintés via sélecteurs descendants (cf. Border.sidebar TextBlock.navlabel). -->
    <Style Selector="Border.notice">
        <Setter Property="Background" Value="#1FE0A53F" />
        <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.notice PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource AmberBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.notice TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- écart avec l'icône (le texte est en colonne * d'un Grid -> largeur bornée -> il enroule vraiment). -->
        <Setter Property="Margin" Value="12,0,0,0" />
    </Style>

    <!-- Skeleton (pulse) -->
    <Style Selector="Border.skeleton">
        <Setter Property="Background" Value="{StaticResource SkeletonBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Style.Animations>
            <Animation Duration="0:0:1.3" IterationCount="INFINITE"
                       PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.95" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Pastille de statut (pulse) -->
    <Style Selector="Border.pulse">
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Anneau "urgent" : overlay sans fond, mêmes bounds que la card (rien ne bouge).
         Seule l'Opacity pulse -> glow qui respire. -->
    <Style Selector="Border.urgentRing">
        <Style.Animations>
            <Animation Duration="0:0:1.4" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Anneau "exclusif VIP" : overlay shop. CornerRadius 14 = match Border.card (sinon les angles dépassent).
         Transparent + IsHitTestVisible=False (côté XAML) pour laisser passer le clic. -->
    <Style Selector="Border.exclusiveRing">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="#FFD371" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BoxShadow" Value="0 0 16 0 #66FFB740" />
        <Style.Animations>
            <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Spinner -->
    <Style Selector="Ellipse.spinner">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="2.6" />
        <Setter Property="StrokeDashArray" Value="3.0,1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Style.Animations>
            <Animation Duration="0:0:0.85" IterationCount="INFINITE" Easing="LinearEasing">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Overlay / panneau notifications -->
    <Style Selector="Border.scrim">
        <Setter Property="Background" Value="{StaticResource ScrimBrush}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.notifyOpen Border.scrim">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.notifyPanel">
        <Setter Property="RenderTransform" Value="translateX(400px)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.notifyOpen Border.notifyPanel">
        <Setter Property="RenderTransform" Value="translateX(0px)" />
    </Style>

    <!-- Carte de notification -->
    <Style Selector="Border.notif">
        <Setter Property="Background" Value="{StaticResource NotifCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="MaxHeight" Value="500" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
                <DoubleTransition Property="MaxHeight" Duration="0:0:0.30" Easing="CubicEaseInOut" />
                <ThicknessTransition Property="Margin" Duration="0:0:0.30" Easing="CubicEaseInOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseIn" />
            </Transitions>
        </Setter>
    </Style>
    <!-- dismiss : glisse à droite + fade + repli -->
    <Style Selector="Border.notif.dismissed">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="MaxHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,0,-12" />
        <Setter Property="RenderTransform" Value="translateX(60px)" />
    </Style>

    <!-- Carte de script (suppression animée) -->
    <Style Selector="Border.scriptcard">
        <Setter Property="MaxHeight" Value="260" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseOut" />
                <DoubleTransition Property="MaxHeight" Duration="0:0:0.30" Easing="CubicEaseInOut" />
                <ThicknessTransition Property="Margin" Duration="0:0:0.30" Easing="CubicEaseInOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseIn" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.scriptcard.removing">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="MaxHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,0,-10" />
        <Setter Property="RenderTransform" Value="translateX(40px)" />
    </Style>

    <!-- Carte de news -->
    <Style Selector="Border.newscard">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.newscard:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-3px)" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeStrongBrush}" />
    </Style>

    <!-- Modal -->
    <Style Selector="Border.modalScrim">
        <Setter Property="Background" Value="#9905060A" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.modalOpen Border.modalScrim">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.modalCard">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="scale(0.92)" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Grid.modalOpen Border.modalCard">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <!-- Toast -->
    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeMedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="BoxShadow" Value="0 10 30 0 #70000000" />
        <Setter Property="RenderTransform" Value="translateY(-12px)" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.toast.show">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>

    <!-- Console (logs) -->
    <Style Selector="TextBox.console">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#C8D2DE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="CaretBrush" Value="Transparent" />
    </Style>

    <!-- Mode Recording/Stream : quand la fenetre porte la classe "stream" (toggle Reglages), toute PII taguee
         Classes="pii" (identifiant, personnage, NIVEAU, serveur, IP de sortie, HWID) est FLOUTEE. Purement visuel.
         Rayon ELEVE (22) : le texte doit devenir illisible, pas juste « adouci » (un flou faible se lit encore). -->
    <Style Selector="Window.stream TextBlock.pii">
        <Setter Property="Effect">
            <BlurEffect Radius="22" />
        </Setter>
    </Style>
    <Style Selector="Window.stream SelectableTextBlock.pii">
        <Setter Property="Effect">
            <BlurEffect Radius="22" />
        </Setter>
    </Style>
    <Style Selector="Window.stream TextBox.pii">
        <Setter Property="Effect">
            <BlurEffect Radius="22" />
        </Setter>
    </Style>

    <!-- ===== Sous-onglets segmentés (ex onglet Combat : Comportement / Sorts / Équipe) ===== -->
    <Style Selector="Border.segbar">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="RadioButton.seg">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <!-- PAS de Background inline sur #root : une valeur locale ÉCRASERAIT les setters :checked/:pointerover
                 (la pastille de sélection ne se peindrait jamais). Le repos est posé en SETTER ci-dessous. -->
            <ControlTemplate>
                <Border Name="root" CornerRadius="7" Padding="13,7">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.seg /template/ Border#root">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
        </Setter>
    </Style>
    <Style Selector="RadioButton.seg:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource HoverSoftBrush}" />
    </Style>
    <Style Selector="RadioButton.seg:checked /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="RadioButton.seg:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- Contenu d'un sous-onglet : fondu (l'Opacity 0/1 est bindée au RadioButton via BoolToDouble). -->
    <Style Selector="StackPanel.subtab">
        <Setter Property="Transitions">
            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" /></Transitions>
        </Setter>
    </Style>

    <!-- Puces (tags) d'une ligne de sort : Ennemi (rouge) / Sur moi (vert) / Buff (ambre). -->
    <Style Selector="Border.tag">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag > TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.tagEnemy"><Setter Property="Background" Value="#22F0533B" /></Style>
    <Style Selector="Border.tagEnemy > TextBlock"><Setter Property="Foreground" Value="#F0806B" /></Style>
    <Style Selector="Border.tagSelf"><Setter Property="Background" Value="#223BD17E" /></Style>
    <Style Selector="Border.tagSelf > TextBlock"><Setter Property="Foreground" Value="#63D3A6" /></Style>
    <Style Selector="Border.tagBuff"><Setter Property="Background" Value="#22F0A93C" /></Style>
    <Style Selector="Border.tagBuff > TextBlock"><Setter Property="Foreground" Value="#E7C46B" /></Style>

    <!-- Ligne de sort (onglet Combat) : survol discret. -->
    <Style Selector="Border.spellrow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.spellrow:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverSoftBrush}" />
    </Style>

    <!-- ===== Panneau repliable « Conditions » (onglet Combat) : barre-toggle + chevron pivotant + corps animé ===== -->
    <!-- Barre cliquable pleine largeur (transparente, hover discret). -->
    <Style Selector="ToggleButton.condbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.condbar /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.condbar:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverSoftBrush}" />
    </Style>
    <Style Selector="ToggleButton.condbar:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <!-- Chevron : SWAP d'icône (pas de rotation -> chaque glyphe dessiné centré, aligné dans les 2 états).
         Replié = chevron DROIT (>), déplié = chevron BAS (v) + couleur accent. -->
    <!-- ⚠ NE PAS poser Data/Foreground inline sur le PathIcon/TextBlock : une valeur locale écrase les setters
         de style -> le swap :checked ne s'appliquerait jamais. Tout est piloté ICI. -->
    <Style Selector="ToggleButton.condbar PathIcon.condchev">
        <Setter Property="Data" Value="{StaticResource IconChevronRight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.condbar:checked PathIcon.condchev">
        <Setter Property="Data" Value="{StaticResource IconChevronDown}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.condbar TextBlock.condlabel">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.condbar:checked TextBlock.condlabel">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- Corps : reveal fondu + hauteur (piloté par Opacity/MaxHeight bindés au ToggleButton). -->
    <Style Selector="Border.condbody">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
                <DoubleTransition Property="MaxHeight" Duration="0:0:0.26" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

</Styles>
