<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GivreClone.App.ViewModels"
             xmlns:ctl="using:GivreClone.App.Controls"
             x:Class="GivreClone.App.Views.CombatSimOverlay"
             x:DataType="vm:BotsViewModel">
    <!-- Overlay niveau fenêtre : simulateur de tour de combat (onglet Comportement -> Simuler). -->
    <Grid Classes.modalOpen="{Binding CombatSimVisible}" IsHitTestVisible="{Binding CombatSimVisible}"
          IsEnabled="{Binding CombatSimVisible}">
        <Border Classes="modalScrim" PointerPressed="OnScrimPressed" />
        <Border Classes="modalCard" MaxWidth="900" MaxHeight="700" Margin="24" Padding="0" CornerRadius="16"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeMedBrush}" BorderThickness="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                DataContext="{Binding CombatSim}" x:DataType="vm:CombatSimViewModel">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- En-tête -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="22,18,16,12">
                    <PathIcon Grid.Column="0" Data="{StaticResource IconRobot}" Width="22" Height="22" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrightBrush}" />
                    <StackPanel Grid.Column="1" Spacing="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.Bots.Sim.Title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource L.Bots.Sim.Hint}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" MaxWidth="620" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="ghost" Width="34" Height="34" MinWidth="0" Padding="0" VerticalAlignment="Top"
                            Click="OnClosePressed" ToolTip.Tip="{DynamicResource L.Common.Close}">
                        <PathIcon Data="{StaticResource IconClose}" Width="15" Height="15" />
                    </Button>
                </Grid>

                <!-- Corps : grille iso (gauche) + panneau de contrôle (droite) -->
                <Grid Grid.Row="1" ColumnDefinitions="*,320" ColumnSpacing="14" Margin="22,0,22,6">
                    <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
                        <Border Grid.Row="0" Classes="segbar">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <!-- Icônes VECTORIELLES (héritent du Foreground du RadioButton -> passent accent quand :checked). -->
                                <RadioButton Classes="seg" GroupName="simMode" IsChecked="{Binding ModeEnemy, Mode=OneWay}"
                                             Command="{Binding SetModeCommand}" CommandParameter="enemy" ToolTip.Tip="{DynamicResource L.Bots.Sim.ModeEnemy}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{StaticResource IconSword}" Width="14" Height="14" />
                                        <TextBlock Text="{DynamicResource L.Bots.Sim.ModeEnemy}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Classes="seg" GroupName="simMode" IsChecked="{Binding ModeMe, Mode=OneWay}"
                                             Command="{Binding SetModeCommand}" CommandParameter="me" ToolTip.Tip="{DynamicResource L.Bots.Sim.ModeMe}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{StaticResource IconAccount}" Width="14" Height="14" />
                                        <TextBlock Text="{DynamicResource L.Bots.Sim.ModeMe}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Classes="seg" GroupName="simMode" IsChecked="{Binding ModeErase, Mode=OneWay}"
                                             Command="{Binding SetModeCommand}" CommandParameter="erase" ToolTip.Tip="{DynamicResource L.Bots.Sim.ModeErase}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" />
                                        <TextBlock Text="{DynamicResource L.Bots.Sim.ModeErase}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="#0E1116" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" MinHeight="360">
                            <ctl:IsoGrid MyCell="{Binding RenderMyCell}" EnemyTokens="{Binding RenderEnemies}"
                                         MoveCells="{Binding MoveCells}" BeamTarget="{Binding BeamTarget}"
                                         DamageCell="{Binding DamageCell}" DamageAmount="{Binding DamageAmount}" DamageElement="{Binding DamageElement}" DamageSeq="{Binding DamageSeq}"
                                         SelfIcon="{StaticResource IconAccount}" EnemyIcon="{StaticResource IconSword}"
                                         Cursor="{Binding GridCursor}" CellCommand="{Binding CellCommand}" />
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">
                            <StackPanel.Styles>
                                <Style Selector="NumericUpDown"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="MinHeight" Value="32" /></Style>
                                <Style Selector="NumericUpDown /template/ TextBox"><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /></Style>
                            </StackPanel.Styles>

                            <!-- Budget du tour -->
                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="13,12">
                                <StackPanel Spacing="9">
                                    <TextBlock Classes="label" Text="{DynamicResource L.Bots.Sim.Budget}" />
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                                            <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Sim.Ap}" />
                                            <NumericUpDown Value="{Binding SelfAp}" Minimum="0" Maximum="20" Increment="1" FormatString="0" ShowButtonSpinner="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                                            <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Sim.Mp}" />
                                            <NumericUpDown Value="{Binding SelfMp}" Minimum="0" Maximum="12" Increment="1" FormatString="0" ShowButtonSpinner="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                                            <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Sim.Range}" />
                                            <NumericUpDown Value="{Binding SelfRange}" Minimum="0" Maximum="20" Increment="1" FormatString="0" ShowButtonSpinner="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                            <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Sim.Turn}" />
                                            <NumericUpDown Value="{Binding TurnNo}" Minimum="1" Maximum="50" Increment="1" FormatString="0" ShowButtonSpinner="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
                                            <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Sim.EnemyHp}" />
                                            <NumericUpDown Value="{Binding DefaultEnemyHp}" Minimum="1" Maximum="100000" Increment="50" FormatString="0" ShowButtonSpinner="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3" IsEnabled="{Binding MultiTurn}">
                                            <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Sim.MaxTurns}" />
                                            <NumericUpDown Value="{Binding MaxTurns}" Minimum="1" Maximum="50" Increment="1" FormatString="0" ShowButtonSpinner="False" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Lecture -->
                            <Button Classes="primary" HorizontalAlignment="Stretch" Height="40" Command="{Binding RunCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" />
                                    <TextBlock Text="{DynamicResource L.Bots.Sim.Run}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <CheckBox IsChecked="{Binding MultiTurn}" Content="{DynamicResource L.Bots.Sim.MultiTurn}" FontSize="12.5" />
                            <!-- Barre de transport groupée (façon lecteur média). -->
                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="5" IsEnabled="{Binding HasResult}">
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                    <Button Grid.Column="0" Classes="ghost" Height="34" MinWidth="0" Command="{Binding StepBackCommand}" ToolTip.Tip="{DynamicResource L.Bots.Sim.StepBack}">
                                        <PathIcon Data="{StaticResource IconBack}" Width="15" Height="15" />
                                    </Button>
                                    <Button Grid.Column="1" Classes="ghost" Height="34" MinWidth="0" Command="{Binding PlayCommand}" IsVisible="{Binding !IsPlaying}" ToolTip.Tip="{DynamicResource L.Bots.Sim.Play}">
                                        <PathIcon Data="{StaticResource IconPlay}" Width="16" Height="16" Foreground="{DynamicResource AccentBrightBrush}" />
                                    </Button>
                                    <Button Grid.Column="1" Classes="ghost" Height="34" MinWidth="0" Command="{Binding PauseCommand}" IsVisible="{Binding IsPlaying}" ToolTip.Tip="{DynamicResource L.Bots.Sim.Pause}">
                                        <PathIcon Data="{StaticResource IconPause}" Width="16" Height="16" Foreground="{DynamicResource AccentBrightBrush}" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="ghost" Height="34" MinWidth="0" Command="{Binding StepForwardCommand}" ToolTip.Tip="{DynamicResource L.Bots.Sim.StepFwd}">
                                        <PathIcon Data="{StaticResource IconChevronRight}" Width="15" Height="15" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="ghost" Height="34" MinWidth="0" Command="{Binding ResetCommand}" ToolTip.Tip="{DynamicResource L.Bots.Sim.Reset}">
                                        <PathIcon Data="{StaticResource IconUpdate}" Width="15" Height="15" />
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Hud}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Summary}" Classes="caption" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding HasResult}" />
                                <TextBlock Text="{DynamicResource L.Bots.Sim.Disclaimer}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Journal -->
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="{DynamicResource L.Bots.Sim.Journal}" />
                                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8" MinHeight="90" MaxHeight="180">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Log}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Classes="caption" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Pied -->
                <Border Grid.Row="2" Background="#12000000" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,1,0,0" Padding="22,12">
                    <Button Classes="ghost" Height="38" MinWidth="120" HorizontalAlignment="Right" Click="OnClosePressed">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource L.Common.Close}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
