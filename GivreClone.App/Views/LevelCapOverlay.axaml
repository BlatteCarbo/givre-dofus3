<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GivreClone.App.ViewModels"
             x:Class="GivreClone.App.Views.LevelCapOverlay"
             x:DataType="vm:BotsViewModel">
    <!-- Overlay niveau fenêtre : personnage au-delà du niveau autorisé par l'offre gratuite. Le botting est bloqué sur ce perso ;
         la fenêtre l'explique et propose les offres. Fermeture par le bouton (pas de clic sur le fond). -->
    <Grid>
        <Grid Classes.modalOpen="{Binding LevelCapModalVisible}" IsHitTestVisible="{Binding LevelCapModalVisible}"
              IsEnabled="{Binding LevelCapModalVisible}">
            <Border Classes="modalScrim" />
            <Border Classes="modalCard" Width="460" Margin="24" Padding="26,24" CornerRadius="16"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeMedBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#26E0A53F" VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource IconLock}" Width="19" Height="19" Foreground="{StaticResource AmberBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L.LevelCap.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding LevelCapModalBody}" Classes="pii" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="12" Padding="16,14"
                            BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
                        <TextBlock Text="{DynamicResource L.LevelCap.Pitch}" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="ghost" Height="38" MinWidth="0" Padding="14,0" Command="{Binding CloseLevelCapModalCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.LevelCap.Close}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- Étincelle : offre complète (« profiter pleinement »), lisible à petite taille (le cadenas ouvert se lisait fermé). -->
                        <Button Classes="primary" Height="38" MinWidth="0" Padding="16,0" Command="{Binding OpenLevelCapOffersCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource IconSparkle}" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.LevelCap.SeeOffers}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
