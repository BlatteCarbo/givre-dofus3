<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GivreClone.App.ViewModels"
             xmlns:models="using:GivreClone.App.Services.VisualMods"
             x:Class="GivreClone.App.Views.VisualModsPanel"
             x:DataType="vm:VisualModsViewModel">
    <UserControl.Styles>
        <Style Selector="Border.visualCard">
            <Setter Property="Background" Value="#20283B" />
            <Setter Property="BorderBrush" Value="#35415A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="TextBlock.visualCaption">
            <Setter Property="Foreground" Value="#A9B6CC" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.visualHeading">
            <Setter Property="Foreground" Value="#F4F7FD" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBox.visualInput">
            <Setter Property="Background" Value="#131A2A" />
            <Setter Property="Foreground" Value="#F4F7FD" />
            <Setter Property="BorderBrush" Value="#44516A" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.visualAction">
            <Setter Property="Background" Value="#3B71D5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="20" MaxWidth="1120" HorizontalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5">
                    <TextBlock Text="Carnet &amp; repères" FontSize="24" FontWeight="Bold" Foreground="#F4F7FD" />
                    <TextBlock Text="Notes de terrain, favoris et repérage sur une grille personnelle" Classes="visualCaption" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="9" Padding="12,7" Background="#28344A" BorderBrush="#4C5C78" BorderThickness="1" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8" Height="8" Fill="#F2C66D" VerticalAlignment="Center" />
                        <TextBlock Text="SESSION " FontSize="11" Foreground="#C3CBDA" />
                        <TextBlock Text="{Binding SessionState}" FontSize="11" FontWeight="Bold" Foreground="#F2C66D" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="visualCard">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Classes="visualHeading" Text="Nouvelle position" />
                        <TextBlock Grid.Column="1" Text="LOCAL · MANUEL" FontWeight="SemiBold" Foreground="#7DDCC4" FontSize="11" />
                    </Grid>
                    <Grid ColumnDefinitions="2*,90,90" ColumnSpacing="9" IsEnabled="{Binding CanEdit}">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Libellé" Classes="visualCaption" />
                            <TextBox Classes="visualInput" PlaceholderText="Ex. mine au sud" Text="{Binding NewLabel}" MaxLength="60"
                                     AutomationProperties.Name="Libellé de la nouvelle position" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="X" Classes="visualCaption" />
                            <TextBox Classes="visualInput" PlaceholderText="-3" Text="{Binding NewX}" MaxLength="7"
                                     AutomationProperties.Name="Coordonnée X de la nouvelle position" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Y" Classes="visualCaption" />
                            <TextBox Classes="visualInput" PlaceholderText="12" Text="{Binding NewY}" MaxLength="7"
                                     AutomationProperties.Name="Coordonnée Y de la nouvelle position" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsEnabled="{Binding CanEdit}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Notes personnelles" Classes="visualCaption" />
                            <TextBox Classes="visualInput" Text="{Binding NewNote}" MaxLength="800" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="56" PlaceholderText="Ressources, rappel, accès…" AutomationProperties.Name="Notes personnelles pour la position" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="9" VerticalAlignment="Bottom">
                            <CheckBox Content="Favori ★" IsChecked="{Binding NewBookmark}" Foreground="#F2C66D" />
                            <Button Classes="visualAction" Content="Enregistrer" Command="{Binding AddPositionCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" Classes="visualCaption" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Grid.Column="0" Classes="visualCard" MinHeight="330">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Positions enregistrées" Classes="visualHeading" />
                        <TextBlock Text="Ton carnet est vide. Ajoute une position avec des coordonnées manuelles."
                                   Classes="visualCaption" TextWrapping="Wrap" IsVisible="{Binding !HasPositions}" />
                        <ItemsControl ItemsSource="{Binding Positions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:VisualPosition">
                                    <Border Background="#182133" CornerRadius="8" Padding="10,9" Margin="0,0,0,7">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Label}" Foreground="#F4F7FD" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="★" Foreground="#F2C66D" IsVisible="{Binding IsBookmark}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="X" Foreground="#7DDCC4" />
                                                    <TextBlock Text="{Binding X}" Foreground="#DEE7F7" />
                                                    <TextBlock Text="Y" Foreground="#7DDCC4" />
                                                    <TextBlock Text="{Binding Y}" Foreground="#DEE7F7" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#A9B6CC" FontSize="11.5" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                                <Button Content="Départ" FontSize="11" Padding="7,3"
                                                        ToolTip.Tip="Utiliser comme point de départ du calcul manuel"
                                                        Command="{Binding $parent[ItemsControl].((vm:VisualModsViewModel)DataContext).UseAsStartCommand}"
                                                        CommandParameter="{Binding}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Button Content="☆" FontSize="12" Padding="6,2" ToolTip.Tip="Ajouter ou retirer le favori"
                                                            AutomationProperties.Name="Basculer le favori de cette position"
                                                            Command="{Binding $parent[ItemsControl].((vm:VisualModsViewModel)DataContext).ToggleBookmarkCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="×" FontSize="13" Padding="7,2" ToolTip.Tip="Supprimer la position"
                                                            AutomationProperties.Name="Supprimer cette position du carnet"
                                                            Command="{Binding $parent[ItemsControl].((vm:VisualModsViewModel)DataContext).DeletePositionCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Classes="visualCard">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Mini-carte 2D" Classes="visualHeading" />
                            <TextBlock Text="Schéma relatif aux positions sauvegardées, sans fond de carte réel."
                                       Classes="visualCaption" TextWrapping="Wrap" />
                            <Border Background="#121B2C" BorderBrush="#394967" BorderThickness="1" CornerRadius="9"
                                    HorizontalAlignment="Center" ClipToBounds="True" Padding="3">
                                <Grid Width="440" Height="210" ClipToBounds="True">
                                    <Canvas IsHitTestVisible="False">
                                        <Line StartPoint="220,0" EndPoint="220,210" Stroke="#31415E" StrokeThickness="1" />
                                        <Line StartPoint="0,105" EndPoint="440,105" Stroke="#31415E" StrokeThickness="1" />
                                        <Line StartPoint="110,0" EndPoint="110,210" Stroke="#23334D" StrokeThickness="1" />
                                        <Line StartPoint="330,0" EndPoint="330,210" Stroke="#23334D" StrokeThickness="1" />
                                        <Line StartPoint="0,52" EndPoint="440,52" Stroke="#23334D" StrokeThickness="1" />
                                        <Line StartPoint="0,158" EndPoint="440,158" Stroke="#23334D" StrokeThickness="1" />
                                    </Canvas>
                                    <Canvas x:Name="PinsCanvas" Width="440" Height="210" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Points verts : notes · points dorés : favoris. Échelle automatique et relative."
                                       Classes="visualCaption" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Classes="visualCard">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Indices de chasse · calcul manuel" Classes="visualHeading" />
                            <TextBlock Text="Reporte toi-même un indice et les deux coordonnées. Le calcul ne recherche ni indice ni itinéraire."
                                       Classes="visualCaption" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*,*,Auto,*,*" ColumnSpacing="5">
                                <TextBlock Grid.Column="0" Text="De" Foreground="#A9B6CC" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Classes="visualInput" PlaceholderText="X" Text="{Binding StartX}" MaxLength="7"
                                         AutomationProperties.Name="Départ, coordonnée X" />
                                <TextBox Grid.Column="2" Classes="visualInput" PlaceholderText="Y" Text="{Binding StartY}" MaxLength="7"
                                         AutomationProperties.Name="Départ, coordonnée Y" />
                                <TextBlock Grid.Column="3" Text="Vers" Foreground="#A9B6CC" VerticalAlignment="Center" />
                                <TextBox Grid.Column="4" Classes="visualInput" PlaceholderText="X" Text="{Binding HintX}" MaxLength="7"
                                         AutomationProperties.Name="Coordonnée X de l'indice" />
                                <TextBox Grid.Column="5" Classes="visualInput" PlaceholderText="Y" Text="{Binding HintY}" MaxLength="7"
                                         AutomationProperties.Name="Coordonnée Y de l'indice" />
                            </Grid>
                            <TextBox Classes="visualInput" Text="{Binding HintText}" MaxLength="120"
                                     PlaceholderText="Indice recopié exactement depuis une source que tu as vérifiée"
                                     AutomationProperties.Name="Transcription exacte de l'indice manuel" />
                            <CheckBox IsChecked="{Binding HintVerified}" Content="J'ai vérifié la transcription et les coordonnées de cet indice"
                                      Foreground="#CFD9EA" />
                            <Button Content="Calculer la distance" Classes="visualAction" Command="{Binding PlanHintCommand}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding RouteResult}" Foreground="#7DDCC4" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding AuthorityText}" Classes="visualCaption" TextWrapping="Wrap" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
