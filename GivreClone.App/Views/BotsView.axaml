<UserControl xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:GivreClone.App.ViewModels"
 xmlns:svc="using:GivreClone.App.Services"
 xmlns:mcp="using:GivreClone.App.Services.Mcp"
 xmlns:lotm="using:GivreClone.App.Services.LotM"
 xmlns:ctl="using:GivreClone.App.Controls"
 xmlns:proto="using:GivreClone.Protocol"
 xmlns:conv="using:GivreClone.App.Converters"
 xmlns:acv="using:Avalonia.Data.Converters"
 xmlns:views="using:GivreClone.App.Views"
 xmlns:lua="using:GivreClone.App.Controls.LuaEditor"
 x:Class="GivreClone.App.Views.BotsView"
 x:DataType="vm:BotsViewModel"
 Classes="page"
 AutomationProperties.Name="Écran de Gestion des Bots"
 AutomationProperties.AutomationId="BotsViewRoot">
 <UserControl.Resources>
 <conv:AllTrueConverter x:Key="AllTrue" />
 <views:SessionTransitionLiveConverter x:Key="SessionTransitionLive" />
 <views:SessionTransitionVisibleConverter x:Key="SessionTransitionVisible" />
 <!-- Ligne de la fenêtre d'interaction (sac / coffre / échange / boutique) : icône, nom, quantité ou prix, bouton d'action. -->
 <DataTemplate x:Key="IwRowTemplate" x:DataType="vm:ExchangeItemRow">
 <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="6" Margin="0,1">
 <ToolTip.Tip><ctl:ItemTooltip Gid="{Binding Gid}" Uid="{Binding Uid}" Pid="{Binding TooltipPid}" /></ToolTip.Tip>
 <Image Source="{Binding Icon}" Width="24" Height="24" IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
 <Border Width="24" Height="24" CornerRadius="5" IsVisible="{Binding !HasIcon}" Background="{StaticResource StrokeSoftBrush}" />
 <StackPanel Grid.Column="1" VerticalAlignment="Center">
 <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="#63D3A6" />
 </StackPanel>
 <Button Grid.Column="2" Padding="8,2" MinHeight="24" IsVisible="{Binding HasAction}" VerticalAlignment="Center"
 Command="{Binding Owner.ActCommand}" CommandParameter="{Binding}"
 AutomationProperties.Name="Action sur l'objet"
 AutomationProperties.AutomationId="BtnActExchangeItem">
 <TextBlock Text="{Binding ActionText}" FontSize="11" />
 </Button>
 </Grid>
 </DataTemplate>
 <!-- Case d'objet en grille (fenêtre d'interaction, comme la banque du jeu) : icône + quantité ; clic = déposer / retirer / acheter… -->
 <DataTemplate x:Key="IwCellTemplate" x:DataType="vm:ExchangeItemRow">
 <Button Classes="ghost" Width="46" Height="46" MinWidth="0" Padding="0" Margin="0,0,4,4"
 Command="{Binding Owner.ActCommand}" CommandParameter="{Binding}" IsEnabled="{Binding HasAction}"
 Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="7"
 AutomationProperties.Name="Case d'objet"
 AutomationProperties.AutomationId="BtnActExchangeCell">
 <ToolTip.Tip><ctl:ItemTooltip Gid="{Binding Gid}" Uid="{Binding Uid}" Pid="{Binding TooltipPid}" /></ToolTip.Tip>
 <Panel>
 <Image Source="{Binding Icon}" Width="34" Height="34" IsVisible="{Binding HasIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
 <Border Width="30" Height="30" CornerRadius="5" IsVisible="{Binding !HasIcon}" Background="{StaticResource StrokeSoftBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
 <Border IsVisible="{Binding HasQtyBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" Padding="3,0" CornerRadius="4" Background="#B0101318">
 <TextBlock Text="{Binding QtyBadge}" FontSize="9.5" FontWeight="SemiBold" Foreground="White" />
 </Border>
 </Panel>
 </Button>
 </DataTemplate>
 <!-- Infobulle d'objet comme dans le jeu : nom, niveau · catégorie · quantité, puis les effets (malus en rouge). -->
 <DataTemplate x:Key="ItemTipTemplate" x:DataType="vm:InventoryItemRow">
 <ctl:ItemTooltip Gid="{Binding Gid}" Uid="{Binding Uid}" Pid="{Binding TooltipPid}" />
 </DataTemplate>
 <!-- Emplacement d'équipement (onglet Inventaire) : icône de l'objet porté, sinon cadre vide ; clic droit = Déséquiper. -->
 <DataTemplate x:Key="EquipSlotTemplate" x:DataType="vm:EquipSlotRow">
 <!-- Clic = sélecteur « Équiper » (objets du sac compatibles), clic droit = Déséquiper -->
 <Button Width="40" Height="40" Margin="2" MinWidth="0" Padding="0" CornerRadius="7" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}"
 BorderThickness="1" Command="{Binding Owner.OpenSlotPickerCommand}" CommandParameter="{Binding}"
 AutomationProperties.Name="Emplacement d'équipement"
 AutomationProperties.AutomationId="BtnEquipSlot">
 <ToolTip.Tip>
 <StackPanel Spacing="3">
 <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.75" />
 <ContentControl Content="{Binding Item}" ContentTemplate="{StaticResource ItemTipTemplate}" IsVisible="{Binding HasItem}" />
 </StackPanel>
 </ToolTip.Tip>
 <Button.ContextMenu>
 <ContextMenu>
 <MenuItem Header="{DynamicResource L.Inv.Unequip}" Command="{Binding Owner.UnequipSlotCommand}" CommandParameter="{Binding}" IsEnabled="{Binding HasItem}"
           AutomationProperties.Name="{DynamicResource L.Inv.Unequip}"
           AutomationProperties.AutomationId="MenuUnequipSlot" />
 </ContextMenu>
 </Button.ContextMenu>
 <Panel>
 <Image Source="{Binding Icon}" Width="32" Height="32" IsVisible="{Binding HasIcon}" />
 <TextBlock Text="·" IsVisible="{Binding !HasItem}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
 </Panel>
 </Button>
 </DataTemplate>
 </UserControl.Resources>
 <UserControl.Styles>
 <!-- Frise d ordre de jeu : combattant en train de jouer -->
 <Style Selector="Border.turnNow">
 <Setter Property="BorderThickness" Value="2" />
 <Setter Property="Background" Value="#40FFFFFF" />
 </Style>
 <!-- Effet d'objet en malus (infobulle / détails) : rouge, comme dans le jeu -->
 <Style Selector="TextBlock.fxneg">
 <Setter Property="Foreground" Value="#E5534B" />
 </Style>
 <!-- Ligne « hors-ligne · géré par le planning »: carte discrète (bord fin), survol = surface, curseur main. -->
 <Style Selector="Button.plannedrow">
 <Setter Property="HorizontalAlignment" Value="Stretch" />
 <Setter Property="HorizontalContentAlignment" Value="Stretch" />
 <Setter Property="Padding" Value="8,6" />
 <Setter Property="Cursor" Value="Hand" />
 <Setter Property="Background" Value="Transparent" />
 <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
 <Setter Property="BorderThickness" Value="1" />
 <Setter Property="Template">
 <ControlTemplate>
 <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
 BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
 <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
 </Border>
 </ControlTemplate>
 </Setter>
 </Style>
 <Style Selector="Button.plannedrow:pointerover"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /></Style>
 <Style Selector="Button.plannedrow:focus-visible">
 <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
 <Setter Property="BorderThickness" Value="2" />
 </Style>
 <!-- Bouton épingle des lignes de l'inspecteur: discret au repos, plein une fois épinglé. -->
 <Style Selector="ToggleButton.pinbtn"><Setter Property="Opacity" Value="0.28" /></Style>
 <Style Selector="ToggleButton.pinbtn:pointerover"><Setter Property="Opacity" Value="0.7" /></Style>
 <Style Selector="ToggleButton.pinbtn:checked"><Setter Property="Opacity" Value="1" /></Style>
 <!-- Journaux HDV (activité/ventes/taxes): ListBox = panneau VIRTUALISÉ (seules les lignes visibles sont réalisées)
 -> un Insert(0) ne re-mesure plus les ~200 lignes réalisées à chaque reprice (cause du micro-freeze). Chrome de
 sélection retiré pour garder l'aspect d'un simple journal en lecture seule. -->
 <Style Selector="ListBox.log">
 <Setter Property="Background" Value="Transparent" />
 <Setter Property="BorderThickness" Value="0" />
 <Setter Property="Padding" Value="0" />
 </Style>
 <Style Selector="ListBox.log ListBoxItem">
 <Setter Property="Padding" Value="0" />
 <Setter Property="MinHeight" Value="0" />
 </Style>
 <Style Selector="ListBox.log ListBoxItem:selected /template/ ContentPresenter">
 <Setter Property="Background" Value="Transparent" />
 </Style>
 <Style Selector="ListBox.log ListBoxItem:pointerover /template/ ContentPresenter">
 <Setter Property="Background" Value="Transparent" />
 </Style>
 </UserControl.Styles>
 <!-- col 0 en Auto: sous la skin un bot tiers, la liste « Bots en jeu » (doublon de l'arbre chef/mules du shell)
 est masquée -> la colonne collapse à 0 et le détail passe en pleine largeur. -->
 <Grid x:Name="BotsPageLayout" ColumnDefinitions="Auto,*" Margin="16" SizeChanged="OnBotsPageSizeChanged">

 <!-- ===== Liste des bots en jeu ===== -->
 <!-- En fenetre etroite la liste se resserre (208 px) pour laisser la place au detail : voir OnBotsPageSizeChanged. -->
 <Border x:Name="BotListPanel" Grid.Column="0" Width="272" IsVisible="{Binding !IsSnowSkin}" Classes="card" Padding="0" Margin="0,0,8,0">
 <Grid RowDefinitions="Auto,*">
 <StackPanel Grid.Row="0" Spacing="2" Margin="18,16,18,10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.ListHeader}" />
 <TextBlock Classes="caption" IsVisible="{Binding HasBots}" Text="{Binding InGameCountText}" />
 <TextBlock Classes="caption" IsVisible="{Binding !HasBots}" Text="{DynamicResource L.Bots.Empty}" />
 </StackPanel>
 <!-- La liste reste propriétaire de son viewport: pas de ScrollViewer parent à hauteur infinie,
      sinon Avalonia réalise toutes les lignes et perd la virtualisation. -->
 <Grid Grid.Row="1" RowDefinitions="*,Auto">
 <ListBox Grid.Row="0" ItemsSource="{Binding Bots}" SelectedItem="{Binding SelectedBot}"
 Background="Transparent" Padding="8,0,8,12" BorderThickness="0"
 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
 ScrollViewer.VerticalScrollBarVisibility="Auto"
 AutomationProperties.Name="{DynamicResource L.Bots.ListHeader}">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:BotRowViewModel">
 <Grid ColumnDefinitions="Auto,*" Margin="0,3">
 <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
 Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center" ClipToBounds="True">
 <Panel>
 <!-- icone generique tant que la classe n'est pas resolue -->
 <PathIcon Data="{StaticResource IconAccount}" Width="16" Height="16"
 Foreground="{DynamicResource AccentBrightBrush}"
 IsVisible="{Binding Row.ClassIcon, Converter={x:Static acv:ObjectConverters.IsNull}}" />
 <!-- tete de classe (avatar reel) -->
 <Image Source="{Binding Row.ClassIcon}" Width="30" Height="30" Stretch="Uniform"
 IsVisible="{Binding Row.ClassIcon, Converter={x:Static acv:ObjectConverters.IsNotNull}}" />
 </Panel>
 </Border>
 <!-- Badge « en groupe » (chef ou membre), COULEUR de l'équipe pour la démarcation -->
 <Border Grid.Column="0" Width="17" Height="17" CornerRadius="9" BorderBrush="{StaticResource PanelBrush}" BorderThickness="2"
 Background="{Binding TeamColorBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
 IsVisible="{Binding InTeam}" ToolTip.Tip="{Binding TeamRoleText}">
 <Image Source="{svc:GameIcon character}" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
 </Border>
 <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1" VerticalAlignment="Center">
 <!-- identifiant + mini-pastille du MODE de la session (bleu = Socket, gris = MITM), calée à
 droite: l'identifiant garde le reste de la largeur et se rogne « … » si besoin.
 Fond MITM en StaticResource (comme la carte Comptes): dans un DataTemplate, un
 DynamicResource est posé en priorité Template et PERD contre le setter du style
 Border.badge (fond AccentSoft); la skin est appliquée avant la fenêtre -> bonne palette. -->
 <DockPanel>
 <Panel DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center">
 <Border Classes="badge" Background="#1F6FEB" Padding="5,0"
 IsVisible="{Binding Row.ModeIsSocket}" ToolTip.Tip="{DynamicResource L.Bots.ModeSocketTip}">
 <TextBlock Text="{DynamicResource L.Accounts.ModeSocket}" FontSize="9.5" FontWeight="SemiBold"
 Foreground="White" />
 </Border>
 <Border Classes="badge" Background="{StaticResource Surface2Brush}" Padding="5,0"
 IsVisible="{Binding !Row.ModeIsSocket}" ToolTip.Tip="{DynamicResource L.Bots.ModeMitmTip}">
 <TextBlock Text="{DynamicResource L.Accounts.ModeMitm}" FontSize="9.5" FontWeight="SemiBold"
 Foreground="{DynamicResource TextSecondaryBrush}" />
 </Border>
 </Panel>
 <TextBlock Text="{Binding Row.Login}" Classes="pii" FontWeight="SemiBold" FontSize="12.5"
 TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
 </DockPanel>
 <TextBlock Text="{Binding Row.Character}" Classes="caption pii" TextTrimming="CharacterEllipsis" />
 <StackPanel Orientation="Horizontal" Spacing="4"
 IsVisible="{Binding Pods, Converter={x:Static acv:StringConverters.IsNotNullOrEmpty}}">
 <Image Source="{svc:GameIcon tx_pods}" Width="10" Height="10" VerticalAlignment="Center" />
 <TextBlock Text="{Binding Pods}" Classes="caption" FontSize="10.5" VerticalAlignment="Center" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,0"
 IsVisible="{Binding Row.Server, Converter={x:Static acv:StringConverters.IsNotNullOrEmpty}}">
 <PathIcon Data="{StaticResource IconNetwork}" Width="9" Height="9"
 Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" />
 <TextBlock Text="{Binding Row.Server}" Classes="pii" FontSize="10.5" TextTrimming="CharacterEllipsis"
 Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" />
 </StackPanel>
 </StackPanel>
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 <ScrollViewer Grid.Row="1" MaxHeight="180" HorizontalScrollBarVisibility="Disabled"
 VerticalScrollBarVisibility="Auto">
 <StackPanel>
 <!-- Persos en « connexion auto » dont le compte n'est pas en jeu: grisés, jamais sélectionnables (ce ne
 sont pas des bots en ligne). Clic -> modale niveau fenêtre: planning du perso + « Connecter maintenant ». -->
 <StackPanel IsVisible="{Binding HasPlannedOffline}" Spacing="4" Margin="8,0,8,12">
 <StackPanel Orientation="Horizontal" Spacing="6" Margin="10,2,0,2">
 <PathIcon Data="{StaticResource IconClock}" Width="11" Height="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Planning.Offline.Header}" Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 <ItemsControl ItemsSource="{Binding PlannedOffline}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:PlannedOfflineRow">
 <Button Classes="plannedrow" ToolTip.Tip="{Binding TipText}"
 Command="{Binding $parent[UserControl].((vm:BotsViewModel)DataContext).OpenPlannedCommand}"
 CommandParameter="{Binding}">
 <views:PlannedOfflineCard />
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </StackPanel>
 </ScrollViewer>
 </Grid>
 </Grid>
 </Border>

 <!-- ===== Detail du bot selectionne ===== -->
 <Grid Grid.Column="1" Margin="8,0,0,0">

 <!-- vide -->
 <StackPanel IsVisible="{Binding !HasSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
 <PathIcon Data="{StaticResource IconRobot}" Width="38" Height="38"
 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.SelectHint}" HorizontalAlignment="Center" />
 </StackPanel>

 <!-- contenu -->
 <ScrollViewer IsVisible="{Binding HasSelection}" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Spacing="14">

 <!-- VERROU FOLLOWER: ce bot est piloté par son équipe (chef) -> automatisation solo bloquée, seul le Combat reste réglable -->
 <Border Classes="notice" IsVisible="{Binding SelectedBot.FollowerLocked}">
 <Grid ColumnDefinitions="Auto,*">
 <PathIcon Grid.Column="0" Data="{StaticResource IconGroup}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Team.FollowerLocked}" />
 </Grid>
 </Border>

 <!-- bandeau -->
 <Border Classes="card" Padding="18,16">
 <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
 <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
 Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center" ClipToBounds="True">
 <Panel>
 <PathIcon Data="{StaticResource IconAccount}" Width="22" Height="22"
 Foreground="{DynamicResource AccentBrightBrush}"
 IsVisible="{Binding SelectedBot.Row.ClassIcon, Converter={x:Static acv:ObjectConverters.IsNull}}" />
 <Image Source="{Binding SelectedBot.Row.ClassIcon}" Width="42" Height="42" Stretch="Uniform"
 IsVisible="{Binding SelectedBot.Row.ClassIcon, Converter={x:Static acv:ObjectConverters.IsNotNull}}" />
 </Panel>
 </Border>
 <StackPanel Grid.Column="1" Margin="14,0" Spacing="4" VerticalAlignment="Center">
 <TextBlock Text="{Binding SelectedBot.Row.Login}" Classes="pii" FontSize="15.5" FontWeight="SemiBold"
 Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
 <StackPanel Orientation="Horizontal" Spacing="14">
 <StackPanel Orientation="Horizontal" Spacing="5">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Character}" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.Row.Character}" Classes="pii" FontSize="12"
 Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" />
 </StackPanel>
 <!-- MODE DE LA SESSION (MITM / Socket): même pastille que la carte Comptes (bleu = Socket, gris =
 MITM, même icône que le bouton de lancement). Row.ModeIsSocket = IsSocketSession pour un bot
 lancé (vérité de la session, pas la préférence mémorisée). Visible sous les DEUX skins (le
 bandeau l'est); Surface2/TextSecondary en DynamicResource -> suit le changement de skin à chaud. -->
 <Panel VerticalAlignment="Center">
 <Border Classes="badge" Background="#1F6FEB" MinWidth="62"
 IsVisible="{Binding SelectedBot.Row.ModeIsSocket, FallbackValue=False}"
 ToolTip.Tip="{DynamicResource L.Bots.ModeSocketTip}">
 <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
 <PathIcon Data="{StaticResource IconNetwork}" Width="10" Height="10" Foreground="White" />
 <TextBlock Text="{DynamicResource L.Accounts.ModeSocket}" FontSize="10.5" FontWeight="SemiBold"
 Foreground="White" VerticalAlignment="Center" />
 </StackPanel>
 </Border>
 <Border Classes="badge" Background="{DynamicResource Surface2Brush}" MinWidth="62"
 IsVisible="{Binding !SelectedBot.Row.ModeIsSocket, FallbackValue=False}"
 ToolTip.Tip="{DynamicResource L.Bots.ModeMitmTip}">
 <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
 <PathIcon Data="{StaticResource IconPlay}" Width="9" Height="9"
 Foreground="{DynamicResource TextSecondaryBrush}" />
 <TextBlock Text="{DynamicResource L.Accounts.ModeMitm}" FontSize="10.5" FontWeight="SemiBold"
 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
 </StackPanel>
 </Border>
 </Panel>
 <TextBlock Text="{Binding SelectedBot.Row.Status}" Classes="caption" VerticalAlignment="Center" />
 </StackPanel>
 </StackPanel>
 <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
 <Button Classes="ghost" Height="36" Width="36" Padding="0" Command="{Binding PreviousBotCommand}" HotKey="Ctrl+PageUp"
 ToolTip.Tip="Personnage précédent (Ctrl+Page haut)" AutomationProperties.Name="Personnage précédent">
 <PathIcon Data="{StaticResource IconChevronUp}" Width="14" Height="14" />
 </Button>
 <Button Classes="ghost" Height="36" Width="36" Padding="0" Command="{Binding NextBotCommand}"
 AutomationProperties.AutomationId="BtnNextBot" HotKey="Ctrl+PageDown"
 ToolTip.Tip="Personnage suivant (Ctrl+Page bas)" AutomationProperties.Name="Personnage suivant">
 <PathIcon Data="{StaticResource IconChevronDown}" Width="14" Height="14" />
 </Button>
 <Button Classes="ghost" Height="36" Command="{Binding CopyLoginCommand}"
         AutomationProperties.Name="Copier l'identifiant du compte"
         AutomationProperties.AutomationId="BtnCopyLogin">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" />
 <TextBlock Text="{DynamicResource L.Bots.CopyLogin}" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <!-- « Reconnecter »: reconnecte le compte TOUT DE SUITE, sans le sortir de la liste (même perso, script
 repris au retour; MITM: Dofus relancé, entrée re-clée; Socket: même session reconnectée). Mis en
 avant quand la session est perdue (« Déconnecté »: MITM, ou socket parqué par le serveur) ou en
 attente de reconnexion (socket); sur une session vivante, confirmation (modale fenêtre). Grisé
 pendant une reconnexion en cours. -->
 <Button Classes.primary="{Binding SelectedBot.Row.CanReconnect}" Classes.ghost="{Binding !SelectedBot.Row.CanReconnect}"
 Height="36" Command="{Binding ReconnectCommand}"
 IsEnabled="{Binding !SelectedBot.Row.ReconnectPending}"
 ToolTip.Tip="{DynamicResource L.Reconnect.Tip}"
 AutomationProperties.Name="Reconnecter le bot immédiatement"
 AutomationProperties.AutomationId="BtnReconnect">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconUpdate}" Width="13" Height="13" />
 <TextBlock Text="{DynamicResource L.Reconnect.Button}" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <Button Classes="ghost" Height="36" Command="{Binding DisconnectCommand}"
         AutomationProperties.Name="Déconnecter le bot"
         AutomationProperties.AutomationId="BtnDisconnect">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconPause}" Width="13" Height="13" />
 <TextBlock Text="{DynamicResource L.Bots.Disconnect}" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 </StackPanel>
 <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
 <Button Classes="ghost" Height="36" Margin="0,0,8,8"
 Command="{Binding QuickExitDungeonCommand}"
 AutomationProperties.AutomationId="BtnQuickExitDungeon"
 IsEnabled="{Binding CanQuickExitDungeon}"
 AutomationProperties.Name="Quitter le donjon"
 ToolTip.Tip="{Binding QuickDungeonTip}">
 <TextBlock Text="{DynamicResource L.Travel.ExitDungeon}" VerticalAlignment="Center" />
 </Button>
 <Button Classes="ghost" Height="36" Margin="0,0,8,8"
 IsEnabled="{Binding CanQuickZaap}"
 AutomationProperties.Name="Zaap"
 ToolTip.Tip="{Binding QuickZaapTip}">
 <Button.Flyout>
 <Flyout Placement="Bottom" Opened="OnQuickTeleportOpened">
 <StackPanel Spacing="6" MinWidth="280" MaxWidth="420" x:DataType="vm:BotsViewModel">
 <TextBlock Classes="caption" Text="{Binding QuickZaapHint}" TextWrapping="Wrap" />
 <TextBox Text="{Binding ZaapSearch, Mode=TwoWay}" Watermark="Nom, coordonnées ou carte" Height="30" />
 <TextBlock Text="{Binding QuickZaapEmpty}" TextWrapping="Wrap" IsVisible="{Binding !HasQuickZaaps}" />
 <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
 IsVisible="{Binding HasQuickZaaps}">
 <ItemsControl ItemsSource="{Binding QuickZaaps}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:QuickTeleportChoice">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="36" Margin="0,0,0,4"
 IsEnabled="{Binding CanSend}" Command="{Binding Travel}" Click="OnQuickTeleportClick"
 ToolTip.Tip="{Binding Reason}"
 AutomationProperties.Name="Téléportation Zaap"
 AutomationProperties.AutomationId="BtnTravelZaap">
 <Grid ColumnDefinitions="*,Auto">
 <StackPanel Spacing="1">
 <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" />
 </StackPanel>
 <TextBlock Grid.Column="1" Text="{Binding CostText}" Foreground="#E6B450" VerticalAlignment="Center" Margin="8,0,0,0" />
 </Grid>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </StackPanel>
 </Flyout>
 </Button.Flyout>
 <TextBlock Text="{DynamicResource L.Travel.Zaap}" VerticalAlignment="Center" />
 </Button>
 <Button Classes="ghost" Height="36" Margin="0,0,8,8"
 IsEnabled="{Binding CanQuickZaapi}"
 AutomationProperties.Name="Zaapi"
 ToolTip.Tip="{Binding QuickZaapiTip}">
 <Button.Flyout>
 <Flyout Placement="Bottom" Opened="OnQuickZaapiOpened">
 <StackPanel Spacing="6" MinWidth="280" MaxWidth="420" x:DataType="vm:BotsViewModel">
 <TextBlock Classes="caption" Text="{Binding QuickZaapiHint}" TextWrapping="Wrap" />
 <TextBox Text="{Binding ZaapiSearch, Mode=TwoWay}" Watermark="Nom, coordonnées ou carte" Height="30" />
 <TextBlock Text="{Binding QuickZaapiEmpty}" TextWrapping="Wrap" IsVisible="{Binding !HasQuickZaapis}" />
 <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
 IsVisible="{Binding HasQuickZaapis}">
 <ItemsControl ItemsSource="{Binding QuickZaapis}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:QuickTeleportChoice">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="36" Margin="0,0,0,4"
 IsEnabled="{Binding CanSend}" Command="{Binding Travel}" Click="OnQuickTeleportClick"
 ToolTip.Tip="{Binding Reason}"
 AutomationProperties.Name="Téléportation Zaapi"
 AutomationProperties.AutomationId="BtnTravelZaapi">
 <Grid ColumnDefinitions="*,Auto">
 <StackPanel Spacing="1">
 <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" />
 </StackPanel>
 <TextBlock Grid.Column="1" Text="{Binding CostText}" Foreground="#E6B450" VerticalAlignment="Center" Margin="8,0,0,0" />
 </Grid>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </StackPanel>
 </Flyout>
 </Button.Flyout>
 <TextBlock Text="{DynamicResource L.Travel.Zaapi}" VerticalAlignment="Center" />
 </Button>
 <Button Classes="ghost" Height="36" Margin="0,0,8,8" Command="{Binding QuickCancelCommand}" AutomationProperties.AutomationId="BtnQuickCancel"
 IsVisible="{Binding QuickActionBusy}"
 AutomationProperties.Name="Annuler l'action rapide">
 <TextBlock Text="Annuler" VerticalAlignment="Center" />
 </Button>
 <Button Classes="ghost" Height="36" Margin="0,0,8,8"
 AutomationProperties.Name="Changer de personnage"
 ToolTip.Tip="Affiche les personnages et les serveurs réellement observés pour ce compte. Le client reste ouvert : un clic le reconnecte sur le personnage choisi.">
 <Button.IsEnabled>
 <MultiBinding Converter="{StaticResource AllTrue}">
 <Binding Path="!SelectedBot.Row.SessionTransitionActive" />
 <Binding Path="!EnhancedActivationBusy" />
 <Binding Path="!SelectedBot.Row.ReconnectPending" />
 </MultiBinding>
 </Button.IsEnabled>
 <Button.Flyout>
 <Flyout Placement="Bottom" Opened="OnCharacterChoicesOpened">
 <StackPanel Spacing="6" MinWidth="260" MaxWidth="380" x:DataType="vm:BotsViewModel">
 <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasCharacterChoices}"
 Text="Un clic relance Dofus et connecte le personnage choisi, sur le même serveur. Ce n'est pas un transfert à chaud." />
 <TextBlock Text="{Binding CharacterChoiceNotice}" TextWrapping="Wrap"
 IsVisible="{Binding CharacterChoiceNotice, Converter={x:Static acv:StringConverters.IsNotNullOrEmpty}}" />
 <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
 IsVisible="{Binding HasCharacterChoices}">
 <ItemsControl ItemsSource="{Binding CharacterChoices}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:ObservedCharacterChoice">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="36" Margin="0,0,0,4"
 Command="{Binding Select}" Click="OnObservedCharacterClick"
 AutomationProperties.Name="Sélection Destination Havre-Sac"
 AutomationProperties.AutomationId="BtnSelectCharacterDestination">
 <StackPanel Spacing="1">
 <TextBlock Text="{Binding Title}" Classes="pii" FontWeight="SemiBold" />
 <TextBlock Text="{Binding Detail}" Classes="caption" />
 </StackPanel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </StackPanel>
 </Flyout>
 </Button.Flyout>
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconAccount}" Width="13" Height="13" />
 <TextBlock Text="Changer de personnage" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <Button Classes="ghost" Height="36" Margin="0,0,8,8" Command="{Binding OpenGameWindowCommand}"
 AutomationProperties.Name="Ouvrir la fenêtre de jeu"
 ToolTip.Tip="Ferme la session Socket et ouvre une fenêtre Dofus avec le même personnage et le même serveur. Ce n'est pas un transfert à chaud : le compte se reconnecte.">
 <Button.IsVisible>
 <MultiBinding Converter="{StaticResource AllTrue}">
 <Binding Path="SelectedBot.Row.Running" />
 <Binding Path="SelectedBot.Row.IsSocketSession" />
 </MultiBinding>
 </Button.IsVisible>
 <Button.IsEnabled>
 <MultiBinding Converter="{StaticResource AllTrue}">
 <Binding Path="!SelectedBot.Row.SessionTransitionActive" />
 <Binding Path="!EnhancedActivationBusy" />
 <Binding Path="!SelectedBot.Row.ReconnectPending" />
 </MultiBinding>
 </Button.IsEnabled>
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconPlay}" Width="13" Height="13" />
 <TextBlock Text="Ouvrir la fenêtre de jeu" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <Button Classes="ghost" Height="36" Margin="0,0,8,8" Command="{Binding ActivateEnhancedCommand}"
 AutomationProperties.Name="Activer Dofus Enhanced"
 ToolTip.Tip="Charge Dofus Enhanced dans ce client MITM. CombatVisuals est déchargé et ne reste pas actif.">
 <Button.IsVisible>
 <MultiBinding Converter="{StaticResource AllTrue}">
 <Binding Path="SelectedBot.Row.Running" />
 <Binding Path="!SelectedBot.Row.IsSocketSession" />
 </MultiBinding>
 </Button.IsVisible>
 <Button.IsEnabled>
 <MultiBinding Converter="{StaticResource AllTrue}">
 <Binding Path="!SelectedBot.Row.SessionTransitionActive" />
 <Binding Path="!EnhancedActivationBusy" />
 <Binding Path="!SelectedBot.Row.ReconnectPending" />
 </MultiBinding>
 </Button.IsEnabled>
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconUpdate}" Width="13" Height="13" />
 <TextBlock Text="Activer Dofus Enhanced" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <Button Classes="ghost" Height="36" Margin="0,0,8,8" Command="{Binding CancelSessionChangeCommand}"
 IsVisible="{Binding SelectedBot.Row.SessionTransitionActive}"
 AutomationProperties.Name="Annuler le changement de session"
 ToolTip.Tip="Annule le changement. Avant la fermeture, la session d'origine reste. Après, elle est déconnectée.">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
 <TextBlock Text="Annuler" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,0,8,8" TextWrapping="Wrap" MaxWidth="360">
 <TextBlock.IsVisible>
 <Binding Path="SelectedBot.Row.SessionTransitionState" Converter="{StaticResource SessionTransitionVisible}" />
 </TextBlock.IsVisible>
 <TextBlock.Text>
 <MultiBinding Converter="{StaticResource SessionTransitionLive}">
 <Binding Path="SelectedBot.Row.SessionTransitionState" />
 <Binding Path="SelectedBot.Row.SessionTransitionMessage" />
 <Binding Path="SelectedBot.Row.SessionTransitionActive" />
 </MultiBinding>
 </TextBlock.Text>
 </TextBlock>
 </WrapPanel>
 <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Classes="caption" Margin="0,2,0,0"
 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
 ToolTip.Tip="{Binding QuickActionStatus}"
 Text="{Binding QuickActionStatus}" />
 </Grid>
 </Border>

 <!-- Niveau / XP / abonnement + actions rapides (comme MizanBot) -->
 <Border Classes="card" Padding="14,10">
 <Grid ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="18">
 <StackPanel Grid.Column="0" Spacing="3" MinWidth="190" VerticalAlignment="Center">
 <TextBlock Text="{Binding SelectedBot.Row.Level, StringFormat='Niveau {0}'}" FontWeight="SemiBold" FontSize="13" />
 <ProgressBar Height="8" CornerRadius="4" Minimum="0" Maximum="100" Foreground="#F5A623"
 Value="{Binding SelectedBot.XpPercent, FallbackValue=0}" IsVisible="{Binding SelectedBot.HasXpBar, FallbackValue=False}" />
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
 <TextBlock Classes="caption" Text="{DynamicResource L.Info.Subscription}" />
 <TextBlock Text="{Binding SelectedBot.SubscriptionText, FallbackValue='—'}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding SelectedBot.KamasTooltip, FallbackValue=''}">
 <TextBlock Classes="caption" Text="{DynamicResource L.Info.Kamas}" />
 <TextBlock Text="{Binding SelectedBot.InfoKamasText, FallbackValue='—'}" Foreground="#E6B450" FontWeight="SemiBold" FontSize="12.5" />
 </StackPanel>
 <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
 <Button Classes.primary="{Binding SelectedBot.ManualFight}" Classes.ghost="{Binding !SelectedBot.ManualFight}" Height="34" Command="{Binding SelectedBot.ToggleManualFightCommand}"
 ToolTip.Tip="Active-le AVANT le combat : coupe le placement, le défi et les tours automatiques ; tu joues en cliquant la carte."
 AutomationProperties.Name="Mode Combat Manuel / Auto"
 AutomationProperties.AutomationId="BtnToggleManualFight">
 <TextBlock Text="{Binding SelectedBot.ManualFightLabel}" VerticalAlignment="Center" />
 </Button>
 <Button Classes="ghost" Height="34" Command="{Binding SelectedBot.OpenHavenBagCommand}" IsVisible="{Binding !SelectedBot.FightActive}" ToolTip.Tip="Entre dans ton havre-sac (hors combat)"
         AutomationProperties.Name="Ouvrir le Havre-Sac"
         AutomationProperties.AutomationId="BtnOpenHavenBag">
 <TextBlock Text="Havre-sac" VerticalAlignment="Center" />
 </Button>
 <Button Classes="ghost" Height="34" Command="{Binding ToggleLuaCommand}"
         AutomationProperties.Name="Basculer vers l'éditeur Lua"
         AutomationProperties.AutomationId="BtnToggleLuaEditor">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconPlay}" Width="11" Height="11" /><TextBlock Text="Lancer / arrêter le script" VerticalAlignment="Center" /></StackPanel>
 </Button>
 <Button Classes="ghost" Height="34" Command="{Binding DepositAllCommand}" ToolTip.Tip="Dépose tout le sac dans la banque (banque ouverte)"
         AutomationProperties.Name="Déposer tout l'inventaire en banque"
         AutomationProperties.AutomationId="BtnDepositAll">
 <TextBlock Text="Tout déposer" VerticalAlignment="Center" />
 </Button>
 </StackPanel>
 </Grid>
 </Border>

 <!-- etat (replié : l'essentiel est dans le bandeau et la barre d'état) -->
 <Border Classes="card" Padding="14,6">
 <Expander Header="État du personnage" IsExpanded="False" HorizontalAlignment="Stretch" FontSize="12.5">
 <StackPanel Spacing="12" Margin="0,8,0,4">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.State}" />
  <!-- État : l'essentiel d'abord (niveau, carte, zone, kamas, XP, énergie, pods) ; PID / IP / paquets / serveur repliés dans « Technique ». -->
 <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="14">
 <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <Image Source="{svc:GameIcon star}" Width="13" Height="13" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Level}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding SelectedBot.Row.Level}" Classes="pii" Foreground="{DynamicResource AccentBrightBrush}" FontWeight="SemiBold" />
 </StackPanel>
 <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <Image Source="avares://GivreClone/Assets/stats/pos.png" Width="13" Height="13" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Map}" VerticalAlignment="Center" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Text="{Binding SelectedBot.Row.MapCoords}" Cursor="Hand" PointerPressed="OnCopyText" ToolTip.Tip="Cliquer pour copier" Foreground="{DynamicResource AccentBrightBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.Row.MapId}" Cursor="Hand" PointerPressed="OnCopyText" ToolTip.Tip="Cliquer pour copier" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 </StackPanel>
 </StackPanel>
 <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconMap}" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}" />
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Zone}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding SelectedBot.ZoneText, FallbackValue='—'}" Foreground="{StaticResource TextPrimaryBrush}"
 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedBot.ZoneText, FallbackValue=''}" />
 </StackPanel>
 <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Kamas}" />
 <TextBlock Text="{Binding SelectedBot.InfoKamasText, FallbackValue='—'}" Foreground="#E6B450" FontWeight="SemiBold" />
 </StackPanel>
 <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
 <Grid ColumnDefinitions="*,Auto">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Experience}" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.XpLevelText, FallbackValue=''}" Foreground="{DynamicResource AccentBrightBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Grid.Column="1" Text="{Binding SelectedBot.InfoXpText, FallbackValue='—'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" />
 </Grid>
 <ProgressBar Height="6" CornerRadius="3" Minimum="0" Maximum="100" Foreground="#6EA8FE"
 Value="{Binding SelectedBot.XpPercent, FallbackValue=0}" IsVisible="{Binding SelectedBot.HasXpBar, FallbackValue=False}" />
 </StackPanel>
 <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Energy}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Text="{Binding SelectedBot.EnergyText, FallbackValue='—'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" />
 </Grid>
 <ProgressBar Height="6" CornerRadius="3" Minimum="0" Maximum="100" Foreground="#63D3A6"
 Value="{Binding SelectedBot.EnergyPercent, FallbackValue=0}" IsVisible="{Binding SelectedBot.HasEnergy, FallbackValue=False}" />
 </StackPanel>
 <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <Image Source="{svc:GameIcon tx_pods}" Width="13" Height="13" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Pods}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding SelectedBot.Pods, FallbackValue='—', TargetNullValue='—'}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
 <ProgressBar Height="6" CornerRadius="3" Minimum="0" Maximum="100" HorizontalAlignment="Stretch" Margin="0,2,0,0"
 Value="{Binding SelectedBot.PodsPercent, FallbackValue=0}" Foreground="{Binding SelectedBot.PodsBrush}"
 IsVisible="{Binding SelectedBot.HasPods, FallbackValue=False}" />
 </StackPanel>
 <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Subscription}" />
 <TextBlock Text="{Binding SelectedBot.SubscriptionText, FallbackValue='—'}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="12" />
 </StackPanel>
 <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.BankKamas}" />
 <TextBlock Text="{Binding SelectedBot.InfoBankKamasText, FallbackValue='—'}" Foreground="#E6B450" FontWeight="SemiBold" />
 </StackPanel>
 </Grid>
 <Expander Header="Technique · PID, IP de sortie, paquets, serveur" FontSize="12" Padding="0" HorizontalAlignment="Stretch">
 <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="18" Margin="0,8,0,0">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Pid}" />
 <TextBlock Text="{Binding SelectedBot.Pid}" Foreground="{StaticResource TextPrimaryBrush}" />
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.ExitIp}" />
 <TextBlock Text="{Binding SelectedBot.Row.ExitIp}" Classes="pii" Foreground="{DynamicResource AccentBrightBrush}" />
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Packets}" />
 <TextBlock Text="{Binding SelectedBot.PacketSummary}" Foreground="{StaticResource TextPrimaryBrush}" />
 </StackPanel>
 <StackPanel Grid.Column="3" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Server}" />
 <TextBlock Text="{Binding SelectedBot.Row.Server}" Classes="pii" Foreground="{StaticResource TextSecondaryBrush}" />
 </StackPanel>
 </Grid>
 </Expander>
 </StackPanel>
 </Expander>
 </Border>

 <!-- console a onglets: Paquets + Infos + Carte + Combat -->
 <Border Classes="card">
 <TabControl x:Name="BotTabs" SelectionChanged="OnTabChanged" TabStripPlacement="{Binding BotTabPlacement}">
 <TabControl.Styles>
 <!-- entetes d'onglet a taille normale (le theme Fluent les fait trop gros): on ne
 touche QUE la police, sinon le trait de selection (SelectedPipe) se desaligne -->
 <Style Selector="TabItem">
 <Setter Property="FontSize" Value="13.5" />
 </Style>
 <!-- Fondu doux au changement d'onglet (comme la nav principale): une transition d'opacite
 sur le conteneur de contenu; le code-behat (OnTabChanged) rejoue 0 -> 1 a chaque bascule. -->
 <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
 <Setter Property="Transitions">
 <Transitions>
 <DoubleTransition Property="Opacity" Duration="0:0:0.20" />
 </Transitions>
 </Setter>
 </Style>
 <!-- (pastilles de jour du Planning: styles déplacés dans Views/PlanningEditor) -->
 </TabControl.Styles>
 <TabItem Header="Activité MCP">
  <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0" RowSpacing="10">
   <TextBlock Text="Tous les appels MCP de l'application" FontSize="17" FontWeight="SemiBold" />
   <TextBlock Grid.Row="1" Text="200 appels récents, tous bots confondus. Accepté ne signifie pas terminé. Les scripts, messages et paramètres sensibles ne sont pas enregistrés ici."
              TextWrapping="Wrap" Opacity="0.75" />
   <ListBox Grid.Row="2" ItemsSource="{Binding McpActions}" MinHeight="200" MaxHeight="620"
            AutomationProperties.Name="Journal global des actions MCP"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate>
     <DataTemplate x:DataType="mcp:McpActionEntry">
      <Grid ColumnDefinitions="75,190,150,*" ColumnSpacing="12" Margin="6,7">
       <TextBlock Text="{Binding TimeText}" Opacity="0.7" />
       <TextBlock Grid.Column="1" Text="{Binding Tool}" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Grid.Column="2" Text="{Binding Target}" TextWrapping="Wrap" />
       <TextBlock Grid.Column="3" Text="{Binding StatusText}" TextWrapping="Wrap" />
      </Grid>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </Grid>
 </TabItem>
 <!-- Console: JOURNAL lisible du bot par défaut (connexion, événements de jeu, script — mêmes lignes colorées que la
 console Lua), ou flot TECHNIQUE (diagnostic transport live: WhoAmI, déplacements, injections, refus). -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="avares://GivreClone/Assets/stats/console.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabConsole}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
 <Border Grid.Row="0" Classes="segbar" HorizontalAlignment="Left" VerticalAlignment="Center">
 <StackPanel Orientation="Horizontal" Spacing="3">
 <RadioButton Classes="seg" GroupName="consoleMode" IsChecked="{Binding ConsoleJournal}" ToolTip.Tip="{DynamicResource L.Bots.Console.JournalTip}">
 <TextBlock Text="{DynamicResource L.Bots.Console.Journal}" VerticalAlignment="Center" />
 </RadioButton>
 <RadioButton Classes="seg" GroupName="consoleMode" IsChecked="{Binding ConsoleTechnical}" ToolTip.Tip="{DynamicResource L.Bots.Console.TechnicalTip}">
 <TextBlock Text="{DynamicResource L.Bots.Console.Technical}" VerticalAlignment="Center" />
 </RadioButton>
 <RadioButton Classes="seg" GroupName="consoleMode" IsChecked="{Binding ConsoleChat}" ToolTip.Tip="Discussion : MP et canaux (guilde, recrutement…)">
 <TextBlock Text="💬 Discussion" VerticalAlignment="Center" />
 </RadioButton>
 </StackPanel>
 </Border>
 <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
 <TextBox x:Name="LuaSearchBox" Height="30" Width="190" VerticalAlignment="Center" FontSize="11.5" IsVisible="{Binding ConsoleJournal}"
 Text="{Binding LuaSearch}" PlaceholderText="Rechercher (mot, joueur…)" AutomationProperties.Name="Rechercher dans le journal" />
 <ComboBox Height="30" MinWidth="130" VerticalAlignment="Center" FontSize="11.5" IsVisible="{Binding ConsoleJournal}"
 ItemsSource="{Binding LuaFilters}" SelectedIndex="{Binding LuaFilterIndex}"
 ToolTip.Tip="{DynamicResource L.Bots.Lua.FilterTip}" />
 <Button Classes="ghost" Height="30" MinWidth="0" Padding="12,0" Click="OnCopyConsole"
 ToolTip.Tip="{DynamicResource L.Bots.Lua.CopyTip}">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
 <TextBlock Text="{DynamicResource L.Bots.Copy}" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <Button Classes="ghost" Height="30" MinWidth="0" Padding="12,0" Click="OnClearConsole">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
 <TextBlock Text="{DynamicResource L.Bots.ClearConsole}" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 </StackPanel>
 <Border Grid.Row="1" Height="520" CornerRadius="12" Margin="0,8,0,0" Background="{DynamicResource ConsolePanelBrush}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" ClipToBounds="True">
 <Panel>
 <!-- Journal: les lignes colorées de la console Lua (catégorie, niveau, heure), filtrables. -->
 <ListBox x:Name="JournalConsole" ItemsSource="{Binding LuaOutput}" SelectionMode="Multiple" IsVisible="{Binding ShowJournalList}"
 KeyDown="OnConsoleKeyDown" DoubleTapped="OnLuaConsoleDoubleTapped" Background="Transparent" BorderThickness="0"
 Padding="6,6" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11.5">
 <ListBox.Styles>
 <Style Selector="ListBoxItem">
 <Setter Property="Padding" Value="4,0" />
 <Setter Property="MinHeight" Value="20" />
 <Setter Property="Height" Value="20" />
 </Style>
 </ListBox.Styles>
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:LuaLogRow">
 <Grid ColumnDefinitions="10,Auto,90,*" ColumnSpacing="8" VerticalAlignment="Center">
 <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}"
 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 <!-- Discussion : messages de tous les canaux + MP envoyés (le champ d'envoi est la barre du bas de la Console). -->
 <Grid IsVisible="{Binding ConsoleChat}" RowDefinitions="Auto,*">
 <CheckBox Grid.Row="0" Margin="10,6,0,0" IsChecked="{Binding ChatOnlyPrivate}" Content="MP seulement" FontSize="12" />
 <ScrollViewer Grid.Row="1" Margin="10,4,10,8" VerticalScrollBarVisibility="Auto">
 <ItemsControl ItemsSource="{Binding ChatLines}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:ChatLineVm">
 <Border Padding="8,7" Margin="0,2" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,0,1">
 <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
 <TextBlock Text="{Binding Time}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.65" Margin="0,3,0,0" />
 <StackPanel Grid.Column="1" Spacing="4">
 <WrapPanel Orientation="Horizontal">
 <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SenderText}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding Brush}" />
 </WrapPanel>
 <ctl:ChatMessageText Message="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="23" Foreground="{StaticResource TextPrimaryBrush}" />
 </StackPanel>
 </Grid>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </Grid>
 <ListBox x:Name="TransportConsole" ItemsSource="{Binding SelectedBot.TransportConsole}" SelectionMode="Multiple"
 IsVisible="{Binding ShowTechList}"
 KeyDown="OnConsoleKeyDown" Background="Transparent" BorderThickness="0"
 Padding="10,8" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11.5"
 Foreground="{StaticResource TextSecondaryBrush}">
 <ListBox.ItemTemplate>
 <DataTemplate>
 <!-- Couleur par catégorie [tag] / échec, via converter (le modèle reste une chaîne) -->
 <TextBlock Text="{Binding}" TextWrapping="NoWrap"
 Foreground="{Binding Converter={x:Static conv:TransportLineBrushConverter.Instance}}" />
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </Panel>
 </Border>
 <Border Grid.Row="3" Classes="panel" Margin="0,8,0,0" IsVisible="{Binding ConsoleTechnical}">
 <StackPanel Spacing="7">
 <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding RefreshFightDiagnosticsCommand}" Content="{DynamicResource L.FightDiag.Refresh}" />
 <SelectableTextBlock Text="{Binding FightDiagnosticText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
 </StackPanel>
 </Border>
 <!-- Barre d'envoi de message en jeu (MP + canaux). Enter envoie (OnChatKeyDown). -->
 <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="Auto,Auto,*,Auto" IsEnabled="{Binding HasSelection}">
 <ComboBox Grid.Column="0" Width="128" MinHeight="32" VerticalAlignment="Stretch"
 ItemsSource="{Binding ChatChannels}" SelectedIndex="{Binding ChatChannelIndex}">
 <ComboBox.ItemTemplate>
 <DataTemplate><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /></DataTemplate>
 </ComboBox.ItemTemplate>
 </ComboBox>
 <TextBox Grid.Column="1" Width="150" Margin="6,0,0,0" MinHeight="32" Text="{Binding ChatTarget}"
 Watermark="{DynamicResource L.Bots.Chat.Target}" IsVisible="{Binding ChatIsPrivate}"
 KeyDown="OnChatKeyDown" />
 <TextBox Grid.Column="2" Margin="6,0,0,0" MinHeight="32" Text="{Binding ChatDraft}"
 Watermark="{DynamicResource L.Bots.Chat.Message}" KeyDown="OnChatKeyDown" />
 <Button Grid.Column="3" Classes="accent" Height="32" MinWidth="0" Padding="16,0" Margin="6,0,0,0"
 Command="{Binding SendChatCommand}" Content="{DynamicResource L.Bots.Chat.Send}" />
 </Grid>
 </Grid>
 </TabItem>

 <!-- Onglet Combat: profil du bot selectionne (style IA, cible, rotation de sorts auto-detectes) -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="avares://GivreClone/Assets/stats/combat.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabCombat}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <ScrollViewer Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
 <StackPanel Spacing="16" Margin="2,0,12,0" MaxWidth="1120" HorizontalAlignment="Stretch">
 <!-- meme fond pour tous les champs (combos + numeriques): coherence visuelle -->
 <StackPanel.Styles>
 <Style Selector="ComboBox">
 <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
 <Setter Property="MinHeight" Value="34" />
 </Style>
 <Style Selector="NumericUpDown">
 <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
 <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
 <Setter Property="MinHeight" Value="32" />
 </Style>
 <Style Selector="NumericUpDown /template/ TextBox">
 <Setter Property="Background" Value="Transparent" />
 <!-- Valeur centree dans la boite -> alignee sous l'entete centree (Priorite / x-tour). -->
 <Setter Property="HorizontalContentAlignment" Value="Center" />
 <Setter Property="TextAlignment" Value="Center" />
 </Style>
 </StackPanel.Styles>

 <!-- Sous-onglets: Comportement / Sorts / Équipe (segmenté, façon concurrent) + import du profil d'un autre perso -->
 <Grid ColumnDefinitions="Auto,*,Auto">
 <Button Grid.Column="2" Classes="ghost" Height="36" Padding="12,0" Command="{Binding OpenCombatImportCommand}"
 IsEnabled="{Binding CombatProfileReady}" ToolTip.Tip="{DynamicResource L.Bots.Combat.ImportTip}"
 AutomationProperties.Name="Importer une configuration de combat"
 AutomationProperties.AutomationId="BtnOpenCombatImport">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <PathIcon Data="{StaticResource IconDownload}" Width="13" Height="13" Foreground="{DynamicResource AccentBrightBrush}" />
 <TextBlock Text="{DynamicResource L.Bots.Combat.ImportButton}" VerticalAlignment="Center" FontWeight="SemiBold" />
 </StackPanel>
 </Button>
 <Border Grid.Column="0" Classes="segbar">
 <StackPanel Orientation="Horizontal" Spacing="3">
 <RadioButton x:Name="segComportement" Classes="seg" GroupName="combatSub" IsChecked="True">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="avares://GivreClone/Assets/stats/pm.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.Combat.TabBehavior}" VerticalAlignment="Center" />
 </StackPanel>
 </RadioButton>
 <RadioButton x:Name="segSorts" Classes="seg" GroupName="combatSub">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="avares://GivreClone/Assets/stats/pa.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.Combat.TabSpells}" VerticalAlignment="Center" />
 </StackPanel>
 </RadioButton>
 </StackPanel>
 </Border>
 </Grid>

 <!-- Perso pas encore identifié: ses réglages ne sont pas connus -> éditeur grisé (rien n'est enregistré). -->
 <Border Classes="notice" IsVisible="{Binding CombatProfilePending}">
 <Grid ColumnDefinitions="Auto,*">
 <PathIcon Grid.Column="0" Data="{StaticResource IconClock}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Combat.WaitingCharacter}" />
 </Grid>
 </Border>

 <!-- ===== COMPORTEMENT ===== -->
 <StackPanel Classes="subtab" Spacing="16" IsVisible="{Binding #segComportement.IsChecked}" IsEnabled="{Binding CombatProfileReady}"
 Opacity="{Binding #segComportement.IsChecked, Converter={x:Static conv:BoolToDoubleConverter.Instance}, ConverterParameter=1}">

 <!-- Bandeau licence: sans le droit "fight", tout le combat auto est grisé. -->
 <Border Classes="notice" IsVisible="{Binding !CanFight}">
 <Grid ColumnDefinitions="Auto,*">
 <PathIcon Grid.Column="0" Data="{StaticResource IconLock}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Combat.NoLicenseFight}" />
 </Grid>
 </Border>

 <!-- Simulateur de tour: rejoue la rotation sur une grille iso -->
 <Button Classes="ghost" HorizontalAlignment="Stretch" Height="42" Padding="14,0"
 Command="{Binding OpenCombatSimCommand}" ToolTip.Tip="{DynamicResource L.Bots.Sim.Hint}"
 AutomationProperties.Name="Lancer la simulation de combat"
 AutomationProperties.AutomationId="BtnOpenCombatSim">
 <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
 <PathIcon Data="{StaticResource IconRobot}" Width="16" Height="16" Foreground="{DynamicResource AccentBrightBrush}" />
 <TextBlock Text="{DynamicResource L.Bots.Combat.Simulate}" VerticalAlignment="Center" FontWeight="SemiBold" />
 </StackPanel>
 </Button>

 <!-- CARTE: Automatisation (jouer auto + pré-combat + challenge) -->
 <!-- Conseiller multiclasse : lecture seule, opt-in par PID ; aucun cast n'est autorisé par cette UI. -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
 <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
 <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" VerticalAlignment="Center"
 Text="Conseiller tactique · diagnostic uniquement" />
 <Button Grid.Row="0" Grid.Column="1" Classes="ghost" Height="28" Padding="10,0"
 Command="{Binding ToggleCombatTacticalAdvisorCommand}" IsEnabled="{Binding CombatProfileReady}"
 Content="{Binding CombatTacticalAdvisorToggleLabel}"
 AutomationProperties.Name="Activer ou désactiver le conseiller tactique sans action jeu"
 AutomationProperties.AutomationId="BtnCombatTacticalAdvisor" />
 <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption" TextWrapping="Wrap"
 Text="{Binding CombatTacticalAdvisorStatusText}" />
 </Grid>
 </Border>

 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
 <StackPanel Spacing="11">
 <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
 <Image Source="{svc:GameIcon gear}" Width="17" Height="17" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Combat.SectionAuto}" VerticalAlignment="Center" />
 </StackPanel>
 <CheckBox IsChecked="{Binding CombatAutoFight}" IsEnabled="{Binding CanFight}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.AutoPlay}" />
 <!-- Mode automatique : tous les sorts appris à dégâts complètent la liste (un sort décoché de la liste reste écarté). -->
 <CheckBox IsChecked="{Binding CombatAutoSpells}" IsEnabled="{Binding CanFight}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.AutoSpells}" ToolTip.Tip="{DynamicResource L.Bots.Combat.AutoSpellsTip}" />
 <!-- Résurrection auto au Phénix (indépendante du combat: pas de gate CanFight). -->
 <CheckBox IsChecked="{Binding CombatAutoRevive}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.AutoRevive}" />
 <!-- Pré-combat autonome: placement (selon le style) + challenge + prêt.
 NÉCESSITE que le « prêt automatique » du CLIENT Dofus soit DÉSACTIVÉ. -->
 <CheckBox IsChecked="{Binding CombatAutoPreFight}" IsEnabled="{Binding CanFight}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.PreFight}" />
 <StackPanel Spacing="5" IsEnabled="{Binding CanFight}">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Combat.Placement}" />
 <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PlacementModeOptions}"
 SelectedItem="{Binding CombatPlacementMode}" IsEnabled="{Binding CombatAutoPreFight}"
 AutomationProperties.Name="Mode de placement pré-combat"
 AutomationProperties.AutomationId="CmbCombatPlacementMode">
 <ComboBox.ItemTemplate>
 <DataTemplate x:CompileBindings="False">
 <TextBlock Text="{Binding Label}" />
 </DataTemplate>
 </ComboBox.ItemTemplate>
 </ComboBox>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Combat.PlacementHint}" />
 </StackPanel>
 </StackPanel>
 </Border>

 <StackPanel Spacing="4" IsEnabled="{Binding CanFight}">
 <CheckBox IsChecked="{Binding CombatNeverApproach}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.NeverApproach}" ToolTip.Tip="{DynamicResource L.Bots.Combat.NeverApproachHint}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Combat.NeverApproachHint}" />
 </StackPanel>

 <!-- CARTE: Verrouillage du combat (appliqué au début de chaque combat ; les FIGHT_LOCK_* d'un script s'y ajoutent) -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
 <StackPanel Spacing="11">
 <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
 <PathIcon Data="{StaticResource IconLock}" Width="15" Height="15" Foreground="{DynamicResource AccentBrightBrush}" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Combat.SectionLock}" VerticalAlignment="Center" />
 </StackPanel>
 <CheckBox IsChecked="{Binding CombatLockSpectators}" IsEnabled="{Binding CanFight}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.LockSpectators}" />
 <CheckBox IsChecked="{Binding CombatLockJoin}" IsEnabled="{Binding CanFight}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.LockJoin}" />
 <CheckBox IsChecked="{Binding CombatLockParty}" IsEnabled="{Binding CanFight}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.LockParty}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Combat.LockHint}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{StaticResource AmberBrush}" Text="{Binding CombatLockScriptNote}"
 IsVisible="{Binding HasCombatLockScriptNote}" />
 </StackPanel>
 </Border>

 <!-- CARTE: Challenges (choix auto au placement, IA adaptée aux challenges actifs, bonus, liste des challenges acceptés) -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
 <StackPanel Spacing="11">
 <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/combat.png" Width="17" Height="17" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Combat.SectionChallenges}" VerticalAlignment="Center" />
 </StackPanel>
 <StackPanel Spacing="3">
 <CheckBox IsChecked="{Binding CombatAutoChallenge}" IsEnabled="{Binding CanFight}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.Challenge}" />
 <TextBlock Classes="caption" Margin="26,0,0,0" TextWrapping="Wrap"
 Text="{DynamicResource L.Bots.Combat.ChallengeHint}" />
 <TextBlock Classes="caption" Margin="26,0,0,0" TextWrapping="Wrap" Foreground="{StaticResource AmberBrush}"
 IsVisible="{Binding !CombatAutoPreFight}"
 Text="{DynamicResource L.Bots.Combat.ChallengeNeedsPreFight}" />
 </StackPanel>
 <StackPanel Spacing="3">
 <CheckBox IsChecked="{Binding CombatChallengeRules}" IsEnabled="{Binding CanFight}" FontSize="13"
 Content="{DynamicResource L.Bots.Combat.ChallengeRules}" />
 <TextBlock Classes="caption" Margin="26,0,0,0" TextWrapping="Wrap"
 Text="{DynamicResource L.Bots.Combat.ChallengeRulesHint}" />
 </StackPanel>
 <StackPanel Spacing="3" IsEnabled="{Binding CombatChallengeRules}">
 <Grid ColumnDefinitions="*,124">
 <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Combat.ChallengeAbandon}" />
 <NumericUpDown Grid.Column="1" Value="{Binding CombatChallengeAbandonHp}" Minimum="0" Maximum="100" Increment="5" FormatString="0" />
 </Grid>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Combat.ChallengeAbandonHint}" />
 </StackPanel>
 <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
 <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Combat.ChallengeBonus}" />
 <Border Grid.Column="1" Classes="segbar" HorizontalAlignment="Left">
 <StackPanel Orientation="Horizontal" Spacing="3">
 <RadioButton Classes="seg" GroupName="challengeBonus" IsChecked="{Binding CombatChallengeXp, Mode=TwoWay}"
 Content="{DynamicResource L.Bots.Combat.BonusXp}" />
 <RadioButton Classes="seg" GroupName="challengeBonus" IsChecked="{Binding CombatChallengeLoot, Mode=TwoWay}"
 Content="{DynamicResource L.Bots.Combat.BonusLoot}" />
 </StackPanel>
 </Border>
 <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="caption" TextWrapping="Wrap"
 Text="{DynamicResource L.Bots.Combat.ChallengeBonusHint}" />
 </Grid>
 <Button Classes="ghost" HorizontalAlignment="Stretch" Height="36" Padding="12,0"
 Command="{Binding OpenChallengeListCommand}"
 AutomationProperties.Name="Ouvrir la liste des challenges"
 AutomationProperties.AutomationId="BtnOpenChallengeList">
 <TextBlock Text="{Binding ChallengeListLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
 </Button>
 </StackPanel>
 </Border>

 <!-- CARTE: Style de combat (style d'IA / cible / vitesse) -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
 <StackPanel Spacing="11">
 <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/combat.png" Width="17" Height="17" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Combat.SectionStyle}" VerticalAlignment="Center" />
 </StackPanel>
 <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="5">
 <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="{DynamicResource L.Bots.Combat.Style}" />
 <ComboBox Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
 ItemsSource="{Binding CombatStyles}" SelectedItem="{Binding CombatStyle}">
 <ComboBox.ItemTemplate>
 <DataTemplate x:CompileBindings="False">
 <TextBlock Text="{Binding Converter={x:Static conv:CombatLabelConverter.Instance}}" />
 </DataTemplate>
 </ComboBox.ItemTemplate>
 </ComboBox>
 <TextBlock Grid.Row="0" Grid.Column="1" Classes="caption" Text="{DynamicResource L.Bots.Combat.Target}" />
 <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
 ItemsSource="{Binding TargetModes}" SelectedItem="{Binding CombatTarget}">
 <ComboBox.ItemTemplate>
 <DataTemplate x:CompileBindings="False">
 <TextBlock Text="{Binding Converter={x:Static conv:CombatLabelConverter.Instance}}" />
 </DataTemplate>
 </ComboBox.ItemTemplate>
 </ComboBox>
 <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="{DynamicResource L.Bots.Combat.Speed}" />
 <ComboBox Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
 ItemsSource="{Binding CombatSpeeds}" SelectedItem="{Binding CombatSpeed}">
 <ComboBox.ItemTemplate>
 <DataTemplate x:CompileBindings="False">
 <TextBlock Text="{Binding Converter={x:Static conv:CombatLabelConverter.Instance}}" />
 </DataTemplate>
 </ComboBox.ItemTemplate>
 </ComboBox>
 </Grid>
 <CheckBox IsChecked="{Binding CombatFinishKill}" Content="{DynamicResource L.Bots.Combat.FinishKill}"
 ToolTip.Tip="{DynamicResource L.Bots.Combat.FinishKillTip}" />
 <!-- Turbo : accusés de tous les combattants et passage de tour agressif TOUJOURS actifs (Socket comme MITM) ; les anciennes
 cases n'avaient plus d'effet, d'où un simple rappel. -->
 <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,4,0,0"
 IsVisible="{Binding CombatIsTurbo}" Text="{DynamicResource L.Bots.Combat.TurboIncludes}" />
 <TextBlock Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
 Text="{DynamicResource L.Bots.Combat.StyleHint}" />
 </StackPanel>
 </Border>

 <!-- CARTE: Réglages (plafond de casts / distance kite) -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
 <StackPanel Spacing="11">
 <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/tools.png" Width="17" Height="17" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Combat.SectionSettings}" VerticalAlignment="Center" />
 </StackPanel>
 <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Combat.MaxCasts}" />
 <NumericUpDown Value="{Binding CombatMaxCasts}" Minimum="1" Maximum="99" Increment="1" FormatString="0" />
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Combat.KiteMin}" />
 <NumericUpDown Value="{Binding CombatKiteDistance}" Minimum="1" Maximum="20" Increment="1" FormatString="0" />
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Combat.KiteMax}" />
 <NumericUpDown Value="{Binding CombatKiteMaxDistance}" Minimum="0" Maximum="20" Increment="1" FormatString="0" />
 </StackPanel>
 </Grid>
 <TextBlock Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
 Text="{DynamicResource L.Bots.Combat.KiteHint}" />
 </StackPanel>
 </Border>

 <!-- CARTE: Auto level-up des caractéristiques -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
 <StackPanel Spacing="11">
 <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/pa.png" Width="17" Height="17" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Combat.SectionLevelUp}" VerticalAlignment="Center" />
 </StackPanel>
 <CheckBox IsChecked="{Binding CombatAutoLevel}" IsEnabled="{Binding CanFight}"
 Content="{DynamicResource L.Bots.Combat.AutoLevel}" />
 <StackPanel Spacing="3" IsEnabled="{Binding CombatAutoLevel}">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Combat.LevelTarget}" />
 <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LevelStatTargets}" SelectedItem="{Binding CombatLevelTarget}">
 <ComboBox.ItemTemplate>
 <DataTemplate x:CompileBindings="False">
 <TextBlock Text="{Binding Converter={x:Static conv:CombatLabelConverter.Instance}}" />
 </DataTemplate>
 </ComboBox.ItemTemplate>
 </ComboBox>
 </StackPanel>
 <TextBlock Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
 Text="{DynamicResource L.Bots.Combat.AutoLevelHint}" />
 </StackPanel>
 </Border>

 <!-- CARTE: Confort client (mods natifs GivreMods.dll) -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
 <StackPanel Spacing="8">
 <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/console.png" Width="17" Height="17" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Combat.ClientComfort}" VerticalAlignment="Center" />
 </StackPanel>
 <Border Classes="notice" IsVisible="{Binding !CanAllMods}">
 <Grid ColumnDefinitions="Auto,*">
 <PathIcon Grid.Column="0" Data="{StaticResource IconLock}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Combat.NoLicenseMods}" />
 </Grid>
 </Border>
 <CheckBox IsChecked="{Binding CombatNoSpellEffects}" IsEnabled="{Binding CanCombatVisualOptions}" FontSize="12.5" Content="{DynamicResource L.Bots.Combat.Visuals.NoSpellEffects}" />
 <CheckBox IsChecked="{Binding CombatShortSpellCasts}" IsEnabled="{Binding CanCombatVisualOptions}" FontSize="12.5" Content="{DynamicResource L.Bots.Combat.Visuals.ShortSpellCasts}" />
 <CheckBox IsChecked="{Binding CombatNoDeathAnimations}" IsEnabled="{Binding CanCombatVisualOptions}" FontSize="12.5" Content="{DynamicResource L.Bots.Combat.Visuals.NoDeathAnimations}" ToolTip.Tip="{DynamicResource L.Bots.Combat.Visuals.DeathTip}" />
 <CheckBox IsChecked="{Binding CombatNoAnim}" IsEnabled="{Binding CanNoAnim}" FontSize="12.5"
 Content="{DynamicResource L.Bots.Combat.NoAnim}" />
 <CheckBox IsChecked="{Binding CombatCollapse}" IsEnabled="{Binding CanCombatCollapse}" FontSize="12.5"
 Content="{DynamicResource L.Bots.Combat.Collapse}" />
 <CheckBox IsChecked="{Binding CombatInstantMove}" IsEnabled="{Binding CanCombatInstantMove}" FontSize="12.5"
 Content="{DynamicResource L.Bots.Combat.InstantMove}"
 ToolTip.Tip="{DynamicResource L.Bots.Combat.Visuals.MovementTip}" />
 <StackPanel Orientation="Horizontal" Spacing="9">
 <Button Classes="ghost" Content="No Anim (profil rapide)" Command="{Binding EnableCombatNoAnimPresetCommand}"
         IsEnabled="{Binding CombatProfileReady}"
         ToolTip.Tip="{DynamicResource L.Bots.Combat.Visuals.PresetTip}" />
 <Button Classes="ghost" Content="Animations normales" Command="{Binding DisableCombatVisualPresetsCommand}"
         IsEnabled="{Binding CombatProfileReady}" />
 <Button Classes="ghost" Content="Vérifier les modules" Command="{Binding RefreshCombatVisualStatusCommand}"
         ToolTip.Tip="Vérification SHA hors jeu, sans injection ni réseau." />
 </StackPanel>
 <TextBlock Classes="caption" Text="{Binding CombatVisualStatus}" TextWrapping="Wrap"
            AutomationProperties.Name="Diagnostic des mods visuels de combat" />
 <CheckBox IsChecked="{Binding CombatTactical}" IsEnabled="{Binding CanTactical}" FontSize="12.5"
 Content="{DynamicResource L.Bots.Combat.Tactical}" />
 <TextBlock Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
 Text="{DynamicResource L.Bots.Combat.ModsHint}" />
 </StackPanel>
 </Border>
 </StackPanel>

 <!-- ===== SORTS ===== -->
 <StackPanel Classes="subtab" Spacing="16" IsVisible="{Binding #segSorts.IsChecked}" IsEnabled="{Binding CombatProfileReady}"
 Opacity="{Binding #segSorts.IsChecked, Converter={x:Static conv:BoolToDoubleConverter.Instance}, ConverterParameter=1}">

 <!-- Rotation de sorts (auto-detectes: sorts APPRIS du perso) -->
 <StackPanel Spacing="7">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Combat.SpellsByPriority}" />
 <ComboBox HorizontalAlignment="Stretch" PlaceholderText="{DynamicResource L.Bots.Combat.AddSpell}"
 ItemsSource="{Binding AvailableSpells}" SelectedItem="{Binding SpellToAdd}">
 <ComboBox.ItemTemplate>
 <DataTemplate x:CompileBindings="False">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <Image Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center"
 IsVisible="{Binding Icon, Converter={x:Static acv:ObjectConverters.IsNotNull}}" />
 <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
 </StackPanel>
 </DataTemplate>
 </ComboBox.ItemTemplate>
 </ComboBox>
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}"
 BorderThickness="1" CornerRadius="10" Padding="12,8" MinHeight="52">
 <StackPanel Spacing="2">
 <Grid ColumnDefinitions="30,44,*,Auto,152,30,30" ColumnSpacing="8" Margin="4,0,4,6">
 <TextBlock Grid.Column="2" Classes="caption" Text="{DynamicResource L.Bots.Combat.ColSpell}" FontSize="10.5" />
 <TextBlock Grid.Column="4" Classes="caption" Text="{DynamicResource L.Bots.Combat.Configure}" FontSize="10.5" HorizontalAlignment="Center" />
 </Grid>
 <TextBlock IsVisible="{Binding !HasCombatSpells}" Classes="caption" TextWrapping="Wrap" Margin="4,10" Text="{DynamicResource L.Bots.Combat.NoSpells}" />
 <ItemsControl x:Name="SpellsList" ItemsSource="{Binding CombatSpells}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:SpellRowViewModel">
 <StackPanel Spacing="0" Margin="0,0,0,2">
 <Border Classes="spellrow" CornerRadius="9" Padding="4,0">
 <Grid ColumnDefinitions="30,44,*,Auto,152,30,30" ColumnSpacing="8" Height="50">
 <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" MinWidth="0" ToolTip.Tip="{DynamicResource L.Bots.Combat.ToggleTip}"
           AutomationProperties.Name="Activer le sort"
           AutomationProperties.AutomationId="ChkEnableSpell" />
 <!-- badge priorité = poignée de glisser-déposer (réordonner) -->
 <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Width="30" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="Hand" PointerPressed="OnSpellDragStart" ToolTip.Tip="{DynamicResource L.Bots.Combat.PriorityTip}">
 <TextBlock Text="{Binding Priority}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
 </Border>
 <!-- icône + nom + tags -->
 <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
 <Image Source="{Binding Icon}" Width="30" Height="30" VerticalAlignment="Center"
 IsVisible="{Binding Icon, Converter={x:Static acv:ObjectConverters.IsNotNull}}" />
 <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
 <Button Classes="ghost" Padding="6,1" FontSize="11" IsVisible="{Binding HasVariant}" ToolTip.Tip="Passer à l'autre variante du sort (hors combat)"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).SwitchVariantCommand}" CommandParameter="{Binding}"
 AutomationProperties.Name="Basculer la variante du sort"
 AutomationProperties.AutomationId="BtnSwitchSpellVariant">
 <TextBlock Text="{Binding AltName, StringFormat='⇄ {0}'}" /></Button>
 <Border Classes="tag tagEnemy" IsVisible="{Binding !OnMe}"><TextBlock Text="{DynamicResource L.Bots.Combat.TagEnemy}" /></Border>
 <Border Classes="tag tagSelf" IsVisible="{Binding OnMe}"><TextBlock Text="{DynamicResource L.Bots.Combat.TagSelf}" /></Border>
 <Border Classes="tag tagBuff" IsVisible="{Binding SelfBuff}"><TextBlock Text="{DynamicResource L.Bots.Combat.TagBuff}" /></Border>
 <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding HasActiveConditions}" ToolTip.Tip="{DynamicResource L.Bots.Combat.CondActive}" />
 <Image Source="avares://GivreClone/Assets/stats/po.png" Width="13" Height="13" Opacity="0.8" VerticalAlignment="Center" IsVisible="{Binding HasPlacement}" ToolTip.Tip="{DynamicResource L.Bots.Combat.PlaceActive}" />
 </StackPanel>
 <!-- résumé fréquence -->
 <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="0,0,6,0">
 <TextBlock Text="{Binding PerTurn, StringFormat='×{0}/tour'}" Classes="caption" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
 <TextBlock Text="{Binding PerTarget, StringFormat='×{0}/cible'}" Classes="caption" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
 IsVisible="{Binding HasPerTarget}" ToolTip.Tip="{DynamicResource L.Bots.Combat.PerTargetTip}" />
 <TextBlock Text="{Binding Cooldown, StringFormat='⟳{0}'}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding HasCooldown}" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource L.Bots.Combat.CooldownTip}" />
 </StackPanel>
 <!-- Configurer (centré): ouvre le modal -->
 <Button Grid.Column="4" Classes="ghost" Height="32" MinWidth="0" Padding="14,0" HorizontalAlignment="Center" VerticalAlignment="Center"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).OpenSpellConfigCommand}"
 CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L.Bots.Combat.ConfigureTip}"
 AutomationProperties.Name="Configurer les conditions du sort"
 AutomationProperties.AutomationId="BtnOpenSpellConfig">
 <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
 <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" />
 <TextBlock Text="{DynamicResource L.Bots.Combat.Configure}" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <StackPanel Grid.Column="5" Orientation="Vertical" Spacing="1" VerticalAlignment="Center" HorizontalAlignment="Center">
 <Button Classes="ghost" Width="26" Height="17" MinWidth="0" Padding="0"
 ToolTip.Tip="{DynamicResource L.Bots.Combat.MoveUpTip}"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).MoveSpellUpCommand}"
 CommandParameter="{Binding}"
 AutomationProperties.Name="Monter la priorité du sort"
 AutomationProperties.AutomationId="BtnMoveSpellUp">
 <PathIcon Data="{StaticResource IconChevronUp}" Width="12" Height="12" />
 </Button>
 <Button Classes="ghost" Width="26" Height="17" MinWidth="0" Padding="0"
 ToolTip.Tip="{DynamicResource L.Bots.Combat.MoveDownTip}"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).MoveSpellDownCommand}"
 CommandParameter="{Binding}"
 AutomationProperties.Name="Descendre la priorité du sort"
 AutomationProperties.AutomationId="BtnMoveSpellDown">
 <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
 </Button>
 </StackPanel>
 <Button Grid.Column="6" Classes="ghost" Width="24" Height="24" MinWidth="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
 ToolTip.Tip="{DynamicResource L.Bots.Combat.RemoveTip}"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).RemoveSpellCommand}"
 CommandParameter="{Binding}"
 AutomationProperties.Name="Supprimer le sort du deck"
 AutomationProperties.AutomationId="BtnRemoveSpell">
 <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" />
 </Button>
 </Grid>
 </Border>
 </StackPanel>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </Border>
 </StackPanel>
 </StackPanel>

 </StackPanel>
 </ScrollViewer>
 </TabItem>

 <!-- Onglet Expédition : zone -> monstres cliquables -> limites -> Lancer (aucun script à écrire) -->
 <TabItem IsSelected="{Binding ExpTabSelected, Mode=TwoWay}">
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <PathIcon Data="{StaticResource IconExpedition}" Width="15" Height="15" />
 <TextBlock Text="{DynamicResource L.Exp.Tab}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <!-- Reglages a gauche et details a droite quand la place le permet, EMPILES en fenetre etroite : sans ca l'ecran
      expedition depassait la fenetre et la colonne de droite se rognait. Pilote par OnExpeditionLayoutSizeChanged. -->
 <Grid x:Name="ExpeditionLayout" ColumnDefinitions="300,*" ColumnSpacing="14" Margin="0,12,0,12" SizeChanged="OnExpeditionLayoutSizeChanged">
 <StackPanel Grid.Column="0" Spacing="8">
 <Button Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding RefreshExpeditionCatalogCommand}" IsEnabled="{Binding !LuaRunning}" Content="{DynamicResource L.Exp.RefreshCatalog}" />
 <!-- Mode : zone de chasse ou donjon -->
 <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
 <Button HorizontalAlignment="Stretch" Classes.accent="{Binding ExpZoneMode}" Command="{Binding ExpSetZoneModeCommand}"><TextBlock Text="{DynamicResource L.Exp.ModeZone}" HorizontalAlignment="Center" /></Button>
 <Button Grid.Column="1" HorizontalAlignment="Stretch" Classes.accent="{Binding ExpDungeonMode}" Command="{Binding ExpSetDungeonModeCommand}"><TextBlock Text="{DynamicResource L.Exp.ModeDungeon}" HorizontalAlignment="Center" /></Button>
 </Grid>
 <StackPanel Spacing="8" IsVisible="{Binding ExpZoneMode}">
 <!-- Anomalies ouvertes (serveur du bot) : un clic prépare l'expédition sur la sous-zone, arrêt auto à la fermeture -->
 <Border Background="#1F2A1E" BorderBrush="#4E7A3A" BorderThickness="1" CornerRadius="10" Padding="8" IsVisible="{Binding ExpHasAnomalies}">
 <StackPanel Spacing="4">
 <TextBlock Text="{DynamicResource L.Exp.Anomalies}" FontSize="12.5" FontWeight="SemiBold" />
 <ItemsControl ItemsSource="{Binding ExpAnomalies}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:AnomalyRow">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,3" Margin="0,0,0,2"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).ExpPickAnomalyCommand}" CommandParameter="{Binding}">
 <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
 <StackPanel>
 <TextBlock Text="{Binding Caption}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding Area}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
 </StackPanel>
 <TextBlock Grid.Column="1" Text="{Binding BonusText}" IsVisible="{Binding HasBonus}" FontSize="12" FontWeight="SemiBold" Foreground="#9BE07A" VerticalAlignment="Center" />
 <TextBlock Grid.Column="2" Text="{Binding RemainingText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 </Grid>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </Border>
 <TextBlock Classes="label" Text="{DynamicResource L.Exp.Area}" />
 <ComboBox ItemsSource="{Binding ExpAreas}" SelectedItem="{Binding ExpArea}" HorizontalAlignment="Stretch" MaxDropDownHeight="360" />
 <TextBlock Classes="label" Text="{DynamicResource L.Exp.SubArea}" />
 <TextBlock Text="Clique plusieurs sous-zones pour les combiner (cartes et monstres réunis)." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
 <ListBox Classes="surfaceList" x:Name="ExpSubAreaList" ItemsSource="{Binding ExpSubAreas}" SelectedItem="{Binding ExpSubArea}" SelectionMode="Multiple,Toggle" Height="420" SelectionChanged="OnExpSubAreasChanged">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="lotm:ExpSubArea">
 <TextBlock Text="{Binding Caption}" FontSize="12" TextTrimming="CharacterEllipsis" />
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </StackPanel>
 <StackPanel Spacing="8" IsVisible="{Binding ExpDungeonMode}">
 <TextBox Text="{Binding ExpDungeonFilter}" Watermark="{DynamicResource L.Exp.DungeonSearch}" Height="32" VerticalContentAlignment="Center" />
 <ListBox Classes="surfaceList" ItemsSource="{Binding ExpDungeons}" SelectedItem="{Binding ExpDungeon}" Height="470">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="lotm:ExpDungeon">
 <TextBlock Text="{Binding Caption}" FontSize="12" TextTrimming="CharacterEllipsis" />
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </StackPanel>
 </StackPanel>
 <ScrollViewer x:Name="ExpeditionDetails" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Spacing="12" Margin="0,0,10,0">
 <TextBlock Text="{Binding ExpSummary}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" TextWrapping="Wrap" />
  <TextBlock Text="{Binding ExpValueText}" IsVisible="{Binding ExpHasValue}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
  <Expander x:Name="ExpeditionRoutePreview" Header="{DynamicResource L.Exp.RoutePreview}" IsVisible="{Binding ExpZoneMode}" HorizontalAlignment="Stretch">
  <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
  <StackPanel Spacing="8">
  <TextBlock Text="{Binding ExpRouteText}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
  <TextBlock Text="{DynamicResource L.Exp.RouteHint}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
  </StackPanel>
  </Border>
  </Expander>
 <!-- Donjon : salles, niveau, boss, clés (✔ possédée / ✖ manquante), nombre de passages -->
 <StackPanel Spacing="8" IsVisible="{Binding ExpDungeonMode}">
 <TextBlock Text="{Binding ExpDungeonDetail}" TextWrapping="Wrap" FontSize="12" />
 <TextBlock Classes="label" Text="{DynamicResource L.Exp.DungeonKeys}" IsVisible="{Binding ExpDungeonHasKeys}" />
 <ItemsControl ItemsSource="{Binding ExpDungeonKeys}" IsVisible="{Binding ExpDungeonHasKeys}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="12" /></DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <TextBlock Text="{Binding ExpDungeonBudgetText}" FontSize="11.5"
 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
 AutomationProperties.Name="Budget de clés du donjon" />
 <StackPanel Spacing="3"><TextBlock Text="{DynamicResource L.Exp.Runs}" FontSize="11.5" /><NumericUpDown Value="{Binding ExpRuns}" Minimum="0" Maximum="1000" Increment="1" FormatString="0" Width="150" HorizontalAlignment="Left" /></StackPanel>
 <TextBlock Text="{DynamicResource L.Exp.DungeonHint}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 <StackPanel Spacing="12" IsVisible="{Binding ExpZoneMode}">
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock Classes="label" Text="{DynamicResource L.Exp.Monsters}" VerticalAlignment="Center" />
 <Button Grid.Column="1" Classes="ghost" Command="{Binding ExpeditionResetMonstersCommand}"><TextBlock Text="{DynamicResource L.Exp.Reset}" FontSize="11.5" /></Button>
 </Grid>
 <TextBlock Text="{DynamicResource L.Exp.ClickHint}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
 <ItemsControl ItemsSource="{Binding ExpMonsters}">
 <ItemsControl.ItemsPanel>
 <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
 </ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:ExpMonsterCard">
 <Button Command="{Binding CycleCommand}" Width="128" Margin="0,0,8,8" Padding="0" Background="Transparent" BorderThickness="0">
 <Border CornerRadius="10" BorderThickness="2" BorderBrush="{Binding Border}" Background="#1A1F28" Padding="6">
 <StackPanel Spacing="3" HorizontalAlignment="Center">
 <Image Source="{Binding Icon}" Width="56" Height="56" Stretch="Uniform" />
 <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding LevelText}" FontSize="10.5" TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{Binding StateText}" FontSize="10.5" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource AccentBrightBrush}" />
 </StackPanel>
 </Border>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />
 <TextBlock Classes="label" Text="{DynamicResource L.Exp.GroupSize}" />
 <Grid ColumnDefinitions="Auto,*,40" ColumnSpacing="8">
 <TextBlock Text="{DynamicResource L.Exp.Min}" VerticalAlignment="Center" FontSize="12" />
 <Slider Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ExpMinGroup}" />
 <TextBlock Grid.Column="2" Text="{Binding ExpMinGroup, StringFormat={}{0:0}}" VerticalAlignment="Center" />
 </Grid>
 <Grid ColumnDefinitions="Auto,*,40" ColumnSpacing="8">
 <TextBlock Text="{DynamicResource L.Exp.Max}" VerticalAlignment="Center" FontSize="12" />
 <Slider Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ExpMaxGroup}" />
 <TextBlock Grid.Column="2" Text="{Binding ExpMaxGroup, StringFormat={}{0:0}}" VerticalAlignment="Center" />
 </Grid>
 </StackPanel>
 <TextBlock Classes="label" Text="{DynamicResource L.Exp.Stop}" />
 <WrapPanel>
 <StackPanel Spacing="3" Margin="0,0,16,0" IsVisible="{Binding ExpZoneMode}"><TextBlock Text="{DynamicResource L.Exp.MaxFights}" FontSize="11.5" /><NumericUpDown Value="{Binding ExpMaxFights}" Minimum="0" Maximum="100000" Increment="10" FormatString="0" Width="150" /></StackPanel>
 <StackPanel Spacing="3" Margin="0,0,16,0"><TextBlock Text="{DynamicResource L.Exp.MaxMinutes}" FontSize="11.5" /><NumericUpDown Value="{Binding ExpMaxMinutes}" Minimum="0" Maximum="100000" Increment="10" FormatString="0" Width="150" /></StackPanel>
 <StackPanel Spacing="3" Width="220"><TextBlock Text="{DynamicResource L.Exp.StopPods}" FontSize="11.5" /><Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ExpStopPods}" /></StackPanel>
 </WrapPanel>
 <CheckBox IsChecked="{Binding ExpBank}"><TextBlock Text="{DynamicResource L.Exp.Bank}" TextWrapping="Wrap" /></CheckBox>
 <StackPanel Spacing="2" IsVisible="{Binding ExpZoneMode}">
 <CheckBox IsChecked="{Binding ExpHdv}"><TextBlock Text="{DynamicResource L.Exp.Hdv}" TextWrapping="Wrap" /></CheckBox>
 <TextBlock Text="{Binding ExpHdvText}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="28,0,0,0" />
 </StackPanel>
 <!-- Élixir uchronique : sans son altération, les monstres d'une anomalie ne donnent pas de fragments -->
 <Border Background="#1F2A1E" BorderBrush="#4E7A3A" BorderThickness="1" CornerRadius="10" Padding="10,8">
 <StackPanel Spacing="6">
 <TextBlock Text="{DynamicResource L.Exp.Elixir}" FontSize="12.5" FontWeight="SemiBold" />
 <ComboBox ItemsSource="{Binding ExpElixirChoices}" SelectedIndex="{Binding ExpElixirRank}" HorizontalAlignment="Stretch" />
 <WrapPanel IsVisible="{Binding ExpUsesElixir}">
 <StackPanel Spacing="3" Margin="0,0,16,0"><TextBlock Text="{DynamicResource L.Exp.ElixirMaxPrice}" FontSize="11.5" /><NumericUpDown Value="{Binding ExpElixirMaxPrice}" Minimum="0" Maximum="100000000" Increment="1000" FormatString="N0" Width="170" /></StackPanel>
 <StackPanel Spacing="3"><TextBlock Text="{DynamicResource L.Exp.ElixirStock}" FontSize="11.5" /><NumericUpDown Value="{Binding ExpElixirStock}" Minimum="1" Maximum="50" FormatString="0" Width="110" ToolTip.Tip="{DynamicResource L.Exp.ElixirStockTip}" /></StackPanel>
 </WrapPanel>
 <TextBlock Text="{DynamicResource L.Exp.ElixirHint}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{Binding ExpElixirState}" FontSize="11.5" TextWrapping="Wrap" Foreground="#9BE07A"
 IsVisible="{Binding ExpElixirState, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
 </StackPanel>
 </Border>
 <StackPanel Orientation="Horizontal" Spacing="8">
 <Button Classes="accent" Command="{Binding ExpeditionStartCommand}" MinHeight="34" Padding="18,0"><TextBlock Text="{DynamicResource L.Exp.Start}" FontWeight="SemiBold" /></Button>
 <Button Classes="ghost" Command="{Binding ExpeditionStopCommand}" MinHeight="34"><TextBlock Text="{DynamicResource L.Exp.StopBtn}" /></Button>
 </StackPanel>
  <TextBlock Text="{Binding ExpStatus}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
  <TextBlock x:Name="ExpeditionRouteLastVisit" Text="{Binding ExpRouteProgress}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource AccentBrightBrush}"
             AutomationProperties.Name="{DynamicResource L.Exp.RoutePreview}" />
 </StackPanel>
 </ScrollViewer>
 </Grid>
 </TabItem>

 <!-- Onglet Trajets : éditeur VISUEL de trajet (clic sur la carte du monde, étapes vérifiées, génération du script) -->
 <TabItem IsSelected="{Binding RoadTabSelected, Mode=TwoWay}">
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <PathIcon Data="{StaticResource IconMap}" Width="15" Height="15" />
 <TextBlock Text="{DynamicResource L.Road.Tab}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <Grid ColumnDefinitions="*,390" ColumnSpacing="12" Margin="0,12,0,12" Height="680" DataContext="{Binding RoadEditor}" x:DataType="vm:RoadEditorViewModel">
 <!-- Carte du monde -->
 <Border Grid.Column="0" CornerRadius="12" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" ClipToBounds="True">
 <Grid>
 <ctl:RouteMapControl Model="{Binding MapModel}" CenterOn="{Binding Center}" HoverCell="{Binding HoverCell, Mode=OneWayToSource}"
 CellCommand="{Binding CellClickedCommand}" CellRemoveCommand="{Binding CellRemoveCommand}" />
 <!-- Barre du haut : aide + position survolée ; actions rapides -->
 <Grid ColumnDefinitions="*,Auto" Margin="10" VerticalAlignment="Top">
 <Border Background="#E61A1F28" CornerRadius="8" Padding="8,5" HorizontalAlignment="Left" IsHitTestVisible="False">
 <TextBlock Text="{Binding HoverText}" FontSize="11.5" />
 </Border>
 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
 <Button Command="{Binding AddHereCommand}" ToolTip.Tip="{DynamicResource L.Road.AddHereTip}"><TextBlock Text="{DynamicResource L.Road.AddHere}" FontSize="11.5" /></Button>
 <Button Classes="ghost" Command="{Binding CenterOnBotCommand}"><TextBlock Text="{DynamicResource L.Road.CenterBot}" FontSize="11.5" /></Button>
 </StackPanel>
 </Grid>
 <!-- Légende -->
 <Border Background="#E61A1F28" CornerRadius="8" Padding="8,5" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
 <StackPanel Orientation="Horizontal" Spacing="12">
 <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="14" Height="3" Background="#63D3A6" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource L.Road.LegendWalk}" FontSize="11" /></StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="14" Height="3" Background="#F2A541" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource L.Road.LegendTeleport}" FontSize="11" /></StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="14" Height="3" Background="#E05A50" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource L.Road.LegendBad}" FontSize="11" /></StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="9" Height="9" Background="#E8A63C" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource L.Road.LegendBot}" FontSize="11" /></StackPanel>
 </StackPanel>
 </Border>
 <!-- Trajet vide : mode d'emploi -->
 <Border IsVisible="{Binding IsEmpty}" Background="#E61A1F28" CornerRadius="10" Padding="14,10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="420">
 <TextBlock Text="{DynamicResource L.Road.EmptyHint}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" />
 </Border>
 </Grid>
 </Border>

 <!-- Panneau : réglages, points, vérification, actions -->
 <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Spacing="10" Margin="0,0,8,0">
 <TextBox Text="{Binding RoadName}" Watermark="{DynamicResource L.Road.NameWatermark}" Height="32" VerticalContentAlignment="Center" />
 <WrapPanel>
 <CheckBox IsChecked="{Binding Loop}" Margin="0,0,14,0"><TextBlock Text="{DynamicResource L.Road.Loop}" /></CheckBox>
 <CheckBox IsChecked="{Binding AutoBank}" Margin="0,0,14,0"><TextBlock Text="{DynamicResource L.Road.AutoBank}" /></CheckBox>
 <CheckBox IsChecked="{Binding UseHdv}"><TextBlock Text="{DynamicResource L.Exp.Hdv}" /></CheckBox>
 </WrapPanel>
 <TextBlock Text="{Binding BankText}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{Binding HdvText}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding UseHdv}" />

 <!-- Résumé + problèmes -->
 <TextBlock Text="{Binding Summary}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" TextWrapping="Wrap" />
 <Border IsVisible="{Binding HasIssues}" Background="#3A1A14" BorderBrush="#E05A50" BorderThickness="1" CornerRadius="8" Padding="8">
 <ItemsControl ItemsSource="{Binding Issues}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Foreground="#F5B0A8" Margin="0,1" /></DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </Border>

 <!-- Outils sur la liste -->
 <WrapPanel IsVisible="{Binding HasWaypoints}">
 <Button Classes="ghost" Margin="0,0,6,6" Command="{Binding OptimizeCommand}" ToolTip.Tip="{DynamicResource L.Road.OptimizeTip}"><TextBlock Text="{DynamicResource L.Road.Optimize}" FontSize="11.5" /></Button>
 <Button Classes="ghost" Margin="0,0,6,6" Command="{Binding ReverseCommand}"><TextBlock Text="{DynamicResource L.Road.Reverse}" FontSize="11.5" /></Button>
 <Button Classes="ghost" Margin="0,0,6,6" Command="{Binding AllGatherCommand}" CommandParameter="1"><TextBlock Text="{DynamicResource L.Road.AllGather}" FontSize="11.5" /></Button>
 <Button Classes="ghost" Margin="0,0,6,6" Command="{Binding AllFightCommand}" CommandParameter="1"><TextBlock Text="{DynamicResource L.Road.AllFight}" FontSize="11.5" /></Button>
 <Button Classes="ghost" Margin="0,0,6,6" Command="{Binding ClearCommand}"><TextBlock Text="{DynamicResource L.Road.Clear}" FontSize="11.5" /></Button>
 </WrapPanel>

 <!-- Points du trajet -->
 <ListBox ItemsSource="{Binding Waypoints}" SelectedItem="{Binding SelectedWaypoint}" MaxHeight="300" IsVisible="{Binding HasWaypoints}">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:RoadWaypointRow">
 <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
 <Border Grid.RowSpan="2" Width="24" Height="24" CornerRadius="12" Background="#4FA3FF" VerticalAlignment="Center">
 <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
 </Border>
 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
 <TextBlock Text="{Binding CoordText}" FontSize="12" FontWeight="SemiBold" />
 <TextBlock Text="{Binding Place}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
 <TextBlock Text="⚠" Foreground="#E05A50" IsVisible="{Binding Duplicate}" ToolTip.Tip="{DynamicResource L.Road.DuplicateTip}" />
 </StackPanel>
 <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="10">
 <CheckBox IsChecked="{Binding Gather}" MinHeight="22" Padding="4,0"><TextBlock Text="{DynamicResource L.Road.Gather}" FontSize="11" /></CheckBox>
 <CheckBox IsChecked="{Binding Fight}" MinHeight="22" Padding="4,0"><TextBlock Text="{DynamicResource L.Road.Fight}" FontSize="11" /></CheckBox>
 <TextBlock Text="{Binding LegText}" Foreground="{Binding LegBrush}" FontSize="11" VerticalAlignment="Center" />
 </StackPanel>
 <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
 <Button Classes="ghost" Padding="5,1" MinWidth="0" Command="{Binding Owner.MoveUpCommand}" CommandParameter="{Binding}"><TextBlock Text="▲" FontSize="10" /></Button>
 <Button Classes="ghost" Padding="5,1" MinWidth="0" Command="{Binding Owner.MoveDownCommand}" CommandParameter="{Binding}"><TextBlock Text="▼" FontSize="10" /></Button>
 <Button Classes="ghost" Padding="5,1" MinWidth="0" Command="{Binding Owner.RemoveCommand}" CommandParameter="{Binding}"><TextBlock Text="✕" FontSize="10" /></Button>
 </StackPanel>
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>

 <!-- Combat + pods -->
 <StackPanel Spacing="4" IsVisible="{Binding HasWaypoints}">
 <TextBlock Classes="label" Text="{DynamicResource L.Exp.GroupSize}" />
 <Grid ColumnDefinitions="Auto,*,30" ColumnSpacing="8">
 <TextBlock Text="{DynamicResource L.Exp.Min}" VerticalAlignment="Center" FontSize="12" />
 <Slider Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MinMonsters}" />
 <TextBlock Grid.Column="2" Text="{Binding MinMonsters, StringFormat={}{0:0}}" VerticalAlignment="Center" />
 </Grid>
 <Grid ColumnDefinitions="Auto,*,30" ColumnSpacing="8">
 <TextBlock Text="{DynamicResource L.Exp.Max}" VerticalAlignment="Center" FontSize="12" />
 <Slider Grid.Column="1" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxMonsters}" />
 <TextBlock Grid.Column="2" Text="{Binding MaxMonsters, StringFormat={}{0:0}}" VerticalAlignment="Center" />
 </Grid>
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Text="{DynamicResource L.Road.MaxPods}" VerticalAlignment="Center" FontSize="12" />
 <NumericUpDown Value="{Binding MaxPods}" Minimum="10" Maximum="100" Increment="5" FormatString="0" Width="120" />
 </StackPanel>
 </StackPanel>

 <!-- Actions -->
 <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="6" IsVisible="{Binding HasWaypoints}">
 <Button Grid.ColumnSpan="2" Classes="accent" HorizontalAlignment="Stretch" MinHeight="34" Command="{Binding RunCommand}">
 <TextBlock Text="{DynamicResource L.Road.Run}" FontWeight="SemiBold" HorizontalAlignment="Center" />
 </Button>
 <Button Grid.Row="1" HorizontalAlignment="Stretch" Command="{Binding SendToEditorCommand}"><TextBlock Text="{DynamicResource L.Road.SendToEditor}" HorizontalAlignment="Center" FontSize="11.5" /></Button>
 <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Command="{Binding SaveCommand}"><TextBlock Text="{DynamicResource L.Road.Save}" HorizontalAlignment="Center" FontSize="11.5" /></Button>
 </Grid>
 <Button Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding ImportFromEditorCommand}" ToolTip.Tip="{DynamicResource L.Road.ImportTip}">
 <TextBlock Text="{DynamicResource L.Road.Import}" HorizontalAlignment="Center" FontSize="11.5" />
 </Button>
 <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </ScrollViewer>
 </Grid>
 </TabItem>

 <!-- Onglet Carte -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon map}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabMap}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <!-- Hauteur FIGEE: le panneau d'infos SCROLLE (jamais coupe) et ne peut plus agrandir la card (fin du flicker). -->
 <Grid x:Name="MapTabGrid" ColumnDefinitions="*,320" ColumnSpacing="10" Margin="0,12,0,0" Height="580" ClipToBounds="True">
 <!-- Carte en relief (remplit l'espace) -->
 <Border Grid.Column="0" CornerRadius="12" Background="#14181F" BorderBrush="{StaticResource StrokeSoftBrush}"
 BorderThickness="1" Height="580" ClipToBounds="True" Padding="0" x:Name="MapTabBorder">
 <Grid>
 <Viewbox Stretch="Uniform">
 <ctl:IsoMapControl x:Name="Map"
 AutomationProperties.Name="{DynamicResource L.Bots.TabMap}"
 Cells="{Binding SelectedBot.MapCells}"
 Actors="{Binding SelectedBot.Inspector.VisibleActors}"
 SelectedCell="{Binding SelectedBot.Inspector.SelectedCell}"
 MatchCells="{Binding SelectedBot.Inspector.MatchCells}"
 MoveSignal="{Binding SelectedBot.LastMove}"
 MapEpoch="{Binding SelectedBot.MapEpoch}"
 SourceCell="{Binding SelectedBot.SelfCellId}"
 ShowTransitions="{Binding ShowTransitions}"
 ShowCellIds="{Binding ShowCellIds}"
 BgOffsetX="{Binding ImgOffX}" BgOffsetY="{Binding ImgOffY}" BgScale="{Binding ImgScale}" BgCellOpacity="{Binding ImgCellOpacity}"
 Interactives="{Binding SelectedBot.Inspector.VisibleInteractives}"
 SelfName="{Binding SelectedBot.Row.CharacterName}"
 SelfActorId="{Binding SelectedBot.SelfActorId}"
 FightMode="{Binding SelectedBot.FightActive}" FightMarks="{Binding SelectedBot.FightMarks}" Fighters="{Binding SelectedBot.FightFighters}" />
 </Viewbox>
 <!-- COMBAT JOUABLE : bandeau PA/PM/phase en haut, barre de sorts + Prêt/Passer + défis + journal en bas (le clic sur la carte place, lance ou déplace). -->
 <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" CornerRadius="10" Padding="10,5" Background="#E61A1F28"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" DataContext="{Binding SelectedBot}" x:DataType="vm:BotRowViewModel"
 IsVisible="{Binding FightActive}">
 <StackPanel Spacing="5">
 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
 <Border Background="#2F6BDB" CornerRadius="5" Padding="7,2"><TextBlock Text="{Binding FightApText}" FontWeight="Bold" FontSize="12" Foreground="White" /></Border>
 <Border Background="#2E9E5B" CornerRadius="5" Padding="7,2"><TextBlock Text="{Binding FightMpText}" FontWeight="Bold" FontSize="12" Foreground="White" /></Border>
 <TextBlock Text="{Binding FightPhaseText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
 </StackPanel>
 <!-- Frise de l'ordre de jeu (déduite des débuts de tour) : le combattant qui joue est encadré, les morts estompés. -->
 <ItemsControl ItemsSource="{Binding TurnChips}" HorizontalAlignment="Center" IsVisible="{Binding TurnChips.Count}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:TurnChip">
 <Border CornerRadius="6" Padding="6,2" Opacity="{Binding Opacity}" ToolTip.Tip="{Binding Tip}"
 Background="#33000000" BorderBrush="{Binding Color}" BorderThickness="1" Classes.turnNow="{Binding IsCurrent}">
 <StackPanel Orientation="Horizontal" Spacing="4">
 <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Color}" />
 <TextBlock Text="{Binding Hp}" FontSize="10" Opacity="0.8" />
 </StackPanel>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <TextBlock Text="{Binding TurnOrderHint}" FontSize="10" Opacity="0.6" HorizontalAlignment="Center"
 IsVisible="{Binding TurnOrderHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
 </StackPanel>
 </Border>
 <!-- Panneau compact, visible seulement EN COMBAT, centré en bas et limité en largeur (la carte reste visible). -->
 <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" MaxWidth="520" CornerRadius="14" Padding="10,8" Background="#E014181F"
 BorderBrush="#40FFFFFF" BorderThickness="1" BoxShadow="0 6 18 0 #80000000" DataContext="{Binding SelectedBot}" x:DataType="vm:BotRowViewModel"
 IsVisible="{Binding FightActive}">
 <StackPanel Spacing="7">
 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding FightAuto}">
 <Button Classes="ghost" Command="{Binding GiveUpFightCommand}" Padding="10,4" FontSize="11.5" Foreground="#FF8A8A" ToolTip.Tip="Abandonne le combat en cours (2 clics)"><TextBlock Text="{Binding GiveUpLabel}" /></Button>
 <TextBlock Text="Combat automatique" VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
 <Button Command="{Binding ToggleManualFightCommand}" Padding="12,4" FontSize="12" ToolTip.Tip="Coupe l'automatisme : tu joues toi-même en cliquant la carte."><TextBlock Text="Reprendre la main" /></Button>
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding FightManualActive}">
 <Button Classes="primary" Command="{Binding FightReadyCommand}" IsVisible="{Binding FightIsPlacement}" Padding="18,5" FontWeight="SemiBold"
         AutomationProperties.Name="Prêt pour le combat"
         AutomationProperties.AutomationId="BtnFightReady"><TextBlock Text="Prêt" /></Button>
 <Button Classes="primary" Command="{Binding FightEndTurnCommand}" IsVisible="{Binding FightIsMyTurn}" Padding="18,5" FontWeight="SemiBold"
         AutomationProperties.Name="Passer le tour de jeu"
         AutomationProperties.AutomationId="BtnFightEndTurn"><TextBlock Text="Passer le tour" /></Button>
 <Button Classes="ghost" Command="{Binding ToggleManualFightCommand}" Padding="10,5" FontSize="11.5" ToolTip.Tip="Rend la main à l'automatisme"><TextBlock Text="Auto" /></Button>
 <Button Classes="ghost" Command="{Binding GiveUpFightCommand}" Padding="10,5" FontSize="11.5" Foreground="#FF8A8A" ToolTip.Tip="Abandonne le combat en cours (2 clics)"
         AutomationProperties.Name="Abandonner le combat en cours"
         AutomationProperties.AutomationId="BtnGiveUpFight"><TextBlock Text="{Binding GiveUpLabel}" /></Button>
 </StackPanel>
 <!-- Défis proposés (placement) -->
 <ItemsControl ItemsSource="{Binding FightChallenges}" IsVisible="{Binding FightIsPlacement}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:FightChallengeItem">
 <Button Margin="0,0,6,6" Padding="8,4" FontSize="11.5" Command="{Binding $parent[ItemsControl].((vm:BotRowViewModel)DataContext).PickFightChallengeCommand}" CommandParameter="{Binding}"
         AutomationProperties.Name="Sélectionner un challenge en combat"
         AutomationProperties.AutomationId="BtnPickFightChallenge">
 <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Bonus}" FontSize="10.5" Opacity="0.75" /></StackPanel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <!-- Barre de sorts -->
 <ItemsControl ItemsSource="{Binding FightSpells}" IsVisible="{Binding FightManualActive}" HorizontalAlignment="Center">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:FightSpellItem">
 <Button Margin="0,0,3,3" Padding="0" Width="36" Height="36" CornerRadius="8" ToolTip.Tip="{Binding Tip}"
 Command="{Binding $parent[ItemsControl].((vm:BotRowViewModel)DataContext).PickFightSpellCommand}" CommandParameter="{Binding}"
 AutomationProperties.Name="Lancer un sort"
 AutomationProperties.AutomationId="BtnPickFightSpell">
 <Grid>
 <Image Source="{Binding Icon}" Stretch="Uniform" Margin="2" />
 <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#CC2F6BDB" CornerRadius="4" Padding="3,0"><TextBlock Text="{Binding ApText}" FontSize="10" FontWeight="Bold" Foreground="White" /></Border>
 <Border IsVisible="{Binding IsSelected}" BorderBrush="#F5A623" BorderThickness="2" CornerRadius="4" />
 </Grid>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <ItemsControl ItemsSource="{Binding FightLog}" IsVisible="{Binding FightManualActive}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="10.5" Opacity="0.7" HorizontalAlignment="Center" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
 </Border>
 <!-- Flèches de changement de carte autour de la carte (2e clic = annuler) -->
 <Button Classes="ghost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8" Height="30" MinWidth="64" Background="#D91A1F28"
 IsVisible="{Binding !SelectedBot.FightActive}" IsEnabled="{Binding SelectedBot.CanGoTop}" Command="{Binding MapChangeCommand}" CommandParameter="top"
 AutomationProperties.Name="Changer de carte vers le Haut"
 AutomationProperties.AutomationId="BtnMapChangeTop">
 <StackPanel Orientation="Horizontal" Spacing="4">
 <TextBlock Text="✕" FontSize="12" IsVisible="{Binding IsTopPending}" Foreground="#FFE07A" />
 <TextBlock Text="{DynamicResource L.Bots.MapNav.Top}" FontSize="12" />
 </StackPanel>
 </Button>
<Button Classes="ghost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" Height="30" MinWidth="64" Background="#D91A1F28"
 IsVisible="{Binding !SelectedBot.FightActive}" IsEnabled="{Binding SelectedBot.CanGoBottom}" Command="{Binding MapChangeCommand}" CommandParameter="bottom"
 AutomationProperties.Name="Changer de carte vers le Bas"
 AutomationProperties.AutomationId="BtnMapChangeBottom">
 <StackPanel Orientation="Horizontal" Spacing="4">
 <TextBlock Text="✕" FontSize="12" IsVisible="{Binding IsBottomPending}" Foreground="#FFE07A" />
 <TextBlock Text="{DynamicResource L.Bots.MapNav.Bottom}" FontSize="12" />
 </StackPanel>
 </Button>
<Button Classes="ghost" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8" Height="30" MinWidth="64" Background="#D91A1F28"
 IsVisible="{Binding !SelectedBot.FightActive}" IsEnabled="{Binding SelectedBot.CanGoLeft}" Command="{Binding MapChangeCommand}" CommandParameter="left" AutomationProperties.Name="Changer de carte vers la Gauche" AutomationProperties.AutomationId="BtnMapChangeLeft">
 <StackPanel Orientation="Horizontal" Spacing="4">
 <TextBlock Text="✕" FontSize="12" IsVisible="{Binding IsLeftPending}" Foreground="#FFE07A" />
 <TextBlock Text="{DynamicResource L.Bots.MapNav.Left}" FontSize="12" />
 </StackPanel>
 </Button>
<Button Classes="ghost" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8" Height="30" MinWidth="64" Background="#D91A1F28"
 IsVisible="{Binding !SelectedBot.FightActive}" IsEnabled="{Binding SelectedBot.CanGoRight}" Command="{Binding MapChangeCommand}" CommandParameter="right" AutomationProperties.Name="Changer de carte vers la Droite" AutomationProperties.AutomationId="BtnMapChangeRight">
 <StackPanel Orientation="Horizontal" Spacing="4">
 <TextBlock Text="✕" FontSize="12" IsVisible="{Binding IsRightPending}" Foreground="#FFE07A" />
 <TextBlock Text="{DynamicResource L.Bots.MapNav.Right}" FontSize="12" />
 </StackPanel>
 </Button>
 <!-- Atlas contextuel en lecture seule : coordonnées et fraîcheur issues du bot sélectionné.
      Aucun point ou déplacement simulé. Le bandeau laisse la souris agir sur la carte. -->
 <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
 Background="#E61A1F28" BorderBrush="{StaticResource StrokeSoftBrush}"
 BorderThickness="1" CornerRadius="9" Padding="10,6" IsHitTestVisible="False"
 IsVisible="{Binding !SelectedBot.FightActive}" MaxWidth="300">
 <StackPanel Spacing="3">
 <TextBlock Text="{DynamicResource L.Bots.MapInfo}" FontWeight="SemiBold" FontSize="11"
 Foreground="{StaticResource TextPrimaryBrush}" />
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Text="{Binding SelectedBot.Row.MapCoords}" Cursor="Hand" PointerPressed="OnCopyText" ToolTip.Tip="Cliquer pour copier" FontWeight="SemiBold" FontSize="12"
 Foreground="{DynamicResource AccentBrightBrush}" />
 <TextBlock Text="{Binding SelectedBot.Row.MapId, StringFormat='mapId {0}'}" FontSize="11"
 Foreground="{StaticResource TextSecondaryBrush}" />
 </StackPanel>
 <TextBlock Text="{Binding SelectedBot.Inspector.FreshnessText}" FontSize="10.5"
 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
 </StackPanel>
 </Border>
 <!-- COIN HDV : panneau repliable en haut à droite de la carte (valeur du sac aux prix marché connus, mes lots, mes ventes). -->
 <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" MinWidth="44" CornerRadius="10" Padding="8,6"
 Background="#E61A1F28" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
 IsVisible="{Binding SelectedBot, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
 <StackPanel Spacing="6" MinWidth="210" DataContext="{Binding SelectedBot}" x:DataType="vm:BotRowViewModel">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,2" MinHeight="26" Command="{Binding ToggleHdvCornerCommand}">
 <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
 <Image Source="{svc:GameIcon auctionHouseResources}" Width="18" Height="18" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.HdvCorner.Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
 <TextBlock Grid.Column="2" Text="▾" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding !HdvCornerOpen}" />
 <TextBlock Grid.Column="2" Text="▴" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HdvCornerOpen}" />
 </Grid>
 </Button>
 <StackPanel Spacing="5" IsVisible="{Binding HdvCornerOpen}">
 <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
 <TextBlock Text="{DynamicResource L.Bots.HdvCorner.BagValue}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Column="1" Text="{Binding HdvBagValueText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" />
 <TextBlock Grid.Row="1" Text="{DynamicResource L.Bots.HdvCorner.Listings}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HdvListingsText}" FontSize="12" />
 <TextBlock Grid.Row="2" Text="{DynamicResource L.Bots.HdvCorner.Sales}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HdvSalesText}" FontSize="12" />
 </Grid>
 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />
 <ItemsControl ItemsSource="{Binding HdvCornerRows}" IsVisible="{Binding HdvCornerHasRows}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvCornerRow">
 <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="6" Margin="0,2">
 <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform" />
 <StackPanel Grid.Column="1">
 <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
 <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"><Run Text="{Binding QtyText}" /><Run Text=" · " /><Run Text="{Binding UnitText}" /></TextBlock>
 </StackPanel>
 <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrightBrush}" />
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <TextBlock Text="{DynamicResource L.Bots.HdvCorner.Empty}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding !HdvCornerHasRows}" />
 <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HdvUnpricedText, Converter={x:Static acv:StringConverters.IsNotNullOrEmpty}}">
 <TextBlock Text="{Binding HdvUnpricedText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{DynamicResource L.Bots.HdvCorner.Unpriced}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 <Button Classes="ghost" HorizontalAlignment="Stretch" MinHeight="26" Command="{Binding RefreshHdvCornerCommand}"><TextBlock Text="{DynamicResource L.Bots.HdvCorner.Refresh}" FontSize="11.5" HorizontalAlignment="Center" /></Button>
 </StackPanel>
 </StackPanel>
 </Border>
 <!-- FENÊTRE D'INTERACTION : s'ouvre seule quand une banque, un échange joueur ou une boutique PNJ est ouvert côté serveur
 (app, script ou joueur dans Dofus). Déposer / retirer / poser / acheter / vendre, kamas, prêt ; demande d'échange reçue. -->
 <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Width="500"
 IsVisible="{Binding SelectedBot, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
 <Border DataContext="{Binding SelectedBot.Interaction}" x:DataType="vm:InteractionWindowViewModel" IsVisible="{Binding IsVisible}"
 CornerRadius="10" Padding="10" Background="#F21A1F28" BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="1">
 <StackPanel Spacing="8">
 <!-- Barre de titre -->
 <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
 <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
 <Button Grid.Column="1" Classes="ghost" Padding="6,2" MinHeight="24" Command="{Binding ToggleCollapsedCommand}" IsVisible="{Binding IsOpen}">
 <Panel><TextBlock Text="▾" IsVisible="{Binding Collapsed}" /><TextBlock Text="▴" IsVisible="{Binding !Collapsed}" /></Panel>
 </Button>
 <Button Grid.Column="2" Classes="ghost" Padding="8,2" MinHeight="24" Command="{Binding CloseCommand}" IsVisible="{Binding IsOpen}">
 <TextBlock Text="{DynamicResource L.Iw.Close}" FontSize="11.5" />
 </Button>
 </Grid>
 <!-- Demande d'échange reçue -->
 <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding HasPending}">
 <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
 <Button Grid.Column="1" Classes="accent" Command="{Binding AcceptRequestCommand}"><TextBlock Text="{DynamicResource L.Iw.Accept}" /></Button>
 <Button Grid.Column="2" Command="{Binding RefuseRequestCommand}"><TextBlock Text="{DynamicResource L.Iw.Refuse}" /></Button>
 </Grid>
 <StackPanel Spacing="8" IsVisible="{Binding IsOpen}">
 <StackPanel Spacing="8" IsVisible="{Binding !Collapsed}">
 <TextBlock IsVisible="{Binding ShowScriptWarning}" Text="{DynamicResource L.Iw.ScriptWarning}" TextWrapping="Wrap" FontSize="11" Foreground="#F5D49A" />
 <!-- Recherche + quantité (la quantité ne sert qu'aux objets) -->
 <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
 <TextBox Text="{Binding Filter}" Watermark="{DynamicResource L.Iw.Filter}" Height="30" VerticalContentAlignment="Center" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Iw.Quantity}" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding IsItemExchange}" />
 <NumericUpDown Grid.Column="2" Value="{Binding Quantity}" Minimum="1" Maximum="100000" Increment="1" FormatString="0" Width="110" IsEnabled="{Binding !WholeStack}" IsVisible="{Binding IsItemExchange}" />
 <CheckBox Grid.Column="3" IsChecked="{Binding WholeStack}" IsVisible="{Binding IsItemExchange}"><TextBlock Text="{DynamicResource L.Iw.Whole}" FontSize="11.5" /></CheckBox>
 </Grid>
 <!-- Objets : catégorie + tri (comme la banque du jeu) -->
 <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6" IsVisible="{Binding IsItemExchange}">
 <Button Grid.Column="2" Classes="ghost" MinHeight="28" Padding="8,0" Command="{Binding ToggleGridViewCommand}" ToolTip.Tip="{DynamicResource L.Iw.ViewToggleTip}"
         AutomationProperties.Name="Basculer l'affichage entre grille et liste"
         AutomationProperties.AutomationId="BtnToggleGridViewCarte">
 <Panel>
 <TextBlock Text="☰" FontSize="13" IsVisible="{Binding GridView}" />
 <TextBlock Text="▦" FontSize="13" IsVisible="{Binding ListView}" />
 </Panel>
 </Button>
 <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" MinHeight="28" FontSize="11.5" />
 <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding ItemSortIndex}" MinHeight="28" FontSize="11.5">
 <ComboBoxItem Content="{DynamicResource L.Iw.SortNone}" />
 <ComboBoxItem Content="{DynamicResource L.Iw.SortName}" />
 <ComboBoxItem Content="{DynamicResource L.Iw.SortQty}" />
 <ComboBoxItem Content="{DynamicResource L.Iw.SortCategory}" />
 </ComboBox>
 </Grid>
 <!-- Téléportation : tri, favoris, kamas, sauvegarde du zaap (comme la fenêtre du jeu) -->
 <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsTeleport}">
 <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding TeleportSortIndex}" MinHeight="28" FontSize="11.5">
 <ComboBoxItem Content="{DynamicResource L.Iw.SortDistance}" />
 <ComboBoxItem Content="{DynamicResource L.Iw.SortName}" />
 <ComboBoxItem Content="{DynamicResource L.Iw.SortCost}" />
 <ComboBoxItem Content="{DynamicResource L.Iw.SortRegion}" />
 </ComboBox>
 <CheckBox Grid.Column="1" IsChecked="{Binding FavoritesOnly}"><TextBlock Text="{DynamicResource L.Iw.FavoritesOnly}" FontSize="11.5" /></CheckBox>
 <Button Grid.Column="2" Classes="ghost" MinHeight="28" Padding="8,0" IsVisible="{Binding CanSaveZaap}" Command="{Binding SaveZaapCommand}"
 ToolTip.Tip="{DynamicResource L.Iw.SaveZaapTip}">
 <TextBlock Text="{DynamicResource L.Iw.SaveZaap}" FontSize="11.5" />
 </Button>
 </Grid>
 <!-- Téléportation : destinations du zaap / zaapi / zaap du havre-sac, les plus proches d'abord ; un clic = départ. -->
 <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsTeleport}">
 <ItemsControl ItemsSource="{Binding TeleportRows}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:TeleportRow">
 <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4" Margin="0,0,0,3">
 <Button Classes="ghost" Width="26" MinWidth="0" Padding="0" VerticalAlignment="Stretch" Command="{Binding Owner.ToggleFavoriteCommand}" CommandParameter="{Binding}"
 ToolTip.Tip="{DynamicResource L.Iw.FavoriteTip}">
 <Panel>
 <TextBlock Text="★" FontSize="14" Foreground="#F2C14E" IsVisible="{Binding IsFavorite}" HorizontalAlignment="Center" VerticalAlignment="Center" />
 <TextBlock Text="☆" FontSize="14" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding !IsFavorite}" HorizontalAlignment="Center" VerticalAlignment="Center" />
 </Panel>
 </Button>
 <Border Grid.Column="1" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource AccentBrightBrush}" Background="#22F2C14E" IsVisible="{Binding IsSelected}" />
 <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,4"
 Command="{Binding Owner.SelectTeleportCommand}" CommandParameter="{Binding}">
 <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
 <StackPanel VerticalAlignment="Center">
 <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
 </StackPanel>
 <TextBlock Grid.Column="1" Text="⌂" FontSize="13" Foreground="#63D3A6" IsVisible="{Binding IsRespawn}" VerticalAlignment="Center"
 ToolTip.Tip="{DynamicResource L.Iw.RespawnHere}" />
 <Panel Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding HasCost}">
 <TextBlock Text="{Binding CostText}" FontSize="11.5" Foreground="#F2C14E" IsVisible="{Binding Affordable}" />
 <TextBlock Text="{Binding CostText}" FontSize="11.5" Foreground="#FF6B7A" IsVisible="{Binding TooExpensive}" />
 <TextBlock Text="{Binding CostText}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
 ToolTip.Tip="Kamas du personnage non encore reçus" IsVisible="{Binding PriceUnknown}" />
 </Panel>
 </Grid>
 </Button>
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 <TextBlock Text="{Binding TeleportReadOnlyHint}" IsVisible="{Binding TeleportReadOnly}"
 Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"
 AutomationProperties.Name="Téléportation vers anomalie indisponible sans preuve serveur" />
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsTeleport}">
 <StackPanel VerticalAlignment="Center" Spacing="1">
 <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"><Run Text="{DynamicResource L.Iw.MyKamas}" /><Run Text=" " /><Run Text="{Binding BagKamasText}" Foreground="#F2C14E" /></TextBlock>
 <TextBlock Text="{Binding RespawnText}" FontSize="10.5" Foreground="#63D3A6" IsVisible="{Binding HasRespawn}" TextTrimming="CharacterEllipsis" />
 </StackPanel>
 <Button Grid.Column="1" Classes="accent" MinHeight="32" Padding="14,0" Command="{Binding TeleportSelectedCommand}" IsEnabled="{Binding CanExecuteTeleport}"
 ToolTip.Tip="{DynamicResource L.Iw.TeleportTip}">
 <TextBlock Text="{DynamicResource L.Iw.Teleport}" FontWeight="SemiBold" />
 </Button>
 </Grid>
 <!-- Deux colonnes : sac | coffre / mon offre / boutique -->
 <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsItemExchange}">
 <StackPanel Spacing="4">
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock Text="{Binding LeftTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Column="1" Text="{Binding BagKamasText}" FontSize="11.5" Foreground="#F2C14E" />
 </Grid>
 <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ListView}">
 <ItemsControl ItemsSource="{Binding LeftRows}" ItemTemplate="{StaticResource IwRowTemplate}" />
 </ScrollViewer>
 <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" IsVisible="{Binding GridView}">
 <ItemsControl ItemsSource="{Binding LeftRows}" ItemTemplate="{StaticResource IwCellTemplate}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 </ItemsControl>
 </ScrollViewer>
 <TextBlock Text="{Binding LeftVisibleText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
 <WrapPanel IsVisible="{Binding IsBank}">
 <TextBlock Text="{DynamicResource L.Iw.TransferLabel}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,4" />
 <Button Classes="ghost" MinHeight="24" Padding="6,0" Margin="0,0,4,4" Command="{Binding TransferBagAllCommand}"><TextBlock Text="{DynamicResource L.Iw.TransferAll}" FontSize="10.5" /></Button>
 <Button Classes="ghost" MinHeight="24" Padding="6,0" Margin="0,0,4,4" Command="{Binding TransferBagVisibleCommand}"><TextBlock Text="{DynamicResource L.Iw.TransferVisible}" FontSize="10.5" /></Button>
 <Button Classes="ghost" MinHeight="24" Padding="6,0" Margin="0,0,4,4" Command="{Binding TransferBagExistingCommand}"><TextBlock Text="{DynamicResource L.Iw.TransferExisting}" FontSize="10.5" /></Button>
 </WrapPanel>
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="4">
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock Text="{Binding RightTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Column="1" Text="{Binding RightKamasText}" FontSize="11.5" Foreground="#F2C14E" />
 </Grid>
 <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" IsVisible="{Binding ListView}">
 <ItemsControl ItemsSource="{Binding RightRows}" ItemTemplate="{StaticResource IwRowTemplate}" />
 </ScrollViewer>
 <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" IsVisible="{Binding GridView}">
 <ItemsControl ItemsSource="{Binding RightRows}" ItemTemplate="{StaticResource IwCellTemplate}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 </ItemsControl>
 </ScrollViewer>
 <TextBlock Text="{Binding RightVisibleText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
 <WrapPanel IsVisible="{Binding IsBank}">
 <TextBlock Text="{DynamicResource L.Iw.TransferLabel}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,4" />
 <Button Classes="ghost" MinHeight="24" Padding="6,0" Margin="0,0,4,4" Command="{Binding TransferBankAllCommand}"><TextBlock Text="{DynamicResource L.Iw.TransferAll}" FontSize="10.5" /></Button>
 <Button Classes="ghost" MinHeight="24" Padding="6,0" Margin="0,0,4,4" Command="{Binding TransferBankVisibleCommand}"><TextBlock Text="{DynamicResource L.Iw.TransferVisible}" FontSize="10.5" /></Button>
 <Button Classes="ghost" MinHeight="24" Padding="6,0" Margin="0,0,4,4" Command="{Binding TransferBankExistingCommand}"><TextBlock Text="{DynamicResource L.Iw.TransferExisting}" FontSize="10.5" /></Button>
 </WrapPanel>
 </StackPanel>
 </Grid>
 <!-- Échange : offre du partenaire + prêt -->
 <StackPanel Spacing="4" IsVisible="{Binding IsTrade}">
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"><Run Text="{DynamicResource L.Iw.TheirOffer}" /><Run Text=" " /><Run Text="{Binding PartnerName}" /></TextBlock>
 <TextBlock Grid.Column="1" Text="{Binding TheirKamasText}" FontSize="11.5" Foreground="#F2C14E" />
 </Grid>
 <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
 <ItemsControl ItemsSource="{Binding TheirRows}" ItemTemplate="{StaticResource IwRowTemplate}" />
 </ScrollViewer>
 <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
 <TextBlock Text="{DynamicResource L.Iw.TheyReady}" FontSize="11.5" Foreground="#63D3A6" IsVisible="{Binding TheyReady}" />
 <TextBlock Text="{DynamicResource L.Iw.TheyNotReady}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" IsVisible="{Binding !TheyReady}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Iw.MeReadyText}" FontSize="11.5" Foreground="#63D3A6" IsVisible="{Binding MeReady}" HorizontalAlignment="Right" />
 </Grid>
 </StackPanel>
 <!-- Kamas + actions groupées -->
 <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasKamasRow}">
 <NumericUpDown Value="{Binding KamasAmount}" Minimum="0" Maximum="2000000000" Increment="1000" FormatString="0" Width="140" Margin="0,0,6,6" />
 <Button Margin="0,0,6,6" IsVisible="{Binding IsBank}" Command="{Binding KamasInCommand}"><TextBlock Text="{DynamicResource L.Iw.KamasInBtn}" /></Button>
 <Button Margin="0,0,6,6" IsVisible="{Binding IsBank}" Command="{Binding KamasOutCommand}"><TextBlock Text="{DynamicResource L.Iw.KamasOutBtn}" /></Button>
 <Button Margin="0,0,6,6" IsVisible="{Binding IsTrade}" Command="{Binding TradeKamasCommand}"><TextBlock Text="{DynamicResource L.Iw.KamasOfferBtn}" /></Button>
 <Button Margin="0,0,6,6" Classes="accent" IsVisible="{Binding IsTrade}" Command="{Binding ToggleReadyCommand}"><TextBlock Text="{Binding ReadyText}" /></Button>
 </WrapPanel>
 </StackPanel>
 </StackPanel>
 <TextBlock IsVisible="{Binding HasStatus}" Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </Border>
 </Border>
 </Grid>
 </Border>

 <!-- Panneau d'infos: SCROLLABLE pour ne jamais couper le contenu. -->
 <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
 <StackPanel Spacing="16">
 <!-- BARRE CARTE : mode, mon personnage, retour d'action, mode compact multibot -->
 <StackPanel Spacing="8">
 <Border DataContext="{Binding SelectedBot.Inspector}" x:DataType="vm:MapInspectorViewModel" IsVisible="{Binding HasOpenInteraction}" Background="#3A2A10" BorderBrush="#E0A040" BorderThickness="1" CornerRadius="8" Padding="8">
 <StackPanel Spacing="6">
 <TextBlock Text="{Binding OpenInteractionText}" TextWrapping="Wrap" FontSize="11.5" Foreground="#F5D49A" />
 <Button HorizontalAlignment="Stretch" Command="{Binding LeaveInteractionCommand}"><TextBlock Text="{DynamicResource L.MapInsp.CloseInteraction}" HorizontalAlignment="Center" /></Button>
 </StackPanel>
 </Border>
 <!-- À PROXIMITÉ : repères du jeu les plus proches (banque, HDV, ateliers, zaap…), un par catégorie ; « Y aller » = trajet auto. -->
 <Border IsVisible="{Binding HasNearby}" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="8" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Spacing="6">
 <TextBlock Text="{DynamicResource L.Near.Title}" FontSize="12.5" FontWeight="SemiBold" />
 <ItemsControl ItemsSource="{Binding NearbyPlaces}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:NearbyPlaceRow">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,4" Margin="0,0,0,4" MinHeight="40"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).NearbyGoCommand}" CommandParameter="{Binding}"
 ToolTip.Tip="{Binding Coords}">
 <Grid ColumnDefinitions="30,*,Auto,Auto" ColumnSpacing="8">
 <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Surface1Brush}">
 <TextBlock Text="{Binding Glyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
 </Border>
 <StackPanel Grid.Column="1" VerticalAlignment="Center">
 <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource AccentBrightBrush}" TextTrimming="CharacterEllipsis" />
 </StackPanel>
 <TextBlock Grid.Column="2" Text="{Binding DistanceText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="3" Text="›" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 </Grid>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasNearbyStatus}">
 <TextBlock Text="{Binding NearbyStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 <Button Grid.Column="1" Classes="ghost" Padding="8,2" IsVisible="{Binding NearbyTraveling}" Command="{Binding NearbyStopCommand}"><TextBlock Text="{DynamicResource L.Near.Stop}" FontSize="11" /></Button>
 </Grid>
 </StackPanel>
 </Border>
 <TextBlock DataContext="{Binding SelectedBot.Inspector}" x:DataType="vm:MapInspectorViewModel" IsVisible="{Binding HasPreview}" Text="{Binding PreviewText}" FontSize="11.5" Foreground="{DynamicResource AccentBrightBrush}" />
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" DataContext="{Binding SelectedBot.Inspector}" x:DataType="vm:MapInspectorViewModel">
 <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding SelectSelfCommand}"><TextBlock Text="{DynamicResource L.MapInsp.MySelf}" HorizontalAlignment="Center" /></Button>
 </Grid>
 <!-- Déplacement rapide : havre-sac (entrer / sortir), zaap et zaapi de la carte -> liste des destinations dans la fenêtre d'interaction. -->
 <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" DataContext="{Binding SelectedBot}" x:DataType="vm:BotRowViewModel"
 IsVisible="{Binding $parent[UserControl].((vm:BotsViewModel)DataContext).SelectedBot, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
 <Button HorizontalAlignment="Stretch" Command="{Binding ToggleHavenBagCommand}" ToolTip.Tip="{DynamicResource L.Travel.HavenBagTip}">
 <TextBlock Text="{Binding HavenBagText}" HorizontalAlignment="Center" FontSize="11.5" />
 </Button>
 <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{Binding OpenZaapHereCommand}" IsEnabled="{Binding HasZaapHere}" ToolTip.Tip="{DynamicResource L.Travel.ZaapTip}">
 <TextBlock Text="{DynamicResource L.Travel.Zaap}" HorizontalAlignment="Center" FontSize="11.5" />
 </Button>
 <Button Grid.Column="2" HorizontalAlignment="Stretch" Command="{Binding OpenZaapiHereCommand}" IsEnabled="{Binding HasZaapiHere}" ToolTip.Tip="{DynamicResource L.Travel.ZaapiTip}">
 <TextBlock Text="{DynamicResource L.Travel.Zaapi}" HorizontalAlignment="Center" FontSize="11.5" />
 </Button>
 </Grid>
 <!-- Dans une salle de donjon : sortie directe, comme le bouton du jeu -->
 <Button DataContext="{Binding SelectedBot}" x:DataType="vm:BotRowViewModel" HorizontalAlignment="Stretch"
 IsVisible="{Binding InDungeon, FallbackValue=False}" Command="{Binding ExitDungeonCommand}" ToolTip.Tip="{Binding ExitDungeonTip}">
 <TextBlock Text="{DynamicResource L.Travel.ExitDungeon}" HorizontalAlignment="Center" FontSize="11.5" />
 </Button>
 <Border DataContext="{Binding SelectedBot.Inspector}" x:DataType="vm:MapInspectorViewModel" IsVisible="{Binding HasFeedback}" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="8">
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock Text="{Binding FeedbackText}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
 <Button Grid.Column="1" Classes="ghost" Width="22" Height="22" MinWidth="0" Padding="0" Command="{Binding DismissFeedbackCommand}"><TextBlock Text="✕" FontSize="11" /></Button>
 </Grid>
 </Border>
 <CheckBox IsChecked="{Binding MapCompact}" FontSize="12" Content="{DynamicResource L.MapInsp.Compact}" />
 <ItemsControl ItemsSource="{Binding Bots}" IsVisible="{Binding MapCompact}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:BotRowViewModel">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,3" Padding="8,4" MinHeight="28"
 Command="{Binding $parent[UserControl].((vm:BotsViewModel)DataContext).SelectBotCommand}" CommandParameter="{Binding}">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Text="{Binding Row.CharacterName}" FontSize="12" FontWeight="SemiBold" />
 <TextBlock Text="{Binding Row.MapCoords}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />

 <!-- INSPECTION : recherche, filtres, sélecteur de superposition, fiche en lecture seule, fraîcheur. -->
 <StackPanel Spacing="8" DataContext="{Binding SelectedBot.Inspector}" x:DataType="vm:MapInspectorViewModel">
 <TextBlock Classes="label" Text="{DynamicResource L.MapInsp.Title}" />
 <TextBox Text="{Binding SearchText}" Watermark="{DynamicResource L.MapInsp.Search}" MinHeight="30"
 AutomationProperties.Name="{DynamicResource L.MapInsp.Search}" />
 <WrapPanel>
 <CheckBox IsChecked="{Binding ShowMonsters}" FontSize="12" Margin="0,0,10,0">
 <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="8" Height="8" Fill="#C85450" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource L.MapInsp.Filter.Monsters}" /><TextBlock Text="{Binding MonsterCount}" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
 </CheckBox>
 <CheckBox IsChecked="{Binding ShowNpcs}" FontSize="12" Margin="0,0,10,0">
 <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="8" Height="8" Fill="#5FC8C8" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource L.MapInsp.Filter.Npcs}" /><TextBlock Text="{Binding NpcCount}" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
 </CheckBox>
 <CheckBox IsChecked="{Binding ShowPlayers}" FontSize="12" Margin="0,0,10,0">
 <StackPanel Orientation="Horizontal" Spacing="4"><Ellipse Width="8" Height="8" Fill="#8076D0" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource L.MapInsp.Filter.Players}" /><TextBlock Text="{Binding PlayerCount}" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
 </CheckBox>
 <CheckBox IsChecked="{Binding ShowResources}" FontSize="12">
 <StackPanel Orientation="Horizontal" Spacing="4"><Path Data="M5,0 L10,5 L5,10 L0,5 Z" Width="9" Height="9" Stretch="Uniform" Fill="#5CD676" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource L.MapInsp.Filter.Resources}" /><TextBlock Text="{Binding ResourceCount}" Foreground="{StaticResource TextMutedBrush}" /></StackPanel>
 </CheckBox>
 </WrapPanel>

 <!-- Ressources de la carte : « Blé · Faucher 3/4 » -->
 <StackPanel Spacing="3" IsVisible="{Binding HasResourceGroups}">
 <TextBlock Text="{DynamicResource L.MapInsp.ResourcesHere}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 <ItemsControl ItemsSource="{Binding ResourceGroups}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:ResourceGroupRow">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6,3" MinHeight="28"
 Command="{Binding $parent[ItemsControl].((vm:MapInspectorViewModel)DataContext).SelectGroupCommand}" CommandParameter="{Binding}">
 <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="6">
 <Image Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform" />
 <TextBlock Grid.Column="1" Text="{Binding Caption}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
 <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrightBrush}" />
 </Grid>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>

 <!-- Résultats de recherche -->
 <StackPanel Spacing="4" IsVisible="{Binding Searching}">
 <TextBlock Text="{Binding ResultsText}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <ItemsControl ItemsSource="{Binding Results}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="svc:MapEntity">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,3" MinHeight="26"
 Command="{Binding $parent[ItemsControl].((vm:MapInspectorViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
 <StackPanel Orientation="Horizontal" Spacing="6"><Image Source="{Binding ., Converter={x:Static conv:MapEntityIconConverter.Instance}}" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" /></StackPanel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </StackPanel>

 <!-- Sélecteur : plusieurs entités sur la même cellule -->
 <StackPanel Spacing="4" IsVisible="{Binding HasCandidates}">
 <TextBlock Text="{Binding OverlapText}" Classes="caption" Foreground="{DynamicResource AccentBrightBrush}" />
 <ItemsControl ItemsSource="{Binding Candidates}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="svc:MapEntity">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,3" MinHeight="26"
 Command="{Binding $parent[ItemsControl].((vm:MapInspectorViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
 <StackPanel Orientation="Horizontal" Spacing="6"><Image Source="{Binding ., Converter={x:Static conv:MapEntityIconConverter.Instance}}" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" /></StackPanel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>

 <!-- Fiche (lecture seule) -->
 <Border IsVisible="{Binding HasSelection}" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Spacing="8">
 <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
 <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{StaticResource Surface1Brush}" ClipToBounds="True"
 IsVisible="{Binding Icon, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
 <Image Source="{Binding Icon}" Stretch="Uniform" />
 </Border>
 <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
 <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
 <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource AccentBrightBrush}" />
 </StackPanel>
 <Button Grid.Column="2" Classes="ghost" Width="26" Height="26" MinWidth="0" Padding="0" VerticalAlignment="Top"
 Command="{Binding ClearSelectionCommand}" ToolTip.Tip="{DynamicResource L.MapInsp.Close}">
 <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" />
 </Button>
 </Grid>
 <ItemsControl ItemsSource="{Binding Members}" IsVisible="{Binding HasMembers}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:InspectorMember">
 <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
 <Border Width="22" Height="22" CornerRadius="4" Background="{StaticResource Surface1Brush}" Margin="0,0,8,0" ClipToBounds="True">
 <Image Source="{Binding Icon}" Stretch="Uniform" />
 </Border>
 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
 <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
 <TextBlock Text="{Binding Level}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='×{0}'}" Foreground="{DynamicResource AccentBrightBrush}" />
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding !IsCharacterSelected}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:InspectorLine">
 <Grid ColumnDefinitions="92,*" Margin="0,1,0,0">
 <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <!-- PNJ : actions déclarées par le jeu, étapes distinctes (rejoindre / demander l'ouverture / confirmée), dialogue et historique -->
 <StackPanel Spacing="6" IsVisible="{Binding IsNpcSelected}">
 <Button Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding JoinCommand}"><TextBlock Text="{DynamicResource L.MapInsp.Join}" HorizontalAlignment="Center" /></Button>
 <ItemsControl ItemsSource="{Binding NpcActions}" IsVisible="{Binding HasNpcActions}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:NpcActionOption">
 <Button Classes="ghost" HorizontalAlignment="Stretch" Margin="0,0,0,4"
 Command="{Binding $parent[ItemsControl].((vm:MapInspectorViewModel)DataContext).RunNpcActionCommand}" CommandParameter="{Binding}">
 <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <TextBlock IsVisible="{Binding ShowNoActions}" Text="{DynamicResource L.MapInsp.NoNpcActions}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock IsVisible="{Binding ShowGameDataMissing}" Text="{DynamicResource L.MapInsp.GameDataMissing}" TextWrapping="Wrap" FontSize="11" Foreground="#E0A040" />
 <TextBlock Text="{Binding PhaseText}" IsVisible="{Binding HasPhase}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource AccentBrightBrush}" />
 <Border IsVisible="{Binding HasDialog}" Background="{StaticResource Surface1Brush}" CornerRadius="8" Padding="8">
 <StackPanel Spacing="6">
 <TextBlock Text="{Binding DialogQuestion}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
 <ItemsControl ItemsSource="{Binding DialogReplies}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:DialogReplyOption">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,3"
 Command="{Binding $parent[ItemsControl].((vm:MapInspectorViewModel)DataContext).ReplyCommand}" CommandParameter="{Binding}">
 <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" />
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <Button Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding LeaveDialogCommand}"><TextBlock Text="{DynamicResource L.MapInsp.CloseDialog}" HorizontalAlignment="Center" /></Button>
 </StackPanel>
 </Border>
 <StackPanel Spacing="2" IsVisible="{Binding HasDialogHistory}">
 <TextBlock Text="{DynamicResource L.MapInsp.History}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 <ItemsControl ItemsSource="{Binding DialogHistory}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="svc:DialogEntry">
 <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </StackPanel>

 <!-- PERSONNAGE : contrôlé vs autre joueur ; onglets Général / Informations (Équipement absent : aucune donnée) -->
 <StackPanel Spacing="6" IsVisible="{Binding IsCharacterSelected}">
 <TextBlock Text="{Binding CharacterRole}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" />
 <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
 <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding SelectInfoTabCommand}" CommandParameter="0"><TextBlock Text="{DynamicResource L.MapInsp.TabGeneral}" HorizontalAlignment="Center" /></Button>
 <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding SelectInfoTabCommand}" CommandParameter="1"><TextBlock Text="{DynamicResource L.MapInsp.TabInfo}" HorizontalAlignment="Center" /></Button>
 </Grid>
 <StackPanel IsVisible="{Binding IsGeneralTab}" Spacing="4">
 <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Surface1Brush}" HorizontalAlignment="Left">
 <PathIcon Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 0 0 12,12 M4,20 C4,16 8,14 12,14 C16,14 20,16 20,20 Z" Width="34" Height="34" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
 </Border>
 <TextBlock IsVisible="{Binding IsOtherPlayer}" Text="{DynamicResource L.MapInsp.OtherLimited}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{Binding NoSocialText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
 <Button IsVisible="{Binding CanTrade}" HorizontalAlignment="Stretch" Command="{Binding RequestTradeCommand}"><TextBlock Text="{DynamicResource L.MapInsp.Trade}" HorizontalAlignment="Center" /></Button>
 </StackPanel>
 <ItemsControl ItemsSource="{Binding CharacterInfo}" IsVisible="{Binding IsInfoTab}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:InspectorLine">
 <Grid ColumnDefinitions="92,*" Margin="0,1,0,0">
 <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 <Button HorizontalAlignment="Stretch" IsVisible="{Binding CanHarvestAll}" Command="{Binding HarvestAllCommand}">
 <TextBlock Text="{Binding HarvestAllText}" HorizontalAlignment="Center" />
 </Button>
 <!-- Action de la ressource : le VERBE du jeu (Faucher, Cueillir, Miner, Couper…) -->
 <Button HorizontalAlignment="Stretch" IsVisible="{Binding IsResourceSelected}" IsEnabled="{Binding ResourceHarvestable}" Command="{Binding UseResourceCommand}">
 <TextBlock Text="{Binding ResourceVerb}" HorizontalAlignment="Center" FontWeight="SemiBold" />
 </Button>
 <!-- FAVORI -->
 <Button Classes="ghost" HorizontalAlignment="Stretch" IsVisible="{Binding CanFavorite}" Command="{Binding ToggleFavoriteCommand}">
 <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"><TextBlock Text="★" IsVisible="{Binding IsFavorite}" /><TextBlock Text="☆" IsVisible="{Binding !IsFavorite}" /><TextBlock Text="{DynamicResource L.MapInsp.Favorite}" /></StackPanel>
 </Button>
 <!-- ATELIER : recettes directement dans la carte -->
 <StackPanel Spacing="6" IsVisible="{Binding IsCraftStation}">
 <TextBlock Text="{DynamicResource L.MapInsp.Workshop}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrightBrush}" />
 <Button Classes="ghost" HorizontalAlignment="Stretch" IsVisible="{Binding CraftNeedsJoin}" Command="{Binding JoinCommand}"><TextBlock Text="{DynamicResource L.MapInsp.CraftJoin}" HorizontalAlignment="Center" /></Button>
 <TextBox Text="{Binding CraftSearch}" Watermark="{DynamicResource L.MapInsp.CraftSearch}" MinHeight="28" />
 <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <ItemsControl ItemsSource="{Binding CraftRecipes}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:CraftRecipeRow">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,3" MinHeight="26"
 Command="{Binding $parent[ItemsControl].((vm:MapInspectorViewModel)DataContext).SelectRecipeCommand}" CommandParameter="{Binding}">
 <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="●" FontSize="9" Foreground="#5CD676" IsVisible="{Binding CanCraftNow}" VerticalAlignment="Center" /><TextBlock Text="{Binding Caption}" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 <StackPanel Spacing="6" IsVisible="{Binding HasCraftRecipe}">
 <TextBlock Text="{Binding SelectedRecipe.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
 <CheckBox IsChecked="{Binding ShowBaseIngredients}" FontSize="11.5" Content="{DynamicResource L.MapInsp.CraftBase}" />
 <ItemsControl ItemsSource="{Binding CraftLines}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:CraftLineRow">
 <Grid ColumnDefinitions="*,Auto,48" Margin="0,1,0,0" ColumnSpacing="6">
 <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
 <TextBlock Grid.Column="1" Text="{Binding NeedHave}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
 <TextBlock Grid.Column="2" Text="{Binding Delta}" FontSize="11.5" HorizontalAlignment="Right" Foreground="#E0605A" IsVisible="{Binding Missing}" />
 <TextBlock Grid.Column="2" Text="{Binding Delta}" FontSize="11.5" HorizontalAlignment="Right" Foreground="#5CD676" IsVisible="{Binding !Missing}" />
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
 <Button Grid.Column="0" Classes="ghost" Width="30" MinWidth="0" Command="{Binding CraftLessCommand}"><TextBlock Text="−" HorizontalAlignment="Center" /></Button>
 <TextBlock Grid.Column="1" Text="{Binding CraftCount, StringFormat='×{0}'}" HorizontalAlignment="Center" VerticalAlignment="Center" />
 <Button Grid.Column="2" Classes="ghost" Width="30" MinWidth="0" Command="{Binding CraftMoreCommand}"><TextBlock Text="+" HorizontalAlignment="Center" /></Button>
 <TextBlock Grid.Column="3" Text="{Binding CraftMax, StringFormat='max {0}'}" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
 </Grid>
 <Button Classes="ghost" HorizontalAlignment="Stretch" IsVisible="{Binding !CraftPending}" Command="{Binding BeginCraftCommand}"><TextBlock Text="{DynamicResource L.MapInsp.CraftBegin}" HorizontalAlignment="Center" /></Button>
 <Border IsVisible="{Binding CraftPending}" Background="{StaticResource Surface1Brush}" CornerRadius="8" Padding="8" BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="1">
 <StackPanel Spacing="8">
 <TextBlock Text="{Binding CraftPreview}" TextWrapping="Wrap" FontSize="11.5" />
 <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
 <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding CancelCraftCommand}"><TextBlock Text="{DynamicResource L.MapInsp.AttackCancel}" HorizontalAlignment="Center" /></Button>
 <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{Binding ConfirmCraftCommand}"><TextBlock Text="{DynamicResource L.MapInsp.CraftConfirm}" HorizontalAlignment="Center" /></Button>
 </Grid>
 </StackPanel>
 </Border>
 <TextBlock Text="{Binding CraftNotice}" IsVisible="{Binding CraftNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </StackPanel>
 <!-- Favoris de cette carte -->
 <StackPanel Spacing="3" IsVisible="{Binding HasFavoritesHere}">
 <TextBlock Text="{DynamicResource L.MapInsp.FavoritesHere}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 <ItemsControl ItemsSource="{Binding FavoritesHere}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="svc:MapFavorite">
 <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,3" MinHeight="26"
 Command="{Binding $parent[ItemsControl].((vm:MapInspectorViewModel)DataContext).GoFavoriteCommand}" CommandParameter="{Binding}">
 <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 <!-- ATTAQUER : l'unique action contre un groupe de monstres -->
 <Button HorizontalAlignment="Stretch" IsVisible="{Binding IsMonsterSelected}" Command="{Binding AttackNowCommand}">
 <TextBlock Text="{DynamicResource L.MapInsp.AttackVerb}" HorizontalAlignment="Center" FontWeight="SemiBold" />
 </Button>
 <TextBlock Text="{DynamicResource L.MapInsp.ReadOnly}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </Border>
 <TextBlock IsVisible="{Binding HasNoSelection}" Text="{DynamicResource L.MapInsp.Empty}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{Binding FreshnessText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>

 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />

 <!-- Survol EN HAUT: lisible sans défiler pendant qu'on survole la carte (la souris ne peut pas survoler ET
 faire défiler le panneau). Le reste (navigation, archimonstres, légende) vient dessous. -->
 <StackPanel Spacing="9">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.MapInfo}" />
 <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
 <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.Bots.MapNav.MapId}" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedBot.Row.MapId}" Cursor="Hand" PointerPressed="OnCopyText" ToolTip.Tip="Cliquer pour copier" Foreground="{StaticResource TextPrimaryBrush}" />
 <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.Bots.MapPos}" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBot.Row.MapCoords}" Cursor="Hand" PointerPressed="OnCopyText" ToolTip.Tip="Cliquer pour copier" Foreground="{DynamicResource AccentBrightBrush}" FontWeight="SemiBold" />
 <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L.Bots.MapCellLabel}" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding #Map.HoveredCell}" Cursor="Hand" PointerPressed="OnCopyText" ToolTip.Tip="Cliquer pour copier" Foreground="{StaticResource TextPrimaryBrush}" />
 </Grid>
 <Button Classes="ghost" HorizontalAlignment="Left" Height="28" Padding="10,0" Click="OnCopyMapInfo" ToolTip.Tip="Copie : id de carte | [x,y] | cellule survolée">
 <TextBlock Text="Copier carte · position · cellule" FontSize="11.5" />
 </Button>
 </StackPanel>

 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />

 <StackPanel Spacing="9">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.MapActor}" />
 <TextBlock Text="{Binding #Map.HoveredActors.Count, StringFormat='({0})'}" Classes="label" />
 </StackPanel>
 <!-- tous les acteurs de la cellule survolee; un groupe de monstres detaille ses monstres.
 Borne en hauteur (ScrollViewer): au-dela de quelques acteurs empiles, ca DEFILE au lieu
 d'agrandir la card (sinon la card grandit/retrecit en boucle = flicker au survol). -->
 <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <ItemsControl ItemsSource="{Binding #Map.HoveredActors}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="proto:MapActor">
 <StackPanel Spacing="2" Margin="0,0,0,7">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
 FontWeight="SemiBold" TextWrapping="Wrap" />
 <TextBlock Text="{Binding ActorId, StringFormat='({0})'}" FontSize="10.5"
 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 <!-- PNJ / indice de chasse: id de MODÈLE (celui de talkNpc / npc:npc), masqué si 0 (!! = entier -> booléen) -->
 <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding !!NpcId}" VerticalAlignment="Center">
 <TextBlock Text="{DynamicResource L.Bots.MapNpcTemplate}" FontSize="10.5"
 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 <TextBlock Text="{Binding NpcId}" FontSize="10.5"
 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 </StackPanel>
 </StackPanel>
 <ItemsControl ItemsSource="{Binding Monsters}" Margin="4,0,0,0">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="proto:MonsterEntry">
 <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3,0,0">
 <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4"
 Background="{StaticResource Surface2Brush}" Margin="0,0,8,0" VerticalAlignment="Center" ClipToBounds="True">
 <Image Source="{Binding GenericId, Converter={x:Static conv:MonsterIconConverter.Instance}}" Stretch="Uniform" />
 </Border>
 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
 <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding GenericId, StringFormat='({0})'}" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='x{0}'}"
 Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </StackPanel>

 <!-- Element interactif sur la cellule survolee: nom (retour a la ligne) + action + id -->
 <StackPanel Spacing="4"
 IsVisible="{Binding #Map.HoveredInteractive, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.MapNav.InteractiveShort}" />
 <!-- DockPanel: le losange reste a gauche, le texte remplit la largeur restante -> le nom PEUT s'enrouler. -->
 <DockPanel LastChildFill="True">
 <Path Data="M5,0 L10,5 L5,10 L0,5 Z" Width="10" Height="10" Stretch="Uniform"
 DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,4,6,0" Fill="#5CD676" />
 <StackPanel Spacing="1">
 <TextBlock Text="{Binding #Map.HoveredInteractive.Name}" Foreground="{StaticResource TextPrimaryBrush}"
 FontWeight="SemiBold" TextWrapping="Wrap" />
 <TextBlock Text="{Binding #Map.HoveredInteractive.ElementId, StringFormat='id {0}'}"
 FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </DockPanel>
 </StackPanel>

 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />

 <StackPanel Spacing="8">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.MapNav.ChangeMap}" />
 <TextBlock Text="Flèches autour de la carte · 2ᵉ clic sur la même flèche = annuler" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
 <CheckBox IsChecked="{Binding ShowTransitions}" FontSize="12"
 Content="{DynamicResource L.Bots.MapNav.ShowTransitions}" />
 <CheckBox IsChecked="{Binding ShowCellIds}" FontSize="12"
 Content="{DynamicResource L.Bots.MapNav.ShowCellIds}" />
 <CheckBox IsChecked="{Binding ShowGameImage}" FontSize="12" Content="Image du jeu en fond (DofusDB)" />
 <Expander Header="Calage de l'image" FontSize="12" IsVisible="{Binding ShowGameImage}" Padding="0">
 <StackPanel Spacing="2" Margin="0,6,0,0">
 <TextBlock Text="{Binding ImgOffX, StringFormat='Décalage X : {0:0}'}" FontSize="11" />
 <Slider Minimum="0" Maximum="700" Value="{Binding ImgOffX}" />
 <TextBlock Text="{Binding ImgOffY, StringFormat='Décalage Y : {0:0}'}" FontSize="11" />
 <Slider Minimum="-200" Maximum="500" Value="{Binding ImgOffY}" />
 <TextBlock Text="{Binding ImgScale, StringFormat='Zoom : {0:0.00}'}" FontSize="11" />
 <Slider Minimum="0.6" Maximum="1.6" Value="{Binding ImgScale}" />
 <TextBlock Text="{Binding ImgCellOpacity, StringFormat='Opacité des cases : {0:0.00}'}" FontSize="11" />
 <Slider Minimum="0" Maximum="1" Value="{Binding ImgCellOpacity}" />
 </StackPanel>
 </Expander>
 </StackPanel>

 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />

 <!-- Journal GLOBAL des archimonstres repérés (tous bots) -->
 <StackPanel Spacing="8">
 <TextBlock Classes="label" Text="{DynamicResource L.Arch.Title}" />
 <TextBlock Text="{DynamicResource L.Arch.Empty}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
 TextWrapping="Wrap" IsVisible="{Binding !HasArchSightings}" />
 <!-- Bornée: une longue liste ne repousse plus « Informations / Acteur survolé » hors de vue. -->
 <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <ItemsControl ItemsSource="{Binding ArchSightings}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="svc:ArchSightingRow">
 <Border CornerRadius="8" Padding="9,6" Margin="0,0,0,5"
 Background="{StaticResource Surface1Brush}" BorderBrush="#4DE24BC8" BorderThickness="1">
 <StackPanel Spacing="2">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <Ellipse Width="8" Height="8" Fill="#E24BC8" VerticalAlignment="Center" />
 <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#EAC3E4" TextTrimming="CharacterEllipsis" />
 </StackPanel>
 <TextBlock Text="{Binding Context}" Classes="pii" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
 <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </StackPanel>

 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />

 <StackPanel Spacing="9">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.MapLegend}" />
 <WrapPanel>
 <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,7">
 <Ellipse Width="10" Height="10" Fill="#E8A63C" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.MapSelf}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,7">
 <Ellipse Width="10" Height="10" Fill="#8076D0" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.MapPlayers}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,7">
 <Ellipse Width="10" Height="10" Fill="#C85450" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.MapMonsters}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,7">
 <Ellipse Width="10" Height="10" Fill="#5FC8C8" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.MapNpc}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,7">
 <Path Data="M5,0 L10,5 L5,10 L0,5 Z" Fill="#5CD676" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.MapNav.Interactive}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,7">
 <Ellipse Width="10" Height="10" Fill="#E24BC8" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Arch.Legend}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
 </StackPanel>
 </WrapPanel>
 </StackPanel>
 </StackPanel>
 </ScrollViewer>
 </Grid>
 </TabItem>

 <!-- Onglet Inventaire: objets du sac (icones = assets du jeu par gid, quantite, gid) -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon inventory}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabInventory}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
 <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,10,0,0">
 <!-- Personnage : rendu de l'apparence (se met à jour quand l'équipement ou le skin change) -->
 <Border Grid.Column="0" Width="210" CornerRadius="12" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Padding="10" VerticalAlignment="Top">
 <StackPanel Spacing="6">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <Image Source="{svc:GameIcon character}" Width="14" Height="14" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.Row.CharacterName}" Classes="pii" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding SelectedBot.Row.Level, StringFormat='Niveau {0}'}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
 <Image x:Name="SelfLookImage" Height="270" Stretch="Uniform" />
 <!-- Le rendu d'Ankama ne dessine que la MONTURE quand le perso est monté : sans cette bascule on ne voyait plus le
      personnage. Masquée tant que le perso n'est pas monté (piloté par SyncSelfLookAsync). -->
 <Button x:Name="LookViewToggle" Classes="ghost" Height="26" Padding="8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
 IsVisible="False" Click="OnToggleLookView"
 ToolTip.Tip="Bascule entre la monture et le personnage (icône de classe si le cavalier ne peut pas être rendu)."
 AutomationProperties.Name="Basculer entre la vue monture et la vue personnage">
 <TextBlock x:Name="LookViewToggleText" Text="Voir le personnage" FontSize="11" VerticalAlignment="Center" />
 </Button>
 <TextBlock x:Name="SelfLookStatus" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Text="Apparence : en attente d'un paquet de look (reconnecte le perso ou change un équipement)." />
 <TextBlock Text="{Binding SelectedBot.Row.Status}" FontSize="11.5" Foreground="{DynamicResource AccentBrightBrush}" TextWrapping="Wrap" />
 <Expander x:Name="EquipmentStatsExpander" Header="Stats de l'équipement" FontSize="11.5" Padding="0">
 <ScrollViewer MaxHeight="{StaticResource DetailViewportHeight}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
 <TextBlock x:Name="EquipStats" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
 </ScrollViewer>
 </Expander>
 <Button Classes="ghost" Height="26" Padding="8,0" Click="OnCopyLook" ToolTip.Tip="Copie la chaîne de look (apparence)"
 AutomationProperties.Name="Copier la chaîne de look"><TextBlock Text="Copier le look" FontSize="11" /></Button>
 </StackPanel>
 </Border>
 <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
 <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,10">
 <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,8" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="18" Height="18" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.KamasText}" Foreground="#F2C14E" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </Border>
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,8" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
 <TextBlock Text="{DynamicResource L.Bots.Items}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.InventoryCount}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </Border>
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,8" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
 IsVisible="{Binding SelectedBot.Pods, Converter={x:Static acv:StringConverters.IsNotNullOrEmpty}}">
 <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
 <Image Source="{svc:GameIcon tx_pods}" Width="16" Height="16" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.Pods}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </Border>
 </StackPanel>
 <TextBox Grid.Column="2" Width="200" Height="32" Margin="8,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
 Text="{Binding SelectedBot.InventoryFilter}" Watermark="{DynamicResource L.Bots.Search}" />
 <ComboBox Grid.Column="3" MinWidth="150" Height="32" Margin="0,0,8,0" VerticalAlignment="Center" ItemsSource="{Binding SelectedBot.InventoryCategories}"
 SelectedItem="{Binding SelectedBot.InventoryCategory}" IsVisible="{Binding SelectedBot.HasInventory}"
 AutomationProperties.Name="Catégories d'inventaire"
 AutomationProperties.AutomationId="CmbInventoryCategories" />
 <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
 <ComboBox MinWidth="150" Height="32" VerticalAlignment="Center" ItemsSource="{Binding ItemSortModes}"
 SelectedIndex="{Binding SelectedBot.InventorySortIndex}"
 AutomationProperties.Name="Mode de tri de l'inventaire"
 AutomationProperties.AutomationId="CmbInventorySortModes" />
 <Button Classes="ghost" Height="32" Padding="10,0" Command="{Binding SelectedBot.OpenAllBagsCommand}"
 AutomationProperties.AutomationId="BtnOpenAllBags"
 ToolTip.Tip="Ouvrir tous les sacs de ressources (openBags)"
 AutomationProperties.Name="Ouvrir tous les sacs de ressources"
 IsVisible="{Binding SelectedBot.HasInventory}">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <TextBlock Text="📦" FontSize="13" VerticalAlignment="Center" />
 <TextBlock Text="Ouvrir les sacs" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <Button Classes="ghost" Height="32" Padding="10,0" Command="{Binding SelectedBot.ToggleInventoryGridCommand}" ToolTip.Tip="{DynamicResource L.Iw.ViewToggleTip}"
 AutomationProperties.Name="Basculer l'affichage du sac entre grille et liste"
 AutomationProperties.AutomationId="BtnToggleGridViewInv"
 IsVisible="{Binding SelectedBot, Converter={x:Static acv:ObjectConverters.IsNotNull}}">
 <Panel>
 <TextBlock Text="☰" FontSize="14" IsVisible="{Binding SelectedBot.InventoryGrid, FallbackValue=False}" />
 <TextBlock Text="▦" FontSize="14" IsVisible="{Binding SelectedBot.InventoryCards, FallbackValue=False}" />
 </Panel>
 </Button>
 </StackPanel>
 </Grid>
 <!-- Barre d'actions d'inventaire : statut de l'action et confirmation de destruction -->
 <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,10" IsVisible="{Binding SelectedBot.HasInventory}">
 <TextBlock IsVisible="{Binding SelectedBot.HasItemStatus}" Text="{Binding SelectedBot.ItemStatus}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
 <Border IsVisible="{Binding SelectedBot.HasPendingDestroy}" Background="#3A1414" BorderBrush="#E05050" BorderThickness="1" CornerRadius="8" Padding="10,8" HorizontalAlignment="Left">
 <StackPanel Orientation="Horizontal" Spacing="10">
 <TextBlock Text="{Binding SelectedBot.PendingDestroyText}" VerticalAlignment="Center" Foreground="#F5B0B0" />
 <Button Command="{Binding SelectedBot.ConfirmDestroyCommand}"><TextBlock Text="{DynamicResource L.Inv.DestroyConfirm}" /></Button>
 <Button Classes="ghost" Command="{Binding SelectedBot.CancelDestroyCommand}"><TextBlock Text="{DynamicResource L.MapInsp.AttackCancel}" /></Button>
 </StackPanel>
 </Border>
 </StackPanel>
 <StackPanel Grid.Row="2" IsVisible="{Binding !SelectedBot.HasInventory}" HorizontalAlignment="Center" Spacing="10" Margin="0,40,0,0">
 <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
 <TextBlock Text="{DynamicResource L.Bots.Waiting}" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
 <TextBlock Text="{DynamicResource L.Bots.Inventory.Empty}" HorizontalAlignment="Center" Classes="caption"
 TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" />
 </StackPanel>
 <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="12">
 <!-- Équipement porté : clic droit sur un emplacement occupé = Déséquiper -->
 <Border Grid.Column="0" Width="250" VerticalAlignment="Top" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" IsVisible="{Binding SelectedBot.HasInventory}">
 <StackPanel Spacing="8">
 <TextBlock Text="{DynamicResource L.Inv.Equipment}" FontSize="12.5" FontWeight="SemiBold" />
 <Grid ColumnDefinitions="Auto,*,Auto">
 <ItemsControl Grid.Column="0" ItemsSource="{Binding SelectedBot.EquipLeft}" ItemTemplate="{StaticResource EquipSlotTemplate}" />
 <TextBlock Grid.Column="1" Text="{Binding SelectedBot.Row.CharacterName}" HorizontalAlignment="Center" VerticalAlignment="Center"
 FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
 <ItemsControl Grid.Column="2" ItemsSource="{Binding SelectedBot.EquipRight}" ItemTemplate="{StaticResource EquipSlotTemplate}" />
 </Grid>
 <ItemsControl ItemsSource="{Binding SelectedBot.EquipDofus}" ItemTemplate="{StaticResource EquipSlotTemplate}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 </ItemsControl>
 <ItemsControl ItemsSource="{Binding SelectedBot.EquipOther}" ItemTemplate="{StaticResource EquipSlotTemplate}" IsVisible="{Binding SelectedBot.HasEquipOther}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 </ItemsControl>
 <TextBlock Text="{DynamicResource L.Inv.EquipHint}" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
 <!-- Sélecteur « Équiper » : objets du sac compatibles avec l'emplacement cliqué ; un clic équipe à CET emplacement -->
 <Border IsVisible="{Binding SelectedBot.SlotPickerVisible, FallbackValue=False}" Background="{StaticResource Surface1Brush}" CornerRadius="8" Padding="8"
 BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="1">
 <StackPanel Spacing="6">
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock Text="{Binding SelectedBot.SlotPickerTitle}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
 <Button Grid.Column="1" Classes="ghost" Width="28" Height="28" MinWidth="0" Padding="0"
 Command="{Binding SelectedBot.CloseSlotPickerCommand}" ToolTip.Tip="Fermer le sélecteur d'équipement"
 AutomationProperties.Name="Fermer le sélecteur d'équipement"><TextBlock Text="✕" FontSize="11" /></Button>
 </Grid>
 <TextBlock Text="{DynamicResource L.Inv.PickerEmpty}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
 IsVisible="{Binding SelectedBot.SlotPickerEmpty, FallbackValue=False}" />
 <ItemsControl ItemsSource="{Binding SelectedBot.SlotPickerItems}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:InventoryItemRow">
 <Button Classes="ghost" Width="44" Height="44" MinWidth="0" Padding="0" Margin="0,0,4,4"
 Command="{Binding Owner.PickForSlotCommand}" CommandParameter="{Binding}" Background="{StaticResource Surface2Brush}" CornerRadius="7"
 AutomationProperties.Name="{Binding Name}">
 <ToolTip.Tip><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemTipTemplate}" /></ToolTip.Tip>
 <Panel>
 <Image Source="{Binding Icon}" Width="32" Height="32" IsVisible="{Binding HasIcon}" />
 <Border Width="28" Height="28" CornerRadius="5" IsVisible="{Binding !HasIcon}" Background="{StaticResource StrokeSoftBrush}" />
 </Panel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </Border>
 <!-- Panoplies : enregistrer l'équipement porté, le remettre en un clic -->
 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />
 <TextBlock Text="{DynamicResource L.Gear.Title}" FontSize="12.5" FontWeight="SemiBold" />
 <StackPanel Spacing="6" IsVisible="{Binding SelectedBot.HasGearSets}">
 <ComboBox ItemsSource="{Binding SelectedBot.GearSetNames}" SelectedItem="{Binding SelectedBot.SelectedGearSet}"
 HorizontalAlignment="Stretch" AutomationProperties.Name="Choisir la panoplie à comparer ou équiper" />
 <Button Classes="ghost" Command="{Binding SelectedBot.PreviewGearSetCommand}"
 AutomationProperties.Name="Comparer la panoplie sélectionnée avec les objets portés">
 <TextBlock Text="Prévisualiser les changements" FontSize="11.5" />
 </Button>
 <TextBlock Text="{Binding SelectedBot.GearPreviewText}" FontSize="11"
 TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
 <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding SelectedBot.EquipGearSetCommand}"
 AutomationProperties.Name="Équiper la panoplie sélectionnée" IsEnabled="{Binding !SelectedBot.GearBusy}">
 <TextBlock Text="{DynamicResource L.Gear.Equip}" HorizontalAlignment="Center" FontSize="11.5" />
 </Button>
 <Button Grid.Column="1" Classes="ghost" Command="{Binding SelectedBot.DeleteGearSetCommand}"
 AutomationProperties.Name="Supprimer la panoplie enregistrée sélectionnée"
 ToolTip.Tip="{DynamicResource L.Gear.Delete}"><TextBlock Text="✕" FontSize="11" /></Button>
 </Grid>
 </StackPanel>
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
 <TextBox Text="{Binding SelectedBot.NewGearSetName}" Watermark="{DynamicResource L.Gear.NameWatermark}"
 AutomationProperties.Name="Nom de la nouvelle panoplie" Height="30" VerticalContentAlignment="Center" FontSize="11.5" />
 <Button Grid.Column="1" Command="{Binding SelectedBot.SaveGearSetCommand}"
 AutomationProperties.Name="Enregistrer la panoplie actuellement équipée"
 ToolTip.Tip="{DynamicResource L.Gear.SaveTip}"><TextBlock Text="{DynamicResource L.Gear.Save}" FontSize="11.5" /></Button>
 </Grid>
 </StackPanel>
 </Border>
 <Grid Grid.Column="1" RowDefinitions="Auto,*">
 <!-- Détails de l'objet cliqué dans la grille : icône, nom, niveau · catégorie, effets (malus en rouge), actions rapides -->
 <Border Grid.Row="0" IsVisible="{Binding SelectedBot.HasDetailItem, FallbackValue=False}" Margin="0,0,0,10" Padding="12,10"
 Background="{StaticResource Surface2Brush}" CornerRadius="10" BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="1">
 <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
 <Panel Width="52" Height="52" VerticalAlignment="Top">
 <Image Source="{Binding SelectedBot.DetailItem.Icon}" Width="48" Height="48" />
 </Panel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Text="{Binding SelectedBot.DetailItem.Name, FallbackValue=''}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
 <TextBlock Text="{Binding SelectedBot.DetailItem.InfoLine, FallbackValue=''}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
 <ctl:ItemAveragePrice Gid="{Binding SelectedBot.DetailItem.Gid, FallbackValue=0}" Pid="{Binding SelectedBot.DetailItem.TooltipPid, FallbackValue=0}"
 FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
 <TextBlock Text="{DynamicResource L.Inv.WornTip}" FontSize="11" Foreground="#63D3A6" IsVisible="{Binding SelectedBot.DetailItem.IsEquipped, FallbackValue=False}" />
 <TextBlock Text="{DynamicResource L.Inv.NoEffects}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
 IsVisible="{Binding !SelectedBot.DetailItem.HasEffects, FallbackValue=False}" />
 <ItemsControl ItemsSource="{Binding SelectedBot.DetailItem.EffectLines}" Margin="0,4,0,0">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Vertical" MaxHeight="190" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:ItemEffectLine">
 <TextBlock Text="{Binding Text}" FontSize="12" Margin="0,0,24,2" Classes.fxneg="{Binding Negative}" />
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top">
 <Button Classes="ghost" HorizontalAlignment="Right" Width="24" Height="24" MinWidth="0" Padding="0" Command="{Binding SelectedBot.CloseItemDetailsCommand}"><TextBlock Text="✕" FontSize="11" /></Button>
 <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding SelectedBot.EquipItemCommand}" CommandParameter="{Binding SelectedBot.DetailItem}"
 IsVisible="{Binding SelectedBot.DetailItem.ShowEquip, FallbackValue=False}"><TextBlock Text="{DynamicResource L.Inv.Equip}" FontSize="11.5" HorizontalAlignment="Center" /></Button>
 <Button HorizontalAlignment="Stretch" Command="{Binding SelectedBot.EquipItemCommand}" CommandParameter="{Binding SelectedBot.DetailItem}"
 IsVisible="{Binding SelectedBot.DetailItem.IsEquipped, FallbackValue=False}"><TextBlock Text="{DynamicResource L.Inv.Unequip}" FontSize="11.5" HorizontalAlignment="Center" /></Button>
 <Button HorizontalAlignment="Stretch" Command="{Binding SelectedBot.UseItemCommand}" CommandParameter="{Binding SelectedBot.DetailItem}"
 IsVisible="{Binding SelectedBot.DetailItem.ShowUse, FallbackValue=False}"><TextBlock Text="{DynamicResource L.Inv.Use}" FontSize="11.5" HorizontalAlignment="Center" /></Button>
 </StackPanel>
 </Grid>
 </Border>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding SelectedBot.InventoryCards, FallbackValue=False}">
 <ItemsControl ItemsSource="{Binding SelectedBot.InventoryItems}">
 <ItemsControl.ItemsPanel>
 <ItemsPanelTemplate>
 <WrapPanel Orientation="Horizontal" />
 </ItemsPanelTemplate>
 </ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:InventoryItemRow">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10,8" Margin="0,0,8,8"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Width="168">
 <ToolTip.Tip><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemTipTemplate}" /></ToolTip.Tip>
 <Border.ContextMenu>
 <ContextMenu>
 <MenuItem Header="{DynamicResource L.Inv.Use}" Command="{Binding Owner.UseItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding ShowUse}" />
 <MenuItem Header="{DynamicResource L.Inv.Equip}" Command="{Binding Owner.EquipItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding ShowEquip}" />
 <MenuItem Header="{DynamicResource L.Inv.Unequip}" Command="{Binding Owner.EquipItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsEquipped}" />
 <MenuItem Header="{DynamicResource L.Iw.Deposit}" Command="{Binding Owner.DepositItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding Owner.CtxBankOpen, FallbackValue=False}" />
 <MenuItem Header="{DynamicResource L.Inv.ToTrade}" Command="{Binding Owner.TradeItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding Owner.CtxTradeOpen, FallbackValue=False}" />
 <MenuItem Header="{DynamicResource L.Iw.Sell}" Command="{Binding Owner.SellItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding Owner.CtxShopOpen, FallbackValue=False}" />
 <Separator />
 <MenuItem Header="{DynamicResource L.Mule.KeepMenu}" Command="{Binding Owner.ToggleMuleKeepCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsEquipped}" />
 <MenuItem Header="{DynamicResource L.Inv.Drop}" Command="{Binding Owner.DropItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsEquipped}" />
 <MenuItem Header="{DynamicResource L.Inv.DestroyMenu}" Command="{Binding Owner.AskDestroyCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsEquipped}" />
 </ContextMenu>
 </Border.ContextMenu>
 <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
 <Image Source="{Binding Icon}" Width="34" Height="34" IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
 <Border Width="34" Height="34" CornerRadius="7" IsVisible="{Binding !HasIcon}" Background="{StaticResource StrokeSoftBrush}" />
 <StackPanel VerticalAlignment="Center" Spacing="2">
 <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="106" />
 <StackPanel Orientation="Horizontal" Spacing="7">
 <TextBlock Text="{Binding QtyText}" Foreground="#63D3A6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
 <TextBlock Text="{Binding GidText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
 <TextBlock Text="🔒" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding IsKept}" ToolTip.Tip="{DynamicResource L.Mule.KeptTip}" />
 </StackPanel>
 </StackPanel>
 </StackPanel>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 <!-- Grille d'icônes (comme le jeu) : quantité en haut à gauche, info-bulle, clic droit = mêmes actions que les cartes -->
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding SelectedBot.InventoryGrid, FallbackValue=False}">
 <ItemsControl ItemsSource="{Binding SelectedBot.InventoryItems}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:InventoryItemRow">
 <Button Classes="ghost" Width="52" Height="52" MinWidth="0" Padding="0" Margin="0,0,5,5"
 Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="8"
 Command="{Binding Owner.ShowItemDetailsCommand}" CommandParameter="{Binding}">
 <ToolTip.Tip><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemTipTemplate}" /></ToolTip.Tip>
 <Button.ContextMenu>
 <ContextMenu>
 <MenuItem Header="{DynamicResource L.Inv.Use}" Command="{Binding Owner.UseItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding ShowUse}" />
 <MenuItem Header="{DynamicResource L.Inv.Equip}" Command="{Binding Owner.EquipItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding ShowEquip}" />
 <MenuItem Header="{DynamicResource L.Inv.Unequip}" Command="{Binding Owner.EquipItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsEquipped}" />
 <MenuItem Header="{DynamicResource L.Iw.Deposit}" Command="{Binding Owner.DepositItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding Owner.CtxBankOpen, FallbackValue=False}" />
 <MenuItem Header="{DynamicResource L.Inv.ToTrade}" Command="{Binding Owner.TradeItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding Owner.CtxTradeOpen, FallbackValue=False}" />
 <MenuItem Header="{DynamicResource L.Iw.Sell}" Command="{Binding Owner.SellItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding Owner.CtxShopOpen, FallbackValue=False}" />
 <Separator />
 <MenuItem Header="{DynamicResource L.Mule.KeepMenu}" Command="{Binding Owner.ToggleMuleKeepCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsEquipped}" />
 <MenuItem Header="{DynamicResource L.Inv.Drop}" Command="{Binding Owner.DropItemCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsEquipped}" />
 <MenuItem Header="{DynamicResource L.Inv.DestroyMenu}" Command="{Binding Owner.AskDestroyCommand}" CommandParameter="{Binding}" IsVisible="{Binding !IsEquipped}" />
 </ContextMenu>
 </Button.ContextMenu>
 <Panel>
 <Image Source="{Binding Icon}" Width="38" Height="38" IsVisible="{Binding HasIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
 <Border Width="34" Height="34" CornerRadius="6" IsVisible="{Binding !HasIcon}" Background="{StaticResource StrokeSoftBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
 <Border IsVisible="{Binding HasQtyBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" Padding="3,0" CornerRadius="4" Background="#B0101318">
 <TextBlock Text="{Binding QtyBadge}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
 </Border>
 <TextBlock Text="🔒" FontSize="9" IsVisible="{Binding IsKept}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2" />
 <Border IsVisible="{Binding IsEquipped}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2" Width="7" Height="7" CornerRadius="4" Background="#63D3A6" />
 </Panel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </Grid>
 </Grid>
 </Grid>
 </Grid>
 </ScrollViewer>
 </TabItem>

 <!-- Onglet Banque: contenu du coffre (reçu à l'ouverture) + type de dépôt systématique -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon bank}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabBank}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,10,0,0">
 <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,10">
 <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,8" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="18" Height="18" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.BankKamasText}" Foreground="#F2C14E" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </Border>
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,8" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
 <TextBlock Text="{DynamicResource L.Bots.Items}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.BankCount}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </Border>
 </StackPanel>
 <TextBox Grid.Column="2" Width="200" Height="32" Margin="8,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
 Text="{Binding SelectedBot.BankFilter}" Watermark="{DynamicResource L.Bots.Search}" />
 <ComboBox Grid.Column="3" MinWidth="150" Height="32" Margin="0,0,8,0" VerticalAlignment="Center" ItemsSource="{Binding SelectedBot.BankCategories}"
 SelectedItem="{Binding SelectedBot.BankCategory}" IsVisible="{Binding SelectedBot.HasBank}"
 AutomationProperties.Name="Catégories de banque"
 AutomationProperties.AutomationId="CmbBankCategories" />
 <ComboBox Grid.Column="4" MinWidth="150" Height="32" VerticalAlignment="Center" ItemsSource="{Binding ItemSortModes}"
 SelectedIndex="{Binding SelectedBot.BankSortIndex}"
 AutomationProperties.Name="Tri des objets en banque"
 AutomationProperties.AutomationId="CmbBankSortModes" />
 </Grid>
 <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
 HorizontalAlignment="Left" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
 <TextBlock Text="{DynamicResource L.Bots.Bank.DepositType}" Classes="caption" VerticalAlignment="Center" />
 <ComboBox ItemsSource="{Binding BankDepositModes}" SelectedIndex="{Binding BankDepositIndex}" MinWidth="230"
           AutomationProperties.Name="Mode de dépôt en banque"
           AutomationProperties.AutomationId="CmbBankDepositModes" />
 <Button Command="{Binding SelectedBot.Interaction.OpenBankCommand}" ToolTip.Tip="{DynamicResource L.Iw.OpenBankTip}"
         AutomationProperties.Name="Ouvrir la Banque"
         AutomationProperties.AutomationId="BtnOpenBank"
 IsVisible="{Binding SelectedBot, Converter={x:Static acv:ObjectConverters.IsNotNull}}"><TextBlock Text="{DynamicResource L.Iw.OpenBank}" /></Button>
 <TextBlock Text="{Binding SelectedBot.Interaction.Status}" Classes="caption" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
 </StackPanel>
 </Border>
 <StackPanel Grid.Row="2" IsVisible="{Binding !SelectedBot.HasBank}" HorizontalAlignment="Center" Spacing="10" Margin="0,40,0,0">
 <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
 <TextBlock Text="{DynamicResource L.Bots.Waiting}" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
 <TextBlock Text="{DynamicResource L.Bots.Bank.Empty}" HorizontalAlignment="Center" Classes="caption"
 TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" />
 </StackPanel>
 <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
 <ItemsControl ItemsSource="{Binding SelectedBot.BankItems}">
 <ItemsControl.ItemsPanel>
 <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
 </ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:InventoryItemRow">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="10,8" Margin="0,0,8,8"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Width="168">
 <ToolTip.Tip><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemTipTemplate}" /></ToolTip.Tip>
 <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
 <Image Source="{Binding Icon}" Width="34" Height="34" IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
 <Border Width="34" Height="34" CornerRadius="7" IsVisible="{Binding !HasIcon}" Background="{StaticResource StrokeSoftBrush}" />
 <StackPanel VerticalAlignment="Center" Spacing="2">
 <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="106" />
 <StackPanel Orientation="Horizontal" Spacing="7">
 <TextBlock Text="{Binding QtyText}" Foreground="#63D3A6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
 <TextBlock Text="{Binding GidText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
 </StackPanel>
 </StackPanel>
 </StackPanel>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </Grid>
 </TabItem>

 <!-- Onglet HDV: module Hôtel de Vente interactif (par perso), 2 colonnes. GAUCHE = mes lots (prix marché MIN
 vs mon prix, état, sous-cote align-or-undercut); DROITE = HDV cible + auto-reprice + taxes + mise en vente. -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon auctionHouseResources}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabHdv}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">
 <Border Grid.Row="0" Classes="notice" IsVisible="{Binding !Hdv.CanHdv}">
 <Grid ColumnDefinitions="Auto,*">
 <PathIcon Grid.Column="0" Data="{StaticResource IconLock}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.NoLicense}" />
 </Grid>
 </Border>

 <!-- sous-onglets: HDV / Achat / Rentabilité / Statistiques / Réglages (patron bouton-accent, comme le sélecteur de période Stats) -->
 <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" IsVisible="{Binding Hdv.CanHdv}">
 <Button Classes="ghost" Classes.accent="{Binding Hdv.ShowMain}" Height="32" MinWidth="0" Padding="14,0" Command="{Binding Hdv.ShowMainViewCommand}">
 <StackPanel Orientation="Horizontal" Spacing="6"><Image Source="{svc:GameIcon auctionHouseResources}" Width="14" Height="14" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource L.Bots.Hdv.ViewMain}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 <Button Classes="ghost" Classes.accent="{Binding Hdv.ShowBuy}" Height="32" MinWidth="0" Padding="14,0" Command="{Binding Hdv.ShowBuyViewCommand}">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconCart}" Width="13" Height="13" /><TextBlock Text="{DynamicResource L.Bots.Hdv.ViewBuy}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 <Button Classes="ghost" Classes.accent="{Binding Hdv.ShowScan}" Height="32" MinWidth="0" Padding="14,0" Command="{Binding Hdv.ShowScanViewCommand}">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13" /><TextBlock Text="{DynamicResource L.Bots.Hdv.ViewScan}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 <Button Classes="ghost" Classes.accent="{Binding Hdv.ShowStats}" Height="32" MinWidth="0" Padding="14,0" Command="{Binding Hdv.ShowStatsViewCommand}">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconChart}" Width="13" Height="13" /><TextBlock Text="{DynamicResource L.Bots.Hdv.ViewStats}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 <Button Classes="ghost" Classes.accent="{Binding Hdv.ShowSettings}" Height="32" MinWidth="0" Padding="14,0" Command="{Binding Hdv.ShowSettingsViewCommand}">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconSettings}" Width="13" Height="13" /><TextBlock Text="{DynamicResource L.Bots.Hdv.ViewSettings}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 </StackPanel>

 <!-- conteneur des sous-vues HDV / Statistiques: crossfade 220 ms comme les onglets principaux (MainWindow PageHost) -->
 <Grid Grid.Row="2" IsEnabled="{Binding Hdv.CanHdv}">
 <Grid.Styles>
 <Style Selector="Grid.subview, ScrollViewer.subview"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
 <Style Selector="Grid.subview.shown, ScrollViewer.subview.shown"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
 </Grid.Styles>
 <Grid ColumnDefinitions="8*,4*" ColumnSpacing="14" Classes="subview" Classes.shown="{Binding Hdv.ShowMain}">
 <Grid.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.22" /></Transitions></Grid.Transitions>
 <!-- même fond d'input que l'onglet Paramètres (Surface2) sur tous les champs du module -->
 <Grid.Styles>
 <Style Selector="ComboBox"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 <Style Selector="NumericUpDown"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 <Style Selector="TextBox"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 </Grid.Styles>

 <!-- ================= COLONNE GAUCHE: mes ventes ================= -->
 <Border Grid.Column="0" Classes="card" Padding="12" VerticalAlignment="Top">
 <!-- la card se DIMENSIONNE À SON CONTENU (Border VerticalAlignment=Top): la liste (row 3 = Auto) est plafonnée
 à ~16 lots (MaxHeight) puis scrolle, et le statut (row 4) vient JUSTE SOUS le dernier lot — plus de gros vide. -->
 <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
 <StackPanel Grid.Row="0" Spacing="8">
 <StackPanel Spacing="1">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.MyListings}" />
 <TextBlock Classes="caption" FontSize="11" Text="{Binding Hdv.ListingsSummaryText}" IsVisible="{Binding Hdv.HasListings}" />
 </StackPanel>
 <WrapPanel Orientation="Horizontal">
 <ProgressBar IsIndeterminate="True" IsVisible="{Binding Hdv.Busy}" Width="56" Height="3" Margin="0,14,10,0" VerticalAlignment="Center" />
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.UndercutBy}" VerticalAlignment="Center" Margin="0,0,6,8" ToolTip.Tip="{DynamicResource L.Bots.Hdv.UndercutByTip}" />
 <NumericUpDown Width="104" Margin="0,0,8,8" Value="{Binding Hdv.PriceStep}" Minimum="1" Maximum="1000000" Increment="1" FormatString="N0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.UndercutByTip}" />
 <Button Classes="ghost" Height="30" MinWidth="0" Padding="10,0" Margin="0,0,8,8" IsEnabled="{Binding Hdv.CanManual}" Command="{Binding Hdv.UndercutAllCommand}"
         AutomationProperties.Name="Aligner tous les prix HDV (-1 kama)"
         AutomationProperties.AutomationId="BtnUndercutAllHdv">
 <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource IconMinus}" Width="12" Height="12" /><TextBlock Text="{DynamicResource L.Bots.Hdv.UndercutAll}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 <Button Classes="ghost" Height="30" MinWidth="0" Padding="10,0" Margin="0,0,0,8" IsEnabled="{Binding Hdv.CanManual}" Command="{Binding Hdv.RefreshCommand}">
 <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource IconUpdate}" Width="12" Height="12" /><TextBlock Text="{DynamicResource L.Bots.Hdv.Refresh}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 </WrapPanel>
 <!-- recherche + tri sur mes lots (utile sur beaucoup de ventes) -->
 <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Hdv.HasListings}">
 <TextBox Grid.Column="0" Height="30" Text="{Binding Hdv.ListingsFilter}" Watermark="{DynamicResource L.Bots.Hdv.SearchListing}"
 AutomationProperties.Name="{DynamicResource L.Bots.Hdv.SearchListing}" />
 <ComboBox Grid.Column="1" MinWidth="160" Height="30" Margin="8,0,0,0" ItemsSource="{Binding Hdv.ListingSortModes}" SelectedIndex="{Binding Hdv.ListingsSortIndex}"
 AutomationProperties.Name="{DynamicResource L.Bots.Hdv.SortDefault}" />
 </Grid>
 </StackPanel>

 <!-- Bandeau: HDV vendeur non ouvert -->
 <Border Grid.Row="1" Classes="notice" Margin="0,10,0,0" IsVisible="{Binding !Hdv.IsHdvOpen}">
 <Grid ColumnDefinitions="Auto,*">
 <PathIcon Grid.Column="0" Data="{StaticResource IconInfo}" />
 <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.OpenSellerHint}" />
 </Grid>
 </Border>

 <!-- en-tête colonnes (même padding horizontal que les lignes) -->
 <Border Grid.Row="2" Padding="8,0" BorderThickness="1" BorderBrush="Transparent" Margin="0,10,0,4">
 <Grid ColumnDefinitions="30,34,*,64,104,158,132">
 <TextBlock Grid.Column="0" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColStatus}" HorizontalAlignment="Center" />
 <TextBlock Grid.Column="2" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColName}" />
 <TextBlock Grid.Column="3" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColLot}" />
 <TextBlock Grid.Column="4" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColMarket}" />
 <TextBlock Grid.Column="5" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColMyPrice}" />
 </Grid>
 </Border>

 <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="800" VerticalAlignment="Top">
 <StackPanel>
 <!-- HDV FERMÉ: attente (façon onglet Banque) — la liste est vidée côté VM. -->
 <StackPanel IsVisible="{Binding !Hdv.IsHdvOpen}" HorizontalAlignment="Center" Spacing="10" Margin="0,40,0,0">
 <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
 <TextBlock Text="{DynamicResource L.Bots.Waiting}" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
 <TextBlock Text="{DynamicResource L.Bots.Hdv.ClosedWait}" HorizontalAlignment="Center" Classes="caption"
 TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" />
 </StackPanel>
 <!-- HDV ouvert mais rien en vente -->
 <TextBlock IsVisible="{Binding Hdv.ShowEmptyListings}" Classes="caption" TextWrapping="Wrap"
 Text="{DynamicResource L.Bots.Hdv.NoListings}" Margin="8,14" />
 <!-- Lots en vente: ListBox VIRTUALISÉE (MaxHeight -> viewport borné): un reprice change l'uid -> RefreshListings
 rebuild toute la collection; sans virtualisation ~35 lignes (NumericUpDown + boutons) étaient re-réalisées à
 chaque reprice = le freeze. Classe `log` = chrome/sélection retirés. $parent[ItemsControl] résout toujours (ListBox EST un ItemsControl). -->
 <ListBox Classes="log" ItemsSource="{Binding Hdv.ListingsView}" MaxHeight="440"
 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
 ScrollViewer.VerticalScrollBarVisibility="Auto"
 AutomationProperties.Name="{DynamicResource L.Bots.Hdv.MyListings}">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvListingRow">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="8,6" Margin="0,0,0,6" Opacity="{Binding RowOpacity}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <ToolTip.Tip><ctl:ItemTooltip Gid="{Binding Gid}" Uid="{Binding Uid}" Pid="{Binding TooltipPid}" /></ToolTip.Tip>
 <Grid ColumnDefinitions="30,34,*,64,104,158,132" VerticalAlignment="Center">
 <!-- état: badge (masqué pendant le fetch) + spinner de chargement par-item -->
 <Panel Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
 <!-- états DU JEU (uielements): vert OK, jaune à-repricer, rouge erreur, gris inconnu -->
 <Panel IsVisible="{Binding !IsFetching}">
 <Image Source="{svc:GameIcon check_green}" Width="16" Height="16" IsVisible="{Binding IsStatusOk}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.StatusOk}" />
 <Image Source="{svc:GameIcon pin_mark_yellow}" Width="18" Height="18" IsVisible="{Binding IsStatusWarning}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.StatusWarn}" />
 <TextBlock Text="●" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" IsVisible="{Binding IsFloorLimited}" ToolTip.Tip="{Binding DecisionText}" />
 <Image Source="{svc:GameIcon pin_mark_red}" Width="18" Height="18" IsVisible="{Binding IsStatusError}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.StatusErr}" />
 <Image Source="{svc:GameIcon subhint_selected}" Width="16" Height="16" IsVisible="{Binding IsStatusUnknown}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.StatusUnknown}" />
 </Panel>
 <Ellipse Classes="spinner" Width="16" Height="16" StrokeThickness="2" IsVisible="{Binding IsFetching}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.Fetching}" />
 </Panel>
 <!-- icône -->
 <Panel Grid.Column="1" Width="30" Height="30">
 <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
 <Border IsVisible="{Binding !HasIcon}" CornerRadius="6" Background="{StaticResource StrokeSoftBrush}" />
 </Panel>
 <!-- nom + uid -->
 <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Spacing="1">
 <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding Uid, StringFormat='UID {0}'}" Classes="caption" FontSize="10" />
 <TextBlock Text="{Binding DecisionText}" Classes="caption" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DecisionText}" />
 </StackPanel>
 <!-- lot -->
 <Border Grid.Column="3" Background="{StaticResource Surface1Brush}" CornerRadius="8" Padding="9,2" VerticalAlignment="Center" HorizontalAlignment="Left">
 <TextBlock Text="{Binding LotText}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="12" />
 </Border>
 <!-- prix marché (logo Kamas AVANT le montant) -->
 <StackPanel Grid.Column="4" Spacing="1" VerticalAlignment="Center">
 <StackPanel Orientation="Horizontal" Spacing="4">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="13" Height="13" VerticalAlignment="Center" IsVisible="{Binding HasMarket}" />
 <TextBlock Text="{Binding MarketText}" Foreground="#F2C14E" VerticalAlignment="Center" />
 </StackPanel>
 <!-- Etat inconnu explicite, même sans survol de l'icône d'état. -->
 <TextBlock Text="{DynamicResource L.Bots.Hdv.StatusUnknown}" IsVisible="{Binding IsStatusUnknown}"
 FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
 <TextBlock Text="{DynamicResource L.Bots.Hdv.StatusErr}" IsVisible="{Binding IsStatusError}"
 FontSize="10.5" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
 </StackPanel>
 <!-- mon prix (large) -->
 <NumericUpDown Grid.Column="5" Width="150" HorizontalAlignment="Left" Value="{Binding Price}" Minimum="1" Maximum="1000000000" Increment="1" FormatString="N0" VerticalAlignment="Center" IsEnabled="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.CanManual}"
 AutomationProperties.Name="{DynamicResource L.Bots.Hdv.ColMyPrice}" />
 <!-- actions (icônes) -->
 <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
 <CheckBox IsChecked="{Binding Ignored}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.Ignore}" VerticalAlignment="Center" Margin="0,0,2,0"
 AutomationProperties.Name="{DynamicResource L.Bots.Hdv.Ignore}" />
 <Button Classes="ghost" Height="30" Width="32" MinWidth="0" Padding="0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.UndercutTip}"
 AutomationProperties.Name="{DynamicResource L.Bots.Hdv.UndercutTip}"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.UndercutListingCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.CanManual}">
 <PathIcon Data="{StaticResource IconMinus}" Width="13" Height="13" />
 </Button>
 <Button Classes="ghost" Height="30" Width="32" MinWidth="0" Padding="0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.RepriceBtn}"
 AutomationProperties.Name="{DynamicResource L.Bots.Hdv.RepriceBtn}"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.RepriceListingCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.CanManual}">
 <PathIcon Data="{StaticResource IconEdit}" Width="13" Height="13" />
 </Button>
 <Button Classes="ghost" Height="30" Width="32" MinWidth="0" Padding="0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.RemoveBtn}"
 AutomationProperties.Name="{DynamicResource L.Bots.Hdv.RemoveBtn}"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.RemoveListingCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.CanManual}">
 <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
 </Button>
 </StackPanel>
 </Grid>
 </Border>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </StackPanel>
 </ScrollViewer>

 <StackPanel Grid.Row="4" Spacing="6" Margin="8,8,0,0">
 <TextBlock Text="{Binding Hdv.StatusText}" Classes="caption" TextWrapping="Wrap" />
 <!-- Historique moyen communiqué via ObjectAveragePricesHistoryEvent. Requête UNIQUEMENT
      après clic explicite ; distincte du reprice et de la recherche de prix par lot. -->
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="9" Padding="10"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Margin="0,7,0,4">
 <StackPanel Spacing="8">
 <TextBlock Text="Historique des prix serveur" FontWeight="SemiBold"
 Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
 <TextBlock Text="Choisir un lot actuellement visible dans « Mes ventes », puis lire manuellement les prix moyens."
 Classes="caption" TextWrapping="Wrap" FontSize="11" />
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
 <ComboBox Grid.Column="0" ItemsSource="{Binding Hdv.ListingsView}"
 SelectedItem="{Binding Hdv.PriceHistorySelection, Mode=TwoWay}"
 IsEnabled="{Binding Hdv.HasListings}" MinHeight="32" PlaceholderText="Choisir un lot"
 AutomationProperties.Name="Objet pour consulter l'historique des prix">
 <ComboBox.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvListingRow">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
 <TextBlock Text="{Binding LotText}" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{Binding Gid, StringFormat='GID {0}'}" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </DataTemplate>
 </ComboBox.ItemTemplate>
 </ComboBox>
 <Button Grid.Column="1" Classes="ghost" MinHeight="32" MinWidth="116"
 Command="{Binding Hdv.ReadPriceHistoryCommand}"
 IsEnabled="{Binding Hdv.CanReadPriceHistory}"
 AutomationProperties.Name="Lire manuellement l'historique des prix de cet objet"
 Content="Lire l'historique" />
 </Grid>
 <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding Hdv.PriceHistoryBusy}" />
 <TextBlock Text="{Binding Hdv.PriceHistorySelectionLabel}" FontSize="11"
 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
 IsVisible="{Binding Hdv.PriceHistorySelection, Converter={x:Static acv:ObjectConverters.IsNotNull}}" />
 <TextBlock Text="{Binding Hdv.PriceHistoryStatus}" FontSize="11"
 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
 <TextBlock Text="{Binding Hdv.PriceHistorySource}" FontSize="10.5"
 Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
 IsVisible="{Binding Hdv.PriceHistorySource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
 <Grid ColumnDefinitions="*,110,95" ColumnSpacing="10" IsVisible="{Binding Hdv.PriceHistoryHasRows}">
 <TextBlock Text="Date serveur" Classes="caption" />
 <TextBlock Grid.Column="1" Text="Prix moyen (K)" Classes="caption" HorizontalAlignment="Right" />
 <TextBlock Grid.Column="2" Text="Vendus" Classes="caption" HorizontalAlignment="Right" />
 </Grid>
 <ItemsControl ItemsSource="{Binding Hdv.PriceHistoryRows}"
 IsVisible="{Binding Hdv.PriceHistoryHasRows}"
 AutomationProperties.Name="Points de prix moyens reçus du serveur">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvPriceHistoryLine">
 <Grid ColumnDefinitions="*,110,95" ColumnSpacing="10" Margin="0,2">
 <TextBlock Text="{Binding DateText}" FontSize="11" TextTrimming="CharacterEllipsis" />
 <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontSize="11"
 HorizontalAlignment="Right" />
 <TextBlock Grid.Column="2" Text="{Binding SoldText}" FontSize="11"
 HorizontalAlignment="Right" />
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <TextBlock Classes="caption" FontSize="10.5" TextWrapping="Wrap"
 Text="La réponse est associée au code de l'événement serveur ; le GID n'est pas confirmé par ce message. Aucun prix manquant n'est estimé." />
 </StackPanel>
 </Border>
 <StackPanel Spacing="6" IsVisible="{Binding Hdv.SellRequiresReview}">
 <TextBlock Foreground="#E8B563" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.ReconcileHint}" />
 <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding Hdv.ReconcileSellCommand}" Content="{DynamicResource L.Bots.Hdv.ReconcileButton}" />
 </StackPanel>
 <StackPanel Spacing="6" IsVisible="{Binding Hdv.RemoveRequiresReview}">
 <TextBlock Foreground="#E8B563" TextWrapping="Wrap" Text="Retrait incertain : vérifier les annonces et le sac dans le jeu avant toute nouvelle demande." />
 <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding Hdv.ReconcileRemoveCommand}" Content="Retrait vérifié manuellement" />
 </StackPanel>
 </StackPanel>
 </Grid>
 </Border>

 <!-- ================= COLONNE DROITE: contrôle ================= -->
 <ScrollViewer Grid.Column="1" MaxHeight="620" VerticalAlignment="Top" VerticalScrollBarVisibility="Visible">
 <StackPanel Spacing="12">

 <Border Classes="card" Padding="12">
 <StackPanel Spacing="6">
 <TextBlock Classes="section" Text="Journal des opérations HDV" />
 <TextBlock Classes="caption" TextWrapping="Wrap"
 Text="Vente, repricing, achat et retrait : consulter les quarantaines du profil actif. Un contrôle local n'est pas un accusé serveur." />
 <Button Classes="ghost" HorizontalAlignment="Left" Height="29"
 Command="{Binding Hdv.InspectHdvDurableOperationsCommand}"
 Content="Contrôler le journal durable"
 AutomationProperties.Name="Lire les opérations HDV durables du personnage actif, sans envoyer d'ordre" />
 <TextBlock Text="{Binding Hdv.HdvDurableOperationsStatus}" TextWrapping="Wrap"
 Foreground="#E8AD6D" FontSize="11" />
 <TextBlock Text="{Binding Hdv.HdvLastManualReview}" TextWrapping="Wrap"
 Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"
 IsVisible="{Binding Hdv.HdvLastManualReview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
 <ListBox ItemsSource="{Binding Hdv.HdvDurableOperationRows}"
 SelectedItem="{Binding Hdv.SelectedHdvJournalOperation, Mode=TwoWay}"
 IsVisible="{Binding Hdv.HdvHasDurableOperationRows}"
 AutomationProperties.Name="Historique de mutations locales HDV, par personnage ; aucun ACK inventé">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvJournalOperationRow">
 <Border BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,0,1" Padding="0,5">
 <StackPanel Spacing="2">
 <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
 <TextBlock Grid.Column="0" Text="{Binding Type}" FontSize="11" FontWeight="SemiBold" />
 <TextBlock Grid.Column="1" Text="{Binding Phase}" FontSize="10.5"
 Foreground="#E8AD6D" TextWrapping="Wrap" />
 </Grid>
 <TextBlock Text="{Binding Details}" FontSize="10.5"
 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
 </StackPanel>
 </Border>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 <Button Classes="ghost" Height="28" HorizontalAlignment="Left"
 Content="Inspecter preuves de l'ordre"
 Command="{Binding Hdv.InspectSelectedHdvOrderEvidenceCommand}"
 IsEnabled="{Binding Hdv.SelectedHdvJournalOperation.IsBlocked}"
 ToolTip.Tip="Relit l'ordre exact, l'époque de connexion, l'inventaire et les annonces du modèle local. Aucun ACK serveur inféré." />
 <TextBlock Text="{Binding Hdv.HdvSelectedEvidenceStatus}"
 Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"
 TextWrapping="Wrap" />
 <Button Classes="ghost" Height="28" HorizontalAlignment="Left"
 Content="Rapprocher l'ordre sélectionné"
 Command="{Binding Hdv.ReconcileSelectedDurableOrderCommand}"
 IsEnabled="{Binding Hdv.SelectedHdvJournalOperation.IsBlocked}"
 ToolTip.Tip="Confirmation humaine d'un run local exact, contrôlé sous verrou de journal. Aucune preuve serveur et aucune taxe libérée." />
 </StackPanel>
 </Border>

 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.Control}" />
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Target}" />
 <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Hdv.Locations}" SelectedItem="{Binding Hdv.SelectedLocation}">
 <ComboBox.ItemTemplate>
 <DataTemplate x:DataType="svc:HdvLocation">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <!-- icône DU JEU (auctionHouse*); repli pastille tant que le bundle n'est pas chargé -->
 <Image Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" IsVisible="{Binding HasIcon}" />
 <Ellipse Width="9" Height="9" Fill="{Binding TypeBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}" />
 <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
 </StackPanel>
 </DataTemplate>
 </ComboBox.ItemTemplate>
 </ComboBox>
 
 <Button Classes="primary" HorizontalAlignment="Stretch" Height="36" Margin="0,8,0,0" Command="{Binding Hdv.OpenSellModalCommand}" IsVisible="{Binding !Hdv.BulkRunning}" AutomationProperties.Name="{DynamicResource L.Bots.Hdv.Sell.Open}">
 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
 <PathIcon Data="{StaticResource IconCart}" Width="14" Height="14" />
 <TextBlock Text="{DynamicResource L.Bots.Hdv.Sell.Open}" VerticalAlignment="Center" FontWeight="SemiBold" />
 </StackPanel>
 </Button>
 </StackPanel>
 </Border>

 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.Auto}" />
 <!-- délais RANDOMISÉS min → max (tirage uniforme à chaque cycle) pour humaniser -->
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.RefreshRate}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.RandTip}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.RefreshRateMs}" Minimum="1000" Maximum="600000" Increment="500" FormatString="0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.RandTip}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="8,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.RefreshRateMaxMs}" Minimum="1000" Maximum="600000" Increment="500" FormatString="0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.RandTip}" />
 </Grid>
 </StackPanel>
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.DelaySales}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.RandTip}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.DelayBetweenSalesMs}" Minimum="0" Maximum="60000" Increment="250" FormatString="0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.RandTip}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="8,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.DelayBetweenSalesMaxMs}" Minimum="0" Maximum="60000" Increment="250" FormatString="0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.RandTip}" />
 </Grid>
 </StackPanel>
 <Grid ColumnDefinitions="*,124">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.FloorPct}" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource L.Bots.Hdv.FloorPctTip}" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.FloorPercent}" Minimum="0" Maximum="100" Increment="1" FormatString="0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.FloorPctTip}" />
 </Grid>
 <Button HorizontalAlignment="Stretch" Height="38" Classes="ghost" Command="{Binding Hdv.ToggleWatcherCommand}" IsEnabled="{Binding !Hdv.Traveling}" AutomationProperties.Name="{Binding Hdv.WatcherText}">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconPlay}" Width="13" Height="13" IsVisible="{Binding !Hdv.WatcherRunning}" />
 <PathIcon Data="{StaticResource IconStop}" Width="13" Height="13" IsVisible="{Binding Hdv.WatcherRunning}" />
 <TextBlock Text="{Binding Hdv.WatcherText}" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <!-- voyage/ouverture auto du HDV en cours: spinner + statut live (StatusText ci-dessus) + Annuler -->
 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding Hdv.Traveling}">
 <Ellipse Classes="spinner" Width="15" Height="15" StrokeThickness="2" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.Hdv.TravelingNow}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="12" VerticalAlignment="Center" />
 <Button Classes="ghost" Height="26" Padding="12,0" VerticalAlignment="Center"
 Command="{Binding Hdv.CancelTravelCommand}"
 Content="{DynamicResource L.Bots.Hdv.CancelTravel}"
 ToolTip.Tip="{DynamicResource L.Bots.Hdv.CancelTravel}" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding Hdv.WatcherRunning}">
 <ProgressBar IsIndeterminate="True" Width="90" Height="3" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.Hdv.WatchingNow}" Foreground="#63D3A6" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 </StackPanel>
 </Border>

 <!-- Remise en vente automatique : chaque lot vendu d'un objet de la liste est remplacé (pendant le repricing auto) -->
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.AutoRelist}" />
 <CheckBox IsChecked="{Binding Hdv.RelistEnabled}" Content="{DynamicResource L.Bots.Hdv.RelistEnable}" />
 <Border Classes="notice" IsVisible="{Binding Hdv.RelistNeedsWatcher}">
 <Grid ColumnDefinitions="Auto,*">
 <PathIcon Grid.Column="0" Data="{StaticResource IconInfo}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.RelistNeedsWatcher}" TextWrapping="Wrap" />
 </Grid>
 </Border>
 <TextBox Height="32" Text="{Binding Hdv.RelistQuery}" Watermark="{DynamicResource L.Bots.Hdv.RelistSearch}" />
 <ItemsControl ItemsSource="{Binding Hdv.RelistSuggestions}" IsVisible="{Binding Hdv.HasRelistSuggestions}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvItemPick">
 <Button Classes="ghost" HorizontalAlignment="Stretch" Height="30" Margin="0,3,0,0" Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.AddRelistPickCommand}" CommandParameter="{Binding}">
 <StackPanel Orientation="Horizontal" Spacing="7"><Image Source="{Binding Icon}" Width="18" Height="18" IsVisible="{Binding HasIcon}" /><TextBlock Text="{Binding Name}" /><TextBlock Classes="caption" Text="{Binding OwnedText}" /></StackPanel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
 <Button Grid.Column="0" HorizontalAlignment="Stretch" Height="30" Classes="ghost" Command="{Binding Hdv.ImportListingsToRelistCommand}"
 ToolTip.Tip="{DynamicResource L.Bots.Hdv.RelistImportTip}">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconDownload}" Width="12" Height="12" /><TextBlock Text="{DynamicResource L.Bots.Hdv.RelistImport}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 <Button Grid.Column="1" Height="30" Classes="ghost" MinWidth="0" Padding="10,0" Command="{Binding Hdv.ClearRelistCommand}" IsVisible="{Binding Hdv.HasRelistRules}"
 ToolTip.Tip="{DynamicResource L.Bots.Hdv.Clear}">
 <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
 </Button>
 </Grid>
 <!-- Modifier toutes les règles : prix minimum en masse, « garder » pour toutes -->
 <Expander Header="{DynamicResource L.Bots.Hdv.RelistBulk}" HorizontalAlignment="Stretch" IsVisible="{Binding Hdv.HasRelistRules}">
 <StackPanel Spacing="8">
 <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.RelistBulkPct}" VerticalAlignment="Center" TextWrapping="Wrap" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.RelistBulkPct}" Minimum="1" Maximum="200" FormatString="0" />
 </Grid>
 <Button HorizontalAlignment="Stretch" Height="30" Classes="ghost" Command="{Binding Hdv.FillRelistMinFromMarketCommand}" Content="{DynamicResource L.Bots.Hdv.RelistMinFromMarket}" />
 <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
 <Button Grid.Column="0" HorizontalAlignment="Stretch" Height="30" Classes="ghost" Command="{Binding Hdv.ScaleRelistMinCommand}" CommandParameter="90" Content="{DynamicResource L.Bots.Hdv.RelistMinDown}" />
 <Button Grid.Column="1" HorizontalAlignment="Stretch" Height="30" Classes="ghost" Command="{Binding Hdv.ScaleRelistMinCommand}" CommandParameter="110" Content="{DynamicResource L.Bots.Hdv.RelistMinUp}" />
 </Grid>
 </StackPanel>
 </Expander>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.RelistEmpty}" IsVisible="{Binding !Hdv.HasRelistRules}" />
 <ItemsControl ItemsSource="{Binding Hdv.RelistRows}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvRelistRow">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Spacing="6">
 <Grid ColumnDefinitions="Auto,*,Auto">
 <Image Grid.Column="0" Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,8,0" IsVisible="{Binding HasIcon}" VerticalAlignment="Top" />
 <StackPanel Grid.Column="1" Spacing="2">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
 <TextBlock Text="{Binding LotText}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="11" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Classes="caption" Text="{Binding StatsText}" />
 <TextBlock Classes="caption" Foreground="{StaticResource AmberBrush}" Text="{DynamicResource L.Bots.Hdv.RelistStockOut}" IsVisible="{Binding StockOut}" />
 <TextBlock Classes="caption" Text="{Binding StateText}" IsVisible="{Binding HasState}" TextWrapping="Wrap" />
 </StackPanel>
 <Button Grid.Column="2" Classes="ghost" Height="28" MinWidth="0" Padding="8,0" VerticalAlignment="Top"
 Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.RemoveRelistCommand}" CommandParameter="{Binding}">
 <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
 </Button>
 </Grid>
 <Grid ColumnDefinitions="*,130" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
 <TextBlock Grid.Row="0" Classes="caption" Text="{DynamicResource L.Bots.Hdv.RelistLotSize}" VerticalAlignment="Center" />
 <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LotChoices}" SelectedIndex="{Binding LotIndex}" />
 <TextBlock Grid.Row="1" Classes="caption" Text="{DynamicResource L.Bots.Hdv.RelistTarget}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Target}" Minimum="1" Maximum="100" FormatString="0" />
 <TextBlock Grid.Row="2" Classes="caption" Text="{DynamicResource L.Bots.Hdv.RelistMinPrice}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MinPrice}" Minimum="0" Maximum="2000000000" Increment="100" FormatString="N0" />
 </Grid>
 </StackPanel>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </Border>

 <!-- Journal d'activité verbeux + horodaté (reprix/vente/retrait/refresh, couleur par niveau) -->
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.LogTitle}" />
 <TextBlock IsVisible="{Binding !Hdv.HasActivity}" Classes="caption" Text="{DynamicResource L.Bots.Hdv.LogEmpty}" />
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" MaxHeight="220" IsVisible="{Binding Hdv.HasActivity}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Padding="4">
 <ListBox Classes="log" ItemsSource="{Binding Hdv.Activity}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvLogEntry">
 <Grid ColumnDefinitions="Auto,*" Margin="4,2">
 <TextBlock Grid.Column="0" Text="{Binding WhenText}" FontFamily="Consolas,Menlo,monospace" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,1,8,0" />
 <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding Color}" FontSize="12" TextWrapping="Wrap" />
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </Border>
 </StackPanel>
 </Border>

 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.Balance}" />
 <!-- Gains (ventes abouties lqn) vs Taxes payées -->
 <Grid ColumnDefinitions="Auto,*,Auto,Auto">
 <TextBlock Grid.Column="0" Classes="caption" Text="{DynamicResource L.Bots.Hdv.Sales}" VerticalAlignment="Center" />
 <Image Grid.Column="2" Source="avares://GivreClone/Assets/stats/kamas.png" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0" />
 <TextBlock Grid.Column="3" Text="{Binding Hdv.TotalSalesText}" Foreground="#63D3A6" FontWeight="SemiBold" VerticalAlignment="Center" />
 </Grid>
 <Grid ColumnDefinitions="Auto,*,Auto,Auto">
 <TextBlock Grid.Column="0" Classes="caption" Text="{DynamicResource L.Bots.Hdv.Taxes}" VerticalAlignment="Center" />
 <Image Grid.Column="2" Source="avares://GivreClone/Assets/stats/kamas.png" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0" />
 <TextBlock Grid.Column="3" Text="{Binding Hdv.TotalTaxText}" Foreground="#F0616D" FontWeight="SemiBold" VerticalAlignment="Center" />
 </Grid>
 <Grid ColumnDefinitions="*,124">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.MaxTax}" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource L.Bots.Hdv.MaxTaxTip}" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.MaxTaxSpend}" Minimum="0" Maximum="2000000000" Increment="1000" FormatString="N0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.MaxTaxTip}" />
 </Grid>
 <!-- Journal des ventes abouties (gains) -->
 <TextBlock IsVisible="{Binding Hdv.HasSalesLog}" Classes="caption" Text="{DynamicResource L.Bots.Hdv.SalesLog}" Margin="0,2,0,0" />
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" MaxHeight="150" IsVisible="{Binding Hdv.HasSalesLog}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Padding="4">
 <ListBox Classes="log" ItemsSource="{Binding Hdv.SalesLog}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvSaleEntry">
 <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="4,2">
 <TextBlock Grid.Column="0" Text="{Binding WhenText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
 <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
 <TextBlock Grid.Column="2" Text="{Binding LotText}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="11" Margin="6,0" VerticalAlignment="Center" />
 <Image Grid.Column="3" Source="avares://GivreClone/Assets/stats/kamas.png" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0" />
 <TextBlock Grid.Column="4" Text="{Binding AmountText}" Foreground="#63D3A6" FontSize="12" VerticalAlignment="Center" />
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </Border>
 <!-- Journal des taxes payées -->
 <TextBlock IsVisible="{Binding Hdv.HasTaxLog}" Classes="caption" Text="{DynamicResource L.Bots.Hdv.TaxLog}" Margin="0,2,0,0" />
 <TextBlock IsVisible="{Binding !Hdv.HasTaxLog}" Classes="caption" Text="{DynamicResource L.Bots.Hdv.NoTax}" />
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" MaxHeight="150" IsVisible="{Binding Hdv.HasTaxLog}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Padding="4">
 <ListBox Classes="log" ItemsSource="{Binding Hdv.TaxLog}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvTaxEntry">
 <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,2">
 <TextBlock Grid.Column="0" Text="{Binding WhenText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
 <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
 <TextBlock Grid.Column="2" Text="{Binding LotText}" Foreground="#63D3A6" FontSize="11" Margin="6,0" VerticalAlignment="Center" />
 <TextBlock Grid.Column="3" Text="{Binding TaxText}" Foreground="#F0616D" FontSize="12" VerticalAlignment="Center" />
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </Border>
 </StackPanel>
 </Border>

 <!-- Mise en vente: fenêtre dédiée (niveau fenêtre, HdvSellOverlay); ici un résumé + la progression d'un passage en cours -->
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.SellHere}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.Sell.CardHint}" />
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock Grid.Column="0" Classes="caption" Text="{Binding Hdv.FreeSlotsText}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Hdv.CheckedCountText}" VerticalAlignment="Center" />
 </Grid>
 <Button Classes="primary" HorizontalAlignment="Stretch" Height="36" Command="{Binding Hdv.OpenSellModalCommand}" IsVisible="{Binding !Hdv.BulkRunning}">
 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
 <PathIcon Data="{StaticResource IconCart}" Width="14" Height="14" />
 <TextBlock Text="{DynamicResource L.Bots.Hdv.Sell.Open}" VerticalAlignment="Center" FontWeight="SemiBold" />
 </StackPanel>
 </Button>
 <StackPanel IsVisible="{Binding Hdv.BulkRunning}" Spacing="6">
 <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
 <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
 <Ellipse Classes="spinner" Width="12" Height="12" />
 <TextBlock Text="{Binding Hdv.BulkProgressText}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
 </StackPanel>
 <Button Grid.Column="1" Classes="ghost" Height="28" MinWidth="0" Padding="12,0" Command="{Binding Hdv.OpenSellModalCommand}"
 Content="{DynamicResource L.Bots.Hdv.Sell.View}" />
 <Button Grid.Column="2" Classes="ghost" Height="28" MinWidth="0" Padding="12,0" Command="{Binding Hdv.CancelBulkCommand}">
 <StackPanel Orientation="Horizontal" Spacing="5">
 <PathIcon Data="{StaticResource IconStop}" Width="10" Height="10" />
 <TextBlock Text="{DynamicResource L.Bots.Hdv.Sell.Stop}" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 </Grid>
 <ProgressBar Minimum="0" Maximum="1" Value="{Binding Hdv.BulkProgressValue}" Height="4" MinHeight="4"
 Foreground="{DynamicResource AccentBrush}" Background="{StaticResource Surface1Brush}" />
 </StackPanel>
 </StackPanel>
 </Border>

 </StackPanel>
 </ScrollViewer>
 </Grid>

 <!-- ================= SOUS-ONGLET STATISTIQUES ================= -->
 <ScrollViewer VerticalScrollBarVisibility="Auto" Classes="subview" Classes.shown="{Binding Hdv.ShowStats}">
 <ScrollViewer.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.22" /></Transitions></ScrollViewer.Transitions>
 <StackPanel Spacing="12">
 <!-- période + export -->
 <Grid ColumnDefinitions="Auto,*,Auto">
 <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
 <Button Classes="ghost" Classes.accent="{Binding Hdv.Stats.PeriodIsDay}" Height="30" MinWidth="0" Padding="12,0" Command="{Binding Hdv.Stats.SetPeriodCommand}" CommandParameter="day" Content="{DynamicResource L.Bots.Period.Day}" />
 <Button Classes="ghost" Classes.accent="{Binding Hdv.Stats.PeriodIsWeek}" Height="30" MinWidth="0" Padding="12,0" Command="{Binding Hdv.Stats.SetPeriodCommand}" CommandParameter="week" Content="{DynamicResource L.Bots.Period.Week}" />
 <Button Classes="ghost" Classes.accent="{Binding Hdv.Stats.PeriodIsMonth}" Height="30" MinWidth="0" Padding="12,0" Command="{Binding Hdv.Stats.SetPeriodCommand}" CommandParameter="month" Content="{DynamicResource L.Bots.Period.Month}" />
 <Button Classes="ghost" Classes.accent="{Binding Hdv.Stats.PeriodIsYear}" Height="30" MinWidth="0" Padding="12,0" Command="{Binding Hdv.Stats.SetPeriodCommand}" CommandParameter="year" Content="{DynamicResource L.Bots.Period.Year}" />
 </StackPanel>
 <Button Grid.Column="2" Classes="ghost" Height="30" MinWidth="0" Padding="12,0" Click="OnExportHdvStats">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconDownload}" Width="13" Height="13" /><TextBlock Text="{DynamicResource L.Bots.Hdv.ExportCsv}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 </Grid>

 <!-- KPIs: Ventes / Taxes / Profit net / Lots vendus -->
 <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
 <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Spacing="4">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Sales}" />
 <StackPanel Orientation="Horizontal" Spacing="5">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{Binding Hdv.Stats.TotalSalesText}" Foreground="#63D3A6" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </StackPanel>
 </Border>
 <Border Grid.Column="1" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Spacing="4">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Taxes}" />
 <StackPanel Orientation="Horizontal" Spacing="5">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{Binding Hdv.Stats.TotalTaxesText}" Foreground="#F0616D" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </StackPanel>
 </Border>
 <Border Grid.Column="2" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Spacing="4">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.NetProfit}" />
 <StackPanel Orientation="Horizontal" Spacing="5">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{Binding Hdv.Stats.NetProfitText}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </StackPanel>
 </Border>
 <Border Grid.Column="3" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Spacing="4">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.LotsSold}" />
 <TextBlock Text="{Binding Hdv.Stats.LotsSoldText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
 </StackPanel>
 </Border>
 </Grid>

 <!-- courbe de profit net cumulé -->
 <Border Classes="card" Padding="12" IsVisible="{Binding Hdv.Stats.HasChart}">
 <StackPanel Spacing="6">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.ProfitChart}" />
 <Viewbox Stretch="Fill" Height="150">
 <Canvas Width="1000" Height="280">
 <Polygon Points="{Binding Hdv.Stats.AreaPoints}" Fill="#2263D3A6" />
 <Polyline Points="{Binding Hdv.Stats.LinePoints}" Stroke="#63D3A6" StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round" />
 </Canvas>
 </Viewbox>
 </StackPanel>
 </Border>

 <!-- graphe en barres: profit net par objet -->
 <Border Classes="card" Padding="12" IsVisible="{Binding Hdv.Stats.HasItems}">
 <StackPanel Spacing="6">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.ProfitByItem}" />
 <ItemsControl ItemsSource="{Binding Hdv.Stats.Items}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvStatItemRow">
 <Grid ColumnDefinitions="140,*,Auto" Margin="0,0,0,5" VerticalAlignment="Center">
 <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
 <Border Grid.Column="1" Height="14" CornerRadius="3" Background="{Binding BarBrush}" HorizontalAlignment="Left" Width="{Binding BarWidth}" VerticalAlignment="Center" Margin="6,0" />
 <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="12" Height="12" VerticalAlignment="Center" />
 <TextBlock Text="{Binding NetText}" FontSize="12" Foreground="{Binding NetBrush}" VerticalAlignment="Center" />
 </StackPanel>
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </Border>

 <!-- tableau par objet -->
 <TextBlock IsVisible="{Binding !Hdv.Stats.HasItems}" Classes="caption" Text="{DynamicResource L.Bots.Hdv.NoStats}" Margin="2,6" />
 <Border Classes="card" Padding="4" IsVisible="{Binding Hdv.Stats.HasItems}">
 <StackPanel>
 <Grid ColumnDefinitions="34,*,72,100,100,100" Margin="6,4">
 <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColItem}" />
 <TextBlock Grid.Column="2" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColUnits}" />
 <TextBlock Grid.Column="3" Classes="caption" Text="{DynamicResource L.Bots.Hdv.Sales}" />
 <TextBlock Grid.Column="4" Classes="caption" Text="{DynamicResource L.Bots.Hdv.Taxes}" />
 <TextBlock Grid.Column="5" Classes="caption" Text="{DynamicResource L.Bots.Hdv.NetProfit}" />
 </Grid>
 <ItemsControl ItemsSource="{Binding Hdv.Stats.Items}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvStatItemRow">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="6" Padding="6,4" Margin="0,0,0,4">
 <Grid ColumnDefinitions="34,*,72,100,100,100" VerticalAlignment="Center">
 <Panel Grid.Column="0" Width="26" Height="26">
 <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
 <Border IsVisible="{Binding !HasIcon}" CornerRadius="5" Background="{StaticResource StrokeSoftBrush}" />
 </Panel>
 <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
 <TextBlock Grid.Column="2" Text="{Binding UnitsText}" Foreground="{DynamicResource AccentBrightBrush}" FontSize="12" VerticalAlignment="Center" />
 <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="11" Height="11" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SalesText}" Foreground="#63D3A6" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="11" Height="11" VerticalAlignment="Center" />
 <TextBlock Text="{Binding TaxesText}" Foreground="#F0616D" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="11" Height="11" VerticalAlignment="Center" />
 <TextBlock Text="{Binding NetText}" Foreground="{Binding NetBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </Grid>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </Border>

 <!-- journal BRUT horodaté (ventes + taxes): traçabilité fine, exporté tel quel en CSV -->
 <Border Classes="card" Padding="4" IsVisible="{Binding Hdv.Stats.HasTransactions}">
 <StackPanel>
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.TxJournal}" Margin="6,4,6,0" />
 <Grid ColumnDefinitions="132,88,*,60,116" Margin="6,4">
 <TextBlock Grid.Column="0" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColWhen}" />
 <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColType}" />
 <TextBlock Grid.Column="2" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColItem}" />
 <TextBlock Grid.Column="3" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColUnits}" />
 <TextBlock Grid.Column="4" Classes="caption" Text="{DynamicResource L.Bots.Hdv.ColAmount}" />
 </Grid>
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" MaxHeight="280" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Padding="2">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <ItemsControl ItemsSource="{Binding Hdv.Stats.Transactions}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvStatTxRow">
 <Grid ColumnDefinitions="132,88,*,60,116" Margin="6,3">
 <TextBlock Grid.Column="0" Text="{Binding WhenText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="3" Text="{Binding QtyText}" FontSize="12" Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" />
 <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="11" Height="11" VerticalAlignment="Center" />
 <TextBlock Text="{Binding AmountText}" FontSize="12" Foreground="{Binding AmountBrush}" VerticalAlignment="Center" />
 </StackPanel>
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </Border>
 </StackPanel>
 </Border>
 </StackPanel>
 </ScrollViewer>

 <!-- ================= SOUS-ONGLET ACHAT ================= -->
 <Grid Grid.ColumnSpan="2" ColumnDefinitions="8*,4*" ColumnSpacing="14" Classes="subview" Classes.shown="{Binding Hdv.ShowBuy}">
 <Grid.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.22" /></Transitions></Grid.Transitions>
 <Grid.Styles>
 <Style Selector="ComboBox"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 <Style Selector="NumericUpDown"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 <Style Selector="TextBox"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 </Grid.Styles>
 <Border Grid.Column="0" Classes="card" Padding="12" VerticalAlignment="Top">
 <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
 <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
 <TextBlock Grid.Column="0" Classes="section" Text="{DynamicResource L.Bots.Hdv.BuyList}" VerticalAlignment="Center" />
 <Button Grid.Column="1" Classes="ghost" Height="30" MinWidth="0" Padding="10,0" Margin="8,0,0,0" Command="{Binding Hdv.DecomposeAllBuyCommand}">
 <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{DynamicResource L.Bots.Hdv.DecomposeAll}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 <Button Grid.Column="2" Classes="ghost" Height="30" MinWidth="0" Padding="10,0" Margin="8,0,0,0" Command="{Binding Hdv.ClearBuyListCommand}">
 <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" /><TextBlock Text="{DynamicResource L.Bots.Hdv.Clear}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 </Grid>
 <TextBox Grid.Row="1" Margin="0,8,0,0" Height="32" Text="{Binding Hdv.BuyQuery}" Watermark="{DynamicResource L.Bots.Hdv.BuySearchWatermark}" />
 <ItemsControl Grid.Row="2" ItemsSource="{Binding Hdv.BuySuggestions}" IsVisible="{Binding Hdv.HasBuySuggestions}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvItemPick">
 <Button Classes="ghost" HorizontalAlignment="Stretch" Height="30" Margin="0,3,0,0" Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.AddBuyItemCommand}" CommandParameter="{Binding}">
 <StackPanel Orientation="Horizontal" Spacing="7"><Image Source="{Binding Icon}" Width="18" Height="18" IsVisible="{Binding HasIcon}" /><TextBlock Text="{Binding Name}" /><TextBlock Classes="caption" Text="{Binding OwnedText}" /></StackPanel>
 </Button>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <StackPanel Grid.Row="3">
 <TextBlock Margin="0,8,0,0" Classes="caption" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Hdv.BuySummaryText}" />
 <TextBlock Margin="0,6,0,0" Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.BuyHint}" IsVisible="{Binding !Hdv.BuyRows.Count}" />
 <TextBlock Margin="0,6,0,0" Classes="caption" TextWrapping="Wrap" Text="{Binding Hdv.BuyStatusText}" IsVisible="{Binding Hdv.BuyStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
 <Border Classes="notice" Margin="0,8,0,0" Padding="10,8" IsVisible="{Binding Hdv.BuyRequiresReview}">
 <StackPanel Spacing="6">
 <TextBlock Foreground="#E8B563" FontWeight="SemiBold" Text="Achat suspendu : journal durable à rapprocher" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Hdv.BuyReviewExplanation}" />
 <Button Classes="ghost" HorizontalAlignment="Left" Padding="12,6"
 Command="{Binding Hdv.ReconcileBuyCommand}" Content="Achat contrôlé manuellement"
 AutomationProperties.Name="Rapprochement manuel d'une intention d'achat HDV incertaine" />
 </StackPanel>
 </Border>
 </StackPanel>
 <ListBox Grid.Row="4" Classes="log" Margin="0,8,0,0" ItemsSource="{Binding Hdv.BuyRows}" SelectedItem="{Binding Hdv.SelectedBuyRow}" AutoScrollToSelectedItem="True" MaxHeight="700" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
 <ListBox.Styles>
 <Style Selector="ListBoxItem:selected">
 <Style.Animations>
 <Animation Duration="0:0:0.8">
 <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
 <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
 </Animation>
 </Style.Animations>
 </Style>
 </ListBox.Styles>
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvBuyRow">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="8,6" Margin="0,0,0,6" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <ToolTip.Tip><ctl:ItemTooltip Gid="{Binding Gid}" Pid="{Binding TooltipPid}" /></ToolTip.Tip>
 <StackPanel Spacing="4">
 <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
 <Image Grid.Column="0" Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,8,0" IsVisible="{Binding HasIcon}" />
 <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
 <NumericUpDown Grid.Column="2" Width="128" ShowButtonSpinner="False" Value="{Binding Needed}" Minimum="1" Maximum="1000000" FormatString="N0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.Quantity}" />
 <TextBlock Grid.Column="3" Classes="caption" Text="{Binding BalanceText}" VerticalAlignment="Center" Margin="8,0" />
 <TextBlock Grid.Column="4" Classes="caption" Text="{Binding PlanCostText}" VerticalAlignment="Center" Margin="8,0" IsVisible="{Binding ShowQuote}" />
 <Button Grid.Column="5" Classes="ghost" Height="26" MinWidth="0" Padding="8,0" Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.DecomposeBuyRowCommand}" CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.DecomposeIngredients}">
 <TextBlock Text="↳" />
 </Button>
 <Button Grid.Column="6" Classes="ghost" Height="26" MinWidth="0" Padding="8,0" Command="{Binding $parent[ItemsControl].((vm:BotsViewModel)DataContext).Hdv.RemoveBuyRowCommand}" CommandParameter="{Binding}">
 <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" />
 </Button>
 </Grid>
 <ItemsControl ItemsSource="{Binding Lots}">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvBuyLot">
 <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,6,6">
 <ToggleButton Classes="ghost" Height="24" MinWidth="0" Padding="8,0" IsChecked="{Binding Allowed}">
 <TextBlock Text="{Binding Label}" FontSize="11" />
 </ToggleButton>
 <NumericUpDown ShowButtonSpinner="False" HorizontalAlignment="Stretch" Value="{Binding Max}" Minimum="0" Maximum="2000000000" Increment="100" FormatString="N0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.MaxLotPrice}" />
 </StackPanel>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <TextBlock Classes="caption" FontSize="11" Text="{Binding StateText}" IsVisible="{Binding StateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
 </StackPanel>
 </Border>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </Grid>
 </Border>
 <ScrollViewer Grid.Column="1">
 <StackPanel Spacing="12">
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.AutoBuy}" />
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Target}" />
 <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Hdv.Locations}" SelectedItem="{Binding Hdv.SelectedLocation}" />
 <StackPanel Spacing="4">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.BuyBudget}" TextWrapping="Wrap" />
 <NumericUpDown ShowButtonSpinner="False" Value="{Binding Hdv.BuyBudget}" Minimum="0" Maximum="2000000000" Increment="1000" FormatString="N0" />
 </StackPanel>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.BuySteps}" />
 <TextBox Text="{Binding Hdv.BuyRecipeName}" Watermark="{DynamicResource L.Bots.Hdv.RecipeName}" />
 <Grid ColumnDefinitions="100,*" ColumnSpacing="8">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.BuyRecipeMult}" Minimum="1" Maximum="1000" FormatString="N0" ToolTip.Tip="{DynamicResource L.Bots.Hdv.RecipeMultiplier}" />
 <Button Grid.Column="1" Height="32" Classes="ghost" Command="{Binding Hdv.LoadBuyRecipeCommand}"><TextBlock Text="{DynamicResource L.Bots.Hdv.LoadRecipe}" /></Button>
 </Grid>
 <Button HorizontalAlignment="Stretch" Height="34" Classes="ghost" Command="{Binding Hdv.FetchBuyPricesCommand}">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconUpdate}" Width="12" Height="12" /><TextBlock Text="{DynamicResource L.Bots.Hdv.FetchPrices}" VerticalAlignment="Center" /></StackPanel>
 </Button>
 <Button HorizontalAlignment="Stretch" Height="38" Classes="primary" Command="{Binding Hdv.ToggleBuyCommand}" IsEnabled="{Binding Hdv.BuyControlEnabled}">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconCart}" Width="13" Height="13" /><TextBlock Text="{Binding Hdv.BuyStartText}" VerticalAlignment="Center" FontWeight="SemiBold" /></StackPanel>
 </Button>
<Button HorizontalAlignment="Stretch" Height="34" Classes="ghost" Command="{Binding Hdv.ToggleSniperCommand}" IsEnabled="{Binding Hdv.SniperControlEnabled}" ToolTip.Tip="{DynamicResource L.Bots.Hdv.SniperExplain}">
<TextBlock Text="{Binding Hdv.SniperStartText}" />
</Button>
<TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Hdv.SniperStatusText}" IsVisible="{Binding Hdv.SniperStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.SpentSession}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Text="{Binding Hdv.BuySpentSession}" Foreground="#F0616D" FontWeight="SemiBold" VerticalAlignment="Center" />
 </Grid>
 </StackPanel>
 </Border>
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.MassMaxPrice}" />
 <Grid ColumnDefinitions="*,100">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Variation}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.BuyTolerancePct}" Minimum="0" Maximum="100" Increment="1" FormatString="0" />
 </Grid>
 <Button HorizontalAlignment="Stretch" Height="30" Classes="ghost" Command="{Binding Hdv.FillBuyMaxFromAvgCommand}">
 <TextBlock Text="{DynamicResource L.Bots.Hdv.MaxFromMarket}" />
 </Button>
 <Button HorizontalAlignment="Stretch" Height="30" Classes="ghost" Command="{Binding Hdv.FillBuyMaxFromPricesCommand}">
 <TextBlock Text="{DynamicResource L.Bots.Hdv.MaxFromSeen}" />
 </Button>
 <Button HorizontalAlignment="Stretch" Height="30" Classes="ghost" Command="{Binding Hdv.ScaleBuyMaxCommand}">
 <TextBlock Text="{DynamicResource L.Bots.Hdv.MaxFromCurrent}" />
 </Button>
 </StackPanel>
 </Border>
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.LinkRelist}" />
 <Button HorizontalAlignment="Stretch" Height="30" Classes="ghost" Command="{Binding Hdv.ImportRelistToBuyCommand}">
 <TextBlock Text="{DynamicResource L.Bots.Hdv.AddRelistToBuy}" />
 </Button>
 <Button HorizontalAlignment="Stretch" Height="30" Classes="ghost" Command="{Binding Hdv.ExportBuyToRelistCommand}">
 <TextBlock Text="{DynamicResource L.Bots.Hdv.RelistTheseAgain}" />
 </Button>
 </StackPanel>
 </Border>
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.LogTitle}" />
 <TextBlock IsVisible="{Binding !Hdv.HasActivity}" Classes="caption" Text="{DynamicResource L.Bots.Hdv.LogEmpty}" />
 </StackPanel>
 </Border>
 </StackPanel>
 </ScrollViewer>
 </Grid>

 <!-- ================= SOUS-ONGLET RENTABILITÉ ================= -->
 <ScrollViewer Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Classes="subview" Classes.shown="{Binding Hdv.ShowScan}">
 <ScrollViewer.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.22" /></Transitions></ScrollViewer.Transitions>
 <StackPanel Spacing="12">
 <StackPanel.Styles>
 <Style Selector="ComboBox"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 <Style Selector="NumericUpDown"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 <Style Selector="TextBox"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 </StackPanel.Styles>
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.ScanTitle}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.LocalScanHint}" />
 <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Analysis}" />
 <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Hdv.ScanModeIndex}">
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.ScanModeResell}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.ScanModeCraft}" />
 </ComboBox>
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Server}" />
 <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Hdv.ScanServers}" SelectedItem="{Binding Hdv.ScanServer}">
 <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:HdvScanServer"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
 </ComboBox>
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Item}" />
 <TextBox Text="{Binding Hdv.ScanQuery}" Watermark="{DynamicResource L.Bots.Hdv.ScanItemWatermark}" />
 </StackPanel>
 </Grid>
 <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.ItemType}" />
 <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Hdv.ScanTypes}" SelectedItem="{Binding Hdv.ScanType}">
 <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:HdvScanFilter"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
 </ComboBox>
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Job}" />
 <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Hdv.ScanJobs}" SelectedItem="{Binding Hdv.ScanJob}">
 <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:HdvScanFilter"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
 </ComboBox>
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Level}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.ScanLevelMin}" Minimum="1" Maximum="200" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="6,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.ScanLevelMax}" Minimum="1" Maximum="200" />
 </Grid>
 </StackPanel>
 </Grid>
 <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.MinGainKamas}" />
 <NumericUpDown HorizontalAlignment="Stretch" Value="{Binding Hdv.ScanMinGain}" Minimum="0" Maximum="2000000000" FormatString="N0" />
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.MinGainPct}" />
 <NumericUpDown HorizontalAlignment="Stretch" Value="{Binding Hdv.ScanMinPct}" Minimum="0" Maximum="1000" />
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.Quantity}" />
 <NumericUpDown HorizontalAlignment="Stretch" Value="{Binding Hdv.ScanQty}" Minimum="1" Maximum="1000" />
 </StackPanel>
 </Grid>
 <CheckBox IsChecked="{Binding Hdv.ScanDecompose}" Content="{DynamicResource L.Bots.Hdv.DecomposeIngredients}" />
 <Grid ColumnDefinitions="*,Auto">
 <ComboBox SelectedIndex="{Binding Hdv.ScanSortIndex}">
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.SortByGain}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.SortByPct}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.LocalScanSortCost}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.SortByName}" />
 </ComboBox>
 <Button Grid.Column="1" Classes="primary" Height="34" Margin="10,0,0,0" Command="{Binding Hdv.RunLocalScanCommand}" IsEnabled="{Binding Hdv.ScanBusy, Converter={x:Static BoolConverters.Not}}">
 <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13" /><TextBlock Text="{DynamicResource L.Bots.Hdv.Analyze}" VerticalAlignment="Center" FontWeight="SemiBold" /></StackPanel>
 </Button>
 </Grid>
 <TextBlock Classes="caption" Text="{Binding Hdv.ScanStatusText}" IsVisible="{Binding Hdv.ScanStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
 </StackPanel>
 </Border>
 <ItemsControl ItemsSource="{Binding Hdv.ScanRows}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HdvScanRow">
 <Border Classes="card" Padding="10" Margin="0,0,0,6">
 <Grid ColumnDefinitions="Auto,2*,2*,Auto,Auto,Auto,Auto">
 <Image Grid.Column="0" Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0" IsVisible="{Binding HasIcon}" />
 <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
 <StackPanel Grid.Column="2" Spacing="2" Margin="8,0">
 <TextBlock Classes="caption" Text="{Binding Detail}" TextWrapping="Wrap" />
 <TextBlock Classes="caption" Text="{Binding PriceEvidenceText}" />
 <TextBlock Classes="caption" Text="{Binding ReliabilityText}" />
 </StackPanel>
 <StackPanel Grid.Column="3" Margin="8,0" Spacing="2">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.LocalScanCost}" />
 <TextBlock Text="{Binding CostText}" />
 </StackPanel>
 <StackPanel Grid.Column="4" Margin="8,0" Spacing="2">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.LocalScanNetValue}" />
 <TextBlock Text="{Binding ValueText}" />
 </StackPanel>
 <StackPanel Grid.Column="5" Margin="8,0" Spacing="2">
 <TextBlock Text="{Binding GainText}" FontWeight="SemiBold" />
 <TextBlock Classes="caption" Text="{Binding GainPctText}" />
 </StackPanel>
 <StackPanel Grid.Column="6" Spacing="3">
 <Button Classes="ghost" Height="26" MinWidth="0" Padding="8,0" Command="{Binding $parent[ItemsControl].((vm:HdvViewModel)DataContext).VerifyLocalScanRowCommand}" CommandParameter="{Binding}">
 <TextBlock Text="{DynamicResource L.Bots.Hdv.LocalScanVerify}" FontSize="11" />
 </Button>
 <Button Classes="ghost" Height="26" MinWidth="0" Padding="8,0" Command="{Binding $parent[ItemsControl].((vm:HdvViewModel)DataContext).ScanToBuyCommand}" CommandParameter="{Binding}">
 <TextBlock Text="{DynamicResource L.Bots.Hdv.ToBuyList}" FontSize="11" />
 </Button>
 </StackPanel>
 </Grid>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </ScrollViewer>

 <!-- ================= SOUS-ONGLET RÉGLAGES ================= -->
 <ScrollViewer Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Classes="subview" Classes.shown="{Binding Hdv.ShowSettings}">
 <ScrollViewer.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.22" /></Transitions></ScrollViewer.Transitions>
 <StackPanel Spacing="10">
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.SettingsHint}" />
 <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
 <Grid.Styles>
 <Style Selector="ComboBox"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 <Style Selector="NumericUpDown"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 <Style Selector="TextBox"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /></Style>
 </Grid.Styles>

 <!-- ===== Colonne gauche ===== -->
 <StackPanel Grid.Column="0" Spacing="12">
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.AutoRepricing}" />
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.RefreshRate}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.RefreshRateMs}" Minimum="1000" Maximum="600000" Increment="500" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="8,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.RefreshRateMaxMs}" Minimum="1000" Maximum="600000" Increment="500" />
 </Grid>
 </StackPanel>
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.DelaySales}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.DelayBetweenSalesMs}" Minimum="0" Maximum="60000" Increment="250" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="8,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.DelayBetweenSalesMaxMs}" Minimum="0" Maximum="60000" Increment="250" />
 </Grid>
 </StackPanel>
 <Grid ColumnDefinitions="*,124">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.FloorPct}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.FloorPercent}" Minimum="0" Maximum="100" />
 </Grid>
 <Grid ColumnDefinitions="*,124">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.TaxCap}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.MaxTaxSpend}" Minimum="0" Maximum="2000000000" Increment="1000" FormatString="N0" />
 </Grid>
 <CheckBox IsChecked="{Binding Hdv.RepriceEnabled}" Content="{DynamicResource L.Bots.Hdv.RepriceEnabled}" />
 <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Hdv.RepriceScopeIndex}">
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.ScopeAll}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.ScopeCheapest}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.ScopeMostExpensive}" />
 </ComboBox>
 </StackPanel>
 </Border>
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.NewListingPrice}" />
 <Grid ColumnDefinitions="*,124">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.UndercutNew}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.ListUndercut}" Minimum="1" Maximum="1000000" />
 </Grid>
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.NoCompetitor}" />
 <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Hdv.NoCompetitorIndex}">
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.NoCompetitorFromNeighbor}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.NoCompetitorKeep}" />
 </ComboBox>
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.LotStrategy}" />
 <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Hdv.LotStrategyIndex}">
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.LotBiggestFirst}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.LotSmallestFirst}" />
 </ComboBox>
 </StackPanel>
 </Border>
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.AutoRelist}" />
 <CheckBox IsChecked="{Binding Hdv.RelistOnSale}" Content="{DynamicResource L.Bots.Hdv.RelistOnSale}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.RelistExplain}" />
 </StackPanel>
 </Border>
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.AdvancedDelays}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.AdvancedDelaysExplain}" />
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.PriceTtl}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.PriceTtlMinSec}" Minimum="1" Maximum="3600" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="6,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.PriceTtlMaxSec}" Minimum="1" Maximum="3600" />
 </Grid>
 </StackPanel>
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.PriceProbe}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.PriceProbeMinMs}" Minimum="0" Maximum="10000" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="6,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.PriceProbeMaxMs}" Minimum="0" Maximum="10000" />
 </Grid>
 </StackPanel>
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.RelistWake}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.RelistWakeMinMs}" Minimum="0" Maximum="60000" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="6,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.RelistWakeMaxMs}" Minimum="0" Maximum="60000" />
 </Grid>
 </StackPanel>
 <Grid ColumnDefinitions="*,124">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.RetryAfterRefusal}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.RelistRetrySec}" Minimum="1" Maximum="3600" />
 </Grid>
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.BulkPause}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.BulkPauseMinSec}" Minimum="0" Maximum="600" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="6,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.BulkPauseMaxSec}" Minimum="0" Maximum="600" />
 </Grid>
 </StackPanel>
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.BulkPauseEvery}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.BulkPauseEveryMin}" Minimum="1" Maximum="1000" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="6,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.BulkPauseEveryMax}" Minimum="1" Maximum="1000" />
 </Grid>
 </StackPanel>
 </StackPanel>
 </Border>
 </StackPanel>

 <!-- ===== Colonne droite ===== -->
 <StackPanel Grid.Column="1" Spacing="12">
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.AutoBuy}" />
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.BuyLotSize}" />
 <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding Hdv.BuyStrategyIndex}">
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.LotBiggestFirst}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Hdv.LotSmallestFirst}" />
 </ComboBox>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.BuyThresholdsExplain}" />
 <Grid ColumnDefinitions="Auto,*,124" ColumnSpacing="8">
 <CheckBox Grid.Column="0" IsChecked="{Binding Hdv.BuyT1000}" MinWidth="0" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource L.Bots.Hdv.Lots1000IfMissing}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.BuyMin1000}" Minimum="1" Maximum="1000" FormatString="0" IsEnabled="{Binding Hdv.BuyT1000}" />
 </Grid>
 <Grid ColumnDefinitions="Auto,*,124" ColumnSpacing="8">
 <CheckBox Grid.Column="0" IsChecked="{Binding Hdv.BuyT100}" MinWidth="0" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource L.Bots.Hdv.Lots100IfMissing}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.BuyMin100}" Minimum="1" Maximum="100" FormatString="0" IsEnabled="{Binding Hdv.BuyT100}" />
 </Grid>
 <Grid ColumnDefinitions="Auto,*,124" ColumnSpacing="8">
 <CheckBox Grid.Column="0" IsChecked="{Binding Hdv.BuyT10}" MinWidth="0" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource L.Bots.Hdv.Lots10IfMissing}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.BuyMin10}" Minimum="1" Maximum="10" FormatString="0" IsEnabled="{Binding Hdv.BuyT10}" />
 </Grid>
 <Grid ColumnDefinitions="Auto,*,124" ColumnSpacing="8">
 <CheckBox Grid.Column="0" IsChecked="{Binding Hdv.BuyT1}" MinWidth="0" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource L.Bots.Hdv.Lots1IfMissing}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.BuyMin1}" Minimum="1" Maximum="1" FormatString="0" IsEnabled="{Binding Hdv.BuyT1}" />
 </Grid>
 <CheckBox IsChecked="{Binding Hdv.BuyDeductStock}" Content="{DynamicResource L.Bots.Hdv.DeductStock}" />
 <CheckBox IsChecked="{Binding Hdv.BuyIgnorePrice}" Content="{DynamicResource L.Bots.Hdv.IgnorePrice}" />
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.DelayBetweenBuys}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.BuyDelayMinMs}" Minimum="0" Maximum="60000" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="6,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.BuyDelayMaxMs}" Minimum="0" Maximum="60000" />
 </Grid>
 </StackPanel>
 <Grid ColumnDefinitions="*,124">
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.RetryUntilSuccess}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.BuyRetrySec}" Minimum="0" Maximum="3600" />
 </Grid>
 <Grid ColumnDefinitions="*,124">
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.SellCycleEvery}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.BuySwitchEvery}" Minimum="0" Maximum="1000" />
 </Grid>
 </StackPanel>
 </Border>
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.Sniper}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.SniperExplain}" />
 <Grid ColumnDefinitions="*,124">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.SniperMaxPct}" VerticalAlignment="Center" />
 <NumericUpDown Grid.Column="1" Value="{Binding Hdv.SniperPct}" Minimum="0" Maximum="100" />
 </Grid>
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Hdv.SniperWait}" />
 <Grid ColumnDefinitions="*,Auto,*">
 <NumericUpDown Grid.Column="0" Value="{Binding Hdv.SniperWaitMinSec}" Minimum="0" Maximum="600" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Hdv.To}" Classes="caption" VerticalAlignment="Center" Margin="6,0" />
 <NumericUpDown Grid.Column="2" Value="{Binding Hdv.SniperWaitMaxSec}" Minimum="0" Maximum="600" />
 </Grid>
 </StackPanel>
 </StackPanel>
 </Border>
 <Border Classes="card" Padding="14">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Hdv.DiscordNotif}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Hdv.DiscordNotifExplain}" />
 <WrapPanel>
 <CheckBox Margin="0,0,16,6" IsChecked="{Binding Hdv.NotifySale}" Content="{DynamicResource L.Bots.Hdv.NotifySales}" />
 <CheckBox Margin="0,0,16,6" IsChecked="{Binding Hdv.NotifyBuy}" Content="{DynamicResource L.Bots.Hdv.NotifyBuys}" />
 <CheckBox Margin="0,0,16,6" IsChecked="{Binding Hdv.NotifyReprice}" Content="{DynamicResource L.Bots.Hdv.NotifyReprice}" />
 <CheckBox Margin="0,0,16,6" IsChecked="{Binding Hdv.NotifyPodsFull}" Content="{DynamicResource L.Bots.Hdv.NotifyPodsFull}" />
 <CheckBox Margin="0,0,16,6" IsChecked="{Binding Hdv.NotifyNoKamas}" Content="{DynamicResource L.Bots.Hdv.NotifyNoKamas}" />
 </WrapPanel>
 </StackPanel>
 </Border>
 </StackPanel>
 </Grid>
 </StackPanel>
 </ScrollViewer>
 </Grid>
 </Grid>
 </TabItem>

 <!-- Onglet Lua: script d'automatisation (moteur MoonSharp, modele move/bank) -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <PathIcon Data="{StaticResource IconScript}" Width="14" Height="14" />
 <TextBlock Text="{DynamicResource L.Bots.TabLua}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,10,0,0">
 <Grid.Styles>
 <Style Selector="Button.iconbtn.lua">
 <Setter Property="Height" Value="30" />
 <Setter Property="Width" Value="32" />
 </Style>
 <Style Selector="Border.luasep">
 <Setter Property="Width" Value="1" />
 <Setter Property="Height" Value="18" />
 <Setter Property="Margin" Value="3,0" />
 <Setter Property="VerticalAlignment" Value="Center" />
 <Setter Property="Background" Value="{StaticResource StrokeSoftBrush}" />
 </Style>
 </Grid.Styles>
 <!-- Barre d'outils: document + fichier + édition (icônes, raccourcis dans les infobulles) | exécution -->
 <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
 <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="9,0" Height="30" MaxWidth="280"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1"
 ToolTip.Tip="{Binding LuaChunkName}">
 <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
 <PathIcon Data="{StaticResource IconScript}" Width="12" Height="12" Foreground="{DynamicResource AccentBrightBrush}" />
 <TextBlock Classes="pii" Text="{Binding LuaDocTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
 Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
 <Ellipse Width="7" Height="7" Fill="#E8B339" VerticalAlignment="Center" IsVisible="{Binding LuaFileModified}"
 ToolTip.Tip="{DynamicResource L.Lua.Editor.Modified}" />
 </StackPanel>
 </Border>
 <Border Classes="luasep" />
 <Button Classes="ghost" Height="30" Padding="9,0" MinWidth="0"
         Command="{Binding NoCodeOpenCommand}" ToolTip.Tip="Créer un trajet, une récolte ou un combat sans écrire de Lua">
 <StackPanel Orientation="Horizontal" Spacing="5">
 <PathIcon Data="{StaticResource IconSparkle}" Width="13" Height="13" />
 <TextBlock Text="Sans code" FontSize="11.5" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <Button Classes="iconbtn lua" Command="{Binding LuaShowTemplatesCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.TemplatesTip}">
 <PathIcon Data="{StaticResource IconSparkle}" Width="14" Height="14" />
 </Button>
 <Button Classes="iconbtn lua" Command="{Binding LuaOpenCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.OpenTip}">
 <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" />
 </Button>
 <Button Classes="iconbtn lua" Command="{Binding LuaShowRecentCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.RecentTip}">
 <PathIcon Data="{StaticResource IconClock}" Width="14" Height="14" />
 </Button>
 <Button Classes="iconbtn lua" Command="{Binding LuaSaveNowCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.SaveTip}">
 <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14" />
 </Button>
 <Button Classes="iconbtn lua" Command="{Binding LuaSaveAsCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.SaveAsTip}">
 <PathIcon Data="{StaticResource IconDownload}" Width="14" Height="14" />
 </Button>
 <Border Classes="luasep" />
 <Button Classes="iconbtn lua" Command="{Binding LuaFormatCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.FormatTip}">
 <PathIcon Data="{StaticResource IconWrench}" Width="14" Height="14" />
 </Button>
 <Button Classes="iconbtn lua" Command="{Binding LuaFindCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.FindTip}">
 <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" />
 </Button>
 <Button Classes="iconbtn lua" Command="{Binding LuaCheckCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.CheckTip}">
 <PathIcon Data="{StaticResource IconCheckCircle}" Width="14" Height="14" />
 </Button>
 <Button Classes="iconbtn lua" Command="{Binding LuaShowApiRefCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.ApiTip}">
 <PathIcon Data="{StaticResource IconBook}" Width="14" Height="14" />
 </Button>
 <Button Classes="iconbtn lua" Command="{Binding LuaOpenFullscreenCommand}" ToolTip.Tip="{DynamicResource L.Lua.Editor.FullscreenTip}">
 <PathIcon Data="{StaticResource IconExpand}" Width="14" Height="14" />
 </Button>
 </StackPanel>
 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
 <!-- Enregistreur de trajet (Road Creator): observe les changements de carte manuels et genere
 un trajet declaratif; une modale « recolter/combattre » s'ouvre a chaque nouvelle carte. -->
 <Button Classes="ghost" Height="30" MinWidth="0" Padding="12,0" Click="OnToggleRecording"
 ToolTip.Tip="{DynamicResource L.Bots.Road.Tip}">
 <Panel>
 <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !Recording}">
 <PathIcon Data="{StaticResource IconMap}" Width="12" Height="12" />
 <TextBlock Text="{DynamicResource L.Bots.Road.Record}" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding Recording}">
 <Ellipse Width="9" Height="9" Fill="#F0616D" VerticalAlignment="Center">
 <Ellipse.Styles>
 <Style Selector="Ellipse">
 <Style.Animations>
 <Animation Duration="0:0:1.2" IterationCount="INFINITE">
 <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
 <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
 <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
 </Animation>
 </Style.Animations>
 </Style>
 </Ellipse.Styles>
 </Ellipse>
 <TextBlock Text="{DynamicResource L.Bots.Road.RecordStop}" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 </Panel>
 </Button>
 <!-- Redémarrer: relance le script AVEC le texte actuel de l'éditeur (F5 quand il tourne). -->
 <Button Classes="ghost" Height="30" MinWidth="0" Padding="12,0" Command="{Binding LuaRestartCommand}"
 IsVisible="{Binding LuaRunning}" IsEnabled="{Binding !SelectedBot.FollowerLocked}" ToolTip.Tip="{DynamicResource L.Lua.Editor.RestartTip}">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconUpdate}" Width="12" Height="12" />
 <TextBlock Text="{DynamicResource L.Lua.Editor.Restart}" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <!-- Bouton UNIQUE Lancer/Arrêter: l'apparence reflète l'état RÉEL du script (point vert
 animé = en cours). Un arrêt autonome (voyage bloqué, fin) rebascule sur « Lancer ». -->
 <Button Classes="accent" Height="30" MinWidth="120" Padding="14,0" Command="{Binding ToggleLuaCommand}"
 ToolTip.Tip="{DynamicResource L.Bots.Lua.ToggleTip}">
 <!-- Actif si le suivi ne verrouille pas ce bot ET que le perso n'est pas capé (offre gratuite > 30). -->
 <Button.IsEnabled>
 <MultiBinding Converter="{StaticResource AllTrue}">
 <Binding Path="!SelectedBot.FollowerLocked" />
 <Binding Path="CanRunLua" />
 </MultiBinding>
 </Button.IsEnabled>
 <Panel>
 <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !LuaRunning}">
 <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" />
 <TextBlock Text="{DynamicResource L.Bots.Lua.Run}" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding LuaRunning}">
 <Ellipse Width="9" Height="9" Fill="#4ADE80" VerticalAlignment="Center">
 <Ellipse.Styles>
 <Style Selector="Ellipse">
 <Style.Animations>
 <Animation Duration="0:0:1.2" IterationCount="INFINITE">
 <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
 <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
 <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
 </Animation>
 </Style.Animations>
 </Style>
 </Ellipse.Styles>
 </Ellipse>
 <TextBlock Text="{DynamicResource L.Bots.Lua.Stop}" FontSize="12" VerticalAlignment="Center" />
 </StackPanel>
 </Panel>
 </Button>
 </StackPanel>
 </Grid>
 <!-- Bandeau cap de niveau (offre gratuite > 30): visible seulement si le perso sélectionné est capé. -->
 <Border Grid.Row="1" Classes="notice" Margin="0,8,0,0" IsVisible="{Binding LevelCapBlocked}">
 <Grid ColumnDefinitions="Auto,*">
 <PathIcon Grid.Column="0" Data="{StaticResource IconLock}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.LevelCapBanner}" TextWrapping="Wrap" />
 </Grid>
 </Border>
 <!-- Éditeur de code (AvaloniaEdit): hauteur réglable par la poignée dessous (mémorisée). -->
 <Border Grid.Row="2" Height="{Binding LuaEditorHeight}" Margin="0,8,0,0" CornerRadius="10" ClipToBounds="True"
 Background="{DynamicResource ConsolePanelBrush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <lua:LuaCodeEditor x:Name="LuaEditor" IsReadOnly="{Binding SelectedBot.FollowerLocked}" />
 </Border>
 <!-- Poignée de redimensionnement -->
 <Thumb Grid.Row="3" Height="10" Cursor="SizeNorthSouth" DragDelta="OnLuaEditorResize"
 ToolTip.Tip="{DynamicResource L.Lua.Editor.ResizeTip}" Background="Transparent">
 <Thumb.Template>
 <ControlTemplate>
 <Border Background="Transparent">
 <Border Width="46" Height="4" CornerRadius="2" Background="{StaticResource StrokeMedBrush}"
 HorizontalAlignment="Center" VerticalAlignment="Center" />
 </Border>
 </ControlTemplate>
 </Thumb.Template>
 </Thumb>
 <!-- Barre d'état: problèmes (clic = suivant, F8) · 1er problème (clic = y aller) · position du curseur -->
 <StackPanel Grid.Row="4" Spacing="5">
 <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="2,0,2,0">
 <Button Grid.Column="0" Classes="ghost" Height="24" MinWidth="0" Padding="9,0" Command="{Binding LuaNextProblemCommand}"
 ToolTip.Tip="{DynamicResource L.Lua.Editor.ProblemTip}">
 <TextBlock Text="{Binding LuaStatusText}" Foreground="{Binding LuaStatusBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
 </Button>
 <Button Grid.Column="1" Classes="ghost" Height="24" MinWidth="0" Padding="8,0" HorizontalAlignment="Left"
 HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
 IsVisible="{Binding LuaHasProblem}" Command="{Binding LuaJumpToFirstProblemCommand}"
 ToolTip.Tip="{Binding LuaFirstProblemText}">
 <TextBlock Text="{Binding LuaFirstProblemText}" FontSize="11.5" TextTrimming="CharacterEllipsis"
 Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
 </Button>
 <TextBlock Grid.Column="2" Text="{Binding #LuaEditor.CaretText}" FontSize="11" VerticalAlignment="Center"
 Foreground="{StaticResource TextMutedBrush}" ToolTip.Tip="{DynamicResource L.Lua.Editor.Shortcuts}" />
 </Grid>
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="6" BorderBrush="{StaticResource StrokeSoftBrush}"
 BorderThickness="1" Padding="6,5">
 <StackPanel Spacing="3">
 <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
 <TextBlock Text="Reprise one-shot · cellule" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
 <TextBox Width="60" Height="25" FontSize="11" Text="{Binding StrictRouteTargetCell}"
 Watermark="0-559" Margin="0,0,8,0" />
 <TextBlock Text="Pods max %" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
 <TextBox Width="45" Height="25" FontSize="11" Text="{Binding StrictRouteMaxPods}"
 Watermark="95" Margin="0,0,8,0" />
 <CheckBox Content="Récolte si attestée" FontSize="11" VerticalAlignment="Center"
 IsChecked="{Binding StrictRouteGather}" Margin="0,0,10,0" />
 <Button Classes="ghost" Height="25" MinWidth="0" Padding="9,0"
 Content="Préparer le script sûr" Command="{Binding PrepareStrictActivityRouteCommand}"
 IsEnabled="{Binding !LuaRunning}"
 ToolTip.Tip="Sur la carte et la cellule réellement observées. Enregistrement par personnage après confirmation ; aucun départ automatique, aucun retry après issue incertaine." />
 </WrapPanel>
 <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
 <TextBlock Text="Objectif atelier · GID résultat" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
 <TextBox Width="78" Height="25" FontSize="11" Text="{Binding StrictRouteCraftGid, Mode=TwoWay}"
 Watermark="facultatif" Margin="0,0,8,0" />
 <TextBlock Text="Quantité" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
 <TextBox Width="65" Height="25" FontSize="11" Text="{Binding StrictRouteCraftQuantity, Mode=TwoWay}"
 Watermark="1" Margin="0,0,10,0" />
 <Button Classes="ghost" Height="25" MinWidth="0" Padding="8,0"
 Content="État objectif" Command="{Binding InspectGuidedProductionCommand}"
 ToolTip.Tip="Lecture des objectifs, tentative ActivityRecovery et état durable. Ne lève aucun blocage." />
 <Button Classes="ghost" Height="25" MinWidth="0" Padding="8,0"
 Content="Vers atelier" Command="{Binding OpenGuidedProductionCommand}"
 ToolTip.Tip="Importe le GID et la quantité depuis l'objectif durable dans le vrai planificateur, uniquement après validation d'identité et absence de tentative d'activité incertaine. Aucun craft automatique." />
 </WrapPanel>
 <TextBlock FontSize="10.5" Foreground="#E8AD6D" Text="{Binding StrictRouteDraftStatus}"
 TextWrapping="Wrap" />
 <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
 Text="{Binding GuidedProductionStatusText}" TextWrapping="Wrap" />
 </StackPanel>
 </Border>
 </StackPanel>
 <Grid Grid.Row="5" Margin="2,10,0,4" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
 <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
 <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
 <TextBlock Classes="caption" Foreground="{StaticResource TextMutedBrush}"
 Text="{DynamicResource L.Bots.Lua.ConsoleTitle}" />
 <TextBlock Text="{Binding ActivityRecoveryStatusText}" FontSize="10.5" FontWeight="SemiBold"
 Foreground="#E8AD6D" TextTrimming="CharacterEllipsis"
 IsVisible="{Binding ActivityRecoveryStatusVisible}"
 ToolTip.Tip="{Binding ActivityRecoveryStatusText}" />
 <TextBlock Text="{Binding SocketAuthorityStatusText}" FontSize="10.5"
 Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
 ToolTip.Tip="{Binding SocketAuthorityStatusText}" />
 </StackPanel>
 <Button Grid.Column="1" Classes="ghost" Height="26" Padding="7,0" MinWidth="0"
 Content="État reprise" Command="{Binding InspectActivityRecoveryCommand}"
 ToolTip.Tip="Lecture du journal durable du personnage sélectionné, sans lancer de script ni effacer une reprise incertaine." />
 <Button Grid.Column="2" Classes="ghost" Height="26" Padding="7,0" MinWidth="0"
 Content="Source TCP" Command="{Binding InspectSocketAuthorityCommand}"
 ToolTip.Tip="Diagnostic source Socket en lecture seule. Écriture TCP locale ≠ ACK serveur ; aucune action de jeu émise." />
 </Grid>
 <ComboBox Grid.Column="1" Height="26" MinWidth="130" VerticalAlignment="Center" FontSize="11.5"
 ItemsSource="{Binding LuaFilters}" SelectedIndex="{Binding LuaFilterIndex}"
 ToolTip.Tip="{DynamicResource L.Bots.Lua.FilterTip}" />
 <Button Grid.Column="2" Classes="ghost" Height="26" MinWidth="0" Padding="10,0"
 Click="OnCopyLua" ToolTip.Tip="{DynamicResource L.Bots.Lua.CopyTip}">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconCopy}" Width="11" Height="11" />
 <TextBlock Text="{DynamicResource L.Bots.Copy}" FontSize="11.5" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 <Button Grid.Column="3" Classes="ghost" Height="26" MinWidth="0" Padding="10,0"
 Command="{Binding ClearLuaLogCommand}" ToolTip.Tip="{DynamicResource L.Bots.Lua.ClearTip}">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconTrash}" Width="11" Height="11" />
 <TextBlock Text="{DynamicResource L.Bots.ClearConsole}" FontSize="11.5" VerticalAlignment="Center" />
 </StackPanel>
 </Button>
 </Grid>
 <Border Grid.Row="6" CornerRadius="12" Height="300" Background="{StaticResource Surface1Brush}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" ClipToBounds="True">
 <ListBox x:Name="LuaConsole" ItemsSource="{Binding LuaOutput}" SelectionMode="Multiple"
 KeyDown="OnConsoleKeyDown" DoubleTapped="OnLuaConsoleDoubleTapped" Background="Transparent" BorderThickness="0"
 Padding="6,6" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11.5">
 <ListBox.Styles>
 <!-- Hauteur de ligne FIXE: lignes uniformes -> pas de chevauchement du texte
 (le bug venait des hauteurs variables des messages qui se replient). -->
 <Style Selector="ListBoxItem">
 <Setter Property="Padding" Value="4,0" />
 <Setter Property="MinHeight" Value="20" />
 <Setter Property="Height" Value="20" />
 </Style>
 </ListBox.Styles>
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:LuaLogRow">
 <Grid ColumnDefinitions="10,Auto,90,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
 <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
 <!-- Erreur située: pastille « L148 » -> ouvre le script à cette ligne (double-clic sur la ligne aussi). -->
 <Button Grid.Column="3" IsVisible="{Binding HasLocation}" Padding="6,0" Height="17" MinWidth="0" Cursor="Hand"
 Background="#33FF6B7A" BorderThickness="0" CornerRadius="5" VerticalAlignment="Center"
 Command="{Binding $parent[ListBox].((vm:BotsViewModel)DataContext).LuaJumpToLogCommand}"
 CommandParameter="{Binding}" ToolTip.Tip="{Binding LocationTip}">
 <TextBlock Text="{Binding LocationLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFB4BC" VerticalAlignment="Center" />
 </Button>
 <TextBlock Grid.Column="4" Text="{Binding Message}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}"
 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </Border>
 </Grid>
 </TabItem>

 <!-- Onglet Stats: tableau de bord du perso (recoltes / combats / temps de botting), persiste 24h/7j/30j -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <PathIcon Data="{StaticResource IconTrendUp}" Width="15" Height="15" Foreground="#57C84D" />
 <TextBlock Text="{DynamicResource L.Bots.TabStats}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <StackPanel Spacing="14" Margin="0,12,0,0" DataContext="{Binding Stats}">
 <!-- Selecteur de periode (+ jour precis via DatePicker + export CSV) -->
 <Grid ColumnDefinitions="Auto,*,Auto">
 <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
 <Button Classes="ghost" Classes.accent="{Binding PeriodIsDay}" Height="28" MinWidth="0" Padding="14,0"
 Command="{Binding SetPeriodCommand}" CommandParameter="Day" Content="{DynamicResource L.Bots.Period.Day}" FontSize="12" />
 <Button Classes="ghost" Classes.accent="{Binding PeriodIsWeek}" Height="28" MinWidth="0" Padding="14,0"
 Command="{Binding SetPeriodCommand}" CommandParameter="Week" Content="{DynamicResource L.Bots.Period.Week}" FontSize="12" />
 <Button Classes="ghost" Classes.accent="{Binding PeriodIsMonth}" Height="28" MinWidth="0" Padding="14,0"
 Command="{Binding SetPeriodCommand}" CommandParameter="Month" Content="{DynamicResource L.Bots.Period.Month}" FontSize="12" />
 <Button Classes="ghost" Classes.accent="{Binding PeriodIsYear}" Height="28" MinWidth="0" Padding="14,0"
 Command="{Binding SetPeriodCommand}" CommandParameter="Year" Content="{DynamicResource L.Bots.Period.Year}" FontSize="12" />
 <Border Width="1" Height="18" Background="{StaticResource StrokeSoftBrush}" Margin="4,0" IsVisible="{Binding HasDays}" />
 <!-- Jour précis: ne propose QUE les jours avec des données (masqué si aucun) -->
 <ComboBox MinWidth="170" MaxWidth="200" Height="28" VerticalAlignment="Center"
 ItemsSource="{Binding AvailableDays}" SelectedItem="{Binding SelectedDayItem}"
 PlaceholderText="{DynamicResource L.Bots.Stats.PickDay}"
 IsVisible="{Binding HasDays}" ToolTip.Tip="{DynamicResource L.Bots.Stats.PickDay}" />
 </StackPanel>
 <Button Grid.Column="2" Classes="ghost" Height="28" MinWidth="0" Padding="12,0" VerticalAlignment="Center"
 Click="OnExportStats" ToolTip.Tip="{DynamicResource L.Bots.Stats.ExportCsv}">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconDownload}" Width="13" Height="13" />
 <TextBlock Text="{DynamicResource L.Bots.Stats.ExportCsv}" VerticalAlignment="Center" FontSize="12" />
 </StackPanel>
 </Button>
 </Grid>

 <!-- Cartes KPI -->
 <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
 <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="6">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="avares://GivreClone/Assets/stats/gathering.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Stats.Harvests}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding HarvestsText}" Foreground="#63D3A6" FontSize="22" FontWeight="SemiBold" />
 <TextBlock Text="{Binding HarvestsPerHourText}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </Border>
 <Border Grid.Column="1" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="6">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="avares://GivreClone/Assets/stats/combat.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Stats.Fights}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding FightsText}" Foreground="#6EA8FE" FontSize="22" FontWeight="SemiBold" />
 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
 <Image Source="{svc:GameIcon check_green}" Width="13" Height="13" VerticalAlignment="Center" />
 <TextBlock Text="{Binding FightsWonText}" Foreground="#63D3A6" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
 <TextBlock Text="✕" Foreground="#FF6B7A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
 <TextBlock Text="{Binding FightsLostText}" Foreground="#FF6B7A" FontSize="12" VerticalAlignment="Center" />
 <TextBlock Text="☠" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="{DynamicResource L.Bots.Stats.Deaths}" />
 <TextBlock Text="{Binding DeathsText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource L.Bots.Stats.Deaths}" />
 </StackPanel>
 </StackPanel>
 </Border>
 <Border Grid.Column="2" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="6">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon hourglass}" Width="14" Height="14" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Stats.AvgFight}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding AvgFightText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
 </StackPanel>
 </Border>
 <Border Grid.Column="3" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="6">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <PathIcon Data="{StaticResource IconRobot}" Width="13" Height="13" Foreground="#E7C46B" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Stats.Botting}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding BottingText}" Foreground="#E7C46B" FontSize="22" FontWeight="SemiBold" />
 </StackPanel>
 </Border>
 </Grid>

 <!-- Cartes KPI avancées: rentabilité (kamas/ressources par heure) + stabilité (banque) -->
 <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
 <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="avares://GivreClone/Assets/stats/kamas.png" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Stats.Kamas}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding KamasGainedText}" Foreground="#E7C46B" FontSize="22" FontWeight="SemiBold" />
 <TextBlock Text="{Binding KamasPerHourText}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 </StackPanel>
 </Border>
 <Border Grid.Column="1" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon resources}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Stats.ResourcesQty}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding ResourcesText}" Foreground="#63D3A6" FontSize="22" FontWeight="SemiBold" />
 <TextBlock Text="{Binding ResourcesPerHourText}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{Binding PodsPerHourText, StringFormat='⛏ {0}'}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" ToolTip.Tip="{DynamicResource L.Bots.Stats.PodsPerHour}" />
 <TextBlock Text="{Binding EstimatedValuePerHourText}" Classes="caption" Foreground="#E7C46B" ToolTip.Tip="{DynamicResource L.Bots.Stats.EstValueTip}" />
 </StackPanel>
 </Border>
 <Border Grid.Column="2" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon XPBonus5}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Stats.Xp}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding XpGainedText}" Foreground="#B98CFF" FontSize="22" FontWeight="SemiBold" />
 <TextBlock Text="{Binding XpPerHourText}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{Binding FragmentsText}" Classes="caption" Foreground="#9BE07A" TextWrapping="Wrap"
 IsVisible="{Binding FragmentsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
 </StackPanel>
 </Border>
 <Border Grid.Column="3" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon shop}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Stats.BankVisits}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding BankVisitsText}" Foreground="#6EA8FE" FontSize="22" FontWeight="SemiBold" />
 </StackPanel>
 </Border>
 </Grid>

 <!-- Courbe de botting + feed des dernieres actions -->
 <Grid ColumnDefinitions="*,300" ColumnSpacing="12" Height="300">
 <Border Grid.Column="0" CornerRadius="12" Background="{StaticResource Surface1Brush}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" Padding="14,12">
 <Grid RowDefinitions="Auto,*,Auto">
 <TextBlock Grid.Row="0" Text="{Binding BottingTitle}" Classes="label" HorizontalAlignment="Center" />
 <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,4">
 <StackPanel Grid.Column="0" Width="42" Spacing="0" VerticalAlignment="Stretch">
 <TextBlock Text="{Binding ChartMaxLabel}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Text="{Binding ChartMidLabel}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,86,0,0" />
 <TextBlock Text="0h" Classes="caption" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,86,0,0" />
 </StackPanel>
 <Border Grid.Column="1" ClipToBounds="True">
 <Panel>
 <TextBlock Text="{DynamicResource L.Bots.Stats.NoData}" Classes="caption"
 Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
 IsVisible="{Binding !HasChart}" />
 <Viewbox Stretch="Fill" IsVisible="{Binding HasChart}">
 <Canvas Width="1000" Height="280">
 <Polygon Points="{Binding AreaPoints}" Fill="#2263D3A6" />
 <Polyline Points="{Binding LinePoints}" Stroke="#63D3A6" StrokeThickness="3"
 StrokeLineCap="Round" StrokeJoin="Round" />
 </Canvas>
 </Viewbox>
 </Panel>
 </Border>
 </Grid>
 <Grid Grid.Row="2" ColumnDefinitions="42,*,Auto" Margin="0,2,0,0">
 <TextBlock Grid.Column="1" Text="{Binding ChartStartLabel}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Column="2" Text="{Binding ChartEndLabel}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 </Grid>
 </Grid>
 </Border>
 <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource Surface1Brush}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" ClipToBounds="True">
 <Grid RowDefinitions="Auto,*">
 <TextBlock Grid.Row="0" Text="{DynamicResource L.Bots.Stats.RecentActions}" Classes="label" Margin="12,10,12,6" />
 <ListBox Grid.Row="1" ItemsSource="{Binding Recent}" Background="Transparent" BorderThickness="0" Padding="6,0,6,6">
 <ListBox.Styles>
 <Style Selector="ListBoxItem">
 <Setter Property="Padding" Value="6,3" />
 <Setter Property="MinHeight" Value="0" />
 </Style>
 </ListBox.Styles>
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:StatsActionRow">
 <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
 <Panel Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
 <Image Source="{Binding Icon}" Width="20" Height="20" IsVisible="{Binding HasIcon}" />
 <!-- Combat: même icône que l'onglet Combat (au lieu du point bleu) -->
 <Image Source="avares://GivreClone/Assets/stats/combat.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsFight}" />
 <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" IsVisible="{Binding ShowDot}"
 HorizontalAlignment="Center" VerticalAlignment="Center" />
 </Panel>
 <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}"
 FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
 <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}"
 FontSize="11" VerticalAlignment="Center" />
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </Grid>
 </Border>
 </Grid>

 <!-- Total recolte par ressource sur la periode (icones = assets du jeu) -->
 <StackPanel Spacing="8" IsVisible="{Binding HasResourceTotals}">
 <TextBlock Text="{DynamicResource L.Bots.Stats.HarvestedPeriod}" Classes="label" />
 <ItemsControl ItemsSource="{Binding ResourceTotals}">
 <ItemsControl.ItemsPanel>
 <ItemsPanelTemplate>
 <WrapPanel Orientation="Horizontal" />
 </ItemsPanelTemplate>
 </ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:ResourceTotalRow">
 <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="10,6" Margin="0,0,8,8"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1">
 <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
 <Image Source="{Binding Icon}" Width="18" Height="18" IsVisible="{Binding HasIcon}" />
 <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
 <TextBlock Text="{Binding QtyText}" Foreground="#63D3A6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>

 <!-- Heatmap de trajet: cartes les plus fréquentées (passages / récoltes / temps moyen) -->
 <StackPanel Spacing="8" IsVisible="{Binding HasHeatmap}">
 <TextBlock Text="{DynamicResource L.Bots.Stats.Heatmap}" Classes="label" />
 <Border CornerRadius="12" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" ClipToBounds="True">
 <Grid RowDefinitions="Auto,*">
 <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="14,10,14,6">
 <TextBlock Grid.Column="0" Text="{DynamicResource L.Bots.Stats.Heat.Map}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" />
 <TextBlock Grid.Column="1" Width="90" Text="{DynamicResource L.Bots.Stats.Heat.Passages}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Right" />
 <TextBlock Grid.Column="2" Width="90" Text="{DynamicResource L.Bots.Stats.Heat.Harvests}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Right" />
 <TextBlock Grid.Column="3" Width="100" Text="{DynamicResource L.Bots.Stats.Heat.AvgTime}" Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Right" />
 </Grid>
 <ScrollViewer Grid.Row="1" MaxHeight="300" Padding="0,0,0,6" VerticalScrollBarVisibility="Auto">
 <ItemsControl ItemsSource="{Binding Heatmap}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:HeatmapRowVm">
 <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="14,4">
 <TextBlock Grid.Column="0" Text="{Binding MapKey}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12.5" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Width="90" Text="{Binding Passages}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center" />
 <TextBlock Grid.Column="2" Width="90" Text="{Binding Harvests}" Foreground="#63D3A6" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center" />
 <TextBlock Grid.Column="3" Width="100" Text="{Binding AvgTime}" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" TextAlignment="Right" VerticalAlignment="Center" />
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </Grid>
 </Border>
 </StackPanel>
 </StackPanel>
 </TabItem>

 <!-- Onglet Planning: semaine type (plages horaires) qui lance/arrete le script pour humaniser -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon calendar}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabPlanning}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <!-- Éditeur partagé avec la modale « planning d'un perso hors ligne » (Views/PlanningEditor) -->
 <views:PlanningEditor DataContext="{Binding Planning}" Margin="0,12,0,4" />
 </ScrollViewer>
 </TabItem>

 <!-- Onglet Parametres: reglages PAR BOT (deplacement + messagerie privee). DataContext parent
 (BotsViewModel) conserve -> les champs pointent Settings.* et la notice lit !CanAutoReply. -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon gear}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabSettings}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <ScrollViewer Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Spacing="16" Margin="2,0,12,0" MaxWidth="760" HorizontalAlignment="Left" x:CompileBindings="False">
 <StackPanel.Styles>
 <Style Selector="ComboBox"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="MinHeight" Value="34" /></Style>
 <Style Selector="NumericUpDown"><Setter Property="Background" Value="{StaticResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" /><Setter Property="MinHeight" Value="32" /></Style>
 </StackPanel.Styles>
 <Button Content="Notifications Windows de ce compte" Command="{Binding ShowLocalNotificationSettingsCommand}" />

 <!-- ===== Deplacement ===== -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Settings.MoveTitle}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.MoveHint}" />
 <Grid ColumnDefinitions="130,*" VerticalAlignment="Center">
 <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.Speed}" />
 <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding Settings.SpeedIndex}">
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.SpeedFast}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.SpeedLegit}" />
 </ComboBox>
 </Grid>
 <Grid ColumnDefinitions="130,*" VerticalAlignment="Center">
 <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.Travel}" />
 <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding Settings.TravelModeIndex}">
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.TravelFast}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.TravelWalk}" />
 </ComboBox>
 </Grid>
 <Grid ColumnDefinitions="130,*" VerticalAlignment="Center">
 <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.ZaapRoute}" />
 <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding Settings.ZaapTravelIndex}"
 AutomationProperties.Name="Raccourci zaap">
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.ZaapRouteAuto}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.ZaapRouteWorld}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.ZaapRouteGround}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.ZaapRouteHaven}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.ZaapRouteZaapi}" />
 </ComboBox>
 </Grid>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.ZaapRouteHint}" />
 <StackPanel Spacing="4" IsVisible="{Binding Settings.PrefersWalk}">
 <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
 <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.WalkMaxHops}" />
 <NumericUpDown Grid.Column="1" Value="{Binding Settings.WalkMaxHops}" Minimum="0" Maximum="500" Increment="5" FormatString="0" />
 </Grid>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.TravelWalkHint}" />
 </StackPanel>
 <StackPanel Spacing="6" IsVisible="{Binding Settings.IsLegit}" Margin="0,2,0,0">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Settings.LegitRange}" />
 <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
 <NumericUpDown Grid.Column="0" Value="{Binding Settings.LegitSettleMinMs}" Minimum="100" Maximum="20000" Increment="100" FormatString="0" />
 <NumericUpDown Grid.Column="1" Value="{Binding Settings.LegitSettleMaxMs}" Minimum="100" Maximum="20000" Increment="100" FormatString="0" />
 </Grid>
 </StackPanel>
 </StackPanel>
 </Border>

 <!-- ===== Anti-blocage (watchdog) ===== -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Settings.AntiStuckTitle}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.AntiStuckHint}" />
 <CheckBox IsChecked="{Binding Settings.AntiStuckEnabled}" FontSize="13"
 Content="{DynamicResource L.Bots.Settings.AntiStuckEnabled}" />
 <StackPanel Spacing="8" IsEnabled="{Binding Settings.AntiStuckEnabled}" Margin="0,2,0,0">
 <CheckBox IsChecked="{Binding Settings.AntiStuckRestartScript}" FontSize="13"
 Content="{DynamicResource L.Bots.Settings.AntiStuckRestart}" />
 <CheckBox IsChecked="{Binding Settings.AntiStuckReconnect}" FontSize="13"
 Content="{DynamicResource L.Bots.Settings.AntiStuckReconnect}" />
 <Grid ColumnDefinitions="180,120" VerticalAlignment="Center">
 <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.AntiStuckTimeout}" />
 <NumericUpDown Grid.Column="1" Value="{Binding Settings.AntiStuckTimeoutSeconds}" Minimum="30" Maximum="3600" Increment="30" FormatString="0" />
 </Grid>
 </StackPanel>
 </StackPanel>
 </Border>

 <!-- ===== Anti-inactivité ===== -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Settings.AntiAfkTitle}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.AntiAfkHint}" />
 <CheckBox IsChecked="{Binding Settings.AntiAfkEnabled}" FontSize="13"
 Content="{DynamicResource L.Bots.Settings.AntiAfkEnabled}" />
 <Grid ColumnDefinitions="220,120" VerticalAlignment="Center" IsEnabled="{Binding Settings.AntiAfkEnabled}">
 <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.AntiAfkIdle}" />
 <NumericUpDown Grid.Column="1" Value="{Binding Settings.AntiAfkIdleMinutes}" Minimum="1" Maximum="30" Increment="1" FormatString="0" />
 </Grid>
 </StackPanel>
 </Border>

 <!-- ===== Succès : récupération automatique des récompenses ===== -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Settings.RegenTitle}" />
 <CheckBox IsChecked="{Binding Settings.RegenerationEnabled}" Content="{DynamicResource L.Bots.Settings.RegenEnable}" />
 <StackPanel Spacing="8" IsEnabled="{Binding Settings.RegenerationEnabled}">
 <Grid ColumnDefinitions="220,120">
 <TextBlock Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.RegenStart}" />
 <NumericUpDown Grid.Column="1" Value="{Binding Settings.RegenerationStartPercent}" Minimum="1" Maximum="100" FormatString="0" />
 </Grid>
 <Grid ColumnDefinitions="220,120">
 <TextBlock Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.RegenStop}" />
 <NumericUpDown Grid.Column="1" Value="{Binding Settings.RegenerationStopPercent}" Minimum="{Binding Settings.RegenerationStartPercent}" Maximum="100" FormatString="0" />
 </Grid>
 <Grid ColumnDefinitions="220,120">
 <TextBlock Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.RegenFood}" />
 <NumericUpDown Grid.Column="1" Value="{Binding Settings.RegenerationFoodGid}" Minimum="0" Maximum="2147483647" FormatString="0" />
 </Grid>
 <CheckBox IsChecked="{Binding Settings.RegenerationWaitForTeam}" Content="{DynamicResource L.Bots.Settings.RegenTeam}" />
 </StackPanel>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.RegenHint}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Settings.RegenerationStatus}" />
 </StackPanel>
 </Border>

 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Settings.AchTitle}" />
 <CheckBox IsChecked="{Binding Settings.AchievementAutoClaim}" FontSize="13"
 Content="{DynamicResource L.Bots.Settings.AchAutoClaim}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.AchHint}" />
 </StackPanel>
 </Border>

 <!-- ===== Caracteristiques : plan ordonne ===== -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Settings.StatsTitle}" />
 <CheckBox IsChecked="{Binding Settings.OrderedCharacteristicsEnabled}" Content="{DynamicResource L.Bots.Settings.StatsEnabled}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.StatsHint}" />
 <ListBox ItemsSource="{Binding Settings.CharacteristicTargets}" SelectedItem="{Binding Settings.SelectedCharacteristicTarget}" MaxHeight="320">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:CharacteristicTargetRow">
 <WrapPanel>
 <ComboBox SelectedIndex="{Binding StatIndex}" MinWidth="150" Margin="0,0,8,4">
 <ComboBoxItem Content="{DynamicResource L.Bots.Combat.Stat.Strength}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Combat.Stat.Vitality}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Combat.Stat.Wisdom}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Combat.Stat.Chance}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Combat.Stat.Agility}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Combat.Stat.Intelligence}" />
 </ComboBox>
 <NumericUpDown Value="{Binding Cap}" Minimum="0" Maximum="10000" Increment="1" FormatString="0" IsEnabled="{Binding HasCap}" Width="110" Margin="0,0,8,4" ToolTip.Tip="{DynamicResource L.Bots.Settings.StatsCap}" />
 <CheckBox IsChecked="{Binding Remainder}" Content="{DynamicResource L.Bots.Settings.StatsRemainder}" />
 </WrapPanel>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 <WrapPanel>
 <Button Command="{Binding Settings.AddCharacteristicTargetCommand}" Content="{DynamicResource L.Bots.Settings.StatsAdd}" Margin="0,0,8,4" />
 <Button Command="{Binding Settings.MoveCharacteristicTargetUpCommand}" Content="{DynamicResource L.Bots.Settings.StatsUp}" Margin="0,0,8,4" />
 <Button Command="{Binding Settings.MoveCharacteristicTargetDownCommand}" Content="{DynamicResource L.Bots.Settings.StatsDown}" Margin="0,0,8,4" />
 <Button Command="{Binding Settings.RemoveCharacteristicTargetCommand}" Content="{DynamicResource L.Bots.Settings.StatsRemove}" Margin="0,0,8,4" />
 </WrapPanel>
 </StackPanel>
 </Border>

 <!-- ===== Messagerie privee ===== -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Settings.MsgTitle}" />
 <Border Classes="notice" IsVisible="{Binding !CanAutoReply}">
 <Grid ColumnDefinitions="Auto,*">
 <PathIcon Grid.Column="0" Data="{StaticResource IconLock}" />
 <TextBlock Grid.Column="1" Text="{DynamicResource L.Bots.Settings.NoLicense}" TextWrapping="Wrap" />
 </Grid>
 </Border>
 <CheckBox IsChecked="{Binding Settings.AutoReplyEnabled}" IsEnabled="{Binding CanAutoReply}" FontSize="13"
 Content="{DynamicResource L.Bots.Settings.AutoReply}" />
 <Grid ColumnDefinitions="130,*" IsEnabled="{Binding Settings.AutoReplyEnabled}">
 <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.Mode}" />
 <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding Settings.ReplyModeIndex}">
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.ModeOff}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.ModeKeyword}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.ModeLlm}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.ModeKeywordThenLlm}" />
 </ComboBox>
 </Grid>

 <!-- Regles mot-cle -> reponse -->
 <StackPanel Spacing="6" IsVisible="{Binding Settings.UsesKeywords}" IsEnabled="{Binding Settings.AutoReplyEnabled}">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Settings.Rules}" />
 <ItemsControl ItemsSource="{Binding Settings.Rules}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:CompileBindings="False">
 <Grid ColumnDefinitions="26,128,1.2*,Auto,*,34" ColumnSpacing="7" Margin="0,0,0,5">
 <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Padding="0" MinWidth="0" />
 <ComboBox Grid.Column="1" SelectedIndex="{Binding MatchIndex}" MinHeight="30" VerticalAlignment="Center">
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.MatchContains}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.MatchEquals}" />
 <ComboBoxItem Content="{DynamicResource L.Bots.Settings.MatchStarts}" />
 </ComboBox>
 <TextBox Grid.Column="2" Text="{Binding Keyword}" Height="30" VerticalContentAlignment="Center" Watermark="{DynamicResource L.Bots.Settings.Keyword}" />
 <TextBlock Grid.Column="3" Text="→" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
 <TextBox Grid.Column="4" Text="{Binding Response}" Height="30" VerticalContentAlignment="Center" Watermark="{DynamicResource L.Bots.Settings.Response}" />
 <Button Grid.Column="5" Classes="ghost" Width="26" Height="26" MinWidth="0" Padding="0" VerticalAlignment="Center"
 ToolTip.Tip="{DynamicResource L.Bots.Settings.RemoveRule}"
 Command="{Binding $parent[ItemsControl].DataContext.Settings.RemoveRuleCommand}"
 CommandParameter="{Binding}">
 <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
 </Button>
 </Grid>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <Button Classes="ghost" HorizontalAlignment="Left" Height="30" Command="{Binding Settings.AddRuleCommand}">
 <StackPanel Orientation="Horizontal" Spacing="6">
 <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" />
 <TextBlock Text="{DynamicResource L.Bots.Settings.AddRule}" VerticalAlignment="Center" FontSize="12.5" />
 </StackPanel>
 </Button>
 </StackPanel>

 <!-- LLM -->
 <StackPanel Spacing="7" IsVisible="{Binding Settings.UsesLlm}" IsEnabled="{Binding Settings.AutoReplyEnabled}">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Settings.LlmTitle}" />
 <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="caption" FontSize="10.5" Text="{DynamicResource L.Bots.Settings.LlmModel}" />
 <TextBox Text="{Binding Settings.LlmModel}" Height="30" VerticalContentAlignment="Center" Watermark="gpt-4o-mini" />
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Classes="caption" FontSize="10.5" Text="{DynamicResource L.Bots.Settings.LlmBaseUrl}" />
 <TextBox Text="{Binding Settings.LlmBaseUrl}" Height="30" VerticalContentAlignment="Center" Watermark="https://api.openai.com/v1" />
 </StackPanel>
 </Grid>
 <StackPanel Spacing="3">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Classes="caption" FontSize="10.5" VerticalAlignment="Center" Text="{DynamicResource L.Bots.Settings.LlmKey}" />
 <TextBlock FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"
 IsVisible="{Binding Settings.HasLlmKey}" Text="{DynamicResource L.Bots.Settings.LlmKeySet}" />
 </StackPanel>
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
 <TextBox Grid.Column="0" Text="{Binding Settings.LlmApiKeyInput}" PasswordChar="●" Height="30" VerticalContentAlignment="Center"
 Watermark="{DynamicResource L.Bots.Settings.LlmKeyPlaceholder}" />
 <Button Grid.Column="1" Classes="ghost" Height="30" IsVisible="{Binding Settings.HasLlmKey}"
 Content="{DynamicResource L.Bots.Settings.LlmKeyClear}" Command="{Binding Settings.ClearLlmKeyCommand}" FontSize="12" />
 </Grid>
 </StackPanel>
 <StackPanel Spacing="3">
 <TextBlock Classes="caption" FontSize="10.5" Text="{DynamicResource L.Bots.Settings.LlmPrompt}" />
 <TextBox Text="{Binding Settings.LlmSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="90" VerticalContentAlignment="Top" />
 </StackPanel>
 </StackPanel>

 <!-- Delais reponse auto -->
 <Grid ColumnDefinitions="2*,*" ColumnSpacing="14" IsEnabled="{Binding Settings.AutoReplyEnabled}">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="caption" FontSize="10.5" Text="{DynamicResource L.Bots.Settings.ReplyDelay}" />
 <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
 <NumericUpDown Grid.Column="0" MinWidth="120" Value="{Binding Settings.ReplyDelayMinMs}" Minimum="0" Maximum="30000" Increment="500" FormatString="0" />
 <NumericUpDown Grid.Column="1" MinWidth="120" Value="{Binding Settings.ReplyDelayMaxMs}" Minimum="0" Maximum="30000" Increment="500" FormatString="0" />
 </Grid>
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Classes="caption" FontSize="10.5" Text="{DynamicResource L.Bots.Settings.Cooldown}" />
 <NumericUpDown MinWidth="110" Value="{Binding Settings.ReplyCooldownSec}" Minimum="0" Maximum="600" Increment="1" FormatString="0" />
 </StackPanel>
 </Grid>
 </StackPanel>
 </Border>

 <!-- ===== Relais Discord ===== -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Settings.DiscordTitle}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.DiscordHint}" />
 <CheckBox IsChecked="{Binding Settings.DiscordRelay}" IsEnabled="{Binding CanAutoReply}" FontSize="13"
 Content="{DynamicResource L.Bots.Settings.DiscordRelay}" />
 <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding Settings.DiscordRelay}">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="caption" FontSize="10.5" Text="{DynamicResource L.Bots.Settings.ManualWindow}" />
 <NumericUpDown Value="{Binding Settings.ManualReplyWindowSec}" Minimum="1" Maximum="600" Increment="5" FormatString="0" />
 </StackPanel>
 <CheckBox Grid.Column="1" IsChecked="{Binding Settings.AutoReplyIfNoManual}" FontSize="12.5" VerticalAlignment="Bottom"
 Content="{DynamicResource L.Bots.Settings.AutoIfNoManual}" />
 </Grid>
 </StackPanel>
 </Border>

 <!-- ===== Copier la messagerie vers d'autres personnages ===== -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="8">
 <TextBlock Classes="section" Text="Copier vers d'autres persos" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="Recopie la réponse automatique, les mots-clés, l'IA et sa clé, les délais et le relais Discord de ce personnage sur ceux que tu coches (les personnages connectés)." />
 <Button Classes="ghost" HorizontalAlignment="Left" Content="Choisir les personnages" Command="{Binding Settings.RefreshCopyTargetsCommand}" />
 <ItemsControl ItemsSource="{Binding Settings.CopyTargets}">
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:CopyTargetRow">
 <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding Name}" FontSize="13" />
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Settings.HasCopyTargets}">
  <Button Classes="ghost" Content="Tout cocher / décocher" Command="{Binding Settings.CheckAllCopyTargetsCommand}" />
  <Button Classes="primary" Content="Copier les réglages de messagerie" Command="{Binding Settings.CopyMessagingToSelectedCommand}" />
  <Button Classes="primary" Content="Copier tous les réglages" Command="{Binding Settings.CopyAllToSelectedCommand}" />
 </StackPanel>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Settings.CopyStatus}" />
 </StackPanel>
 </Border>

 <!-- ===== Notifications Discord (webhook du perso) ===== -->
 <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="{DynamicResource L.Bots.Settings.WebhookTitle}" />
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.Settings.WebhookHint}" />
 <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
 <TextBox Grid.Column="0" Text="{Binding Settings.DiscordWebhookUrl}" Watermark="https://discord.com/api/webhooks/…" Height="32" VerticalContentAlignment="Center" />
 <Button Grid.Column="1" Classes="ghost" Height="32" Padding="12,0" Command="{Binding Settings.TestWebhookCommand}" Content="{DynamicResource L.Bots.Settings.WebhookTest}" />
 </Grid>
 <CheckBox IsChecked="{Binding Settings.NotifyAnomalyOpened}" FontSize="13" Content="{DynamicResource L.Bots.Settings.NotifyAnomalyOpened}" />
 <CheckBox IsChecked="{Binding Settings.NotifyAnomalyClosed}" FontSize="13" Content="{DynamicResource L.Bots.Settings.NotifyAnomalyClosed}" />
 <CheckBox IsChecked="{Binding Settings.NotifyResale}" FontSize="13" Content="{DynamicResource L.Bots.Settings.NotifyResale}" />
 <CheckBox IsChecked="{Binding Settings.NotifyForge}" FontSize="13" Content="{DynamicResource L.Bots.Settings.NotifyForge}" />
 </StackPanel>
 </Border>
 </StackPanel>
 </ScrollViewer>
 </TabItem>

 <!-- Onglet Paquets -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon exchange}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabPackets}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <StackPanel Spacing="10" Margin="0,10,0,0">
 <Grid ColumnDefinitions="*,Auto">
 <TextBox Grid.Column="0" MaxWidth="300" HorizontalAlignment="Left" Height="30" MinHeight="30"
 Text="{Binding SelectedBot.PacketSearch}" Watermark="{DynamicResource L.Bots.Packet.Search}" />
 <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
 <Button Classes="ghost" Classes.accent="{Binding SelectedBot.FilterIsAll}" Height="30" MinWidth="0" Command="{Binding SetFilterCommand}" CommandParameter="all">
 <TextBlock Text="{DynamicResource L.Bots.Filter.All}" FontSize="12" />
 </Button>
 <Button Classes="ghost" Classes.accent="{Binding SelectedBot.FilterIsIn}" Height="30" MinWidth="0" Command="{Binding SetFilterCommand}" CommandParameter="in">
 <TextBlock Text="{DynamicResource L.Bots.Filter.In}" FontSize="12" />
 </Button>
 <Button Classes="ghost" Classes.accent="{Binding SelectedBot.FilterIsOut}" Height="30" MinWidth="0" Command="{Binding SetFilterCommand}" CommandParameter="out">
 <TextBlock Text="{DynamicResource L.Bots.Filter.Out}" FontSize="12" />
 </Button>
 <Button Classes="ghost" Classes.accent="{Binding SelectedBot.FilterIsNamed}" Height="30" MinWidth="0" Command="{Binding SetFilterCommand}" CommandParameter="named">
 <TextBlock Text="{DynamicResource L.Bots.Filter.Named}" FontSize="12" />
 </Button>
 <ToggleButton Classes="ghost" Height="30" Width="34" MinWidth="0" Padding="0" IsChecked="{Binding SelectedBot.PacketPinnedOnly}"
 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
 ToolTip.Tip="{DynamicResource L.Bots.Packet.PinnedOnly}">
 <PathIcon Data="{StaticResource IconPin}" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
 </ToggleButton>
 <Button Classes="ghost" Height="30" Width="34" MinWidth="0" Command="{Binding ClearConsoleCommand}"
 ToolTip.Tip="{DynamicResource L.Bots.ClearConsole}">
 <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
 </Button>
 </StackPanel>
 </Grid>
 <Grid ColumnDefinitions="*,300" ColumnSpacing="10">
 <!-- flux (chaque ligne selectionnable) -->
 <Border Grid.Column="0" Height="340" CornerRadius="10" Background="{StaticResource Surface1Brush}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" ClipToBounds="True">
 <ListBox ItemsSource="{Binding SelectedBot.ConsoleLines}" SelectedItem="{Binding SelectedBot.SelectedLine}"
 Background="Transparent" BorderThickness="0" Padding="6,6">
 <ListBox.ItemTemplate>
 <DataTemplate x:DataType="vm:PacketLineViewModel">
 <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
 TextElement.FontFamily="Cascadia Code,Consolas,Menlo,monospace" TextElement.FontSize="11.5">
 <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
 <TextBlock Grid.Column="1" Text="{Binding Arrow}" Foreground="{Binding Brush}" Margin="0,0,8,0" />
 <TextBlock Grid.Column="2" Text="{Binding Display}" Foreground="{Binding Brush}" TextTrimming="CharacterEllipsis" />
 <TextBlock Grid.Column="3" Text="{Binding Preview}" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" />
 <ToggleButton Grid.Column="4" Classes="pinbtn" IsChecked="{Binding Pinned}" Background="Transparent"
 BorderThickness="0" Padding="0" MinWidth="0" Width="22" Height="18" Margin="6,0,0,0"
 VerticalAlignment="Center" ToolTip.Tip="{DynamicResource L.Bots.Packet.Pin}">
 <TextBlock Text="📌" FontSize="10" />
 </ToggleButton>
 </Grid>
 </DataTemplate>
 </ListBox.ItemTemplate>
 </ListBox>
 </Border>
 <!-- inspecteur: contenu decode du paquet selectionne -->
 <Border Grid.Column="1" Height="340" CornerRadius="10" Background="{StaticResource Surface1Brush}"
 BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="1" ClipToBounds="True">
 <Grid RowDefinitions="Auto,*">
 <!-- Bascule Arbre / JSON / Hex + Copier -->
 <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,8,10,4">
 <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
 <Button Classes="ghost" Classes.accent="{Binding SelectedBot.PacketViewIsTree}" Height="24" MinWidth="0" Padding="9,0" Command="{Binding SetPacketViewCommand}" CommandParameter="tree">
 <TextBlock Text="{DynamicResource L.Bots.Packet.Tree}" FontSize="11" />
 </Button>
 <Button Classes="ghost" Classes.accent="{Binding SelectedBot.PacketViewIsJson}" Height="24" MinWidth="0" Padding="9,0" Command="{Binding SetPacketViewCommand}" CommandParameter="json">
 <TextBlock Text="JSON" FontSize="11" />
 </Button>
 <Button Classes="ghost" IsVisible="{Binding IsDeveloper}" Classes.accent="{Binding SelectedBot.PacketViewIsHex}" Height="24" MinWidth="0" Padding="9,0" Command="{Binding SetPacketViewCommand}" CommandParameter="hex">
 <TextBlock Text="Hex" FontSize="11" />
 </Button>
 </StackPanel>
 <Button Grid.Column="1" Classes="ghost" Height="24" Width="30" MinWidth="0" Padding="0" Click="OnCopyPacket"
 ToolTip.Tip="{DynamicResource L.Bots.Copy}">
 <PathIcon Data="{StaticResource IconCopy}" Width="12" Height="12" />
 </Button>
 </Grid>
 <ScrollViewer Grid.Row="1" Padding="10,0,10,8" HorizontalScrollBarVisibility="Auto">
 <TextBox Text="{Binding SelectedBot.InspectorText}" IsReadOnly="True"
 Background="Transparent" BorderThickness="0" Padding="0"
 FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="11.5"
 Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="NoWrap" />
 </ScrollViewer>
 </Grid>
 </Border>
 </Grid>
 <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource L.Bots.ConsoleHint}" />
 <!-- The raw packet stream above is the ordinary workflow. The additional offline
      evidence/verification tools remain available, but are collapsed by default. -->
 <Expander Header="Outils de diagnostic du protocole" IsExpanded="False">
 <StackPanel Spacing="12" Margin="8,12,8,8">
 <TextBlock Text="Vérifications hors jeu, indépendantes des actions du bot."
 Classes="caption" TextWrapping="Wrap" />
 <views:MZP4OfflinePacketPanel />
 <views:MZP6ProtocolInspectorPanel />
 </StackPanel>
 </Expander>
 </StackPanel>
 </TabItem>

 <!-- Onglet Infos -->
 <TabItem>
 <TabItem.Header>
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon character}" Width="15" Height="15" VerticalAlignment="Center" />
 <TextBlock Text="{DynamicResource L.Bots.TabInfos}" VerticalAlignment="Center" />
 </StackPanel>
 </TabItem.Header>
 <StackPanel Spacing="14" Margin="0,12,0,0">
 <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Character}" />
 <TextBlock Text="{Binding SelectedBot.Row.CharacterName}" Classes="pii" Foreground="{StaticResource TextPrimaryBrush}" />
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Breed}" />
 <TextBlock Text="{Binding SelectedBot.Row.Breed}" Foreground="{StaticResource TextPrimaryBrush}" />
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Gender}" />
 <TextBlock Text="{Binding SelectedBot.Row.Gender}" Foreground="{StaticResource TextPrimaryBrush}" />
 </StackPanel>
 </Grid>
 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />
 <!-- Compte et progression : abonnement, kamas (sac / coffre), expérience du niveau, énergie -->
 <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
 <StackPanel Grid.Column="0" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Subscription}" />
 <TextBlock Text="{Binding SelectedBot.SubscriptionText, FallbackValue='—'}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
 <TextBlock Classes="caption" Foreground="#E6B450" Text="{DynamicResource L.Info.SubSoon}"
 IsVisible="{Binding SelectedBot.SubscriptionWarn, FallbackValue=False}" />
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Kamas}" />
 <TextBlock Text="{Binding SelectedBot.InfoKamasText, FallbackValue='—'}" Foreground="#E6B450" FontWeight="SemiBold" />
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="3">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.BankKamas}" />
 <TextBlock Text="{Binding SelectedBot.InfoBankKamasText, FallbackValue='—'}" Foreground="#E6B450" FontWeight="SemiBold" />
 </StackPanel>
 </Grid>
 <Grid ColumnDefinitions="2*,*" ColumnSpacing="18">
 <StackPanel Grid.Column="0" Spacing="4">
 <Grid ColumnDefinitions="*,Auto">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Experience}" VerticalAlignment="Center" />
 <TextBlock Text="{Binding SelectedBot.XpLevelText, FallbackValue=''}" Foreground="{DynamicResource AccentBrightBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Grid.Column="1" Text="{Binding SelectedBot.InfoXpText, FallbackValue='—'}" Foreground="{StaticResource TextPrimaryBrush}" />
 </Grid>
 <ProgressBar Height="6" CornerRadius="3" Minimum="0" Maximum="100" Foreground="#6EA8FE"
 Value="{Binding SelectedBot.XpPercent, FallbackValue=0}" IsVisible="{Binding SelectedBot.HasXpBar, FallbackValue=False}" />
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="4">
 <Grid ColumnDefinitions="*,Auto">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Energy}" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Text="{Binding SelectedBot.EnergyText, FallbackValue='—'}" Foreground="{StaticResource TextPrimaryBrush}" />
 </Grid>
 <ProgressBar Height="6" CornerRadius="3" Minimum="0" Maximum="100" Foreground="#63D3A6"
 Value="{Binding SelectedBot.EnergyPercent, FallbackValue=0}" IsVisible="{Binding SelectedBot.HasEnergy, FallbackValue=False}" />
 </StackPanel>
 </Grid>
 <StackPanel Spacing="3" IsVisible="{Binding SelectedBot.HasAlterations, FallbackValue=False}">
 <TextBlock Classes="label" Text="{DynamicResource L.Info.Alterations}" />
 <TextBlock Text="{Binding SelectedBot.AlterationsText, FallbackValue=''}" Foreground="#9BE07A" TextWrapping="Wrap" />
 </StackPanel>
 <!-- Points de caractéristiques : dépense manuelle (hors combat, 2 clics) -->
 <StackPanel Spacing="6">
 <StackPanel Orientation="Horizontal" Spacing="8">
 <TextBlock Classes="label" Text="Points de caractéristiques" VerticalAlignment="Center" />
 <TextBlock Text="{Binding StatPointsText}" Foreground="{DynamicResource AccentBrightBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
 </StackPanel>
 <Grid ColumnDefinitions="160,110,Auto,*" ColumnSpacing="8">
 <ComboBox ItemsSource="{Binding StatChoices}" SelectedIndex="{Binding StatChoiceIndex}" HorizontalAlignment="Stretch" />
 <NumericUpDown Grid.Column="1" Value="{Binding StatAmount}" Minimum="1" Maximum="1000" FormatString="0" />
 <Button Grid.Column="2" Classes.primary="{Binding StatSpendArmed}" Classes.ghost="{Binding !StatSpendArmed}"
 Command="{Binding SpendStatPointsCommand}" IsEnabled="{Binding !StatSpendBusy}"
 ToolTip.Tip="Hors combat. Budget de points à investir selon les paliers ; confirmation en deux clics.">
 <TextBlock Text="{Binding StatSpendLabel}" />
 </Button>
 <TextBlock Grid.Column="3" Text="{Binding StatSpendText}" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" />
 </Grid>
 </StackPanel>
 <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />
 <!-- Stats de combat live (PV / PA / PM / PO) lues des paquets (jxg/kub/dégâts) -->
 <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
 <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10">
 <StackPanel Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon tx_lifePoints}" Width="16" Height="16" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Life}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding SelectedBot.LifeText}" Foreground="#FF6B7A" FontSize="18" FontWeight="SemiBold" />
 </StackPanel>
 </Border>
 <Border Grid.Column="1" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10">
 <StackPanel Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon tx_actionPoints}" Width="16" Height="16" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Pa}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding SelectedBot.PaText}" Foreground="#6EA8FE" FontSize="18" FontWeight="SemiBold" />
 </StackPanel>
 </Border>
 <Border Grid.Column="2" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10">
 <StackPanel Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon tx_movementPoints}" Width="16" Height="16" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Pm}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding SelectedBot.PmText}" Foreground="#63D3A6" FontSize="18" FontWeight="SemiBold" />
 </StackPanel>
 </Border>
 <Border Grid.Column="3" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10">
 <StackPanel Spacing="4">
 <StackPanel Orientation="Horizontal" Spacing="7">
 <Image Source="{svc:GameIcon tx_range}" Width="16" Height="16" VerticalAlignment="Center" />
 <TextBlock Classes="label" Text="{DynamicResource L.Bots.Po}" VerticalAlignment="Center" />
 </StackPanel>
 <TextBlock Text="{Binding SelectedBot.RangeText}" Foreground="#E6B450" FontSize="18" FontWeight="SemiBold" />
 </StackPanel>
 </Border>
 </Grid>
 <TextBlock Classes="caption" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
 Text="{DynamicResource L.Bots.StatsHint}" />
 <!-- Métiers du personnage : niveaux/XP provenant des messages réellement décodés.
      Aucun pourcentage n'est affiché tant que les bornes XP ne sont pas connues. -->
 <Border Classes="card" IsVisible="{Binding SelectedBot.HasJobs, FallbackValue=False}">
 <StackPanel Spacing="10">
 <TextBlock Classes="section" Text="Métiers" />
 <ItemsControl ItemsSource="{Binding SelectedBot.Jobs}">
 <ItemsControl.ItemsPanel>
 <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
 </ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate>
 <DataTemplate x:DataType="vm:JobRow">
 <Border Padding="10" Margin="0,0,10,10" Width="205" BorderBrush="{StaticResource TextMutedBrush}" BorderThickness="0.5" CornerRadius="8">
 <StackPanel Spacing="5">
 <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
 <Image Grid.Column="0" Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Center" />
 <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
 <TextBlock Grid.Column="2" Text="{Binding Level, StringFormat='Niv. {0}'}" Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" />
 </Grid>
 <TextBlock Text="{Binding XpText}" Classes="caption" />
 <ProgressBar IsVisible="{Binding HasXp}" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="5" />
 </StackPanel>
 </Border>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </StackPanel>
 </Border>
 </StackPanel>
 </TabItem>

 <TabItem>
 <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="{StaticResource IconTreasure}" Width="15" Height="15" /><TextBlock Text="Chasse au trésor" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
 <views:TreasureView DataContext="{Binding Treasure}" />
 </TabItem>
 <TabItem>
 <TabItem.Header><StackPanel Orientation="Horizontal" Spacing="7"><PathIcon Data="{StaticResource IconWrench}" Width="15" Height="15" /><TextBlock Text="Forgemagie" VerticalAlignment="Center" /></StackPanel></TabItem.Header>
 <views:SmithMagicView DataContext="{Binding SmithMagic}" />
 </TabItem>
 </TabControl>
 </Border>
 <!-- Barre d'état (comme MizanBot) -->
 <Border Classes="card" Padding="16,10">
 <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="22" VerticalAlignment="Center">
 <StackPanel Grid.Column="0" Spacing="4">
 <Grid ColumnDefinitions="Auto,*,Auto"><Image Source="{svc:GameIcon tx_lifePoints}" Width="13" Height="13" Margin="0,0,6,0" />
 <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource L.Bots.Life}" /><TextBlock Grid.Column="2" Text="{Binding SelectedBot.LifeText}" Foreground="#FF6B7A" FontWeight="SemiBold" FontSize="12" /></Grid>
 <ProgressBar Height="5" CornerRadius="3" Minimum="0" Maximum="{Binding SelectedBot.CharMaxLife, FallbackValue=1}" Value="{Binding SelectedBot.CharLife, FallbackValue=0}" Foreground="#FF6B7A" IsVisible="{Binding SelectedBot.HasCharStats, FallbackValue=False}" />
 </StackPanel>
 <StackPanel Grid.Column="1" Spacing="4">
 <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="caption" Text="{DynamicResource L.Info.Energy}" /><TextBlock Grid.Column="1" Text="{Binding SelectedBot.EnergyText, FallbackValue='—'}" FontWeight="SemiBold" FontSize="12" /></Grid>
 <ProgressBar Height="5" CornerRadius="3" Minimum="0" Maximum="100" Foreground="#63D3A6" Value="{Binding SelectedBot.EnergyPercent, FallbackValue=0}" IsVisible="{Binding SelectedBot.HasEnergy, FallbackValue=False}" />
 </StackPanel>
 <StackPanel Grid.Column="2" Spacing="4">
 <Grid ColumnDefinitions="Auto,*,Auto"><Image Source="{svc:GameIcon tx_pods}" Width="13" Height="13" Margin="0,0,6,0" />
 <TextBlock Grid.Column="1" Classes="caption" Text="{DynamicResource L.Bots.Pods}" /><TextBlock Grid.Column="2" Text="{Binding SelectedBot.Pods, FallbackValue='—', TargetNullValue='—'}" FontWeight="SemiBold" FontSize="12" /></Grid>
 <ProgressBar Height="5" CornerRadius="3" Minimum="0" Maximum="100" Value="{Binding SelectedBot.PodsPercent, FallbackValue=0}" Foreground="{Binding SelectedBot.PodsBrush}" IsVisible="{Binding SelectedBot.HasPods, FallbackValue=False}" />
 </StackPanel>
 <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
 <TextBlock Classes="caption" Text="{DynamicResource L.Info.Kamas}" /><TextBlock Text="{Binding SelectedBot.InfoKamasText, FallbackValue='—'}" Foreground="#E6B450" FontWeight="SemiBold" FontSize="12" />
 </StackPanel>
 <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
 <TextBlock Classes="caption" Text="{DynamicResource L.Bots.Map}" />
 <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding SelectedBot.Row.MapCoords}" Foreground="{DynamicResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="12" />
 <TextBlock Text="{Binding SelectedBot.ZoneText, FallbackValue=''}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" /></StackPanel>
 </StackPanel>
 </Grid>
 </Border>

 </StackPanel>
 </ScrollViewer>
 </Grid>
 <views:NoCodeWizardOverlay Grid.ColumnSpan="2"/>
 </Grid>
</UserControl>
