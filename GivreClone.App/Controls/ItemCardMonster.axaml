<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:social="using:GivreClone.App.Services.Social"
             x:Class="GivreClone.App.Controls.ItemCardMonster"
             x:DataType="social:MonsterHoverModel"
             MinWidth="240" MaxWidth="380">
  <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}"
          BorderThickness="1" CornerRadius="12" Padding="12">
    <StackPanel Spacing="4">
      <TextBlock Classes="section" Text="{Binding Title}" />
      <TextBlock Text="{Binding LevelLine}" />
      <TextBlock Text="{Binding XpLine}" />
      <TextBlock Text="{Binding MapLine}" IsVisible="{Binding HasMap}" />
      <TextBlock Text="{Binding MembersText}" TextWrapping="Wrap" IsVisible="{Binding HasMembers}" />
    </StackPanel>
  </Border>
</UserControl>
