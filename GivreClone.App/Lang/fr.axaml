 <sys:String x:Key="L.Bots.TabInventory">Inventaire</sys:String>
 <sys:String x:Key="L.Bots.Inventory.Empty">Inventaire vide ou pas encore reçu — relance le bot et reconnecte le personnage pour charger le sac.</sys:String>
 <sys:String x:Key="L.Bots.TabBank">Banque</sys:String>
 <sys:String x:Key="L.Bots.Bank.DepositType">Type de dépôt</sys:String>
 <sys:String x:Key="L.Bots.Bank.Empty">Coffre vide ou pas encore ouvert — ouvre ta banque en jeu (ou via un dépôt du script) pour charger son contenu.</sys:String>
 <sys:String x:Key="L.Bots.Bank.DepAll">Déposer tout l'inventaire</sys:String>
 <sys:String x:Key="L.Bots.Bank.DepExisting">Déposer les objets déjà présents</sys:String>
 <sys:String x:Key="L.Bots.Bank.DepVisible">Déposer les objets visibles</sys:String>
 <sys:String x:Key="L.Bots.Search">Rechercher (nom, gid)…</sys:String>
 <sys:String x:Key="L.Bots.Items">Objets</sys:String>
