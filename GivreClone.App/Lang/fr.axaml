 <!-- Login / Licence -->
 <sys:String x:Key="L.Login.Title">GivreClone</sys:String>
 <sys:String x:Key="L.Login.Subtitle">Entrez votre clé de licence pour continuer</sys:String>
 <sys:String x:Key="L.Login.Placeholder">XXXX-XXXX-XXXX-XXXX</sys:String>
 <sys:String x:Key="L.Login.Validate">Valider la licence</sys:String>
 <sys:String x:Key="L.Login.Remember">Rester connecté</sys:String>
 <sys:String x:Key="L.Login.Help">Besoin d'aide ? Rejoindre le Discord</sys:String>
 <sys:String x:Key="L.Login.Loading">Chargement…</sys:String>
 <sys:String x:Key="L.Login.Connecting">Contact du serveur…</sys:String>
 <sys:String x:Key="L.Login.Success">Licence validée !</sys:String>
 <sys:String x:Key="L.Login.ErrInvalid">Clé de licence invalide. Vérifiez votre saisie.</sys:String>
 <sys:String x:Key="L.Login.ErrRejected">Licence refusée. Contactez le support.</sys:String>
 <sys:String x:Key="L.Auth.Expired">Votre licence a expiré.</sys:String>
 <sys:String x:Key="L.Auth.Hwid">Cette licence est liée à un autre appareil. Réinitialisez votre HWID ou contactez le support.</sys:String>
 <sys:String x:Key="L.Auth.Blacklisted">Votre appareil a été blacklisté.</sys:String>
 <sys:String x:Key="L.Auth.NotFound">Clé de licence introuvable.</sys:String>
 <sys:String x:Key="L.Auth.Banned">Cette licence a été bannie.</sys:String>
 <sys:String x:Key="L.Auth.BannedReasonFmt">Cette licence a été bannie. Raison: {0}</sys:String>
 <sys:String x:Key="L.Auth.TooManyDevices">Trop d'appareils utilisent cette licence.</sys:String>
 <sys:String x:Key="L.Auth.Paused">Votre licence est actuellement en pause.</sys:String>
 <sys:String x:Key="L.Auth.RateLimited">Trop de tentatives. Patientez avant de réessayer.</sys:String>
 <sys:String x:Key="L.Auth.Connection">Échec de connexion. Vérifiez votre connexion Internet et réessayez.</sys:String>
 <sys:String x:Key="L.Auth.DateTime">La date et l'heure de votre appareil sont désynchronisées. Corrigez-les et réessayez.</sys:String>
 <sys:String x:Key="L.Auth.SignatureError">Erreur de signature du client ({0}) — mets à jour GivreClone.</sys:String>
 <sys:String x:Key="L.Auth.ClockWrong">Horloge système incorrecte — active le réglage automatique de la date et de l’heure de Windows, puis reconnecte-toi.</sys:String>
 <sys:String x:Key="L.Auth.Verify">Impossible de vérifier la réponse du serveur. Veuillez réessayer.</sys:String>
 <sys:String x:Key="L.Auth.Unavailable">Le serveur est indisponible. Veuillez réessayer plus tard.</sys:String>
 <sys:String x:Key="L.Auth.Generic">Échec de la connexion. Réessayez ou contactez le support.</sys:String>
 <sys:String x:Key="L.Auth.SessionEnded">Session terminée. Reconnectez-vous.</sys:String>
 <sys:String x:Key="L.LicLink.Resuming">Reconnexion à la licence…</sys:String>
 <sys:String x:Key="L.LicLink.WaitingNetwork">Licence: en attente du réseau…</sys:String>
 <sys:String x:Key="L.LicLink.Stalled">Licence injoignable — bots en pause, nouvel essai automatique</sys:String>
 <sys:String x:Key="L.LicLink.NeedsUser">Session de licence interrompue — bots en pause</sys:String>
 <sys:String x:Key="L.LicLink.Retry">Reconnecter</sys:String>
 <sys:String x:Key="L.LicLink.Paused">Bots en pause: reconnexion de la licence en cours</sys:String>
 <sys:String x:Key="L.LicLink.Offline">Serveur de licence injoignable — bots en pause, reconnexion automatique</sys:String>
 <sys:String x:Key="L.LicLink.Tip">Votre licence reste valide: la session est reprise automatiquement après une coupure réseau ou une mise en veille.</sys:String>
 <sys:String x:Key="L.Mapping.MissingTitle">Mapping incomplet</sys:String>
 <sys:String x:Key="L.Mapping.MissingBody">{0} message(s) essentiel(s) du protocole sont introuvables dans le mapping. Le bot ne pourra pas décoder les paquets (carte, déplacement, personnage). Vérifiez que le mapping est publié et complet sur le serveur. Lancer quand même ?</sys:String>
 <sys:String x:Key="L.Mapping.LaunchAnyway">Lancer quand même</sys:String>
 <sys:String x:Key="L.Control.KillTitle">Service indisponible</sys:String>
 <sys:String x:Key="L.Control.KillDefault">Le service est temporairement indisponible. Réessayez plus tard.</sys:String>
 <sys:String x:Key="L.Control.OutdatedTitle">Mise à jour requise</sys:String>
 <sys:String x:Key="L.Control.OutdatedDefault">Une nouvelle version est requise. Téléchargez la dernière build pour continuer.</sys:String>
 <sys:String x:Key="L.Control.VersionFmt">Votre version: {0} — requise: {1}</sys:String>
 <sys:String x:Key="L.Control.UpdateNow">Mettre à jour maintenant</sys:String>
 <sys:String x:Key="L.Control.Updating">Préparation de la mise à jour…</sys:String>
 <sys:String x:Key="L.Control.Downloading">Téléchargement… {0}%</sys:String>
 <sys:String x:Key="L.Control.Restarting">Installation… GivreClone va redémarrer.</sys:String>
 <sys:String x:Key="L.Control.Retry">Réessayer</sys:String>
 <sys:String x:Key="L.Control.WhatsNew">Nouveautés: {0}</sys:String>
 <sys:String x:Key="L.Control.Unreachable">Connexion au serveur requise pour vérifier l'autorisation. Vérifiez votre connexion et réessayez.</sys:String>
 <sys:String x:Key="L.Control.OfferTitle">Mise à jour disponible</sys:String>
 <sys:String x:Key="L.Control.OfferBody">Une nouvelle version de GivreClone est disponible.</sys:String>
 <sys:String x:Key="L.Control.OfferHint">Vos bots continuent de tourner. « Mettre à jour maintenant » les arrête et redémarre GivreClone; sinon, la mise à jour se fera au prochain lancement.</sys:String>
 <sys:String x:Key="L.Control.Later">Au prochain lancement</sys:String>
 <sys:String x:Key="L.Control.OfferToast">Mise à jour {0} disponible: vos bots continuent</sys:String>
 <sys:String x:Key="L.Control.Deferred">Mise à jour reportée au prochain lancement de GivreClone</sys:String>
 <sys:String x:Key="L.Control.PendingFmt">MAJ {0}</sys:String>
 <sys:String x:Key="L.Control.PendingTip">Mise à jour prête: elle s'installera au prochain lancement. Cliquez pour l'installer maintenant.</sys:String>

 <!-- Pré-extraction des cartes (cache disque, 1er lancement / après un patch Dofus) -->
 <sys:String x:Key="L.MapExtract.Title">Préparation des cartes</sys:String>
 <sys:String x:Key="L.MapExtract.Explain">Première extraction des cartes du jeu depuis les fichiers de Dofus. C'est une opération unique (refaite seulement après une mise à jour de Dofus): elle accélère durablement tous les chargements de carte. Vous pouvez continuer à utiliser GivreClone pendant ce temps.</sys:String>
 <sys:String x:Key="L.MapExtract.Background">Continuer en arrière-plan</sys:String>
 <sys:String x:Key="L.MapExtract.BgStarted">Préparation des cartes: elle continue en arrière-plan. Vous serez prévenu à la fin.</sys:String>
 <sys:String x:Key="L.MapExtract.Done">Préparation des cartes terminée ({0} cartes prêtes).</sys:String>
 <sys:String x:Key="L.MappingLoad.Title">Chargement du protocole</sys:String>
 <sys:String x:Key="L.MappingLoad.Explain">Récupération du protocole de jeu depuis le serveur. Cela ne prend qu'un instant — on s'assure qu'il est bien chargé avant de lancer le bot.</sys:String>

