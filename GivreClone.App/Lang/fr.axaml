 <sys:String x:Key="L.Reconnect.SocketLog">Reconnexion demandée: attente annulée, reconnexion immédiate.</sys:String>
 <sys:String x:Key="L.Reconnect.SocketCutLog">Reconnexion demandée: session coupée, reconnexion immédiate (le bot reste dans la liste).</sys:String>
 <sys:String x:Key="L.Reconnect.SocketNow">Socket: reconnexion…</sys:String>
