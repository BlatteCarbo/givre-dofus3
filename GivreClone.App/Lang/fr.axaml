 <sys:String x:Key="L.Bots.Hdv.MyListings">Mes ventes en cours</sys:String>
    <sys:String x:Key="L.Bots.Hdv.AddRelistToBuy">Ajouter les objets remis en vente</sys:String>
    <sys:String x:Key="L.Bots.Hdv.AdvancedDelays">Délais avancés</sys:String>
    <sys:String x:Key="L.Bots.Hdv.AdvancedDelaysExplain">Chaque délai est tiré au hasard entre les deux bornes, pour ne jamais répéter le même rythme.</sys:String>
    <sys:String x:Key="L.Bots.Hdv.Analysis">Analyse</sys:String>
    <sys:String x:Key="L.Bots.Hdv.Analyze">Analyser</sys:String>
    <sys:String x:Key="L.Bots.Hdv.AutoBuy">Achat automatique</sys:String>
    <sys:String x:Key="L.Bots.Hdv.AutoRelist">Remise en vente automatique</sys:String>
    <sys:String x:Key="L.Bots.Hdv.AutoRepricing">Repricing automatique</sys:String>
