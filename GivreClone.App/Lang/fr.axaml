 <sys:String x:Key="L.Mapping.NewProfile">Nouveau profil</sys:String>
 <sys:String x:Key="L.Mapping.NewProfileTip">Créer un profil (copie du profil actif) pour la version détectée</sys:String>
 <sys:String x:Key="L.Mapping.OverwriteReference">Écraser la référence</sys:String>
 <sys:String x:Key="L.Mapping.OverwriteReferenceTip">Remplacer la référence beta (profil « Défaut ») par les mappings du profil actif</sys:String>
