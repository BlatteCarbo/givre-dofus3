 <sys:String x:Key="L.Bots.Hdv.Bulk.CheckResourcesTip">Cocher toutes les ressources de la liste</sys:String>
 <sys:String x:Key="L.Bots.Hdv.Bulk.UncheckAll">Aucun</sys:String>
 <sys:String x:Key="L.Bots.Hdv.Bulk.CheckedFmt">{0} coché(s)</sys:String>
 <sys:String x:Key="L.Bots.Hdv.Bulk.NothingChecked">Coche au moins un objet à mettre en vente.</sys:String>
