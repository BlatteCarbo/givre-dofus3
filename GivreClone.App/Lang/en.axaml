 <!-- Mapping -->
 <sys:String x:Key="L.Mapping.Title">Manual mapping</sys:String>
 <sys:String x:Key="L.Mapping.Intro">Reference = clean beta ("Default" profile). Create one profile per client build for your mapping - you can also overwrite the reference. "Save" writes the active profile.</sys:String>
 <sys:String x:Key="L.Mapping.ProfileLabel">Profile:</sys:String>
 <sys:String x:Key="L.Mapping.DeleteProfileTip">Delete the active profile (the default profile cannot be deleted)</sys:String>
 <sys:String x:Key="L.Mapping.NewProfilePlaceholder">New profile name (empty = detected game version)</sys:String>
 <sys:String x:Key="L.Mapping.NewProfile">New profile</sys:String>
 <sys:String x:Key="L.Mapping.NewProfileTip">Create a profile (copy of the active profile) for the detected version</sys:String>
 <sys:String x:Key="L.Mapping.OverwriteReference">Overwrite reference</sys:String>
 <sys:String x:Key="L.Mapping.OverwriteReferenceTip">Replace the beta reference ("Default" profile) with the active profile's mappings</sys:String>
