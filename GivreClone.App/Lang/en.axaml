<ResourceDictionary xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="using:System"
 x:Class="GivreClone.App.Lang.En">

 <sys:String x:Key="L.Bots.Settings.StatsTitle">Characteristics: ordered targets</sys:String>
 <sys:String x:Key="L.Bots.Settings.StatsEnabled">Enable automatic spending for this character</sys:String>
 <sys:String x:Key="L.Bots.Settings.StatsHint">At the next level, outside combat: raise the first base to its cap, then the next. “Remainder” receives all remaining points; later rows are not used. Costs come from the game's breed tiers. Overrides the single combat target while enabled; Auto-combat permission required. Spending is irreversible and each send is logged. Select a row to move or remove it.</sys:String>
 <sys:String x:Key="L.Bots.Settings.StatsCap">Base cap (excluding bonuses)</sys:String>
 <sys:String x:Key="L.Bots.Settings.StatsRemainder">Remainder</sys:String>
 <sys:String x:Key="L.Bots.Settings.StatsAdd">Add target</sys:String>
 <sys:String x:Key="L.Bots.Settings.StatsUp">Move up</sys:String>
 <sys:String x:Key="L.Bots.Settings.StatsDown">Move down</sys:String>
 <sys:String x:Key="L.Bots.Settings.StatsRemove">Remove target</sys:String>
 <!-- Common -->
 <sys:String x:Key="L.Bots.Settings.RegenTitle">Regeneration before combat</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenEnable">Enable for this character</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenStart">Start below (%)</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenStop">Stop at (%)</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenFood">Food (item ID, 0 = none)</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenTeam">Wait for team HP before the next fight</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenHint">Server-confirmed HP only. Offline members or members absent from the active roster are ignored; online unknown HP, dead, fighting or away members block combat after a 30 s wait. Each member heals using regenerate() or their own settings. No food: rest; timeout: no fight. Stop threshold is at least the start threshold.</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenOff">Operator regeneration disabled.</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenUnknown">Waiting for server-confirmed HP.</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenWaiting">Waiting for team: same map, alive, out of combat, HP at stop threshold.</sys:String>
 <sys:String x:Key="L.Bots.Settings.RegenReady">HP received; team ready if waiting is enabled.</sys:String>
 <sys:String x:Key="L.Socket.Delete.Tooltip">Delete character "{0}"</sys:String>
 <sys:String x:Key="L.Socket.Delete.TypeName">To confirm permanent deletion, type the exact character name shown above.</sys:String>
 <sys:String x:Key="L.Socket.Delete.NameMismatch">Type the exact character name to confirm deletion.</sys:String>
 <sys:String x:Key="L.Socket.Create.SelectAccount">Select exactly one account to create a character.</sys:String>
 <sys:String x:Key="L.Socket.Create.StopAccount">Stop this account before creating a character in the Socket picker.</sys:String>
