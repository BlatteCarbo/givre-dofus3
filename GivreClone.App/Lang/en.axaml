 <!-- Paramètres : trajets -->
 <sys:String x:Key="L.Bots.Settings.Travel">Travel</sys:String>
 <sys:String x:Key="L.Bots.Settings.TravelFast">World-map zaap, ground zaap or haven bag whenever shorter</sys:String>
 <sys:String x:Key="L.Bots.Settings.TravelWalk">Prefer walking</sys:String>
 <sys:String x:Key="L.Bots.Settings.WalkMaxHops">Beyond this many maps on foot, zaap / haven bag allowed (0 = always walk when possible)</sys:String>
 <sys:String x:Key="L.Bots.Settings.TravelWalkHint">Zaap and haven bag are still used when the destination can't be reached on foot (changing island: Astrub → Otomai, Frigost…). Between areas linked on foot (Astrub → Bonta), the bot walks. A world-map zaap is tried first when that zaap is known and the kamas cover it.</sys:String>
 <sys:String x:Key="L.Bots.Settings.ZaapRoute">Zaap shortcut</sys:String>
 <sys:String x:Key="L.Bots.Settings.ZaapRouteAuto">Automatic</sys:String>
 <sys:String x:Key="L.Bots.Settings.ZaapRouteWorld">Zaap from the world map</sys:String>
 <sys:String x:Key="L.Bots.Settings.ZaapRouteGround">Ground zaap</sys:String>
 <sys:String x:Key="L.Bots.Settings.ZaapRouteHaven">Haven bag</sys:String>
 <sys:String x:Key="L.Bots.Settings.ZaapRouteZaapi">Zaapi</sys:String>
 <sys:String x:Key="L.Bots.Settings.ZaapRouteHint">World-map zaap teleports without opening a zaap or the haven bag, only when the character knows that zaap and the kamas cover the last announced cost. Otherwise automatic mode uses the ground zaap, then the haven bag.</sys:String>

