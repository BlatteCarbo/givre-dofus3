 <sys:String x:Key="L.Bots.Hdv.MyListings">My current listings</sys:String>
 <sys:String x:Key="L.Bots.Hdv.AddRelistToBuy">Add relisted items</sys:String>
 <sys:String x:Key="L.Bots.Hdv.AdvancedDelays">Advanced delays</sys:String>
 <sys:String x:Key="L.Bots.Hdv.AdvancedDelaysExplain">Each delay is picked at random between the two bounds, so the same pace is never repeated.</sys:String>
