 <!-- Login / License -->
 <sys:String x:Key="L.Login.Title">GivreClone</sys:String>
 <sys:String x:Key="L.Login.Subtitle">Enter your license key to continue</sys:String>
 <sys:String x:Key="L.Login.Placeholder">XXXX-XXXX-XXXX-XXXX</sys:String>
 <sys:String x:Key="L.Login.Validate">Validate license</sys:String>
 <sys:String x:Key="L.Login.Remember">Keep me signed in</sys:String>
 <sys:String x:Key="L.Login.Help">Need help? Join the Discord</sys:String>
 <sys:String x:Key="L.Login.Loading">Loading…</sys:String>
 <sys:String x:Key="L.Login.Connecting">Contacting server…</sys:String>
 <sys:String x:Key="L.Login.Success">License verified!</sys:String>
 <sys:String x:Key="L.Login.ErrInvalid">Invalid license key. Please check your input.</sys:String>
 <sys:String x:Key="L.Login.ErrRejected">License rejected. Please contact support.</sys:String>
 <sys:String x:Key="L.Auth.Expired">Your license has expired.</sys:String>
 <sys:String x:Key="L.Auth.Hwid">This license is locked to another device. Reset your HWID or contact support.</sys:String>
 <sys:String x:Key="L.Auth.Blacklisted">Your device has been blacklisted.</sys:String>
 <sys:String x:Key="L.Auth.NotFound">License key not found.</sys:String>
 <sys:String x:Key="L.Auth.Banned">This license has been banned.</sys:String>
 <sys:String x:Key="L.Auth.BannedReasonFmt">This license has been banned. Reason: {0}</sys:String>
 <sys:String x:Key="L.Auth.TooManyDevices">Too many devices are using this license.</sys:String>
 <sys:String x:Key="L.Auth.Paused">Your license is currently paused.</sys:String>
 <sys:String x:Key="L.Auth.RateLimited">Too many attempts. Please wait before trying again.</sys:String>
 <sys:String x:Key="L.Auth.Connection">Connection failed. Check your internet connection and try again.</sys:String>
 <sys:String x:Key="L.Auth.DateTime">Your device's date and time are out of sync. Please correct them and retry.</sys:String>
 <sys:String x:Key="L.Auth.SignatureError">Client signature error ({0}) — please update GivreClone.</sys:String>
 <sys:String x:Key="L.Auth.ClockWrong">System clock is wrong — turn on automatic date and time in Windows, then sign in again.</sys:String>
 <sys:String x:Key="L.Auth.Verify">Could not verify the server response. Please try again.</sys:String>
 <sys:String x:Key="L.Auth.Unavailable">The server is unavailable. Please try again later.</sys:String>
 <sys:String x:Key="L.Auth.Generic">Login failed. Please try again or contact support.</sys:String>
 <sys:String x:Key="L.Auth.SessionEnded">Session ended. Please sign in again.</sys:String>
 <sys:String x:Key="L.LicLink.Resuming">Reconnecting to the licence…</sys:String>
 <sys:String x:Key="L.LicLink.WaitingNetwork">Licence: waiting for the network…</sys:String>
 <sys:String x:Key="L.LicLink.Stalled">Licence unreachable — bots paused, retrying automatically</sys:String>
 <sys:String x:Key="L.LicLink.NeedsUser">Licence session interrupted — bots paused</sys:String>
 <sys:String x:Key="L.LicLink.Retry">Reconnect</sys:String>
 <sys:String x:Key="L.LicLink.Paused">Bots paused: reconnecting the licence</sys:String>
 <sys:String x:Key="L.LicLink.Offline">Licence server unreachable — bots paused, reconnecting automatically</sys:String>
 <sys:String x:Key="L.LicLink.Tip">Your licence is still valid: the session resumes automatically after a network outage or sleep.</sys:String>
 <sys:String x:Key="L.Mapping.MissingTitle">Incomplete mapping</sys:String>
 <sys:String x:Key="L.Mapping.MissingBody">{0} essential protocol message(s) are missing from the mapping. The bot won't be able to decode packets (map, movement, character). Make sure the mapping is published and complete on the server. Launch anyway?</sys:String>
 <sys:String x:Key="L.Mapping.LaunchAnyway">Launch anyway</sys:String>
 <sys:String x:Key="L.Control.KillTitle">Service unavailable</sys:String>
 <sys:String x:Key="L.Control.KillDefault">The service is temporarily unavailable. Please try again later.</sys:String>
 <sys:String x:Key="L.Control.OutdatedTitle">Update required</sys:String>
 <sys:String x:Key="L.Control.OutdatedDefault">A newer version is required. Please download the latest build to continue.</sys:String>
 <sys:String x:Key="L.Control.VersionFmt">Your version: {0} — required: {1}</sys:String>
 <sys:String x:Key="L.Control.UpdateNow">Update now</sys:String>
 <sys:String x:Key="L.Control.Updating">Preparing the update…</sys:String>
 <sys:String x:Key="L.Control.Downloading">Downloading… {0}%</sys:String>
 <sys:String x:Key="L.Control.Restarting">Installing… GivreClone will restart.</sys:String>
 <sys:String x:Key="L.Control.Retry">Retry</sys:String>
 <sys:String x:Key="L.Control.WhatsNew">What's new: {0}</sys:String>
 <sys:String x:Key="L.Control.Unreachable">A server connection is required to verify authorization. Check your connection and try again.</sys:String>
 <sys:String x:Key="L.Control.OfferTitle">Update available</sys:String>
 <sys:String x:Key="L.Control.OfferBody">A new version of GivreClone is available.</sys:String>
 <sys:String x:Key="L.Control.OfferHint">Your bots keep running. "Update now" stops them and restarts GivreClone; otherwise the update will be installed on next launch.</sys:String>
 <sys:String x:Key="L.Control.Later">On next launch</sys:String>
 <sys:String x:Key="L.Control.OfferToast">Update {0} available: your bots keep running</sys:String>
 <sys:String x:Key="L.Control.Deferred">Update postponed to the next GivreClone launch</sys:String>
 <sys:String x:Key="L.Control.PendingFmt">Update {0}</sys:String>
 <sys:String x:Key="L.Control.PendingTip">Update ready: it will be installed on next launch. Click to install it now.</sys:String>

 <!-- Map pre-extraction (disk cache, first launch / after a Dofus patch) -->
 <sys:String x:Key="L.MapExtract.Title">Preparing maps</sys:String>
 <sys:String x:Key="L.MapExtract.Explain">First-time extraction of the game's maps from Dofus's files. This runs only once (and again only after a Dofus update): it permanently speeds up every map load. You can keep using GivreClone in the meantime.</sys:String>
 <sys:String x:Key="L.MapExtract.Background">Continue in background</sys:String>
 <sys:String x:Key="L.MapExtract.BgStarted">Preparing maps: it continues in the background. You'll be notified when it's done.</sys:String>
 <sys:String x:Key="L.MapExtract.Done">Maps ready ({0} maps prepared).</sys:String>
 <sys:String x:Key="L.MappingLoad.Title">Loading protocol</sys:String>
 <sys:String x:Key="L.MappingLoad.Explain">Fetching the game protocol from the server. This only takes a moment — we make sure it's fully loaded before launching the bot.</sys:String>

