 <sys:String x:Key="L.Mapping.ColName">Clear name</sys:String>
 <sys:String x:Key="L.Mapping.CodePlaceholder">code</sys:String>
 <sys:String x:Key="L.Mapping.NamePlaceholder">Clear message name</sys:String>
 <sys:String x:Key="L.Mapping.DeleteRowTip">Delete row</sys:String>
 <sys:String x:Key="L.Mapping.AddRow">Add row</sys:String>
 <sys:String x:Key="L.Mapping.BuildNotDetected">build not detected</sys:String>
 <sys:String x:Key="L.Mapping.DetectedBuild">Detected build: {0}</sys:String>
 <sys:String x:Key="L.Mapping.StatusCount">{0} mappings - profile “{1}”.</sys:String>

 <!-- Settings -->
 <sys:String x:Key="L.Settings.Title">Settings</sys:String>
 <sys:String x:Key="L.Settings.Language">Language</sys:String>
 <sys:String x:Key="L.Settings.Appearance">Appearance</sys:String>
 <sys:String x:Key="L.Settings.AppearanceDesc">Interface accent theme. Changes apply instantly.</sys:String>
 <sys:String x:Key="L.Settings.ThemeBlue">Blue</sys:String>
 <sys:String x:Key="L.Settings.ThemePurple">Purple</sys:String>
 <sys:String x:Key="L.Settings.ThemeEmerald">Emerald</sys:String>
 <sys:String x:Key="L.Settings.ThemeCrimson">Crimson</sys:String>
 <sys:String x:Key="L.Settings.ThemeAmber">Amber</sys:String>
 <sys:String x:Key="L.Settings.ThemeDark">Dark (opaque)</sys:String>
 <sys:String x:Key="L.Settings.Audio">Audio</sys:String>
 <sys:String x:Key="L.Settings.UiSounds">Interface sounds</sys:String>
 <sys:String x:Key="L.Settings.UiSoundsDesc">Clicks, navigation, feedback.</sys:String>
 <sys:String x:Key="L.Settings.UiSoundsVolume">Sound volume</sys:String>
 <sys:String x:Key="L.Settings.UiSoundsVolumeDesc">Loudness of interface sounds.</sys:String>
 <sys:String x:Key="L.Settings.AmbientMusic">Ambient music</sys:String>
 <sys:String x:Key="L.Settings.AmbientMusicDesc">Background sound loop.</sys:String>
 <sys:String x:Key="L.Settings.Effects">Effects</sys:String>
 <sys:String x:Key="L.Settings.BgParticles">Background particles</sys:String>
 <sys:String x:Key="L.Settings.BgParticlesDesc">Animated blue dots in the window background.</sys:String>
 <sys:String x:Key="L.Settings.Mods">In-game native mods</sys:String>
 <sys:String x:Key="L.Settings.ModsInject">Inject native mods</sys:String>
 <sys:String x:Key="L.Settings.ModsInjectDesc">Enables the tactical-mode and no-anim options; takes effect on the next client launch.</sys:String>
 <sys:String x:Key="L.Settings.AutoRelaunch">Auto-relaunch</sys:String>
 <sys:String x:Key="L.Settings.AutoRelaunchDesc">If a client closes unexpectedly (crash on launch or external close), relaunches it on its own. Bounded (after 3 crashes in 3 min, relaunch is suspended).</sys:String>
 <sys:String x:Key="L.Settings.Discord">Discord</sys:String>
 <sys:String x:Key="L.Settings.RichPresence">Discord "Playing GivreClone" status</sys:String>
 <sys:String x:Key="L.Settings.RichPresenceDesc">Shows GivreClone in your Discord status (name, elapsed time, Discord/site buttons) like a game. ⚠️ Reveals to your Discord contacts that you use GivreClone. Requires Discord to be running.</sys:String>
 <sys:String x:Key="L.Settings.DiscordJoin">GivreClone Discord</sys:String>
 <sys:String x:Key="L.Settings.DiscordJoinDesc">Support, update announcements, help and script sharing.</sys:String>
 <sys:String x:Key="L.Settings.DiscordJoinBtn">Join the Discord</sys:String>
 <sys:String x:Key="L.Settings.Arch">Archmonsters</sys:String>
 <sys:String x:Key="L.Settings.ArchDm">Receive archmonster Discord DMs</sys:String>
 <sys:String x:Key="L.Settings.ArchDmDesc">Get a Discord DM when one of your characters spots an archmonster. Off: you no longer get the DM, but the detection still goes to the public channel and the admin view. Doesn't affect the in-game alert.</sys:String>
 <sys:String x:Key="L.Sub.EndsOn">Subscription until {0}</sys:String>
 <sys:String x:Key="L.Sub.Unlimited">Unlimited subscription</sys:String>
 <sys:String x:Key="L.Snow.NoBotsTitle">No bots in game</sys:String>
 <sys:String x:Key="L.Snow.NoBotsHint">Launch an account from the Accounts tab to see it appear here.</sys:String>
 <sys:String x:Key="L.Snow.NoBotsGo">Open Accounts</sys:String>
 <sys:String x:Key="L.Arch.Found">Archmonster {0} spotted — {1}</sys:String>
 <sys:String x:Key="L.Arch.Title">Recent archmonsters</sys:String>
 <sys:String x:Key="L.Arch.Empty">No archmonster spotted yet.</sys:String>
 <sys:String x:Key="L.Arch.Legend">Archmonster</sys:String>
 <sys:String x:Key="L.Settings.Privacy">Privacy</sys:String>
 <sys:String x:Key="L.Settings.StreamMode">Recording / Stream mode</sys:String>
 <sys:String x:Key="L.Settings.StreamModeDesc">Blurs every piece of personal info in the interface (login, character, server, exit IP, hardware id) so you can record a video or stream without revealing anything. Purely visual.</sys:String>
 <sys:String x:Key="L.Settings.Skin">Interface</sys:String>
 <sys:String x:Key="L.Settings.SkinSnow">un bot tiers-style interface</sys:String>
 <sys:String x:Key="L.Settings.SkinSnowDesc">Full un bot tiers-style theme: flat grey/violet, top menu bar, chief → mules tree on the left. Reversible (toggle back for the current interface). Applies on restart.</sys:String>
 <sys:String x:Key="L.Settings.SkinRestart.Title">Restart required</sys:String>
 <sys:String x:Key="L.Settings.SkinRestart.Body">The full un bot tiers theme (colors and layout) applies when the app restarts. Restart now? Otherwise it will apply on the next launch.</sys:String>
 <sys:String x:Key="L.Settings.SkinRestart.Ok">Restart now</sys:String>
 <sys:String x:Key="L.Settings.PacketDump">Discovery capture (diagnostic)</sys:String>
 <sys:String x:Key="L.Settings.PacketDumpDesc">Writes the field tree of unrecognised messages to the transport logs. Leave Off during normal use.</sys:String>
 <sys:String x:Key="L.Settings.PacketDumpAll">Exhaustive capture (post-patch rebind)</sys:String>
 <sys:String x:Key="L.Settings.PacketDumpAllDesc">Also dumps messages that are already named. After a Dofus update a mis-rebound code carries a wrong name and would stay invisible. Very verbose: switch on for a single capture only.</sys:String>
 <sys:String x:Key="L.Settings.ViewDensity">View / density</sys:String>
