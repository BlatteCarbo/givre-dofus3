 <sys:String x:Key="L.Lua.Editor.TabScripts">Plantillas de script</sys:String>
 <sys:String x:Key="L.Lua.Editor.TabSnippets">Fragmentos</sys:String>
 <sys:String x:Key="L.Lua.Editor.Replace">Reemplazar el script</sys:String>
 <sys:String x:Key="L.Lua.Editor.InsertAtCaret">Insertar en el cursor</sys:String>
 <sys:String x:Key="L.Lua.Editor.TemplatesHint">«Reemplazar el script» se puede deshacer (Ctrl+Z). Consejo: en el editor, escribe el activador de un fragmento y luego Intro.</sys:String>
 <sys:String x:Key="L.Lua.Editor.RecentTitle">Scripts recientes</sys:String>
 <sys:String x:Key="L.Lua.Editor.RecentEmpty">Ningún script abierto recientemente.</sys:String>
 <sys:String x:Key="L.Lua.Editor.Library">Carpeta de scripts (%APPDATA%\GivreClone\scripts)</sys:String>
 <sys:String x:Key="L.Lua.Editor.Browse">Examinar…</sys:String>
 <sys:String x:Key="L.Lua.Editor.Open">Abrir</sys:String>
 <sys:String x:Key="L.Lua.Editor.Forget">Quitar de la lista</sys:String>
 <sys:String x:Key="L.Lua.Editor.MissingTag">no encontrado</sys:String>
 <sys:String x:Key="L.Lua.Editor.ApiTitle">Referencia de la API Lua</sys:String>
 <sys:String x:Key="L.Lua.Editor.ApiSearch">Busca una función, un módulo, una palabra de la descripción…</sys:String>
 <sys:String x:Key="L.Lua.Editor.ApiEmpty">Sin resultados.</sys:String>
