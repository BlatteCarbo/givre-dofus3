 <sys:String x:Key="L.Bots.Lua.CopyTip">Copiar la consola — o solo las líneas seleccionadas (clic, Ctrl+clic, Mayús+clic; Ctrl+C)</sys:String>
 <sys:String x:Key="L.Bots.Lua.ClearTip">Vaciar la consola</sys:String>
