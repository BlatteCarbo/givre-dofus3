 <sys:String x:Key="L.Bots.Tab.Actions">Acciones</sys:String>
 <sys:String x:Key="L.Accounts.Title">Cuentas</sys:String>
 <sys:String x:Key="L.Accounts.Subtitle">Añade tus cuentas, asígnales un proxy (pestaña Proxys) y lánzalas - 1 IP por cuenta, cero fugas.</sys:String>
 <sys:String x:Key="L.Accounts.AddTitle">Añadir una cuenta</sys:String>
 <sys:String x:Key="L.Accounts.Login">Usuario</sys:String>
 <sys:String x:Key="L.Accounts.LoginHint">correo o usuario de Ankama</sys:String>
 <sys:String x:Key="L.Accounts.Password">Contraseña</sys:String>
 <sys:String x:Key="L.Accounts.PasswordHint">Cifrada en el disco</sys:String>
 <sys:String x:Key="L.Accounts.AccountLabel">Etiqueta de la cuenta (opcional)</sys:String>
 <sys:String x:Key="L.Accounts.AccountLabelHint">ej: Principal, Mula 1, gremio...</sys:String>
 <sys:String x:Key="L.Accounts.Interface">Interfaz de red</sys:String>
 <sys:String x:Key="L.Accounts.InterfacePick">Elegir una interfaz</sys:String>
 <sys:String x:Key="L.Accounts.RefreshInterfaces">Actualizar</sys:String>
 <sys:String x:Key="L.Accounts.Add">Añadir cuenta</sys:String>
 <sys:String x:Key="L.Accounts.ListTitle">Mis cuentas</sys:String>
 <sys:String x:Key="L.Accounts.Empty">Aún no hay cuentas. Añade una arriba.</sys:String>
 <sys:String x:Key="L.Accounts.Launch">Lanzar</sys:String>
 <sys:String x:Key="L.Accounts.LaunchTip">Lanza esta cuenta con el cliente de Dofus (modo MITM: se abre la ventana del juego y el bot la controla). Este modo queda guardado para esta cuenta: Lanzar todo, el horario, el equipo y el reinicio automático también la lanzarán en MITM.</sys:String>
 <sys:String x:Key="L.Accounts.ModeMitm">MITM</sys:String>
 <sys:String x:Key="L.Accounts.ModeSocket">Socket</sys:String>
 <sys:String x:Key="L.Accounts.ModeMitmTip">Modo de la cuenta: MITM (con el cliente de Dofus). Es el modo que usan Lanzar todo, el horario, el equipo y el reinicio automático. Cambia cuando lanzas la cuenta con el otro botón («Socket»).</sys:String>
 <sys:String x:Key="L.Accounts.ModeSocketTip">Modo de la cuenta: Socket (sin el cliente de Dofus). Es el modo que usan Lanzar todo, el horario, el equipo y el reinicio automático. Cambia cuando lanzas la cuenta con el otro botón («Lanzar»).</sys:String>
 <sys:String x:Key="L.Accounts.StopBtn">Detener</sys:String>
 <sys:String x:Key="L.Accounts.Remove">Eliminar</sys:String>
 <sys:String x:Key="L.Accounts.RemoveTitle">Eliminar cuenta</sys:String>
 <sys:String x:Key="L.Accounts.RemoveBody">¿Eliminar definitivamente {0}?</sys:String>
 <sys:String x:Key="L.Accounts.Removed">Cuenta {0} eliminada</sys:String>
 <sys:String x:Key="L.Accounts.Added">Cuenta {0} añadida</sys:String>
 <sys:String x:Key="L.Accounts.Edited">Cuenta {0} actualizada</sys:String>
 <sys:String x:Key="L.Accounts.EditTitle">Editar cuenta</sys:String>
 <sys:String x:Key="L.Accounts.EditLogin">Usuario</sys:String>
 <sys:String x:Key="L.Accounts.EditLabel">Etiqueta</sys:String>
 <sys:String x:Key="L.Accounts.EditPassword">Contraseña</sys:String>
 <sys:String x:Key="L.Accounts.LabelOptional">Opcional</sys:String>
 <sys:String x:Key="L.Accounts.PasswordKeep">Dejar vacío para no cambiar</sys:String>
 <sys:String x:Key="L.Accounts.LoginRequired">Introduce un usuario</sys:String>
 <sys:String x:Key="L.Accounts.NoInterface">Ninguna interfaz asignada a esta cuenta</sys:String>
 <sys:String x:Key="L.Accounts.StatusIdle">Inactivo</sys:String>
 <sys:String x:Key="L.Accounts.StatusIsolated">IP aislada</sys:String>
 <sys:String x:Key="L.Accounts.Isolated">{0}: IP aislada en {1}</sys:String>
 <sys:String x:Key="L.Accounts.Stopped">{0}: aislamiento detenido</sys:String>
 <sys:String x:Key="L.Accounts.StoppedRevoked">{0} detenido: permiso «{1}» revocado.</sys:String>
 <sys:String x:Key="L.Accounts.Banned">Baneada</sys:String>
 <sys:String x:Key="L.Accounts.BannedUntil">Baneada hasta el {0}</sys:String>
 <sys:String x:Key="L.Accounts.BanResumeAt"> (reanudación automática a las {0})</sys:String>
 <sys:String x:Key="L.Accounts.UnbanTip">Cuenta baneada por Ankama: ningún lanzamiento automático (planificación, Lanzar todo, equipo, relanzamiento). Haz clic para quitar la marca.</sys:String>
 <sys:String x:Key="L.Accounts.UnbanTitle">Quitar el baneo</sys:String>
 <sys:String x:Key="L.Accounts.UnbanBody">La cuenta {0} está marcada como baneada. Quitar la marca reactiva sus lanzamientos automáticos. Comprueba antes que el baneo ha terminado.</sys:String>
 <sys:String x:Key="L.Accounts.Unbanned">{0}: marca de baneo quitada.</sys:String>
 <sys:String x:Key="L.Accounts.BannedNoAuto">{0} está baneada: lanzamiento automático rechazado.</sys:String>
 <sys:String x:Key="L.Accounts.StopAllTitle">Detener todas las cuentas</sys:String>
 <sys:String x:Key="L.Accounts.StopAllBody">¿Detener las {0} cuenta(s) activa(s) (clientes de Dofus cerrados, reconexiones pendientes canceladas)?</sys:String>
 <sys:String x:Key="L.Accounts.StoppedAll">{0} cuenta(s) detenida(s)</sys:String>
 <sys:String x:Key="L.Accounts.LaunchAllTitle">Iniciar todas las cuentas</sys:String>
 <sys:String x:Key="L.Accounts.LaunchAllBody">¿Iniciar las {0} cuenta(s) sin lanzar?</sys:String>
 <sys:String x:Key="L.Accounts.NoMultiLicense">Tu licencia no incluye el permiso «Multi» — solo se puede ejecutar una cuenta a la vez.</sys:String>
 <sys:String x:Key="L.Accounts.LaunchError">Error: {0}</sys:String>
 <sys:String x:Key="L.Accounts.Launching">Lanzando...</sys:String>
 <sys:String x:Key="L.Accounts.LaunchModalTitle">Lanzamiento</sys:String>
 <sys:String x:Key="L.Accounts.ViaProxy">Conexión vía {0} {1}:{2}</sys:String>
 <sys:String x:Key="L.Accounts.NoProxyMode">Sin proxy - IP real (sin aislamiento)</sys:String>
 <sys:String x:Key="L.Accounts.InGame">En juego - {0} paquetes ({1} reconocidos)</sys:String>
 <sys:String x:Key="L.Accounts.Crashed">Cliente cerrado (fallo)</sys:String>
 <sys:String x:Key="L.Accounts.CrashedToast">{0}: el cliente se cerró de forma inesperada (fallo).</sys:String>
 <sys:String x:Key="L.Accounts.CrashedRelaunch">{0}: el cliente falló — reiniciando automáticamente…</sys:String>
 <sys:String x:Key="L.Accounts.CrashLoop">{0}: demasiados fallos seguidos — reinicio automático suspendido.</sys:String>
 <sys:String x:Key="L.Accounts.CrashedPlanning">{0}: el cliente se cerró inesperadamente — el horario gestiona la reconexión (solo durante la franja).</sys:String>
 <sys:String x:Key="L.Planning.Auto.Connecting">Horario: conectando {0} para {1}…</sys:String>
 <sys:String x:Key="L.Planning.Auto.Connected">Conectado por el horario: {0} está en el juego, el script empieza en el primer mapa.</sys:String>
 <sys:String x:Key="L.Planning.Auto.Adopted">Horario: {0} está en el juego durante su franja — gestionado por la conexión auto (desconectado fuera de franja, tras una cuenta atrás cancelable).</sys:String>
 <sys:String x:Key="L.Planning.Auto.WrongChar">Horario: {0} entró en el juego con {1} en lugar de {2} — desconectado, franja omitida. Juega {2} una vez en esta cuenta (último personaje jugado).</sys:String>
 <sys:String x:Key="L.Planning.Auto.Timeout">Horario: {0} no llegó al juego a tiempo — nuevo intento en 1 min.</sys:String>
 <sys:String x:Key="L.Planning.Auto.GaveUp">Horario: no se pudo conectar {0} tras {1} intentos — franja omitida.</sys:String>
 <sys:String x:Key="L.Planning.Auto.NeedsShield">Horario: {0} pide un código del Escudo — lanza esta cuenta a mano una vez (el dispositivo queda recordado), luego el horario se reanuda.</sys:String>
 <sys:String x:Key="L.Planning.Auto.Suspended">Horario: {0} no pudo conectarse durante {1} franjas seguidas — conexión auto suspendida hasta que lances esta cuenta a mano.</sys:String>
 <sys:String x:Key="L.Planning.Auto.NoDofus">Horario: Dofus.exe no encontrado — lanza una cuenta a mano una vez para localizarlo.</sys:String>
