 <sys:String x:Key="L.Bots.CopyLogin">Copiar identificador</sys:String>
 <sys:String x:Key="L.Bots.Disconnect">Desconexión</sys:String>
 <!-- Pastille del MODO de la sesión -->
 <sys:String x:Key="L.Bots.ModeSocketTip">Sesión en modo Socket: conexión directa al servidor del juego, sin el cliente de Dofus.</sys:String>
 <sys:String x:Key="L.Bots.ModeMitmTip">Sesión en modo MITM: el bot pasa por el cliente de Dofus lanzado para esta cuenta.</sys:String>
 <sys:String x:Key="L.Bots.LoginCopied">Identificador {0} copiado</sys:String>
 <sys:String x:Key="L.Bots.Filter.All">Todo</sys:String>
 <sys:String x:Key="L.Bots.Filter.In">Entrante</sys:String>
 <sys:String x:Key="L.Bots.Filter.Out">Saliente</sys:String>
 <sys:String x:Key="L.Bots.Filter.Named">Reconocidos</sys:String>
 <sys:String x:Key="L.Bots.ClearConsole">Vaciar</sys:String>
 <sys:String x:Key="L.Bots.ConsoleHint">Inicie una cuenta con proxy y entre al juego. Haga clic en un paquete para ver su contenido decodificado (campo por campo) - útil para localizar un valor conocido.</sys:String>
 <sys:String x:Key="L.Bots.SoonTitle">Control en juego</sys:String>
 <sys:String x:Key="L.Bots.SoonBody">Acciones rápidas, mapa y scripts llegarán con la vía de inyección (el MITM es solo de observación por ahora).</sys:String>
 <sys:String x:Key="L.Bots.Tab.Map">Mapa</sys:String>
