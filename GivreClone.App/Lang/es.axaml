 <sys:String x:Key="L.Bots.Settings.ReplyDelay">Retardo de respuesta (ms) — mín / máx</sys:String>
 <sys:String x:Key="L.Bots.Settings.Cooldown">Enfriamiento por jugador (s)</sys:String>
 <sys:String x:Key="L.Bots.Settings.LlmTitle">IA (LLM)</sys:String>
 <sys:String x:Key="L.Bots.Settings.LlmModel">Modelo</sys:String>
