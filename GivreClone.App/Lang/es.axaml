 <sys:String x:Key="L.Bots.MapPos">Posición</sys:String>
 <sys:String x:Key="L.Bots.MapCellLabel">Celda</sys:String>
 <sys:String x:Key="L.Bots.MapActor">Actor</sys:String>
 <sys:String x:Key="L.Bots.MapHint">Relieve táctico del mapa (extraído del cliente): suelo transitable claro, obstáculos en volumen (gris oscuro = sin línea de visión). Usted, jugadores y monstruos se sitúan en su celda; pase el ratón para ver la celda y el actor.</sys:String>
 <sys:String x:Key="L.Bots.PacketContent">Contenido del paquete</sys:String>
 <sys:String x:Key="L.Bots.Map">Mapa</sys:String>
 <sys:String x:Key="L.Bots.InfosSoon">Scripts y acciones llegarán aquí con la vía de inyección (el MITM es solo de observación por ahora).</sys:String>
 <sys:String x:Key="L.Bots.State">Estado</sys:String>
 <sys:String x:Key="L.Bots.Console">Consola</sys:String>
 <sys:String x:Key="L.Bots.Pid">PID</sys:String>
