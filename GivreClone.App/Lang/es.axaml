 <sys:String x:Key="L.Bots.TabInventory">Inventario</sys:String>
 <sys:String x:Key="L.Bots.Inventory.Empty">Inventario vacío o aún no recibido — reinicia el bot y reconecta el personaje para cargar la bolsa.</sys:String>
 <sys:String x:Key="L.Bots.TabBank">Banco</sys:String>
 <sys:String x:Key="L.Bots.Bank.DepositType">Tipo de depósito</sys:String>
 <sys:String x:Key="L.Bots.Bank.Empty">Banco vacío o aún no abierto — abre tu banco en el juego (o mediante un depósito del script) para cargar su contenido.</sys:String>
 <sys:String x:Key="L.Bots.Bank.DepAll">Depositar todo el inventario</sys:String>
 <sys:String x:Key="L.Bots.Bank.DepExisting">Depositar los objetos ya presentes</sys:String>
 <sys:String x:Key="L.Bots.Bank.DepVisible">Depositar los objetos visibles</sys:String>
