 <sys:String x:Key="L.Bots.Lua.Filter.Info">Normal</sys:String>
 <sys:String x:Key="L.Bots.Lua.Filter.Warn">Advertencias</sys:String>
 <sys:String x:Key="L.Bots.Lua.Filter.Error">Errores</sys:String>

 <!-- Bots: pestaña Combate (i18n) -->
 <sys:String x:Key="L.Bots.Combat.AutoPlay">Jugar automáticamente mis turnos de combate</sys:String>
 <sys:String x:Key="L.Bots.Combat.AutoSpells">Modo automático: todos mis hechizos aprendidos</sys:String>
 <sys:String x:Key="L.Bots.Combat.AutoSpellsTip">Juega con todos tus hechizos aprendidos que hacen daño, además de tu lista, ordenados por daño por PA. Un hechizo de tu lista conserva sus ajustes; desmarcado, se excluye.</sys:String>
 <sys:String x:Key="L.Bots.Combat.PreFight">Pre-combate auto: colocarse y prepararse</sys:String>
 <sys:String x:Key="L.Bots.Combat.Placement">Colocación</sys:String>
 <sys:String x:Key="L.Bots.Combat.Placement.Legacy">Según el estilo</sys:String>
 <sys:String x:Key="L.Bots.Combat.Placement.None">Ninguna</sys:String>
 <sys:String x:Key="L.Bots.Combat.Placement.Near">Cerca</sys:String>
 <sys:String x:Key="L.Bots.Combat.Placement.Far">Lejos</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlacementHint">Ninguna: conservar la casilla. Cerca / Lejos: minimizar / maximizar la distancia al enemigo más cercano, independientemente del estilo. Según el estilo conserva el comportamiento de los perfiles existentes.</sys:String>
 <sys:String x:Key="L.Bots.Combat.Challenge">Elegir y validar un desafío en cada combate</sys:String>
 <sys:String x:Key="L.Bots.Combat.AutoRevive">Auto-resurrección (Fénix)</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeHint">Entre los desafíos aceptados, GivreClone toma el que más rinde de media (probabilidad de éxito × bono).</sys:String>
 <sys:String x:Key="L.Bots.Combat.SectionChallenges">Desafíos</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeNeedsPreFight">Activa «Precombate auto» arriba: el desafío se elige durante la colocación.</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeRules">Adaptar la IA a los desafíos en curso</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeRulesHint">Estatua: no se mueve · Versátil: cada hechizo una vez por turno · Primero, Elitista, Focus…: un solo objetivo · Osado, Prudente, Pegajoso…: casilla de fin de turno impuesta. También vale para un desafío elegido a mano.</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeBonus">Bono</sys:String>
 <sys:String x:Key="L.Bots.Combat.BonusXp">XP</sys:String>
 <sys:String x:Key="L.Bots.Combat.BonusLoot">Botín</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeBonusHint">GivreClone anuncia este bono al servidor en cada combate (modos Socket y clásico); el diario muestra el bono confirmado por el servidor.</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeList">Desafíos aceptados ({0}/{1})…</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeListTitle">Desafíos aceptados</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeListSub">Desmarca los desafíos que GivreClone nunca debe elegir. Fallar un desafío no cuesta nada: solo se pierde el bono.</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeSupportEnforced">IA adaptada</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeSupportEnforcedTip">La IA cambia su forma de jugar para cumplir este desafío.</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeSupportNatural">Sin acción</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeSupportNaturalTip">Nada especial que hacer: se cumple o no según el combate.</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeSupportNone">No gestionado</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeSupportNoneTip">La IA no sabe cumplir este desafío (arma, daño indirecto, coordinación de equipo…).</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeDefaults">Valores recomendados</sys:String>
 <sys:String x:Key="L.Bots.Combat.ChallengeFallback">Desafío n.º {0}</sys:String>
 <sys:String x:Key="L.Bots.Combat.Style">Estilo de IA</sys:String>
 <sys:String x:Key="L.Bots.Combat.Target">Objetivo</sys:String>
 <sys:String x:Key="L.Bots.Combat.Speed">Velocidad</sys:String>
 <sys:String x:Key="L.Bots.Combat.SpellsByPriority">Hechizos lanzados por prioridad</sys:String>
 <sys:String x:Key="L.Bots.Combat.AddSpell">＋ Añadir un hechizo…</sys:String>
 <sys:String x:Key="L.Bots.Combat.ColSpell">Hechizo</sys:String>
 <sys:String x:Key="L.Bots.Combat.ColPriority">Prioridad</sys:String>
 <sys:String x:Key="L.Bots.Combat.PriorityTip">Orden de lanzamiento: cuanto MENOR es el número (y más ARRIBA en la lista), mayor es la prioridad. Arrastra esta insignia — o usa las flechas — para reordenar.</sys:String>
 <sys:String x:Key="L.Bots.Combat.ColPerTurn">× / turno</sys:String>
 <sys:String x:Key="L.Bots.Combat.ColPerTarget">× / objetivo</sys:String>
 <sys:String x:Key="L.Bots.Combat.PerTargetCfgTip">Lanzamientos máx. de este hechizo sobre un mismo objetivo por turno (0 = solo el límite del juego).</sys:String>
 <sys:String x:Key="L.Bots.Combat.ColCooldown">Recarga</sys:String>
 <sys:String x:Key="L.Bots.Combat.CooldownTip">Recarga: turnos mínimos entre dos lanzamientos (0 = ninguno)</sys:String>
 <sys:String x:Key="L.Bots.Combat.ColSelf">Sí mismo</sys:String>
 <sys:String x:Key="L.Bots.Combat.ToggleTip">Activar / desactivar</sys:String>
 <sys:String x:Key="L.Bots.Combat.SelfCastTip">Lanzar sobre mí (mejora/cura)</sys:String>
 <sys:String x:Key="L.Bots.Combat.ColBuff">Mejora</sys:String>
 <sys:String x:Key="L.Bots.Combat.SelfBuffTip">Mejora: lanzar sobre mí aunque no haya enemigo a rango. Sin marcar = hechizo de zona ofensivo, lanzado solo si hay un enemigo en la zona.</sys:String>
 <sys:String x:Key="L.Bots.Combat.Conditions">Condiciones</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondTip">El hechizo se lanza solo si se cumplen TODAS sus condiciones. 0 (o 0–100 para PV) = desactivado. PV objetivo/propio en %.</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondTgtHp">PV objetivo %</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondSelfHp">PV propio %</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondMinAp">PA mín</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondMinTurn">Turno ≥</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondMinEnemies">Enemigos ≥</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondMinAoeHits">En zona ≥</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondGroupTarget">PV del objetivo</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondGroupSelf">PV del personaje</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondGroupContext">Contexto</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondHpHint">0–100 % = cualquier objetivo</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondSelfHint">0–100 % = siempre</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondActive">Condiciones activas</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondTgtHpTip">Solo lanza el hechizo si los PV del OBJETIVO (%) están en el rango mín–máx. Ej. 0–30 = rematar a un enemigo débil; 20–100 = evitar los casi muertos.</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondTgtHpDesc">Rango de PV % del objetivo (0–100 = cualquier objetivo).</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondSelfHpTip">Solo lanza el hechizo si TUS PV (%) están en el rango mín–máx. Ej. 0–50 = cura/defensa cuando estás bajo.</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondSelfHpDesc">Rango de TUS PV % (0–100 = siempre).</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondHpMinTip">PV % mínimo del rango.</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondHpMaxTip">PV % máximo del rango.</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondMinApTip">PA mínimo: solo lanza este hechizo si tienes al menos esta cantidad de PA al lanzar (0 = sin condición).</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondMinTurnTip">A partir del turno: solo lanza este hechizo desde este número de turno (1 = desde el turno 1; 0 = sin condición). Ej. 3 = esperar al turno 3.</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondMinEnemiesTip">Enemigos mínimos: solo lanza este hechizo si quedan al menos esta cantidad de enemigos vivos (0 = sin condición). Ej. 2 = para un hechizo de zona.</sys:String>
 <sys:String x:Key="L.Bots.Combat.CondMinAoeHitsTip">Enemigos mínimos en zona (solo hechizos de ZONA): solo lanza este hechizo si la MEJOR casilla objetivo atrapa al menos esta cantidad de enemigos en su zona (0 = sin condición). Evita malgastar un AoE amplio en un solo objetivo.</sys:String>
 <sys:String x:Key="L.Bots.Combat.RemoveTip">Quitar el hechizo</sys:String>
 <sys:String x:Key="L.Bots.Combat.ColOrder">Orden</sys:String>
 <sys:String x:Key="L.Bots.Combat.NoSpells">Ningún hechizo en la rotación — añade algunos con la lista desplegable de arriba.</sys:String>
 <sys:String x:Key="L.Bots.Combat.MoveUpTip">Subir (prioridad más alta)</sys:String>
 <sys:String x:Key="L.Bots.Combat.MoveDownTip">Bajar (prioridad más baja)</sys:String>
 <sys:String x:Key="L.Bots.Combat.MaxCasts">Lanzamientos máx / turno</sys:String>
 <sys:String x:Key="L.Bots.Combat.TabBehavior">Comportamiento</sys:String>
 <sys:String x:Key="L.Bots.Combat.TabSpells">Hechizos</sys:String>
 <sys:String x:Key="L.Bots.Combat.TabTeam">Equipo</sys:String>
 <sys:String x:Key="L.Bots.Combat.SpellConfigTitle">CONFIGURACIÓN DEL HECHIZO</sys:String>
 <sys:String x:Key="L.Bots.Combat.TabEssential">Esencial</sys:String>
 <sys:String x:Key="L.Bots.Combat.TabPlacement">Colocación y zonas</sys:String>
 <sys:String x:Key="L.Bots.Combat.TabAdvConditions">Condiciones avanzadas</sys:String>
 <sys:String x:Key="L.Bots.Combat.QuickRules">Reglas rápidas</sys:String>
 <sys:String x:Key="L.Bots.Combat.RuleEnabled">Hechizo activado</sys:String>
 <sys:String x:Key="L.Bots.Combat.RuleOnMe">Lanzar directamente sobre mí</sys:String>
 <sys:String x:Key="L.Bots.Combat.RuleBuff">Mejora: lanzar aunque no haya enemigo a rango</sys:String>
 <sys:String x:Key="L.Bots.Combat.RuleSummon">Invocación (colocar en una celda libre)</sys:String>
 <sys:String x:Key="L.Bots.Combat.SummonTip">El hechizo invoca una criatura en una celda transitable libre a rango, en vez de apuntar a un enemigo. Dale una prioridad baja (número pequeño) para invocar al inicio del turno.</sys:String>
 <sys:String x:Key="L.Bots.Combat.RuleTargetAlly">Apuntar a un aliado (cura/mejora)</sys:String>
 <sys:String x:Key="L.Bots.Combat.TargetAllyTip">El hechizo apunta a un COMPAÑERO (o a tu invocación) en vez de a un enemigo: apunta al aliado con menos PV lanzable desde aquí. Combínalo con la ventana de PV objetivo (p. ej. «curar solo por debajo del 60 %»). El lanzamiento sobre uno mismo lo gestiona «Lanzar sobre mí».</sys:String>
 <sys:String x:Key="L.Bots.Combat.MaxSummons">Invocaciones máx</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceRange">Alcance de lanzamiento</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceRangeTip">Limita la distancia a la que el bot lanza este hechizo. 0 = alcance natural del hechizo (bonus de alcance incluidos).</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceRangeMin">Distancia mín.</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceRangeMinTip">No lanzar más cerca de esta distancia: el bot se coloca más lejos (kite por hechizo). 0 = sin mínimo.</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceRangeMax">Alcance máx.</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceRangeMaxTip">Limita el alcance de lanzamiento: el bot se acerca en vez de disparar de lejos. 0 = alcance máx. natural.</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceRangeHint">0 = automático. Distancia mín. = mantener las distancias (kite); alcance máx. = forzar el acercamiento.</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceMove">Movimiento</sys:String>
  <sys:String x:Key="L.Bots.Combat.NeverApproach">Nunca acercarse (todos los hechizos y fin de turno)</sys:String>
  <sys:String x:Key="L.Bots.Combat.NeverApproachHint">Bloquea el desplazamiento para lanzar y cualquier acercamiento al enemigo más cercano, incluso por un desafío. Permite alejarse y moverse lateralmente. Un desafío incompatible puede fallar; la colocación inicial es independiente.</sys:String>
  <sys:String x:Key="L.Bots.Combat.PlaceApproach">Desplazarse para lanzar este hechizo</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceApproachTip">Activado: el bot busca una casilla de lanzamiento y se mueve a ella. Desactivado: solo lanza si YA está a alcance.</sys:String>
  <sys:String x:Key="L.Bots.Combat.PlaceApproachHint">Desmárcalo para lanzar solo este hechizo en el sitio. El acercamiento al final del turno sigue permitido: usa Nunca acercarse en Comportamiento para todos los hechizos y el fin de turno.</sys:String>
 <sys:String x:Key="L.Bots.Combat.PlaceActive">Colocación personalizada</sys:String>
 <!-- Simulador de turno de combate -->
 <sys:String x:Key="L.Bots.Combat.Simulate">Simular el turno</sys:String>
 <sys:String x:Key="L.Bots.Sim.Title">Simulador de turno</sys:String>
 <sys:String x:Key="L.Bots.Sim.Hint">Coloca tu personaje y enemigos, ajusta PA/PM/alcance, y lanza: el bot repite su rotación paso a paso.</sys:String>
 <sys:String x:Key="L.Bots.Sim.ModeEnemy">Colocar un enemigo</sys:String>
 <sys:String x:Key="L.Bots.Sim.ModeMe">Colocarme</sys:String>
 <sys:String x:Key="L.Bots.Sim.ModeErase">Borrar</sys:String>
 <sys:String x:Key="L.Bots.Sim.Budget">Presupuesto del turno</sys:String>
 <sys:String x:Key="L.Bots.Sim.Ap">PA</sys:String>
 <sys:String x:Key="L.Bots.Sim.Mp">PM</sys:String>
 <sys:String x:Key="L.Bots.Sim.Range">Alcance</sys:String>
 <sys:String x:Key="L.Bots.Sim.Turn">Turno n.º</sys:String>
 <sys:String x:Key="L.Bots.Sim.Run">Simular</sys:String>
 <sys:String x:Key="L.Bots.Sim.Reset">Reiniciar</sys:String>
 <sys:String x:Key="L.Bots.Sim.Play">Reproducir</sys:String>
 <sys:String x:Key="L.Bots.Sim.Pause">Pausa</sys:String>
 <sys:String x:Key="L.Bots.Sim.StepBack">Paso anterior</sys:String>
 <sys:String x:Key="L.Bots.Sim.StepFwd">Paso siguiente</sys:String>
 <sys:String x:Key="L.Bots.Sim.Journal">Registro del turno</sys:String>
 <sys:String x:Key="L.Bots.Sim.Hud">Turno {0} · PA {1} · PM {2} · {3} enemigo(s)</sys:String>
 <sys:String x:Key="L.Bots.Sim.Summary">{0} lanzamiento(s) · {1} desplazamiento(s) · {2} K.O.</sys:String>
 <sys:String x:Key="L.Bots.Sim.LogMove">Desplazamiento → casilla {0}</sys:String>
 <sys:String x:Key="L.Bots.Sim.LogCast">{0} → enemigo (distancia {1})</sys:String>
 <sys:String x:Key="L.Bots.Sim.LogCastSelf">{0} sobre sí mismo</sys:String>
 <sys:String x:Key="L.Bots.Sim.LogPass">Pasa el turno (nada lanzable)</sys:String>
 <sys:String x:Key="L.Bots.Sim.LogNoEnemy">Ningún enemigo en el tablero</sys:String>
 <sys:String x:Key="L.Bots.Sim.LogEnd">Fin del turno</sys:String>
 <sys:String x:Key="L.Bots.Sim.EnemyHp">PV de los enemigos</sys:String>
 <sys:String x:Key="L.Bots.Sim.MultiTurn">Reproducir hasta el final del combate</sys:String>
 <sys:String x:Key="L.Bots.Sim.MaxTurns">Turnos máx.</sys:String>
 <sys:String x:Key="L.Bots.Sim.LogCastDmg">{0} → enemigo (-{1} PV, distancia {2})</sys:String>
 <sys:String x:Key="L.Bots.Sim.LogKill">{0} → enemigo derrotado ({1} restante(s))</sys:String>
 <sys:String x:Key="L.Bots.Sim.LogTurnSep">— Turno {0} —</sys:String>
 <sys:String x:Key="L.Bots.Sim.SummaryCleared">Pack eliminado en {0} turno(s) · {1} K.O.</sys:String>
 <sys:String x:Key="L.Bots.Sim.Disclaimer">Daño medio, sin resistencias/represalia — herramienta de comprensión, no una repetición exacta.</sys:String>
 <sys:String x:Key="L.Bots.Combat.Done">Terminar</sys:String>
 <sys:String x:Key="L.Bots.Combat.Configure">Configurar</sys:String>
 <sys:String x:Key="L.Bots.Combat.TagEnemy">Enemigo</sys:String>
 <sys:String x:Key="L.Bots.Combat.TagSelf">Sobre mí</sys:String>
 <sys:String x:Key="L.Bots.Combat.TagBuff">Mejora</sys:String>
 <sys:String x:Key="L.Bots.Combat.ConfigureTip">Configurar este hechizo: esencial, colocación y zonas, condiciones avanzadas.</sys:String>
 <sys:String x:Key="L.Bots.Combat.TeamSoon">Grupo / multicuenta — pronto</sys:String>
 <sys:String x:Key="L.Bots.Combat.TeamSoonHint">La gestión de grupo (líder / seguidores, invitaciones, espera entre bots, controlador Lua) llegará en un lote dedicado.</sys:String>
 <!-- Equipo (multi-cuenta) -->
 <sys:String x:Key="L.Bots.Team.NeedTwo">Lanza al menos 2 cuentas en el juego para componer un equipo.</sys:String>
 <sys:String x:Key="L.Bots.Team.Compose">Componer el equipo</sys:String>
 <sys:String x:Key="L.Bots.Team.Leader">Líder del equipo</sys:String>
 <sys:String x:Key="L.Bots.Team.PickLeader">Elegir el líder…</sys:String>
 <sys:String x:Key="L.Bots.Team.Follow">Seguir</sys:String>
 <sys:String x:Key="L.Bots.Team.RoleLeader">Líder</sys:String>
 <sys:String x:Key="L.Bots.Team.RoleFollower">Miembro del equipo</sys:String>
 <sys:String x:Key="L.Bots.Team.Form">Formar el grupo</sys:String>
 <sys:String x:Key="L.Bots.Team.Disband">Disolver el equipo</sys:String>
 <sys:String x:Key="L.Bots.Team.FollowSection">Seguimiento</sys:String>
 <sys:String x:Key="L.Bots.Team.SyncDelay">Retardo aleatorio entre bots (mín → máx, ms)</sys:String>
 <sys:String x:Key="L.Bots.Team.FollowToggle">Seguir automáticamente al líder</sys:String>
 <sys:String x:Key="L.Bots.Team.CombatToggle">Unirse a los combates del líder</sys:String>
 <sys:String x:Key="L.Bots.Team.FollowHelp">Los followers se pegan al líder (celda + mapa, incluso fuera del world-graph) y lo esperan antes de cambiar de zona.</sys:String>
 <sys:String x:Key="L.Bots.Team.CombatHelp">Los followers se unen a cada combate; el líder los espera antes de atacar Y antes de elegir el desafío.</sys:String>
 <sys:String x:Key="L.Bots.Team.Registered">Miembros registrados (en línea o no)</sys:String>
 <sys:String x:Key="L.Bots.Team.FollowerLocked">Esta cuenta la dirige su equipo (manda el líder): el script y la planificación están bloqueados. Solo la pestaña Combate sigue editable.</sys:String>
 <sys:String x:Key="L.Bots.Team.FollowHint">Una vez formado el grupo, los seguidores se unen automáticamente al mapa del líder (escalonados por el retardo). Líder en combate: esperan. Un seguidor que ejecuta su propio script mantiene el control.</sys:String>
 <sys:String x:Key="L.Bots.Team.PresOffline">Desconectado</sys:String>
 <sys:String x:Key="L.Bots.Team.PresConnected">Conectado</sys:String>
 <sys:String x:Key="L.Bots.Team.PresSameMap">Mismo mapa que el líder</sys:String>
