 <sys:String x:Key="L.Login.Success">¡Licencia verificada!</sys:String>
 <sys:String x:Key="L.Login.ErrInvalid">Clave de licencia no válida. Comprueba lo que has escrito.</sys:String>
 <sys:String x:Key="L.Login.ErrRejected">Licencia rechazada. Contacta con el soporte.</sys:String>
 <sys:String x:Key="L.Auth.Expired">Tu licencia ha caducado.</sys:String>
 <sys:String x:Key="L.Auth.Hwid">Esta licencia está vinculada a otro dispositivo. Restablece tu HWID o contacta con el soporte.</sys:String>
 <sys:String x:Key="L.Auth.Blacklisted">Tu dispositivo ha sido incluido en la lista negra.</sys:String>
 <sys:String x:Key="L.Auth.NotFound">Clave de licencia no encontrada.</sys:String>
 <sys:String x:Key="L.Auth.Banned">Esta licencia ha sido baneada.</sys:String>
 <sys:String x:Key="L.Auth.BannedReasonFmt">Esta licencia ha sido baneada. Motivo: {0}</sys:String>
 <sys:String x:Key="L.Auth.TooManyDevices">Demasiados dispositivos están usando esta licencia.</sys:String>
 <sys:String x:Key="L.Auth.Paused">Tu licencia está actualmente en pausa.</sys:String>
 <sys:String x:Key="L.Auth.RateLimited">Demasiados intentos. Espera antes de volver a intentarlo.</sys:String>
 <sys:String x:Key="L.Auth.Connection">Error de conexión. Comprueba tu conexión a Internet e inténtalo de nuevo.</sys:String>
 <sys:String x:Key="L.Auth.DateTime">La fecha y la hora de tu dispositivo están desincronizadas. Corrígelas e inténtalo de nuevo.</sys:String>
 <sys:String x:Key="L.Auth.SignatureError">Error de firma del cliente ({0}) — actualiza GivreClone.</sys:String>
 <sys:String x:Key="L.Auth.ClockWrong">Reloj del sistema incorrecto — activa la fecha y hora automáticas de Windows y vuelve a conectarte.</sys:String>
 <sys:String x:Key="L.Auth.Verify">No se pudo verificar la respuesta del servidor. Inténtalo de nuevo.</sys:String>
 <sys:String x:Key="L.Auth.Unavailable">El servidor no está disponible. Inténtalo de nuevo más tarde.</sys:String>
 <sys:String x:Key="L.Auth.Generic">Error al iniciar sesión. Inténtalo de nuevo o contacta con el soporte.</sys:String>
 <sys:String x:Key="L.Auth.SessionEnded">Sesión finalizada. Vuelve a iniciar sesión.</sys:String>
 <sys:String x:Key="L.LicLink.Resuming">Reconectando la licencia…</sys:String>
 <sys:String x:Key="L.LicLink.WaitingNetwork">Licencia: esperando la red…</sys:String>
 <sys:String x:Key="L.LicLink.Stalled">Licencia inaccesible — bots en pausa, reintento automático</sys:String>
 <sys:String x:Key="L.LicLink.NeedsUser">Sesión de licencia interrumpida — bots en pausa</sys:String>
 <sys:String x:Key="L.LicLink.Retry">Reconectar</sys:String>
 <sys:String x:Key="L.LicLink.Paused">Bots en pausa: reconectando la licencia</sys:String>
 <sys:String x:Key="L.LicLink.Offline">Servidor de licencias inaccesible — bots en pausa, reconexión automática</sys:String>
 <sys:String x:Key="L.LicLink.Tip">Tu licencia sigue siendo válida: la sesión se reanuda sola tras un corte de red o una suspensión.</sys:String>
 <sys:String x:Key="L.Mapping.MissingTitle">Mapeo incompleto</sys:String>
 <sys:String x:Key="L.Mapping.MissingBody">Faltan {0} mensaje(s) esencial(es) del protocolo en el mapeo. El bot no podrá decodificar los paquetes (mapa, movimiento, personaje). Comprueba que el mapeo esté publicado y completo en el servidor. ¿Iniciar de todos modos?</sys:String>
 <sys:String x:Key="L.Mapping.LaunchAnyway">Iniciar de todos modos</sys:String>
 <sys:String x:Key="L.Control.KillTitle">Servicio no disponible</sys:String>
 <sys:String x:Key="L.Control.KillDefault">El servicio no está disponible temporalmente. Inténtalo de nuevo más tarde.</sys:String>
 <sys:String x:Key="L.Control.OutdatedTitle">Actualización necesaria</sys:String>
 <sys:String x:Key="L.Control.OutdatedDefault">Se requiere una versión más reciente. Descarga la última build para continuar.</sys:String>
 <sys:String x:Key="L.Control.VersionFmt">Tu versión: {0} — requerida: {1}</sys:String>
 <sys:String x:Key="L.Control.UpdateNow">Actualizar ahora</sys:String>
 <sys:String x:Key="L.Control.Updating">Preparando la actualización…</sys:String>
 <sys:String x:Key="L.Control.Downloading">Descargando… {0}%</sys:String>
 <sys:String x:Key="L.Control.Restarting">Instalando… GivreClone se reiniciará.</sys:String>
 <sys:String x:Key="L.Control.Retry">Reintentar</sys:String>
 <sys:String x:Key="L.Control.WhatsNew">Novedades: {0}</sys:String>
 <sys:String x:Key="L.Control.Unreachable">Se requiere conexión al servidor para verificar la autorización. Comprueba tu conexión e inténtalo de nuevo.</sys:String>
 <sys:String x:Key="L.Control.OfferTitle">Actualización disponible</sys:String>
 <sys:String x:Key="L.Control.OfferBody">Hay una nueva versión de GivreClone disponible.</sys:String>
 <sys:String x:Key="L.Control.OfferHint">Tus bots siguen funcionando. «Actualizar ahora» los detiene y reinicia GivreClone; si no, la actualización se instalará en el próximo inicio.</sys:String>
 <sys:String x:Key="L.Control.Later">En el próximo inicio</sys:String>
 <sys:String x:Key="L.Control.OfferToast">Actualización {0} disponible: tus bots siguen funcionando</sys:String>
 <sys:String x:Key="L.Control.Deferred">Actualización aplazada al próximo inicio de GivreClone</sys:String>
 <sys:String x:Key="L.Control.PendingFmt">Act. {0}</sys:String>
 <sys:String x:Key="L.Control.PendingTip">Actualización lista: se instalará en el próximo inicio. Haz clic para instalarla ahora.</sys:String>

 <!-- Pre-extracción de mapas (caché en disco, primer inicio / tras un parche de Dofus) -->
 <sys:String x:Key="L.MapExtract.Title">Preparando los mapas</sys:String>
 <sys:String x:Key="L.MapExtract.Explain">Primera extracción de los mapas del juego desde los archivos de Dofus. Es una operación única (se repite solo tras una actualización de Dofus): acelera de forma duradera todas las cargas de mapa. Puedes seguir usando GivreClone mientras tanto.</sys:String>
 <sys:String x:Key="L.MapExtract.Background">Continuar en segundo plano</sys:String>
 <sys:String x:Key="L.MapExtract.BgStarted">Preparando los mapas: continúa en segundo plano. Se te avisará al terminar.</sys:String>
 <sys:String x:Key="L.MapExtract.Done">Mapas listos ({0} mapas preparados).</sys:String>
 <sys:String x:Key="L.MappingLoad.Title">Cargando el protocolo</sys:String>
 <sys:String x:Key="L.MappingLoad.Explain">Obteniendo el protocolo del juego desde el servidor. Solo tarda un momento: nos aseguramos de que esté cargado antes de iniciar el bot.</sys:String>

