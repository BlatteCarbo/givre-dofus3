<ResourceDictionary x:Class="GivreClone.App.Themes.Amber" xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème : Ambre -->
    <Color x:Key="Accent">#F0A93C</Color>
    <Color x:Key="AccentBright">#F7C06A</Color>
    <Color x:Key="AccentDeep">#D2862A</Color>

    <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBright}" />
    <SolidColorBrush x:Key="AccentDeepBrush"   Color="{StaticResource AccentDeep}" />
    <SolidColorBrush x:Key="AccentSoftBrush"   Color="#26F0A93C" />

    <Color x:Key="SystemAccentColor">#F0A93C</Color>
    <Color x:Key="SystemAccentColorLight1">#F3B655</Color>
    <Color x:Key="SystemAccentColorLight2">#F6C36F</Color>
    <Color x:Key="SystemAccentColorLight3">#F9D088</Color>
    <Color x:Key="SystemAccentColorDark1">#D2862A</Color>
    <Color x:Key="SystemAccentColorDark2">#AE6E22</Color>
    <Color x:Key="SystemAccentColorDark3">#8B561B</Color>

    <RadialGradientBrush x:Key="WindowGlowBrush" Center="62%,8%" GradientOrigin="62%,8%" RadiusX="75%" RadiusY="70%">
        <GradientStop Offset="0" Color="#23F0A93C" />
        <GradientStop Offset="1" Color="#00F0A93C" />
    </RadialGradientBrush>
</ResourceDictionary>
