<ResourceDictionary x:Class="GivreClone.App.Themes.Emerald" xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème : Émeraude -->
    <Color x:Key="Accent">#2FD68A</Color>
    <Color x:Key="AccentBright">#5FE3A8</Color>
    <Color x:Key="AccentDeep">#1FA86A</Color>

    <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBright}" />
    <SolidColorBrush x:Key="AccentDeepBrush"   Color="{StaticResource AccentDeep}" />
    <SolidColorBrush x:Key="AccentSoftBrush"   Color="#262FD68A" />

    <Color x:Key="SystemAccentColor">#2FD68A</Color>
    <Color x:Key="SystemAccentColorLight1">#4FDD9A</Color>
    <Color x:Key="SystemAccentColorLight2">#6FE4AB</Color>
    <Color x:Key="SystemAccentColorLight3">#8FEBBC</Color>
    <Color x:Key="SystemAccentColorDark1">#1FA86A</Color>
    <Color x:Key="SystemAccentColorDark2">#198A57</Color>
    <Color x:Key="SystemAccentColorDark3">#136D45</Color>

    <RadialGradientBrush x:Key="WindowGlowBrush" Center="62%,8%" GradientOrigin="62%,8%" RadiusX="75%" RadiusY="70%">
        <GradientStop Offset="0" Color="#232FD68A" />
        <GradientStop Offset="1" Color="#002FD68A" />
    </RadialGradientBrush>
</ResourceDictionary>
