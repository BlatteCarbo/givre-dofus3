<ResourceDictionary x:Class="GivreClone.App.Skins.ClassicPalette" xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- ==========================================================================================
 Skin « » — PALETTE. Redéfinit les clés de base de Theme.axaml en gris neutres sombres (palette relevée sur l'interface web de MizanBot, accent orange)
 + accent violet. Copiée en entrées PROPRES de Application.Resources par SkinService (les
 entrées propres priment sur TOUS les MergedDictionaries, quel que soit l'ordre de fusion).
 AmberBrush n'est PAS redéfini (les bandeaux « notice » restent ambre, sémantique).
 Valeurs littérales (aucun StaticResource interne) -> chaque entrée est autonome.
 ========================================================================================== -->

 <!-- Couleurs de base (au cas où une vue référence la Color brute) -->
 <Color x:Key="Bg0">#131313</Color>
 <Color x:Key="Bg1">#161616</Color>
 <Color x:Key="Surface1">#171717</Color>
 <Color x:Key="Surface2">#212224</Color>
 <Color x:Key="Surface3">#2A2B2E</Color>
 <Color x:Key="TextPrimary">#ECECEC</Color>
 <Color x:Key="TextSecondary">#B4B4B8</Color>
 <Color x:Key="TextMuted">#8A8A90</Color>
 <Color x:Key="Success">#3EBA4A</Color>
 <Color x:Key="Danger">#E5534B</Color>

 <!-- Brosses de fond / surface -->
 <SolidColorBrush x:Key="Bg1Brush" Color="#161616" />
 <SolidColorBrush x:Key="Surface1Brush" Color="#171717" />
 <SolidColorBrush x:Key="Surface2Brush" Color="#212224" />
 <SolidColorBrush x:Key="Surface3Brush" Color="#2A2B2E" />

 <!-- Texte: argent un bot tiers -->
 <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECECEC" />
 <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B4B4B8" />
 <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8A90" />

 <!-- États -->
 <SolidColorBrush x:Key="SuccessBrush" Color="#3EBA4A" />
 <SolidColorBrush x:Key="DangerBrush" Color="#E5534B" />

 <!-- Bordures: opaques (les translucides blancs disparaissaient sur le gris) -->
 <SolidColorBrush x:Key="StrokeSoftBrush" Color="#202020" />
 <SolidColorBrush x:Key="StrokeMedBrush" Color="#2A2A2A" />
 <SolidColorBrush x:Key="StrokeStrongBrush" Color="#3F3F3F" />

 <!-- Survols (translucides blancs -> restent un léger éclaircissement du gris) -->
 <SolidColorBrush x:Key="HoverSoftBrush" Color="#16FFFFFF" />
 <SolidColorBrush x:Key="HoverMedBrush" Color="#24FFFFFF" />

 <!-- Contrôles / saisie -->
 <SolidColorBrush x:Key="ControlFillBrush" Color="#FF212224" />
 <SolidColorBrush x:Key="ControlStrokeBrush" Color="#2A2A2A" />
 <SolidColorBrush x:Key="InputFillBrush" Color="#1B1B1D" />
 <SolidColorBrush x:Key="InputStrokeBrush" Color="#202020" />
 <SolidColorBrush x:Key="ConsolePanelBrush" Color="#161616" /> <!-- console/carte: gris un bot tiers -->


 <!-- Panneaux / notifications / overlay / tooltip -->
 <SolidColorBrush x:Key="PanelBrush" Color="#F51B1B1D" />
 <SolidColorBrush x:Key="NotifCardBrush" Color="#1B1B1D" />
 <SolidColorBrush x:Key="NotifSuccessBg" Color="#2A3320" />
 <SolidColorBrush x:Key="TooltipBrush" Color="#F52A2A2A" />
 <SolidColorBrush x:Key="ScrimBrush" Color="#7A1A1A1A" />
 <SolidColorBrush x:Key="SkeletonBrush" Color="#2A2B2E" />

 <!-- Accent: NON redéfini -> la skin un bot tiers SUIT l'accent Givre choisi par l'utilisateur (ambre par défaut,
 ou bleu/violet/emeraude/crimson selon le thème actif). On ne touche donc PAS aux clés Accent*/AccentSoft*/
 SystemAccentColor: elles restent celles du thème d'accent (Themes/*.axaml). Surfaces grises un bot tiers + TON
 accent. (Choix utilisateur: « suivre l'accent Givre ».) -->


 <!-- Plus de halo d'accent: Un bot tiers est plat -->
 <SolidColorBrush x:Key="WindowGlowBrush" Color="#00000000" />

 <!-- ToggleSwitch OFF (le ON suit SystemAccentColor = violet) -->
 <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#2A2B2E" />
 <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#34343A" />
 <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#3F3F3F" />
 <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#44444A" />
 <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#B4B4B8" />
 <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#E6E6E6" />

 <!-- ComboBox (Fluent) -->
 <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF212224" />
 <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF2A2B2E" />
 <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF1A1A1C" />
 <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FF2A2B2E" />
 <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2A2A2A" />
 <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F5161616" />
 <SolidColorBrush x:Key="ComboBoxForeground" Color="#B4B4B8" />
 <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#B4B4B8" />
 <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#ECECEC" />
 <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#ECECEC" />

 <!-- DatePicker (onglet Stats) -->
 <SolidColorBrush x:Key="DateTimePickerFlyoutButtonBackground" Color="#212224" />
 <SolidColorBrush x:Key="DateTimePickerFlyoutButtonBackgroundPointerOver" Color="#2A2B2E" />
 <SolidColorBrush x:Key="DateTimePickerFlyoutButtonBackgroundPressed" Color="#1A1A1C" />
 <SolidColorBrush x:Key="DateTimePickerFlyoutButtonBorderBrush" Color="#2A2A2A" />
 <SolidColorBrush x:Key="DateTimePickerButtonForeground" Color="#ECECEC" />
 <SolidColorBrush x:Key="DateTimePickerFlyoutButtonForegroundPointerOver" Color="#ECECEC" />
 <SolidColorBrush x:Key="DateTimePickerFlyoutButtonForegroundPressed" Color="#ECECEC" />
 <SolidColorBrush x:Key="DatePickerFlyoutPresenterBackground" Color="#F5161616" />
 <SolidColorBrush x:Key="DatePickerFlyoutPresenterBorderBrush" Color="#2A2A2A" />
 <SolidColorBrush x:Key="DatePickerFlyoutPresenterHighlightFill" Color="#2A2B2E" />
 <SolidColorBrush x:Key="DatePickerFlyoutPresenterSpacerFill" Color="#1A1A1C" />

 <!-- Coins des popups: plats -->
 <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>
</ResourceDictionary>
