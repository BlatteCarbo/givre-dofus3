<Styles x:Class="GivreClone.App.Skins.ClassicControls" xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- ==========================================================================================
 Skin « » — STYLES DE CONTRÔLES. Ajouté à Application.Styles APRÈS Controls.axaml
 (les styles plus tardifs de même spécificité gagnent). Les setters de Controls.axaml résolvent
 leurs {StaticResource *Brush} au CHARGEMENT (valeurs GivreClone figées); on les RÉ-ÉMET ici en
 {DynamicResource *Brush} -> ils pointent vers la palette un bot tiers (owner-copy de SkinService).
 L'accent est TOUJOURS consommé en DynamicResource (jamais StaticResource Accent* = crash).
 ========================================================================================== -->

 <!-- Police globale: Segoe UI au lieu de Roboto -->
 <Style Selector="Window">
 <Setter Property="FontFamily" Value="Segoe UI, Roboto, sans-serif" />
 </Style>

 <!-- Texte: argent un bot tiers -->
 <Style Selector="TextBlock.h1"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
 <Style Selector="TextBlock.section"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
 <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
 <Style Selector="TextBlock.body"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
 <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>

 <!-- ===== Bouton primaire: violet PLAT (plus de dégradé bleu + halo + scale) ===== -->
 <Style Selector="Button.primary">
 <Setter Property="Template">
 <ControlTemplate>
 <Border Name="Bg" CornerRadius="4" Padding="22,0" Background="{DynamicResource AccentBrush}">
 <ContentPresenter Content="{TemplateBinding Content}"
 HorizontalAlignment="Center" VerticalAlignment="Center"
 TextElement.Foreground="White" />
 </Border>
 </ControlTemplate>
 </Setter>
 </Style>
 <Style Selector="Button.primary:pointerover /template/ Border#Bg">
 <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}" />
 </Style>
 <Style Selector="Button.primary:pressed /template/ Border#Bg">
 <Setter Property="Background" Value="{DynamicResource AccentDeepBrush}" />
 </Style>
 <Style Selector="Button.primary:pointerover"><Setter Property="RenderTransform" Value="scale(1)" /></Style>
 <Style Selector="Button.primary:pressed"><Setter Property="RenderTransform" Value="scale(1)" /></Style>

 <!-- ===== Bouton accent: même traitement violet plat, compact ===== -->
 <Style Selector="Button.accent">
 <Setter Property="Template">
 <ControlTemplate>
 <Border Name="Bg" CornerRadius="4" Padding="16,0" Background="{DynamicResource AccentBrush}">
 <ContentPresenter Content="{TemplateBinding Content}"
 HorizontalAlignment="Center" VerticalAlignment="Center"
 TextElement.Foreground="White" />
 </Border>
 </ControlTemplate>
 </Setter>
 </Style>
 <Style Selector="Button.accent:pointerover /template/ Border#Bg">
 <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}" />
 </Style>
 <Style Selector="Button.accent:pressed /template/ Border#Bg">
 <Setter Property="Background" Value="{DynamicResource AccentDeepBrush}" />
 </Style>
 <Style Selector="Button.accent:pointerover"><Setter Property="RenderTransform" Value="scale(1)" /></Style>
 <Style Selector="Button.accent:pressed"><Setter Property="RenderTransform" Value="scale(1)" /></Style>

 <!-- ===== Carte: gris plat + liseré sombre + coins presque droits ===== -->
 <Style Selector="Border.card">
 <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
 <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" />
 <Setter Property="CornerRadius" Value="3" />
 </Style>
 <Style Selector="Border.badge"><Setter Property="CornerRadius" Value="2" /></Style>
 <Style Selector="Border.notice"><Setter Property="CornerRadius" Value="2" /></Style>

 <!-- ===== Boutons neutres: fond/texte re-pointés vers la palette un bot tiers ===== -->
 <Style Selector="Button.ghost"><Setter Property="Background" Value="{DynamicResource Surface2Brush}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
 <Style Selector="Button.ghost:pointerover"><Setter Property="Background" Value="{DynamicResource Surface3Brush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
 <Style Selector="Button.iconbtn"><Setter Property="Background" Value="{DynamicResource Surface2Brush}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
 <Style Selector="Button.iconbtn:pointerover"><Setter Property="Background" Value="{DynamicResource Surface3Brush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
 <Style Selector="Button.file"><Setter Property="Background" Value="{DynamicResource Surface1Brush}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
 <Style Selector="Button.file:pointerover"><Setter Property="Background" Value="{DynamicResource Surface3Brush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
 <Style Selector="Button.link"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
 <Style Selector="Button.link:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
 <Style Selector="Button.cardx"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
 <Style Selector="Button.cardx:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>

 <!-- Bouton choix de langue -->
 <Style Selector="Button.langpick"><Setter Property="Background" Value="{DynamicResource Surface1Brush}" /><Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" /><Setter Property="CornerRadius" Value="3" /></Style>
 <Style Selector="Button.langpick.active"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>

 <!-- ===== Saisie ===== -->
 <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource InputFillBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InputStrokeBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="CornerRadius" Value="3" /></Style>
 <Style Selector="TextBox.key"><Setter Property="Background" Value="{DynamicResource InputFillBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InputStrokeBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="CornerRadius" Value="4" /></Style>
 <Style Selector="TextBox.search"><Setter Property="Background" Value="{DynamicResource InputFillBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InputStrokeBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="CornerRadius" Value="3" /></Style>

 <!-- ===== Dropdowns ===== -->
 <Style Selector="ComboBox"><Setter Property="Background" Value="{DynamicResource ControlFillBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="CornerRadius" Value="3" /></Style>
 <Style Selector="ComboBoxItem"><Setter Property="CornerRadius" Value="2" /></Style>
 <Style Selector="DatePicker"><Setter Property="Background" Value="{DynamicResource Surface2Brush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="CornerRadius" Value="3" /></Style>
 <Style Selector="DatePicker /template/ Button#PART_FlyoutButton"><Setter Property="Background" Value="{DynamicResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="CornerRadius" Value="3" /></Style>

 <!-- ===== Divers ===== -->
 <Style Selector="RadioButton"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
 <Style Selector="ToggleSwitch"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
 <Style Selector="ToolTip"><Setter Property="Background" Value="{DynamicResource TooltipBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource StrokeMedBrush}" /><Setter Property="CornerRadius" Value="3" /></Style>

 <!-- Sous-onglets segmentés -->
 <Style Selector="Border.segbar"><Setter Property="Background" Value="{DynamicResource Surface2Brush}" /><Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" /><Setter Property="CornerRadius" Value="2" /></Style>

 <!-- Console (logs): texte argent -->
 <Style Selector="TextBox.console"><Setter Property="Foreground" Value="#C0C0C0" /></Style>

 <!-- Notifications / toast: surfaces un bot tiers + coins plats -->
 <Style Selector="Border.notif"><Setter Property="Background" Value="{DynamicResource NotifCardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" /><Setter Property="CornerRadius" Value="4" /></Style>
 <Style Selector="Border.toast"><Setter Property="Background" Value="{DynamicResource PanelBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource StrokeMedBrush}" /><Setter Property="CornerRadius" Value="4" /></Style>

 <!-- ===== Lignes de liste (Proxys / Adaptateurs / Mon compte): NON stylées par défaut.
 Définies UNIQUEMENT ici -> sous la skin un bot tiers, elles deviennent des rangées grises plates. ===== -->
 <Style Selector="Border.listItem">
 <Setter Property="Background" Value="#3A3A3A" />
 <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoftBrush}" />
 <Setter Property="BorderThickness" Value="1" />
 <Setter Property="CornerRadius" Value="2" />
 </Style>

 <!-- ===== Radius PLATS des boutons dont le rayon est cuit dans le template (Controls.axaml).
 On réécrit le template à l'identique, coins 0-4px. Fond/texte via TemplateBinding. ===== -->
 <Style Selector="Button.ghost">
 <Setter Property="Template">
 <ControlTemplate>
 <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"
 BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
 <ContentPresenter Content="{TemplateBinding Content}"
 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
 VerticalAlignment="Center"
 TextElement.Foreground="{TemplateBinding Foreground}" />
 </Border>
 </ControlTemplate>
 </Setter>
 </Style>
 <Style Selector="Button.iconbtn">
 <Setter Property="Template">
 <ControlTemplate>
 <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="0"
 BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
 <ContentPresenter Content="{TemplateBinding Content}"
 HorizontalAlignment="Center" VerticalAlignment="Center"
 TextElement.Foreground="{TemplateBinding Foreground}" />
 </Border>
 </ControlTemplate>
 </Setter>
 </Style>
 <Style Selector="Button.file">
 <Setter Property="Template">
 <ControlTemplate>
 <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="16,0"
 BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
 <Grid ColumnDefinitions="*,Auto">
 <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}"
 VerticalAlignment="Center"
 TextElement.Foreground="{TemplateBinding Foreground}" />
 <PathIcon Grid.Column="1" Data="{DynamicResource IconChevronRight}"
 Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
 </Grid>
 </Border>
 </ControlTemplate>
 </Setter>
 </Style>
 <Style Selector="Button.win">
 <Setter Property="Template">
 <ControlTemplate>
 <Border Background="{TemplateBinding Background}" CornerRadius="0">
 <ContentPresenter Content="{TemplateBinding Content}"
 HorizontalAlignment="Center" VerticalAlignment="Center"
 TextElement.Foreground="{TemplateBinding Foreground}" />
 </Border>
 </ControlTemplate>
 </Setter>
 </Style>
</Styles>
