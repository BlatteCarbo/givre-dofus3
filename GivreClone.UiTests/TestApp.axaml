<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:GivreClone.App.Themes"
             x:Class="GivreClone.UiTests.TestApp"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GivreClone/Styles/Theme.axaml" />
        <ResourceInclude Source="avares://GivreClone/Styles/Icons.axaml" />
        <themes:Amber />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://GivreClone/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
