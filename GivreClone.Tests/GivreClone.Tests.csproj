    <!-- Shared source snapshots deliberately omit private protocol bundles.
         Run mapping-dependent tests when a real data/ bundle is supplied;
         missing fixtures must not prevent unrelated offline tests from building. -->
    <Content Include="..\data\matching_current.json" Link="data\matching_current.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\matching_current.json')" />
    <Content Include="..\data\confirmed.json" Link="data\confirmed.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\confirmed.json')" />
    <Content Include="..\data\fields.json" Link="data\fields.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\fields.json')" />
