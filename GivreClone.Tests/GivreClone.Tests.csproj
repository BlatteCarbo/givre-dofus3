    <Content Include="..\data\clear_game_2025.proto" Link="data\clear_game_2025.proto" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\data\clear_game_2025.proto')" />
  </ItemGroup>

  <!-- Output can live outside the repo. PathMap rewrites CallerFilePath, so source scans read the real root beside the assembly. -->
  <Target Name="WriteGivreRepoRoot" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)givre-repo-root.txt" Lines="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))" Overwrite="true" />
