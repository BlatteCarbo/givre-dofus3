<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the exact production bus and message model; only GivreCore protocol types are stubbed. -->
    <Compile Include="../../GivreClone.Engine/PacketBus.cs" Link="PacketBus.cs" />
    <Compile Include="../../GivreClone.Engine/BotMessage.cs" Link="BotMessage.cs" />
    <Compile Include="../../GivreClone.Tests/MZP0PacketBusTests.cs" Link="MZP0PacketBusTests.cs" />
    <Compile Include="MZP0ProtocolStubs.cs" />
  </ItemGroup>
</Project>
